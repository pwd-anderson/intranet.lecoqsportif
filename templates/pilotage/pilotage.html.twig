    const det=(fr.includes(r)?S.detFR:S.detIN)[r[C.ORD]]||[];
    const q=r[C.Q]||1,mt=r[C.MT]||0;
    det.forEach(l=>{const c=l[7]||0;if(!(c>0))return;
