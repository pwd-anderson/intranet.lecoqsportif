  document.getElementById('hmeta').innerHTML='Analyse au <strong>'+fmtD(TODAY)+'</strong><br>'+fmtN(o.length)+' commandes · '+fmtN(S.detail.length)+' lignes';
  document.getElementById('kpis').innerHTML=[
