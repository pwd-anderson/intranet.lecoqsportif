  const pp=$('#p-subst [data-pp]'),pn=$('#p-subst [data-pn]');
  if(pp)pp.onclick=()=>{S.page.subst=pg-1;renderSubstTable();};
  if(pn)pn.onclick=()=>{S.page.subst=pg+1;renderSubstTable();};
}

/* ---------- RESTE À ALLOUER ---------- */
function restRows(){
  const f=S.filters.rest||{};
  return S.rest.filter(r=>{
    if(f.coll&&r[1]!==f.coll)return false;
    if(f.src&&r[3]!==f.src)return false;
    if(f.dispo&&r[5]!==f.dispo)return false;
    if(f.q){const q=f.q.toLowerCase();
      if(!(String(r[0]).toLowerCase().includes(q)||String(r[2]||'').toLowerCase().includes(q)))return false;}
    return true;});
}
function renderRest(){
  const p=$('#p-rest');
  const colls=[...new Set(S.rest.map(r=>r[1]))].filter(Boolean).sort();
  const srcs=[...new Set(S.rest.map(r=>r[3]))].filter(Boolean).sort();
