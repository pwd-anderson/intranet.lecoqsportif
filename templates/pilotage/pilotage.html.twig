/* ---------- EXPORTS ---------- */
function dlBlob(blob,name){const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),4000);}
function aoaSheet(wb,name,aoa){const ws=XLSX.utils.aoa_to_sheet(aoa);ws['!freeze']={xSplit:0,ySplit:1};XLSX.utils.book_append_sheet(wb,ws,name.slice(0,31));}
function dlWb(base,sheets){
  const wb=XLSX.utils.book_new();
  sheets.forEach(([n,aoa])=>aoaSheet(wb,n,aoa));
  const out=XLSX.write(wb,{type:'array',bookType:'xlsx'});
  dlBlob(new Blob([out],{type:'application/octet-stream'}),`${base}_${today()}.xlsx`);
}
function today(){const d=new Date();return d.toISOString().slice(0,10);}
function exportPil(mod){
  const rows=pilRows(mod);
  dlWb(mod==='pfr'?'Pilotage_France':'Pilotage_International',
   [[mod==='pfr'?'PILOTAGE FRANCE':'PILOTAGE INTERNATIONAL',[S.heads[mod],...rows]]]);
}
function substAoa(tab){
  const sd=tab==='FR'?S.subFR:S.subIN;
  const rows=sd.rows.map(r=>{const key=r[0]+'|'+r[3]+'|'+r[8];const v=S.retained[tab][key];
    const rr=[...r]; if(v!=null&&v!=='')rr[14]=+v; return rr;});
  return [sd.head,...rows];
}
function exportSubst(){
  const tab=S.substTab, sd=tab==='FR'?S.subFR:S.subIN;
  const rows=substRows().map(r=>{const key=r[0]+'|'+r[3]+'|'+r[8];const v=S.retained[tab][key];
    const rr=[...r]; if(v!=null&&v!=='')rr[14]=+v; return rr;});
  dlWb(tab==='FR'?'Subst_France':'Subst_Intl',[[tab==='FR'?'SUBST FRANCE':'SUBST INTL',[sd.head,...rows]]]);
}
function exportOrder(ord,mod){
  const rows=mod==='pfr'?S.pfr:S.pint, H=S.heads[mod];
  const r=rows.find(x=>x[C.ORD]===ord); if(!r)return;
  const det=(mod==='pfr'?S.detFR:S.detIN)[ord]||[];
  const tab=mod==='pfr'?'FR':'IN', sd=tab==='FR'?S.subFR:S.subIN;
  const sub=sd.rows.filter(s=>s[0]===ord).map(s=>{const key=s[0]+'|'+s[3]+'|'+s[8];const v=S.retained[tab][key];
    const rr=[...s]; if(v!=null&&v!=='')rr[14]=+v; return rr;});
  const info=H.map((h,i)=>[h,r[i]]);
  const sheets=[['COMMANDE',[['Champ','Valeur'],...info]],
    ['DETAIL',[['N° COMMANDE','SKU','DÉSIGNATION','QTÉ','ALLOUÉE','SOURCES → ARRIVÉES','À TEMPS','RETARD','ANNULÉ'],...det.map(l=>[ord,...l])]]];
  if(sub.length)sheets.push(['SUBSTITUTIONS',[sd.head,...sub]]);
  dlWb('Commande_'+ord,sheets);
}
function exportFull(){
  const H=S.heads;
  const detAoa=(d)=>{const out=[['N° COMMANDE','SKU','DÉSIGNATION','QTÉ','ALLOUÉE','SOURCES → ARRIVÉES','À TEMPS','RETARD','ANNULÉ']];
    for(const ord of Object.keys(d))for(const l of d[ord])out.push([ord,...l]);return out;};
  const {fr,int}=(()=>{const svg=S.filters.macro;S.filters.macro={};const r=macroRows();S.filters.macro=svg;return r;})();
  const gFR=agg(fr,'France'),gIN=agg(int,'International');
  const groups=[];const mk=(seg,rows,tag)=>{const by={};rows.forEach(r=>{(by[r[C.COLL]]=by[r[C.COLL]]||[]).push(r);});
    Object.keys(by).sort().forEach(cl=>{const a=agg(by[cl],tag);groups.push([seg,cl,a.pretP,a.pretC,a.pretE,a.partP,a.partC,+a.lateAvg.toFixed(2),a.lateN,a.mt,a.cmd]);});};
  mk('France — Wholesale France',fr,'France');mk('International — Wholesale International',int,'International');
  const tot={};for(const k of Object.keys(gFR))tot[k]=(gFR[k]||0)+(gIN[k]||0);tot.lateAvg=tot.lateN?tot.lateSum/tot.lateN:0;
  groups.push(['TOTAL','',tot.pretP,tot.pretC,tot.pretE,tot.partP,tot.partC,+tot.lateAvg.toFixed(2),tot.lateN,tot.mt,tot.cmd]);
  dlWb('Pilotage_Livraisons_V2',[
    ['Maccro View',[H.macro,...groups]],
    ['PILOTAGE FRANCE',[H.pfr,...S.pfr]],
    ['PILOTAGE INTERNATIONAL',[H.pint,...S.pint]],
    ['DETAIL FRANCE',detAoa(S.detFR)],
    ['DETAIL INTL',detAoa(S.detIN)],
    ['SUBST FRANCE',substAoa('FR')],
    ['SUBST INTL',substAoa('IN')],
    ['RESTE A ALLOUER',[S.heads.rest,...S.rest]],
    ['METHODE DE CALCUL',[['Sujet','Règle'],...S.methode]]
  ]);
}

