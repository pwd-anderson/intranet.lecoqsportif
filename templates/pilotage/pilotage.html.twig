    <div class="card v"><div class="lab">Dont dispo maintenant</div><div class="val">${fmt(now)}</div><div class="det">total module : ${fmt(sd.stats[5])}</div></div>
    <div class="card n"><div class="lab">Qté retenue (saisie)</div><div class="val">${fmt(ret)}</div><div class="det">reprise dans les exports</div></div>`;
  p.querySelector('[data-count]').textContent=`${nf.format(rows.length)} lignes de proposition`;
  p.querySelector('[data-chips]').innerHTML=chipHtml('subst',renderSubst);bindChips('#p-subst','subst',renderSubst);
