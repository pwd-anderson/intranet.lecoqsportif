function substRows(){
  const tab=S.substTab, sd=tab==='FR'?S.subFR:S.subIN, f=S.filters.subst||{};
  return sd.rows.filter(r=>{
    if(f.type&&r[7]!==f.type)return false;
    if(f.dispo==='now'&&!((r[10]||0)>0))return false;
    if(f.dispo==='later'&&((r[10]||0)>0))return false;
    if(f.q){const q=f.q.toLowerCase();
      const hay=[r[0],r[1],r[3],r[4],r[8],r[9]].map(x=>String(x||'').toLowerCase()).join('¦');
      if(!hay.includes(q))return false;}
    return true;});
}
function renderSubstTable(){
  const p=$('#p-subst'), tab=S.substTab, sd=tab==='FR'?S.subFR:S.subIN;
  const rows=substRows();
  const man=rows.reduce((s,r)=>s+(r[5]||0),0), prop=rows.reduce((s,r)=>s+(r[13]||0),0),
        now=rows.reduce((s,r)=>s+Math.min(r[10]||0,r[13]||0),0);
