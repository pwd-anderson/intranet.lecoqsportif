function sheetAoa(wb,name){return XLSX.utils.sheet_to_json(wb.Sheets[name],{header:1,defval:null,raw:true});}
function classifySource(wb,fname){
  /* détecte backlog client / fournisseur / stock par les en-têtes */
  let best=null;
  for(const sn of wb.SheetNames){
    const rows=XLSX.utils.sheet_to_json(wb.Sheets[sn],{header:1,defval:null,range:0,raw:false});
    let hi=-1,heads=null;
    for(let i=0;i<Math.min(6,rows.length);i++){
      const up=(rows[i]||[]).map(x=>String(x||'').trim().toUpperCase());
      if(up.filter(Boolean).length>4){hi=i;heads=up;break;}
    }
    if(!heads)continue;
    const has=t=>heads.some(h=>h.includes(t));
    if(has('TYPE FLUX')||has('INTERSITE')){best={k:'bf',sn,hi};break;}
    if(has('STOCK INTERNE')&&has('SITE')){best={k:'st',sn,hi};break;}
    if(has('MAINNETWORK')||((has('QUANTITE')||has('QUANTITÉ'))&&has('SKU'))){best={k:'bc',sn,hi};break;}
  }
  if(!best){showModal('alert','Fichier non reconnu : '+fname+'<br>Attendu : backlog client, backlog fournisseur ou stock &amp; allocation (ou le classeur Pilotage).');return;}
  const ws=wb.Sheets[best.sn];
  const json=XLSX.utils.sheet_to_json(ws,{defval:null,range:best.hi,raw:true,cellDates:true});
  S.srcFiles[best.k]={rows:json,name:fname,aoa:XLSX.utils.sheet_to_json(ws,{header:1,defval:null,range:best.hi,raw:true,cellDates:true})};
  const lbl={bc:'d-bc',bf:'d-bf',st:'d-st'}[best.k], nm={bc:'n-bc',bf:'n-bf',st:'n-st'}[best.k];
  $('#'+lbl).classList.add('ok');$('#l-'+best.k).classList.add('ok');
  $('#'+nm).textContent='— '+fname+' ('+nf.format(json.length)+' lignes)';
  const ready=S.srcFiles.bc&&S.srcFiles.bf&&S.srcFiles.st;
  $('#btnCompute').disabled=!ready;
  /* les 3 sources sont là : le calcul part tout seul */
  if(ready&&!S._autoRun){S._autoRun=true;
    setTimeout(()=>{computeV9().catch(e=>{showModal('alert','Erreur moulinette : '+e.message);console.error(e);$('#prog').style.display='none';S._autoRun=false;});},150);}
}
function loadPilotageWb(wb,fname){
  prog(.2,'Lecture du classeur Pilotage…');
  setTimeout(()=>{
  try{
    const get=n=>wb.SheetNames.find(s=>s.trim().toUpperCase()===n)||wb.SheetNames.find(s=>s.trim().toUpperCase().startsWith(n));
    const aoa=n=>sheetAoa(wb,get(n)).map(r=>r.map(v=>v instanceof Date?v.toISOString().slice(0,10):v));
    const pfrA=aoa('PILOTAGE FRANCE'),pintA=aoa('PILOTAGE INTERNATIONAL');
    const dFR=aoa('DETAIL FRANCE'),dIN=aoa('DETAIL INTL');
    const grp=(a)=>{const d={};for(let i=1;i<a.length;i++){const r=a[i];if(!r||!r[0])continue;(d[r[0]]=d[r[0]]||[]).push(r.slice(1,9));}return d;};
    const sub=(n)=>{const a=sheetAoa(wb,get(n)).map(r=>r.map(v=>v instanceof Date?v.toISOString().slice(0,10):v));
      const hi=a.findIndex(r=>String(r[0]||'').trim().toUpperCase()==='COMMANDE');
      return {stats:a[1]||[],head:a[hi],rows:a.slice(hi+1).filter(r=>r&&r[0])};};
    const restA=aoa('RESTE A ALLOUER');
    const rHi=restA.findIndex(r=>String(r[0]||'').trim().toUpperCase()==='SKU');
    let meth=[];const ms=get('METHODE');
    if(ms)meth=sheetAoa(wb,ms).filter(r=>r&&(r[0]||r[1])).map(r=>[String(r[0]||''),String(r[1]||'')]);
    const d={fileDate:fname.replace(/\.xlsx?$/i,''),
      pfrHead:pfrA[0],pfr:pfrA.slice(1).filter(r=>r&&r[3]),
      pintHead:pintA[0],pint:pintA.slice(1).filter(r=>r&&r[3]),
      detFR:grp(dFR),detIN:grp(dIN),subFR:sub('SUBST FRANCE'),subIN:sub('SUBST INTL'),
      restHead:restA[rHi],rest:restA.slice(rHi+1).filter(r=>r&&r[0]),restStats:restA[1]||[],
      macroHead:S.heads.macro,macro:[],methode:meth.length?meth:S.methode};
    prog(1,'Terminé');
    applyData(d,'(classeur chargé : '+fname+')');
    setTimeout(()=>{$('#prog').style.display='none';$('#loadZone').classList.remove('on');},600);
  }catch(err){showModal('alert','Erreur de lecture du classeur : '+err.message);$('#prog').style.display='none';}
  },30);
}
