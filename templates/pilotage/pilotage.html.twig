{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
:root{
  --paper:#fff; --field:#eceef1; --line:#d8dce2; --line2:#e8ebef;
  --ink:#172b4c; --ink2:#3d4753; --mut:#6b7683;
  /* Couleurs intranet (identiques au thème du site, cf. public/assets/css/color_theme.css) */
  --gold:#40a2ed; --goldD:#2b84d4; --bleu:#2b84d4; --bleuF:#eef6fd;
  --vert:#0f7b3d; --vertF:#e7f4ec;
  --ambre:#a86a00; --ambreF:#fdf2dc;
  --rouge:#c8102e; --rougeF:#fceaec;
  --gris:#5b6572; --grisF:#eef0f3;
  --r:6px;
}
.pilotage-wrap *{box-sizing:border-box}
/* Neutralise le style checkbox custom du thème global du site (qui masque
   les inputs natifs hors du markup [type=checkbox]+label attendu) */
.pilotage-wrap input[type="checkbox"]{position:static!important;left:auto!important;
  opacity:1!important;appearance:auto;-webkit-appearance:auto;width:15px;height:15px;
  margin:0;cursor:pointer;vertical-align:middle}
.pilotage-wrap{background:var(--field);color:var(--ink);
  font:14px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  -webkit-font-smoothing:antialiased;font-variant-numeric:tabular-nums;min-height:calc(100vh - 60px)}
.pilotage-wrap h1,.pilotage-wrap h2,.pilotage-wrap h3{margin:0}

/* ---------- en-tête : fond clair ---------- */
.pilotage-wrap header{background:var(--paper);border-bottom:1px solid var(--line);
  padding:12px 24px;display:flex;align-items:center;gap:20px;position:sticky;top:0;z-index:50}
.htitle{flex:1;min-width:0}
.htitle h1{font-size:20px;font-weight:700;letter-spacing:-.02em;color:var(--ink);
  display:flex;align-items:baseline;gap:9px}
.htitle h1 em{font-style:normal;font-size:12px;font-weight:700;letter-spacing:.04em;
  color:var(--ink);background:var(--gold);border-radius:4px;padding:2px 7px;position:relative;top:-2px}
.htitle .sub{font-size:12px;color:var(--mut);margin-top:3px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hbtn{background:var(--ink);color:#fff;border:none;border-radius:var(--r);padding:9px 15px;
  font-weight:600;font-size:13px;cursor:pointer;white-space:nowrap;font-family:inherit}
.hbtn.sec{background:var(--paper);color:var(--ink);border:1px solid var(--line)}
.hbtn:hover{background:var(--gold);color:var(--ink);border-color:var(--gold)}

/* ---------- onglets : le triangle du coq marque l'actif ---------- */
.pilotage-wrap nav{background:var(--paper);display:flex;gap:4px;padding:0 24px;
  position:sticky;top:72px;z-index:49;overflow-x:auto;border-bottom:1px solid var(--line)}
.pilotage-wrap nav button{background:none;border:none;color:var(--ink2);padding:13px 15px 12px;font-size:13.5px;
  font-weight:600;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap;
  font-family:inherit;position:relative}
.pilotage-wrap nav button.on{color:var(--goldD);border-bottom-color:var(--gold)}
.pilotage-wrap nav button.on:after{content:"";position:absolute;left:50%;bottom:-3px;translate:-50% 0;
  border-left:5px solid transparent;border-right:5px solid transparent;border-bottom:5px solid var(--gold)}
.pilotage-wrap nav button:hover{color:var(--ink)}
.pilotage-wrap main{padding:20px 24px 64px;max-width:1900px;margin:0 auto}
.panel{display:none}.panel.on{display:block}

/* ---------- écran d'accueil : rien tant qu'aucune donnée ---------- */
.pilotage-wrap:not(.has-data) nav,.pilotage-wrap:not(.has-data) #btnFull,.pilotage-wrap:not(.has-data) #btnLoad,.pilotage-wrap:not(.has-data) #btnReset,
.pilotage-wrap:not(.has-data) .panel,.pilotage-wrap:not(.has-data) .htitle .sub{display:none!important}
.pilotage-wrap:not(.has-data) main{padding-top:0}
.pilotage-wrap:not(.has-data) #btnCloseLoad{display:none}
.pilotage-wrap:not(.has-data) #loadZone{display:block;max-width:760px;margin:8vh auto 0;
  border-style:dashed;border-width:2px;padding:34px 34px 30px}
.pilotage-wrap.has-data #loadZone{display:none;margin:0 0 18px}
.pilotage-wrap.has-data #loadZone.on{display:block}
#loadZone{background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:20px 22px}
#loadZone.drag{border-color:var(--gold);background:var(--bleuF)}
#loadZone h3{font-size:18px;letter-spacing:-.01em;margin-bottom:6px}
#loadZone .lead{font-size:13.5px;color:var(--ink2);line-height:1.6;margin-bottom:18px}
#loadZone .lead b{color:var(--ink)}
.dates-det{margin:12px 0 4px}
.dates-det summary{cursor:pointer;font-size:12.5px;color:var(--mut);font-weight:600}
.dates{display:flex;gap:22px;flex-wrap:wrap;align-items:flex-end;
  background:var(--grisF);border-radius:8px;padding:12px 14px;margin-bottom:16px}
.dates label{display:block;font-size:11.5px;font-weight:700;color:var(--ink2);margin-bottom:4px}
.dates input{border:1px solid var(--line);border-radius:var(--r);padding:7px 9px;
  font-size:13px;font-family:inherit;background:var(--paper)}
.dates .hint{font-size:12px;color:var(--mut);flex:1;min-width:200px}
.srcline{display:flex;align-items:center;gap:9px;padding:9px 11px;border:1px solid var(--line2);
  border-radius:var(--r);margin-bottom:7px;font-size:13.5px;font-weight:600;background:var(--paper)}
.srcline.ok{border-color:var(--vert);background:var(--vertF)}
.dot{width:9px;height:9px;border-radius:50%;background:var(--line);flex:0 0 auto}
.dot.ok{background:var(--vert)}
.srcline .mut{font-weight:400}
#prog{display:none;margin-top:14px}
#progBar{height:6px;background:var(--line2);border-radius:3px;overflow:hidden}
#progFill{height:100%;width:0;background:var(--gold);transition:width .25s}
#progTxt{font-size:12.5px;color:var(--ink2);margin-top:6px}

/* ---------- cartes ---------- */
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(196px,1fr));gap:12px;margin-bottom:16px}
.card{background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--gold);
  border-radius:8px;padding:13px 15px;cursor:pointer;transition:border-color .15s,background .15s;overflow:hidden}
.card:hover{border-color:var(--gold);background:#f5faff}
.card .lab{font-size:11.5px;color:var(--mut);font-weight:600}
.card .val{font-size:22px;white-space:normal;overflow-wrap:break-word;font-weight:700;letter-spacing:-.02em;margin-top:2px;line-height:1.2}
.card .det{font-size:12px;color:var(--mut);margin-top:2px}
.card.v{border-left-color:var(--vert)}.card.j{border-left-color:var(--ambre)}
.card.r{border-left-color:var(--rouge)}.card.n{border-left-color:var(--gris)}

/* ---------- filtres ---------- */
.fbar{display:flex;flex-wrap:wrap;gap:9px;align-items:flex-end;background:var(--paper);
  border:1px solid var(--line);border-radius:8px;padding:11px 13px;margin-bottom:12px}
.fbar label{font-size:11.5px;font-weight:600;color:var(--mut);display:block;margin-bottom:3px}
.fbar .fg{display:flex;flex-direction:column}
.fbar select,.fbar input[type=text]{border:1px solid var(--line);border-radius:var(--r);
  padding:7px 9px;font-size:13px;background:var(--paper);min-width:125px;font-family:inherit;color:var(--ink)}
.fbar input[type=text]{min-width:220px}
.fbar select:focus,.fbar input:focus{outline:2px solid var(--gold);outline-offset:-1px}
.fbar .sp{flex:1}
.chip{background:var(--bleuF);color:var(--goldD);border:1px solid #b8dbf6;border-radius:13px;
  padding:4px 11px;font-size:12px;font-weight:600;cursor:pointer;display:inline-block}
.chip:after{content:" ✕";opacity:.6}
.btn{background:var(--ink);color:#fff;border:none;border-radius:var(--r);padding:8px 14px;
  font-weight:600;font-size:12.5px;cursor:pointer;font-family:inherit}
.btn.gold{background:var(--gold);color:var(--ink)}
.btn.ghost{background:var(--paper);border:1px solid var(--line);color:var(--ink)}
.btn:hover{filter:brightness(1.15)}
.btn.ghost:hover{border-color:var(--gold);color:var(--goldD);filter:none}
.btn:disabled{opacity:.4;cursor:not-allowed;filter:none}

/* ---------- tables ---------- */
.twrap{background:var(--paper);border:1px solid var(--line);border-radius:8px;
  overflow:auto;max-height:calc(100vh - 300px)}
.pilotage-wrap table{border-collapse:collapse;width:100%;font-size:12.6px}
.pilotage-wrap thead th{background:var(--ink);color:#fff;text-align:left;padding:9px;position:sticky;top:0;
  cursor:pointer;user-select:none;white-space:nowrap;font-size:11.5px;font-weight:600;z-index:2}
.pilotage-wrap thead th .arr{color:var(--gold);font-size:10px}
.pilotage-wrap tbody td{padding:7px 9px;border-bottom:1px solid var(--line2);white-space:nowrap;vertical-align:top}
.pilotage-wrap tbody tr:hover{background:#eef6fd}
.pilotage-wrap tbody tr.click{cursor:pointer}
.pilotage-wrap td.num{text-align:right}
.pilotage-wrap td.syn{white-space:normal;min-width:280px;max-width:440px;font-size:12.8px}
.badge{display:inline-block;border-radius:11px;padding:2px 9px;font-size:11.5px;font-weight:600;white-space:nowrap}
.b-vert{background:var(--vertF);color:var(--vert)}
.b-jaune{background:var(--ambreF);color:var(--ambre)}
.b-blanc{background:var(--grisF);color:var(--gris)}
.b-noir{background:#e2e5e9;color:var(--ink)}
.b-rouge{background:var(--rougeF);color:var(--rouge)}
.late{color:var(--rouge);font-weight:600}
.early{color:var(--vert);font-weight:600}
.pgn{display:flex;gap:7px;align-items:center;justify-content:flex-end;margin-top:11px;
  font-size:12.5px;color:var(--ink2)}
.pgn button{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);
  padding:5px 11px;cursor:pointer;font-family:inherit;font-size:12.5px}
.pgn button:disabled{opacity:.4;cursor:not-allowed}
.mut{color:var(--mut)}
h2.sec{font-size:15px;font-weight:700;letter-spacing:-.01em;margin:18px 0 9px}

/* ---------- tiroir commande ---------- */
#ovl{display:none;position:fixed;inset:0;background:rgba(16,20,24,.42);z-index:60}
#drawer{position:fixed;top:0;right:0;width:min(880px,94vw);height:100%;background:var(--field);
  z-index:61;transform:translateX(101%);transition:transform .22s ease;
  overflow:auto;box-shadow:-8px 0 28px rgba(16,20,24,.16)}
#drawer.open{transform:none}
#drawer .dh{display:flex;align-items:center;gap:12px;padding:15px 20px;background:var(--paper);
  border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2}
#drawer .dh h3{font-size:17px;letter-spacing:-.01em;flex:1}
#drawer .dh .x{background:none;border:1px solid var(--line);border-radius:var(--r);
  padding:6px 11px;cursor:pointer;font-family:inherit;font-size:12.5px;color:var(--ink)}
#dBody{padding:18px 20px 40px}
.synbox{background:var(--paper);border:1px solid var(--line);border-left:4px solid var(--gold);
  border-radius:8px;padding:13px 15px;font-size:14px;margin-bottom:15px}
.kv{display:grid;grid-template-columns:repeat(auto-fit,minmax(168px,1fr));gap:9px;margin-bottom:15px}
.kv .it{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:9px 11px}
.kv .it .k{font-size:11px;color:var(--mut);font-weight:600}
.kv .it .v{font-size:15px;font-weight:700;margin-top:1px}
.dact{display:flex;gap:9px;margin-bottom:15px;flex-wrap:wrap}

/* ---------- macro v2 : actions, couverture, grille ---------- */
.actbar{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin-bottom:14px}
.act{background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:12px 15px;border-top:3px solid var(--gold);cursor:pointer}
.act:hover{border-color:var(--gold)}
.act .t{font-size:11.5px;font-weight:700;color:var(--mut);text-transform:uppercase;letter-spacing:.03em}
.act .big{font-size:20px;font-weight:700;letter-spacing:-.02em;margin:3px 0 1px}
.act .sub{font-size:12.5px;color:var(--ink2)}
.act a{font-size:12.5px;font-weight:600;color:var(--goldD);text-decoration:none}
.cover{display:flex;height:9px;border-radius:5px;overflow:hidden;background:var(--line2);min-width:130px}
.cover i{display:block;height:100%}
.grid2{display:grid;grid-template-columns:7fr 5fr;gap:16px;align-items:start;margin-bottom:6px}
.pilotage-wrap td .mini{font-size:11px;color:var(--mut);font-weight:400}
@media (max-width:1100px){.grid2{grid-template-columns:1fr}}
/* ---------- arrivées par semaine ---------- */
.arrchart{background:var(--paper);border:1px solid var(--line);border-radius:8px;padding:16px 16px 8px;overflow-x:auto;margin-bottom:13px}
.arrchart svg{display:block}
.arrleg{display:flex;gap:18px;font-size:12.5px;color:var(--ink2);padding:4px 2px 8px}
.arrleg i{display:inline-block;width:11px;height:11px;border-radius:2px;margin-right:6px;vertical-align:-1px}
.segArr{background:var(--ambreF);color:var(--ambre);border-radius:3px;padding:0 3px}
.arrq{color:var(--ambre);font-weight:700}
/* ---------- divers ---------- */
.note{font-size:12.5px;color:var(--ink2);background:var(--paper);border:1px solid var(--line);
  border-left:4px solid var(--ambre);border-radius:var(--r);padding:10px 13px;margin-bottom:13px}
.meth td{padding:9px 11px;border-bottom:1px solid var(--line2);white-space:normal;vertical-align:top;font-size:13px}
.meth td:first-child{font-weight:700;width:270px;color:var(--ink)}
.pilotage-wrap input.qr{width:76px;border:1px solid var(--ambre);background:var(--ambreF);border-radius:4px;
  padding:3px 6px;font-size:12.5px;text-align:right;font-family:inherit}
.substTag{display:inline-block;margin-right:7px}
@media (max-width:900px){
.pilotage-wrap header{flex-wrap:wrap;gap:12px;padding:10px 14px}
  .htitle{border-left:none;padding-left:0;flex:1 1 100%;order:3}
.pilotage-wrap nav{top:auto;position:static;padding:0 10px}
.pilotage-wrap main{padding:14px 12px 48px}
  .twrap{max-height:none}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}

/* ---------- intégration Symfony : bascule live/import + progress bar live ---------- */
.pilotage-wrap .hide{display:none!important}
.pilotage-wrap .srctabs{display:flex;gap:8px;margin-bottom:14px}
.pilotage-wrap .srctabs button{background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:var(--r);padding:8px 14px;font-weight:600;font-size:12.5px;cursor:pointer;font-family:inherit}
.pilotage-wrap .srctabs button.on{background:var(--gold);color:var(--ink);border-color:var(--gold)}
.pilotage-wrap .srctabs button:hover{filter:brightness(1.08)}
.pilotage-wrap .srctabs button#btnShowDiagram{background:transparent;color:var(--goldD);border-color:var(--goldD)}
.pilotage-wrap .srctabs button#btnShowDiagram:hover{background:var(--bleuF)}
.pilotage-wrap .coll-wrap{display:flex;align-items:flex-start;gap:18px;flex-wrap:wrap;margin-bottom:16px}
.pilotage-wrap .coll-label{font-size:11.5px;font-weight:700;color:var(--ink2);margin-bottom:6px}
.pilotage-wrap #pil-collections{border:1px solid var(--line);border-radius:var(--r);padding:4px;font-size:12.5px;min-width:220px;background:var(--paper);font-family:inherit}
.pilotage-wrap #pil-collections option{padding:5px 9px;border-radius:4px}
.pilotage-wrap #progLive{display:none;margin-top:14px}
.pilotage-wrap #progLive.on{display:block}
.pilotage-wrap #progBarLive{height:6px;background:var(--line2);border-radius:3px;overflow:hidden}
.pilotage-wrap #progFillLive{height:100%;width:0;background:var(--gold);transition:width .25s}
.pilotage-wrap #progTxtLive{font-size:12.5px;color:var(--ink2);margin-top:6px}
</style>
{% endblock %}

{% block body %}
<div class="pilotage-wrap">
<header>
  <div class="htitle">
    <h1>Pilotage Livraisons <em>V2</em></h1>
    <div class="sub">Backlog client × backlog fournisseur × stock &amp; allocation — moteur V10 · données du <span id="fdate">…</span><span id="srcMode"></span></div>
  </div>
  <button class="hbtn sec" id="btnReset" title="Décharge tous les fichiers et revient à l’écran d’accueil">⟲ Tout décharger</button>
  <button class="hbtn sec" id="btnLoad">Charger des fichiers</button>
  <button class="hbtn" id="btnFull">Exporter le classeur</button>
</header>
<nav id="tabs">
  <button data-t="macro" class="on">Macro View</button>
  <button data-t="pfr">Pilotage France</button>
  <button data-t="pint">Pilotage International</button>
  <button data-t="subst">Substitutions</button>
  <button data-t="rest">Reste à allouer</button>
  <button data-t="arr">Arrivées par semaine</button>
  <button data-t="meth">Méthode de calcul</button>
</nav>
<main>
  <div id="loadZone">
    <h3>Chargez les données pour lancer le calcul</h3>
    <div class="lead">
      Par défaut les 3 sources (backlog client, backlog fournisseur, stock &amp; allocation) sont chargées en direct depuis l'ERP.
      Un mode d'import de fichiers (.xlsx, .xls, .csv) reste disponible pour les tests — le calcul part tout seul (30 à 60 s) dès que les 3 sources sont prêtes.
    </div>

    <div class="srctabs">
      <button class="on" id="tabLive" type="button">Données live (ERP)</button>
      <button id="tabFileImport" type="button">Import fichiers</button>
      <button id="btnShowDiagram" type="button" style="margin-left:auto">Comment ça calcule ?</button>
    </div>

    <div id="liveZone">
      <div class="coll-wrap">
        <div>
          <div class="coll-label">Collections (Ctrl+clic pour sélection multiple) — filtre appliqué uniquement au backlog client</div>
          <select id="pil-collections" multiple size="4">
            <option value="2026-02-FW" selected>FW26 — 2026-02-FW</option>
            <option value="2027-01-SS" selected>SS27 — 2027-01-SS</option>
            <option value="2027-02-FW">FW27 — 2027-02-FW</option>
          </select>
        </div>
      </div>
      <button class="btn gold" id="btnLoadLive">Charger les données</button>
      <div id="progLive"><div id="progBarLive"><div id="progFillLive"></div></div><div id="progTxtLive"></div></div>
    </div>

    <div id="fileZone" class="hide">
      <div class="srcline" id="l-bc"><span class="dot" id="d-bc"></span> Backlog client <span class="mut" id="n-bc"></span></div>
      <div class="srcline" id="l-bf"><span class="dot" id="d-bf"></span> Backlog fournisseur <span class="mut" id="n-bf"></span></div>
      <div class="srcline" id="l-st"><span class="dot" id="d-st"></span> Stock &amp; allocation <span class="mut" id="n-st"></span></div>
      <input type="file" id="fileInp" multiple accept=".xlsx,.xls,.csv,.png" style="display:none">
      <div style="margin-top:12px;display:flex;gap:9px;flex-wrap:wrap">
        <button class="btn gold" id="btnCompute" disabled>Lancer le calcul</button>
        <button class="btn ghost" id="btnCloseLoad">Fermer</button>
      </div>
      <div id="prog"><div id="progBar"><div id="progFill"></div></div><div id="progTxt"></div></div>
    </div>

    <details class="dates-det"><summary>Dates de calcul (automatiques)</summary>
      <div class="dates">
        <div>
          <label for="refArrInp">Référence des arrivées (T0 stock et PO)</label>
          <input type="date" id="refArrInp">
        </div>
        <div>
          <label for="genDateInp">Jour de calcul (retards échus)</label>
          <input type="date" id="genDateInp">
        </div>
        <div class="hint">Prerémplies à aujourd'hui.</div>
      </div>
    </details>
  </div>

  <div class="panel on" id="p-macro"></div>
  <div class="panel" id="p-pfr"></div>
  <div class="panel" id="p-pint"></div>
  <div class="panel" id="p-subst"></div>
  <div class="panel" id="p-rest"></div>
  <div class="panel" id="p-arr"></div>
  <div class="panel" id="p-meth"></div>
</main>

<div id="ovl"></div>
<div id="drawer">
  <div class="dh"><h3 id="dTitle">Commande</h3><span id="dStat"></span><button class="x" id="dClose">Fermer</button></div>
  <div id="dBody"></div>
</div>
</div>{# /.pilotage-wrap #}

{# Modale explicative : schéma de la moulinette (SVG statique, aucune dépendance externe) #}
<div class="modal fade" id="diagramModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Comment la moulinette calcule le pilotage</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body" style="overflow-x:auto">
        <svg viewBox="0 0 920 580" style="width:100%;height:auto;min-width:760px;font-family:system-ui,'Segoe UI',Roboto,Helvetica,Arial,sans-serif">
          <defs>
            <marker id="pilArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0,0 L10,5 L0,10 z" fill="#172b4c"></path>
            </marker>
          </defs>

          <text x="460" y="26" text-anchor="middle" font-size="19" font-weight="700" fill="#172b4c">Moulinette Pilotage Livraisons</text>

          <!-- Zone Sources -->
          <rect x="10" y="55" width="200" height="320" rx="10" fill="#dbe4ff" opacity="0.4"></rect>
          <text x="110" y="75" text-anchor="middle" font-size="13" font-weight="700" fill="#1e40af">SOURCES</text>
