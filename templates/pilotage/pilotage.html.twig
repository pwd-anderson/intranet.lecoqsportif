/* ── Table pilotage ─────────────────────────────────────────────────────── */
const PILCOLS=[['cat','Catégorie'],['cf','Client facturé'],['ord','N° commande'],['stat','Statut'],['coll','Collection'],
 ['dliv','Date demandée'],['qte','Qté commandée'],['pctOn','% à temps'],['pctLate','% en retard'],['on','Qté à temps'],
 ['etaOn1','1ʳᵉ ETA à temps'],['etaOn2','Dernière ETA à temps'],['late','Qté en retard'],['etaL1','1ʳᵉ ETA retard'],
 ['etaL2','Dernière ETA retard'],['retMoy','Retard moy (j)'],['qs','Qté dispo (stock)'],['qp','Qté à venir (prod)'],
 ['qa','Qté à annuler'],['cov','% couverture'],['nsrc','Nb sources'],['tsrc','Type de source'],['posTxt','PO fournisseur'],
 ['eur','Montant EUR'],['mag','Magasin / client cmd'],['ref','Réf. cmd client']];
function pilFiltered(){
  const q=norm(document.getElementById('fSearch').value),cat=document.getElementById('fCat').value,
    st=document.getElementById('fStat').value,co=document.getElementById('fColl').value,ca=document.getElementById('fCancel').checked;
  let a=S.orders.filter(o=>(!cat||o.cat===cat)&&(!st||o.stat===st)&&(!co||o.coll===co)&&(!ca||o.qa>0)
    &&(!q||norm(o.cf).includes(q)||norm(o.ord).includes(q)||norm(o.mag).includes(q)||norm(o.posTxt).includes(q)||norm(o.ref).includes(q)));
  const{k,dir}=S.pilSort;
  a.sort((x,y)=>{let A=x[k],B=y[k];if(A instanceof Date)A=+A;if(B instanceof Date)B=+B;
    if(A==null)A=-Infinity;if(B==null)B=-Infinity;
    return (typeof A==='string'?A.localeCompare(B):A-B)*dir;});
  return a;}
function drawPil(){
  const a=pilFiltered(),tot=Math.ceil(a.length/S.PER);
  if(S.pilPage>=tot)S.pilPage=0;
  const page=a.slice(S.pilPage*S.PER,(S.pilPage+1)*S.PER);
  document.getElementById('cPil').textContent=fmtN(a.length)+' commandes · '+fmtN(a.reduce((s,x)=>s+x.qte,0))+' pcs · '+fmtE(a.reduce((s,x)=>s+x.eur,0));
  const th=PILCOLS.map(([k,l])=>'<th class="s" data-k="'+k+'">'+l+(S.pilSort.k===k?(S.pilSort.dir>0?' ▲':' ▼'):'')+'</th>').join('');
  const body=page.map(o=>{
    const pc=o.stat.includes('On time')?'p-g':o.stat.includes('Partiellement')?'p-a':o.stat.includes('À annuler')?'p-n':'p-r';
    const cc=o.cov>=.999?'hi':o.cov<.5?'lo':'';
    return '<tr class="clickable'+(o.stat.includes('À annuler')?' cancel':'')+'" data-ord="'+esc(o.ord)+'">'+
      '<td>'+esc(o.cat)+'</td><td>'+esc(o.cf)+'</td><td><b>'+esc(o.ord)+'</b></td>'+
      '<td><span class="pill '+pc+'">'+o.stat+'</span></td><td>'+esc(o.coll)+'</td><td class="num">'+fmtD(o.dliv)+'</td>'+
      '<td class="r num">'+fmtN(o.qte)+'</td><td class="r num ontime">'+fmtP(o.pctOn)+'</td>'+
      '<td class="r num '+(o.pctLate>0?'late':'')+'">'+fmtP(o.pctLate)+'</td><td class="r num">'+fmtN(o.on)+'</td>'+
      '<td class="num">'+fmtD(o.etaOn1)+'</td><td class="num">'+fmtD(o.etaOn2)+'</td>'+
      '<td class="r num">'+fmtN(o.late)+'</td><td class="num">'+fmtD(o.etaL1)+'</td><td class="num">'+fmtD(o.etaL2)+'</td>'+
      '<td class="r num '+(o.retMoy?'late':'')+'">'+  (o.retMoy==null?'':Math.round(o.retMoy))+'</td>'+
      '<td class="r num">'+fmtN(o.qs)+'</td><td class="r num">'+fmtN(o.qp)+'</td>'+
      '<td class="r num '+(o.qa>0?'late':'')+'">'+fmtN(o.qa)+'</td>'+
      '<td><div class="cov"><div class="track"><div class="fill '+cc+'" style="width:'+Math.min(100,o.cov*100)+'%"></div></div><span>'+fmtP(o.cov)+'</span></div></td>'+
      '<td class="r num">'+o.nsrc+'</td><td>'+esc(o.tsrc)+'</td><td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+esc(o.posTxt)+'">'+esc(o.posTxt)+'</td>'+
      '<td class="r num">'+fmtE(o.eur)+'</td><td>'+esc(o.mag)+'</td><td>'+esc(o.ref)+'</td></tr>';}).join('');
  document.getElementById('tPil').innerHTML='<thead><tr>'+th+'</tr></thead><tbody>'+body+'</tbody>';
  document.querySelectorAll('#tPil th.s').forEach(t=>t.onclick=()=>{const k=t.dataset.k;
    S.pilSort=(S.pilSort.k===k)?{k,dir:-S.pilSort.dir}:{k,dir:-1};S.pilPage=0;drawPil();});
  document.querySelectorAll('#tPil tbody tr').forEach(t=>t.onclick=()=>openDrawer(t.dataset.ord));
  document.getElementById('pgPil').innerHTML=pager(S.pilPage,tot,'pil');
  bindPager('pil');}
function pager(p,tot,id){if(tot<=1)return'';
  return '<button data-a="f" data-id="'+id+'" '+(p===0?'disabled':'')+'>«</button><button data-a="p" data-id="'+id+'" '+(p===0?'disabled':'')+'>‹</button>'+
   '<span>page '+(p+1)+' / '+tot+'</span><button data-a="n" data-id="'+id+'" '+(p>=tot-1?'disabled':'')+'>›</button><button data-a="l" data-id="'+id+'" '+(p>=tot-1?'disabled':'')+'>»</button>';}
function bindPager(id){document.querySelectorAll('#pg'+(id==='pil'?'Pil':'Det')+' button').forEach(b=>b.onclick=()=>{
  const a=b.dataset.a,arr=id==='pil'?pilFiltered():detFiltered(),tot=Math.ceil(arr.length/S.PER);
  let p=id==='pil'?S.pilPage:S.detPage;
  p=a==='f'?0:a==='l'?tot-1:a==='p'?Math.max(0,p-1):Math.min(tot-1,p+1);
  if(id==='pil'){S.pilPage=p;drawPil();}else{S.detPage=p;drawDet();}});}

/* ── Table détail ───────────────────────────────────────────────────────── */
function detFiltered(){
  const q=norm(document.getElementById('dSearch').value),st=document.getElementById('dStat').value;
  return S.detail.filter(r=>(!st||r.st===st)&&(!q||norm(r.sku).includes(q)||norm(r.ord).includes(q)||norm(r.cf).includes(q)||norm(r.des).includes(q)));}
function drawDet(){
  const a=detFiltered(),tot=Math.ceil(a.length/S.PER);
  if(S.detPage>=tot)S.detPage=0;
  const page=a.slice(S.detPage*S.PER,(S.detPage+1)*S.PER);
  document.getElementById('cDet').textContent=fmtN(a.length)+' lignes · '+fmtN(a.reduce((s,x)=>s+x.qte,0))+' pcs';
  document.getElementById('tDet').innerHTML='<thead><tr><th>Catégorie</th><th>Client facturé</th><th>N° commande</th><th>SKU</th><th>Désignation</th>'+
    '<th class="r">Qté cmd</th><th>Date demandée</th><th>ETA</th><th class="r">Retard (j)</th><th>Statut</th>'+
    '<th class="r">Qté stock</th><th class="r">Qté prod/transit</th><th class="r">Qté à annuler</th><th>PO / sources</th><th>Collection</th><th>Droppé</th><th class="r">Montant</th></tr></thead><tbody>'+
    page.map(r=>{const pc=r.st==='LIVRABLE'||r.st==='OK DELAI'?'p-g':r.st==='RETARD'?'p-a':r.st==='PARTIEL'?'p-a':'p-r';
      return '<tr><td>'+esc(r.cat)+'</td><td>'+esc(r.cf)+'</td><td><b>'+esc(r.ord)+'</b></td><td>'+esc(r.sku)+'</td><td>'+esc(r.des)+'</td>'+
      '<td class="r num">'+fmtN(r.qte)+'</td><td class="num">'+fmtD(r.dliv)+'</td><td class="num">'+fmtD(r.eta)+'</td>'+
      '<td class="r num '+(r.ret>0?'late':'')+'">'+(r.ret==null?'':r.ret)+'</td><td><span class="pill '+pc+'">'+esc(r.st)+'</span></td>'+
      '<td class="r num">'+fmtN(r.qs)+'</td><td class="r num">'+fmtN(r.qp)+'</td><td class="r num '+(r.qa>0?'late':'')+'">'+fmtN(r.qa)+'</td>'+
      '<td style="max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+esc(r.srcTxt)+'">'+esc(r.srcTxt)+'</td>'+
      '<td>'+esc(r.coll)+'</td><td>'+esc(r.drop)+'</td><td class="r num">'+fmtE(r.eur)+'</td></tr>';}).join('')+'</tbody>';
  document.getElementById('pgDet').innerHTML=pager(S.detPage,tot,'det');bindPager('det');}

/* ── Drawer commande ────────────────────────────────────────────────────── */
function openDrawer(ord){
  const o=S.orders.find(x=>x.ord===ord);if(!o)return;
  const lines=S.detail.filter(r=>r.ord===ord),srcs=(S.srcByOrder.get(ord)||[]).slice().sort((a,b)=>a.eta-b.eta);
  document.getElementById('dTitle').textContent=o.ord+' — '+o.cf;
  document.getElementById('dMeta').innerHTML=esc(o.mag)+' · '+esc(o.cat)+' · '+esc(o.coll)+' · réf. client '+esc(o.ref)+
    ' · demandée le <b>'+fmtD(o.dliv)+'</b> · <span class="pill '+(o.stat.includes('On time')?'p-g':o.stat.includes('Partiellement')?'p-a':o.stat.includes('À annuler')?'p-n':'p-r')+'">'+o.stat+'</span>';
  document.getElementById('dKpi').innerHTML=[
    ['Qté commandée',fmtN(o.qte)],['Dispo stock',fmtN(o.qs)],['À venir (prod)',fmtN(o.qp)],
    ['À annuler',fmtN(o.qa)],['Couverture',fmtP(o.cov)],['À temps',fmtN(o.on)],['En retard',fmtN(o.late)],
    ['Mode',o.ffob?'FFOB (enlèvement)':'Livré (+'+R.TRANSIT+' j)'],
    ['Retard moyen',o.retMoy==null?'—':Math.round(o.retMoy)+' j'],['Montant',fmtE(o.eur)]
  ].map(k=>'<div class="dbox"><div class="l">'+k[0]+'</div><div class="v num">'+k[1]+'</div></div>').join('');
  document.getElementById('dSrc').innerHTML='<thead><tr><th>Source</th><th>Type</th><th>État</th><th>Date IC</th><th>ETA</th><th class="r">Retard</th><th class="r">Qté</th><th class="r">Nb SKU</th></tr></thead><tbody>'+
    (srcs.length?srcs.map(s=>{const rt=(s.eta&&o.dliv)?Math.max(0,diffD(s.eta,o.dliv)):null;
      return '<tr><td><b>'+esc(s.lab)+'</b></td><td>'+esc(s.t)+'</td><td>'+esc(s.st)+'</td><td class="num">'+fmtD(s.xf)+'</td><td class="num">'+fmtD(s.eta)+'</td>'+
      '<td class="r num '+(rt?'late':'ontime')+'">'+(rt==null?'':rt?'+'+rt+' j':'à temps')+'</td><td class="r num">'+fmtN(s.q)+'</td><td class="r num">'+s.nsku+'</td></tr>';}).join('')
      :'<tr><td colspan="8" style="color:var(--faint)">Aucune source — commande à annuler</td></tr>')+'</tbody>';
  document.getElementById('dLines').innerHTML='<thead><tr><th>SKU</th><th>Désignation</th><th class="r">Qté</th><th>Date demandée</th><th>ETA</th><th class="r">Retard</th><th>Statut</th><th class="r">Stock</th><th class="r">Prod</th><th class="r">À annuler</th></tr></thead><tbody>'+
    lines.map(r=>{const pc=r.st==='LIVRABLE'||r.st==='OK DELAI'?'p-g':(r.st==='RETARD'||r.st==='PARTIEL')?'p-a':'p-r';
      return '<tr><td><b>'+esc(r.sku)+'</b></td><td>'+esc(r.des)+'</td><td class="r num">'+fmtN(r.qte)+'</td><td class="num">'+fmtD(r.dliv)+'</td>'+
      '<td class="num">'+fmtD(r.eta)+'</td><td class="r num '+(r.ret>0?'late':'ontime')+'">'+(r.ret==null?'':r.ret>0?'+'+r.ret+' j':'à temps')+'</td>'+
      '<td><span class="pill '+pc+'">'+esc(r.st)+'</span></td><td class="r num">'+fmtN(r.qs)+'</td><td class="r num">'+fmtN(r.qp)+'</td><td class="r num">'+fmtN(r.qa)+'</td></tr>';}).join('')+'</tbody>';
  document.getElementById('pil-drawer').classList.add('open');document.getElementById('ov').classList.add('on');}
const closeD=()=>{document.getElementById('pil-drawer').classList.remove('open');document.getElementById('ov').classList.remove('on')};
document.getElementById('dClose').onclick=closeD;document.getElementById('ov').onclick=closeD;
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeD()});

/* ── Filtres ────────────────────────────────────────────────────────────── */
['fSearch','fCat','fStat','fColl','fCancel'].forEach(id=>document.getElementById(id).addEventListener('input',()=>{S.pilPage=0;drawPil()}));
['dSearch','dStat'].forEach(id=>document.getElementById(id).addEventListener('input',()=>{S.detPage=0;drawDet()}));
document.getElementById('btnReset').onclick=()=>location.reload();

/* ── Export CSV ─────────────────────────────────────────────────────────── */
function csv(rows,name){
  const c=rows.map(r=>r.map(v=>{const s=v==null?'':(v instanceof Date?fmtD(v):String(v));
    return /[";\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s}).join(';')).join('\n');
  const b=new Blob(['﻿'+c],{type:'text/csv;charset=utf-8'}),u=URL.createObjectURL(b),a=document.createElement('a');
  a.href=u;a.download=name;a.click();URL.revokeObjectURL(u);}
document.getElementById('btnCsvPil').onclick=()=>csv([PILCOLS.map(c=>c[1]),...pilFiltered().map(o=>PILCOLS.map(([k])=>
  k==='pctOn'||k==='pctLate'||k==='cov'?(o[k]==null?'':(o[k]*100).toFixed(1).replace('.',',')+'%'):
  (o[k] instanceof Date?fmtD(o[k]):(k==='retMoy'&&o[k]!=null?Math.round(o[k]):o[k]))))],'pilotage_livraisons.csv');
document.getElementById('btnCsvDet').onclick=()=>csv([['Catégorie','Client facturé','N° commande','SKU','Désignation','Qté commandée','Date demandée','ETA','Retard (j)','Statut','Qté stock','Qté prod/transit','Qté à annuler','PO / sources','Collection','Droppé','Montant EUR'],
  ...detFiltered().map(r=>[r.cat,r.cf,r.ord,r.sku,r.des,r.qte,fmtD(r.dliv),fmtD(r.eta),r.ret,r.st,r.qs,r.qp,r.qa,r.srcTxt,r.coll,r.drop,r.eur])],'detail_par_article.csv');

/* ── Export Excel (SheetJS via CDN) ─────────────────────────────────────── */
document.getElementById('btnExport').onclick=async()=>{
  const b=document.getElementById('btnExport');b.disabled=true;b.textContent='Chargement…';
  try{ await loadXlsx(); doExcel(); }
  catch(err){ alert(err.message); }
  finally{ b.disabled=false;b.textContent='Exporter Excel'; }};
function doExcel(){
  try{
    const wb=XLSX.utils.book_new(),o=S.orders;
    const nQ=o.reduce((s,x)=>s+x.qte,0),nE=o.reduce((s,x)=>s+x.eur,0),nS=o.reduce((s,x)=>s+x.qs,0),nP=o.reduce((s,x)=>s+x.qp,0),nA=o.reduce((s,x)=>s+x.qa,0);
    const cnt=t=>o.filter(x=>x.stat.includes(t)).length;
    const p=[PILCOLS.map(c=>c[1].toUpperCase())];
    for(const x of o)p.push(PILCOLS.map(([k])=>x[k] instanceof Date?fmtD(x[k]):(k==='retMoy'&&x[k]!=null?Math.round(x[k]):x[k])));
    const s2=XLSX.utils.aoa_to_sheet(p);
    XLSX.utils.book_append_sheet(wb,s2,'PILOTAGE LIVRAISONS');
    const d=[['CATÉGORIE','CLIENT FACTURÉ','N° COMMANDE','SKU','DÉSIGNATION','QTÉ COMMANDÉE','DATE DEMANDÉE','ETA','RETARD (j)','STATUT','QTÉ STOCK','QTÉ PROD/TRANSIT','QTÉ À ANNULER','PO / SOURCES','COLLECTION','DROPPÉ','MONTANT EUR']];
    for(const r of S.detail)d.push([r.cat,r.cf,r.ord,r.sku,r.des,r.qte,fmtD(r.dliv),fmtD(r.eta),r.ret,r.st,r.qs,r.qp,r.qa,r.srcTxt,r.coll,r.drop,r.eur]);
    const s3=XLSX.utils.aoa_to_sheet(d);
    XLSX.utils.book_append_sheet(wb,s3,'DETAIL PAR ARTICLE');
    XLSX.writeFile(wb,'Pilotage_livraisons_'+fmtD(TODAY).replace(/\//g,'-')+'.xlsx');
  }catch(e){alert('Export impossible : '+e.message);}
}

}); // DOMContentLoaded
</script>
{% endblock %}
