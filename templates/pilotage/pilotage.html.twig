  const stats=['🟢 Pousser tout','🟡 Pousser partiel','⚪ Rien à pousser','⚫ Annulé'];
  const f=S.filters.macro||{};
  p.innerHTML=`
  <div class="fbar">
    <div class="fg"><label>Segment</label><select data-f="seg"><option value="">Tous</option><option>France</option><option>International</option></select></div>
    <div class="fg"><label>Collection</label><select data-f="coll">${selOpt(colls,'Toutes')}</select></div>
    <div class="fg"><label>Statut</label><select data-f="stat"><option value="">Tous</option>${stats.map(s=>`<option>${s}</option>`).join('')}</select></div>
    <div class="fg"><label>Groupement</label><select data-f="grp">${selOpt(grps,'Tous')}</select></div>
