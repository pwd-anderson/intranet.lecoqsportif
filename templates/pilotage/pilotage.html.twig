  document.getElementById('tRepart').innerHTML='<thead><tr><th>Catégorie</th><th class="r">Commandes</th><th class="r">Pièces</th><th class="r">Montant €</th><th class="r">Couverture</th></tr></thead><tbody>'+
    ['WHOLESALE FRANCE','INTERNATIONAL'].map(c=>{const g=o.filter(x=>x.cat===c),q=g.reduce((a,b)=>a+b.qte,0);
      return '<tr><td><b>'+c+'</b></td><td class="r num">'+fmtN(g.length)+'</td><td class="r num">'+fmtN(q)+'</td><td class="r num">'+fmtE(g.reduce((a,b)=>a+b.eur,0))+'</td><td class="r num">'+fmtP(q?g.reduce((a,b)=>a+b.qs+b.qp,0)/q:0)+'</td></tr>'}).join('')+'</tbody>';

  const top=(cat,el)=>{
    const m=new Map();
    for(const x of o.filter(y=>y.cat===cat)){const e=m.get(x.cf)||{eur:0,g:0,a:0,r:0};e.eur+=x.eur;
      if(x.stat.includes('On time'))e.g++;else if(x.stat.includes('Partiellement'))e.a++;else e.r++;m.set(x.cf,e);}
    const tot=[...m.values()].reduce((s,x)=>s+x.eur,0);
    document.getElementById(el).innerHTML='<thead><tr><th>Client facturé</th><th class="r">Montant €</th><th class="r">% CA</th><th class="c">🟢</th><th class="c">🟠</th><th class="c">🔴</th></tr></thead><tbody>'+
      [...m.entries()].sort((a,b)=>b[1].eur-a[1].eur).slice(0,5).map(([k,v])=>
        '<tr class="clickable" onclick="pilFilterClient('+JSON.stringify(k).replace(/"/g,'&quot;')+')"><td>'+esc(k)+'</td><td class="r num">'+fmtE(v.eur)+'</td><td class="r num">'+fmtP(tot?v.eur/tot:0)+
        '</td><td class="c num">'+v.g+'</td><td class="c num">'+v.a+'</td><td class="c num">'+v.r+'</td></tr>').join('')+'</tbody>';};
