let xlsxReady=null;
function loadXlsx(){
  if(window.XLSX)return Promise.resolve();
  if(xlsxReady)return xlsxReady;
  xlsxReady=new Promise((resolve,reject)=>{
    const s=document.createElement('script');
    s.src='https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
    s.onload=resolve;s.onerror=()=>reject(new Error('Impossible de charger la bibliothèque Excel.'));
    document.head.appendChild(s);
  });
  return xlsxReady;
}
function progFile(p,txt){
  const b=document.getElementById('pbarFile');
  b.classList.add('on');
  b.querySelector('i').style.width=(p*100)+'%';
  document.getElementById('pstatusFile').textContent=txt||'';
}
function mark(id,name){
  const c=document.getElementById('chip-'+id);
  c.classList.add('ok');
  c.textContent=c.textContent.split(' — ')[0]+' — '+name.slice(0,34);
}
async function handle(files){
  if(!files.length)return;
  try{ await loadXlsx(); }catch(err){ progFile(0,err.message); return; }
  progFile(.05,'Lecture des fichiers…');
  for(let i=0;i<files.length;i++){
    const f=files[i];
    progFile(.05+.2*(i/files.length),'Lecture de '+f.name+'…');
    try{
      const buf=await f.arrayBuffer();
      const wb=XLSX.read(new Uint8Array(buf),{type:'array',cellDates:true});
      const ws=wb.Sheets[wb.SheetNames[0]];
      const rows=XLSX.utils.sheet_to_json(ws,{defval:null,raw:true});
      if(!rows.length)continue;
      const keys=Object.keys(rows[0]).map(norm);
      const has=n=>keys.includes(norm(n));
      if(has('MAINNETWORK')||(has('SKU')&&has('QUANTITE'))){S.clients=rows;mark('clients',f.name);}
      else if(has('TYPE FLUX')||has('QTE A LIVRER')){S.fourn=rows;mark('fourn',f.name);}
      else if(has('STOCK INTERNE')||has('STATUS STOCK')){S.stock=rows;mark('stock',f.name);}
      else{progFile(.1,'Fichier non reconnu : '+f.name);}
    }catch(err){progFile(0,'Erreur sur '+f.name+' : '+err.message);}
  }
  if(S.clients&&S.fourn&&S.stock){progFile(.3,'Fichiers reçus, calcul en cours…');setTimeout(compute,60);}
  else progFile(.15,'En attente des fichiers manquants…');
}
const dz=document.getElementById('dropzone'),fi=document.getElementById('fileInput');
document.getElementById('btnPick').addEventListener('click',()=>fi.click());
fi.addEventListener('change',e=>handle([...e.target.files]));
['dragenter','dragover'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();dz.classList.add('over');}));
['dragleave','drop'].forEach(ev=>dz.addEventListener(ev,e=>{e.preventDefault();if(ev==='drop')handle([...e.dataTransfer.files]);dz.classList.remove('over');}));

/* ── Moteur de calcul (identique à l'outil PM) ──────────────────────────── */
function compute(){
  prog(.4,'Préparation du backlog clients…');
  const cm=colMap(S.clients[0]||{});
  let cl=[];
  for(const r of S.clients){
    const coll=String(G(r,cm,'COLLECTION')||'');
    if(!R.COLLECTIONS.includes(coll))continue;
    const sku=String(G(r,cm,'SKU')||'');
    if(!sku||R.SAMPLE.test(sku))continue;
    const q=toNum(G(r,cm,'QUANTITE','QTE','QUANTITÉ'));
    if(q<=0)continue;
    const net=String(G(r,cm,'MAINNETWORK')||'').trim().toUpperCase();
    let cat=null;
    if(net==='WHOLESALE FRANCE')cat='WHOLESALE FRANCE';
    else if(net==='WHOLESALE INTERNATIONAL'||net==='WHOLESALE EUROPE')cat='INTERNATIONAL';
    else continue;
    const site=String(G(r,cm,'SITE')||'').trim();
    cl.push({cat,site,sku,qte:q,
      ord:String(G(r,cm,'N° COMMANDE','N COMMANDE','NO COMMANDE')||'').trim(),
      ref:G(r,cm,'REF. COMMANDE','REF COMMANDE')||'',
      cf:String(G(r,cm,'NOM CLIENT')||'').trim(),
      mag:(String(G(r,cm,'CODE CLIENT CMD.','CODE CLIENT CMD')||'').trim()+' - '+String(G(r,cm,'NOM CLIENT CMD.','NOM CLIENT CMD')||'').trim()).trim(),
      des:G(r,cm,'DESIGNATION')||'',coll,
      drop:String(G(r,cm,'DROPPÉ','DROPPE')||'NON').trim().toUpperCase(),
      dliv:toDate(G(r,cm,'DATE LIVRAISON')),dcmd:toDate(G(r,cm,'DATE COMMANDE')),
      eur:toNum(G(r,cm,'PRIX EUR')),direct:site===R.DIRECT,ffob:R.FFOB_SITES.includes(site)});
  }
  prog(.5,'Préparation du backlog fournisseur…');
  const fm=colMap(S.fourn[0]||{});
  const supply=new Map();
  for(const r of S.fourn){
    const coll=String(G(r,fm,'COLLECTION')||'');
    if(!R.COLLECTIONS.includes(coll))continue;
    const art=String(G(r,fm,'ARTICLE')||'');
    if(!art||R.SAMPLE.test(art))continue;
    const flux=String(G(r,fm,'TYPE FLUX')||'').trim();
    const exp=String(G(r,fm,'SITE EXPEDITION')||'').trim();
    const isBL=flux==='BL Fournisseur';
    if(!isBL&&!R.HUBS.includes(exp))continue;
    const q=toNum(G(r,fm,'QTÉ À LIVRER','QTE A LIVRER'));
    if(q<=0)continue;
    const fourn=String(G(r,fm,'NOM FOURN.','NOM FOURN')||'').trim();
    const podate=toDate(G(r,fm,'DATE DE COMMANDE'));
    let xf=toDate(G(r,fm,'DATE EXPÉDITION','DATE EXPEDITION'));
    let est=false;
    if(!xf&&podate){xf=addD(podate,R.XF_DEF);est=true;}
    if(!xf)continue;
    const iks=/I\.?K\.?S/i.test(fourn);
    const transit=(isBL&&iks)?R.TRANSIT_IKS:R.TRANSIT;
    const eta=addD(xf,transit);
    const orig=isBL?('En production'+(est?' (date IC estimée : PO + 3 mois)':'')):('Parti de '+exp+' (transfert interne)');
    if(!supply.has(art))supply.set(art,[]);
    supply.get(art).push({po:String(G(r,fm,'N° COMMANDE','N COMMANDE','NO COMMANDE')||'').trim(),fourn,
      ref:String(G(r,fm,'REF. INTERNE','REF INTERNE')||'').trim(),xf,eta,rem:q,orig,
      type:isBL?'PO usine':'Stock Asia'});
  }
  for(const a of supply.values())a.sort((x,y)=>x.eta-y.eta);

  prog(.58,'Préparation du stock…');
  const sm=colMap(S.stock[0]||{});
  const stock=new Map();
  for(const r of S.stock){
    if(String(G(r,sm,'STATUS STOCK')||'').trim()!=='A1')continue;
    const site=String(G(r,sm,'SITE')||'').trim(),art=String(G(r,sm,'ARTICLE')||'').trim();
    if(!site||!art)continue;
    const q=toNum(G(r,sm,'STOCK INTERNE'));
    if(q<=0)continue;
    const k=site+'|'+art;stock.set(k,(stock.get(k)||0)+q);
  }

  prog(.64,'Priorisation des clients…');
  const tot=new Map();
  for(const r of cl)tot.set(r.cf,(tot.get(r.cf)||0)+r.qte);
  const rank=new Map([...tot.entries()].sort((a,b)=>b[1]-a[1]).map(([k],i)=>[k,i]));
  cl.sort((a,b)=>(rank.get(a.cf)-rank.get(b.cf))||((a.dliv||9e15)-(b.dliv||9e15))
    ||((a.dcmd||9e15)-(b.dcmd||9e15))||(a.ord<b.ord?-1:a.ord>b.ord?1:0)||(a.sku<b.sku?-1:1));

  prog(.70,'Affectation du stock…');
  const take=(site,sku,need)=>{if(need<=0)return 0;const k=site+'|'+sku,a=stock.get(k)||0;if(a<=0)return 0;
    const t=Math.min(need,a);stock.set(k,a-t);return t;};
  for(const r of cl)r.qs=(r.direct||R.HUBS.includes(r.site))?0:take(r.site,r.sku,r.qte);

  prog(.76,'Affectation de la production…');
  const ETA_HUB=addD(TODAY,R.TRANSIT);
  const srcByOrder=new Map();
  for(const r of cl){
    const ffob=r.ffob;
    let need=r.qte-r.qs,qp=0,onT=r.qs,late=0,lateW=0,lateQ=0;
    const etasOn=[],etasLate=[],srcs=[],types=new Set(),pos=[];
    if(r.qs>0){srcs.push({t:'Stock local',lab:'STOCK '+r.site,q:r.qs,eta:TODAY,xf:null,
      st:'Déjà en stock, livrable immédiatement',on:true});types.add('Stock local');}
    if(need>0&&!r.direct){
      const hubs=R.HUBS.includes(r.site)?[r.site,...R.HUBS.filter(h=>h!==r.site)]:R.HUBS;
      for(const h of hubs){
        if(need<=0)continue;
        const t=take(h,r.sku,need);
        if(t>0){need-=t;qp+=t;
          const e=ffob?TODAY:ETA_HUB;
          const on=ffob?true:(r.dliv?e<=r.dliv:false);
          (on?etasOn:etasLate).push(e);
          if(on)onT+=t;else{late+=t;lateW+=Math.max(0,diffD(e,r.dliv))*t;lateQ+=t;}
          srcs.push({t:'Stock Asia',lab:'STOCK '+h,q:t,eta:e,xf:null,
            st:ffob?('Disponible à '+h+' — FFOB, à enlever par le client'):('Déjà produit, en stock à '+h+' (Asie) — transit '+R.TRANSIT+' j'),on});types.add('Stock Asia');}
      }
    }
    let arr2=supply.get(r.sku);
    if(arr2&&ffob)arr2=arr2.slice().sort((x,y)=>(x.xf||x.eta)-(y.xf||y.eta));
    if(arr2&&need>0){
      for(const sp of arr2){
        if(need<=0)break;
        if(sp.rem<=0)continue;
        const t=Math.min(need,sp.rem);sp.rem-=t;need-=t;qp+=t;
        const e=ffob?sp.xf:sp.eta;
        const on=r.dliv?e<=r.dliv:false;
        (on?etasOn:etasLate).push(e);
        if(on)onT+=t;else{late+=t;lateW+=Math.max(0,diffD(e,r.dliv))*t;lateQ+=t;}
        srcs.push({t:sp.type,lab:sp.po,q:t,eta:e,xf:sp.xf,
          st:(ffob?'FFOB — mise à disposition XF '+fmtD(sp.xf)+' · ':'')+sp.orig+(sp.fourn?' — '+sp.fourn:''),on});
        types.add(sp.type);if(sp.type==='PO usine')pos.push(sp.po);
      }
    }
    r.qp=qp;r.qa=need;r.on=onT;r.late=late;r.lateW=lateW;r.lateQ=lateQ;
    r.etaOnArr=etasOn;r.etaLateArr=etasLate;
    const allE=srcs.map(s=>s.eta).filter(Boolean);
    r.eta=allE.length?new Date(Math.max(...allE)):null;
    r.ret=(r.eta&&r.dliv)?Math.max(0,diffD(r.eta,r.dliv)):null;
    r.cov=r.qte?(r.qs+r.qp)/r.qte:0;
    r.srcTxt=srcs.map(s=>s.lab+' · '+fmtN(s.q)+' pcs'+(s.xf?' · IC '+fmtD(s.xf):'')+' · ETA '+fmtD(s.eta)+' · '+s.st).join(' | ');
    r.types=[...types];r.pos=[...new Set(pos)];
    r.st=r.drop==='OUI'?'ANNULER (droppé)':(r.qa>=r.qte?'ANNULER':(r.qa>0?'PARTIEL':(qp===0?'LIVRABLE':(late>0?'RETARD':'OK DELAI'))));
    if(!srcByOrder.has(r.ord))srcByOrder.set(r.ord,[]);
    const acc=srcByOrder.get(r.ord);
    for(const s of srcs){
      const e=acc.find(x=>x.lab===s.lab&&x.eta&&s.eta&&+x.eta===+s.eta);
      if(e){e.q+=s.q;e.nsku++;}else acc.push({...s,nsku:1});
    }
  }

  prog(.88,'Agrégation par commande…');
  const om=new Map();
  for(const r of cl){
    let o=om.get(r.ord);
    if(!o){o={cat:r.cat,cf:r.cf,mag:r.mag,ord:r.ord,ref:r.ref,coll:r.coll,dliv:r.dliv,
      qte:0,on:0,late:0,qs:0,qp:0,qa:0,eur:0,nl:0,ffob:false,etaOn:[],etaLate:[],retW:0,retQ:0,types:new Set(),pos:new Set()};om.set(r.ord,o);}
    o.qte+=r.qte;o.on+=r.on;o.late+=r.late;o.qs+=r.qs;o.qp+=r.qp;o.qa+=r.qa;o.eur+=r.eur;o.nl++;
    if(r.ffob)o.ffob=true;
    if(!o.dliv||(r.dliv&&r.dliv<o.dliv))o.dliv=r.dliv;
    o.retW+=r.lateW;o.retQ+=r.lateQ;
    for(const t of r.types)o.types.add(t);
    for(const p of r.pos)o.pos.add(p);
  }
  for(const r of cl){
    const o=om.get(r.ord);
    for(const e of r.etaOnArr)o.etaOn.push(e);
    for(const e of r.etaLateArr)o.etaLate.push(e);
  }
  const ORDER=['Stock local','Stock Asia','PO usine'];
  const orders=[...om.values()].map(o=>{
    const covq=o.on+o.late;
    o.pctLate=covq?o.late/covq:0;o.pctOn=covq?o.on/covq:0;
    o.stat=(covq===0&&R.COLL_PROD_LANCEE.includes(o.coll))?'⚫ À annuler':(o.pctLate===0?'🟢 On time':(o.pctLate>=.5?'🔴 Critique +50% retard':'🟠 Partiellement en retard'));
    o.cov=o.qte?(o.qs+o.qp)/o.qte:0;
    o.retMoy=o.retQ?o.retW/o.retQ:null;
    o.etaOn1=o.etaOn.length?new Date(Math.min(...o.etaOn)):null;
    o.etaOn2=o.etaOn.length?new Date(Math.max(...o.etaOn)):null;
    o.etaL1=o.etaLate.length?new Date(Math.min(...o.etaLate)):null;
    o.etaL2=o.etaLate.length?new Date(Math.max(...o.etaLate)):null;
    o.nsrc=(srcByOrder.get(o.ord)||[]).length;
    o.tsrc=[...o.types].sort((a,b)=>ORDER.indexOf(a)-ORDER.indexOf(b)).join(' + ')||'—';
    o.posTxt=[...o.pos].join(' ; ');
    return o;});
  S.detail=cl;S.orders=orders;S.srcByOrder=srcByOrder;
  prog(1,'Terminé — '+fmtN(orders.length)+' commandes, '+fmtN(cl.length)+' lignes article.');
  setTimeout(render,40);
}

