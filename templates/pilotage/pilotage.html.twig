const HEAD_MACRO=['SEGMENT','COLLECTION','🟢 PRÊT À ENVOYER (pcs)','🟢 CMD PRÊTES','🟢 VALEUR PRÊT (€)',
 '🟡 PARTIEL (pcs)','🟡 CMD PARTIEL','RETARD PRÉV. MOYEN (j)','NB CMD EN RETARD (PRÉV.)','VALEUR EUR','TOTAL CMD'];
const HEAD_REST=['SKU','COLLECTION','DESCRIPTION ARTICLE','SOURCE','PCS','DISPO','ETA'];

const METHODE_V10=[
 ['Périmètre','Une ligne de pilotage = un groupe commande × collection. Ligne retenue si DROPPÉ ≠ OUI, quantité > 0 et date de livraison renseignée. Le montant EUR additionne toutes les lignes du groupe, lignes droppées comprises.'],
 ['Réseaux','France affichée = WHOLESALE FRANCE. E-commerce, retail et marketing contracts sont alloués avec la France mais ne sont pas affichés. Tout le reste part en international.'],
 ['Sources','Stock : colonne « Stock Interne », sites commençant par W — Logtex (WLOGM), autres FR (WHSLM, WFIFR), SF Chine (WSFCN), DT Thaïlande (WDTTH). Production : backlog fournisseur filtré sur TYPE FLUX = BL Fournisseur, INTERSITE = NON, DROPPÉ = NON, site de réception en W.'],
 ['Dates d\u2019arrivée','T0 paramétrable (13/08/2026 par défaut). France : stock Logtex et FR à T0 + 5 j · PO vers sites FR à ETA + 5 j (ETA passée ramenée à T0) · stock et PO Asie à XF + 90 j. International : stock SF/DT + 10 j · PO Asie ETA + 10 j · stock Logtex + 30 j · PO France ETA + 30 j.'],
 ['Règle SS27','Collection 2027-01-SS : arrivée = XF usine + 80 j, quel que soit le site de réception, sans écrêtage à T0.'],
 ['Allocation','Exclusive : une pièce ne sert qu\u2019une commande. Le module France consomme en premier, l\u2019international ensuite. Priorité : top 10 clients par € du module, puis date demandée, puis n° de commande. Deux passes par commande — passe 1 « à temps » (arrivée ≤ date demandée + 10 j), puis passe 2 au plus tôt. Candidats triés par arrivée croissante, stock avant PO.'],
 ['Annulation','Vrai zéro seulement : plus aucune pièce disponible pour ce SKU, tous sites confondus, après les deux passes.'],
 ['Retard échu','Date du jour de calcul moins date demandée. Masqué pour les commandes SS27 dont la date demandée est antérieure au 01/12/2026 (anomalie ERP), pour les commandes France annulées et pour les commandes internationales à 100 % disponibles.'],
 ['Substitutions','Propositions exclusives puisées dans le reste à allouer, même collection obligatoire, 5 candidats au maximum par SKU manquant. Rang 1 = même article, autre taille (taille la plus proche d\u2019abord). Rang 2 = même modèle (premier mot de la désignation), autre coloris, accord client requis.'],
 ['Reste à allouer','Stock et PO non consommés après les deux passes, par SKU × source, limité aux collections FW26 et SS27. L\u2019ETA affichée est l\u2019ETA brute du PO, sans délai de transport.'],
 ['Écarts connus','Les colonnes de périmètre, d\u2019identité client et de montant sont reproduites à l\u2019identique. Les quantités allouées et les dates d\u2019arrivée restent à quelques pour cent du classeur de référence : les départages entre commandes à égalité de priorité sur un SKU en pénurie ne sont pas tous reproductibles.']
];
const nf=new Intl.NumberFormat('fr-FR'), nf2=new Intl.NumberFormat('fr-FR',{maximumFractionDigits:0});
const fmt=v=>v==null||v===''?'':nf.format(v);
const fmtE=v=>v==null||v===''?'':nf2.format(v)+' €';
const pdate=v=>{if(!v)return null;const m=/^(\d{4})-(\d{2})-(\d{2})/.exec(String(v));
  return m?new Date(+m[1],+m[2]-1,+m[3]).getTime():null;};
const fmtD=v=>{if(!v)return '';const [y,m,d]=String(v).split('-');return d&&m?`${d}/${m}/${y}`:v;};
const fmtPct=v=>v==null||v===''?'':Math.round(v*100)+' %';
const esc=s=>String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const statCls=s=>String(s||'').includes('🟢')?'b-vert':String(s||'').includes('🟡')?'b-jaune':String(s||'').includes('⚫')?'b-noir':'b-blanc';

/* ---------- décodage données embarquées ---------- */
async function inflateB64(b64){
  const bin=atob(b64), buf=new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++)buf[i]=bin.charCodeAt(i);
  const ds=new DecompressionStream('gzip');
  const stream=new Blob([buf]).stream().pipeThrough(ds);
  const ab=await new Response(stream).arrayBuffer();
  return JSON.parse(new TextDecoder().decode(ab));
}
async function boot(){
  /* V2 : aucun calcul au lancement. On attend le dépôt des fichiers. */
  PIL.classList.remove('has-data');
  $('#loadZone').classList.add('on');
  const today=new Date(),iso=today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
  if(!$('#refArrInp').value)$('#refArrInp').value=iso;
  if(!$('#genDateInp').value)$('#genDateInp').value=iso;
}
function applyData(d,label){
  S.pfr=d.pfr; S.pint=d.pint; S.detFR=d.detFR; S.detIN=d.detIN; S.subFR=d.subFR; S.subIN=d.subIN;
  S.rest=d.rest; S.arrFlow=d.arrFlow||null; S.macro=d.macro||[]; S.methode=(d.methode&&d.methode.length)?d.methode:METHODE_V10;
  S.heads={pfr:d.pfrHead||HEAD_FR,pint:d.pintHead||HEAD_INT,macro:d.macroHead||HEAD_MACRO,sub:d.subFR.head,rest:d.restHead||HEAD_REST};
