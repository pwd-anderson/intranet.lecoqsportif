     <td><span class="badge ${statCls(r[2])}">${esc(r[2])}</span></td><td><b>${esc(r[3])}</b></td><td style="white-space:normal">${esc(r[4])}</td>
     <td class="num">${fmt(r[5])}</td><td class="num">${fmt(r[6])}</td><td>${esc(r[7])}</td><td><b>${esc(r[8])}</b></td>
     <td style="white-space:normal">${esc(r[9])}</td><td class="num ${r[10]>0?'early':''}">${fmt(r[10])}</td>
     <td class="num">${fmt(r[11])}</td><td>${fmtD(r[12])}</td><td class="num">${fmt(r[13])}</td>
     <td><input class="qr" type="number" min="0" data-k="${esc(key)}" value="${val}"></td></tr>`;}).join('')+'</tbody>';
