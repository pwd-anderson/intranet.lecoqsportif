function pushScope(){
  const f=S.filters.macro||{},parts=[];
  if(f.seg)parts.push('Segment : '+f.seg); if(f.coll)parts.push('Collection : '+f.coll);
  if(f.grp)parts.push('Groupement : '+f.grp); if(f.q)parts.push('Recherche : '+f.q);
  return parts.length?parts.join(' · '):'Tous segments et collections';
}


/* ---------- graphe : livraisons demandées par mois, couverture ---------- */
function renderMacChart(all){
  const box=$('#macChart'); if(!box)return;
  const drill=S.macroChartMonth||null;   /* 'YYYY-MM' quand on est descendu à la semaine */
  const byK={};
  const MO=['janv','févr','mars','avr','mai','juin','juil','août','sept','oct','nov','déc'];
  all.forEach(r=>{const t=pdate(r[C.DDEM]); if(t==null)return;
    const d=new Date(t);
    if(drill&&(d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0'))!==drill)return;
    let k,lab,sub;
    if(drill){const w=t-((d.getDay()+6)%7)*86400000;const wd=new Date(w);
      k=String(w);lab='sem. '+String(wd.getDate()).padStart(2,'0')+'/'+String(wd.getMonth()+1).padStart(2,'0');sub='';}
    else{k=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0');
      lab=MO[d.getMonth()]+' '+String(d.getFullYear()).slice(2);sub='';}
    const o=byK[k]=byK[k]||{lab,vert:0,ambre:0,gris:0};
    const q=r[C.Q]||0,c=r[C.QCANC]||0;
    if(String(r[C.STAT]||'').includes('🟢'))o.vert+=q;
    else{o.gris+=c;o.ambre+=Math.max(0,q-c);}});
  const keys=Object.keys(byK).sort();
  if(!keys.length){box.innerHTML='';return;}
  const mx=Math.max(...keys.map(k=>byK[k].vert+byK[k].ambre+byK[k].gris))||1;
  const BW=40,GAP=16,H=250,PL=52,PR=46,PB=40,PT=14;
  const W=PL+keys.length*(BW+GAP)+PR;
  const y=v=>PT+(H-PT-PB)*(1-v/mx);
  const y2=p=>PT+(H-PT-PB)*(1-Math.max(0,Math.min(1,(p-60)/42)));
  let g='';for(let i=0;i<=4;i++){const v=mx*i/4,yy=y(v);
    g+=`<line x1="${PL-4}" y1="${yy.toFixed(1)}" x2="${W-PR+4}" y2="${yy.toFixed(1)}" stroke="var(--line2)"/>`+
       `<text x="${PL-8}" y="${(yy+4).toFixed(1)}" text-anchor="end" font-size="10" fill="var(--mut)">${v>=1000?Math.round(v/1000)+'k':Math.round(v)}</text>`;}
  [70,80,90,100].forEach(p2=>{g+=`<text x="${W-PR+8}" y="${(y2(p2)+4).toFixed(1)}" font-size="10" fill="var(--goldD)">${p2} %</text>`;});
  const pts=[];
  keys.forEach((k,i)=>{const o=byK[k],T=o.vert+o.ambre+o.gris,x=PL+i*(BW+GAP);
    const yv=y(o.vert),ya=y(o.vert+o.ambre),yg=y(T);
    const pc=T?100*(1-o.gris/T):100;
    g+=`<g class="mcm" data-k="${k}" style="cursor:${drill?'default':'pointer'}">`+
      `<title>${o.lab} — ${fmt(T)} pcs demandées · ${fmt(o.vert)} en cmd 100 % · ${fmt(o.ambre)} partielles · ${fmt(o.gris)} à annuler · couverture ${pc.toFixed(0)} %</title>`+
      (o.gris?`<rect x="${x}" y="${yg.toFixed(1)}" width="${BW}" height="${(y(0)-yg).toFixed(1)}" fill="#c2c8d0" rx="2"/>`:'')+
      (o.ambre?`<rect x="${x}" y="${ya.toFixed(1)}" width="${BW}" height="${(y(0)-ya).toFixed(1)}" fill="var(--gold)" rx="2"/>`:'')+
      (o.vert?`<rect x="${x}" y="${yv.toFixed(1)}" width="${BW}" height="${(y(0)-yv).toFixed(1)}" fill="var(--vert)" rx="2"/>`:'')+`</g>`+
      `<text x="${x+BW/2}" y="${H-PB+15}" text-anchor="middle" font-size="10.5" font-weight="600" fill="var(--ink2)">${o.lab}</text>`+
      `<text x="${x+BW/2}" y="${H-PB+27}" text-anchor="middle" font-size="9.5" fill="var(--mut)">${T>=1000?Math.round(T/1000)+'k':fmt(T)} pcs</text>`;
    pts.push([x+BW/2,y2(pc)]);});
  g+=`<polyline fill="none" stroke="var(--goldD)" stroke-width="2" stroke-dasharray="4 3" points="${pts.map(p2=>p2[0].toFixed(1)+','+p2[1].toFixed(1)).join(' ')}"/>`;
  pts.forEach(p2=>{g+=`<circle cx="${p2[0].toFixed(1)}" cy="${p2[1].toFixed(1)}" r="3.5" fill="var(--paper)" stroke="var(--goldD)" stroke-width="2"/>`;});
  box.innerHTML=`<h2 class="sec">Livraisons demandées par ${drill?'semaine — '+drill.split('-').reverse().join('/'):'mois'} — couverture</h2>
   <div class="arrchart" style="padding-bottom:4px">
    <div class="arrleg"><span><i style="background:var(--vert)"></i>Cmd couvertes à 100 %</span><span><i style="background:var(--gold)"></i>Partielles</span><span><i style="background:#c2c8d0"></i>À annuler</span><span><i style="background:var(--goldD)"></i>% couverture à terme</span></div>
    <svg width="${W}" height="${H}" viewBox="0 0 ${W} ${H}">${g}</svg>
    <div class="mut" style="font-size:11.5px;padding:2px 2px 8px">${drill?'<a id="mcBack" style="color:var(--goldD);font-weight:600;cursor:pointer">← Retour aux mois</a>':'Clic sur un mois → détail semaine par semaine.'} Axe = <b>date de livraison demandée</b>.</div>
   </div>`;
  if(drill){const bk=$('#mcBack');if(bk)bk.onclick=()=>{S.macroChartMonth=null;renderMacro();};}
  else $$('#macChart .mcm').forEach(el=>el.onclick=()=>{S.macroChartMonth=el.dataset.k;renderMacro();});
}
/* ---------- articles qui bloquent le plus ---------- */
function renderMacBlockers(all,fr){
