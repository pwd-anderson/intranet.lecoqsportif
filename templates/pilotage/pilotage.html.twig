/* MOULINETTE V10 — recalcul depuis les 3 fichiers sources
   Calibrée sur les exports réels (Backlog_Clients / Backlog_Fournisseur / Stock_allocation).
   Périmètre validé : groupes commande × collection, montant = toutes lignes (droppées incluses). */
'use strict';
const R={
  refArr:'',   /* vide = date du jour de calcul */
  genDate:null,          // date du jour du calcul (null = aujourd'hui)
  sortMode:'topset-date',// 'topset-date' | 'euro-date' | 'top-euro-then-date'
  passMode:'order',     // 'global' (passe 1 tous, puis passe 2 tous) | 'order' (par commande)   // T0 des arrivées (figé, comme le classeur V9) — modifiable
  grace:10,
  frStockDelay:5, frPoDelay:5, frAsiaDelay:90,
  ss27PoDelay:80,
  intPrepDelay:10, intPoAsiaDelay:10, intFrDelay:30,
  topClients:10,
  sitesLog:['WLOGM'], sitesFRo:['WHSLM','WFIFR'], siteSF:'WSFCN', siteDT:'WDTTH',
  netsFR:['WHOLESALE FRANCE'], netsFRdom:['E-COMMERCE','RETAIL','MARKETING CONTRACTS'],
  frUsesAsiaStock:true, frAsiaGroups:['SF','DT'], domFirst:true,
  fairShare:{FR:false,INT:false},  // partage proportionnel entre non-top-10 à même date
  frStockCol:'I', asiaStockCol:'I',  // 'I'=Stock Interne, 'D'=Stock Disponible
  stockStatuses:['A1'],
  collFW:'2026-02-FW', collSS:'2027-01-SS',
  ss27EchuCutoff:'2026-12-01', substMaxCand:5, substR2Max:99, substR2OnlyIfNoR1:false, substR2SameSize:false, debugRaw:false
};
const DAY=864e5;
const T0=(()=>{const d=new Date();return Date.UTC(d.getFullYear(),d.getMonth(),d.getDate());})();
let TARR=T0,TGEN=T0; // initialisés depuis R dans computeV9
const dstr=t=>new Date(t).toISOString().slice(0,10);
const dfr=t=>{const s=dstr(t);return s.slice(8,10)+'/'+s.slice(5,7)+'/'+s.slice(0,4);};
const nUS=n=>Math.round(n).toLocaleString('en-US');
function toT(v){ if(v==null||v==='')return null;
  if(v instanceof Date)return Date.UTC(v.getFullYear(),v.getMonth(),v.getDate());
  if(typeof v==='number')return Date.UTC(1899,11,30)+Math.round(v)*DAY;
  const s=String(v).trim();
  let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/); if(m)return Date.UTC(+m[1],+m[2]-1,+m[3]);
  m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/); if(m)return Date.UTC(+m[3],+m[2]-1,+m[1]);
  const d=new Date(s); return isNaN(d)?null:Date.UTC(d.getFullYear(),d.getMonth(),d.getDate());}
const NRM=s=>String(s??'').trim().toUpperCase().replace(/\s+/g,' ');
function findKey(obj,cands){
  const keys=Object.keys(obj);
  for(const c of cands){for(const k of keys)if(NRM(k)===c)return k;}
  for(const c of cands){for(const k of keys)if(NRM(k).includes(c))return k;}
  return null;}
function letterIdx(L){let n=0;for(const ch of L)n=n*26+(ch.charCodeAt(0)-64);return n-1;}
function pick(rows,cands,letter){
  const k=rows.length?findKey(rows[0].obj,cands):null;
  if(k)return r=>r.obj[k];
  if(letter!=null){const i=letterIdx(letter);return r=>r.arr[i];}
  return ()=>null;}
const num=v=>{const n=parseFloat(v);return isNaN(n)?0:n;};

async function computeV9(){
  const tick=()=>new Promise(r=>setTimeout(r,25));
  const _ra=(typeof document!=='undefined'&&document.getElementById('refArrInp')&&document.getElementById('refArrInp').value)||R.refArr;
  const _gd=(typeof document!=='undefined'&&document.getElementById('genDateInp')&&document.getElementById('genDateInp').value)||R.genDate;
  TGEN=_gd?(toT(_gd)||T0):T0; TARR=toT(_ra)||TGEN;
  /* Saisons déduites du code collection (AAAA-01-SS → 1er janv AAAA, AAAA-02-FW → 1er juil AAAA).
     Une collection est « pré-saison » si sa saison n'a pas commencé à la date de calcul :
     ses PO partent du XF usine + 80 j, et ses dates demandées antérieures au mois précédant
     la saison sont traitées en anomalie ERP (retard échu masqué). */
  const COLLSET=new Set();
  const seasonStart=c=>{const m=/^(\d{4})-(\d{2})/.exec(String(c||''));if(!m)return null;
    return new Date(+m[1], m[2]==='01'?0:6, 1).getTime();};
  const isFut=c=>{const t=seasonStart(c);return t!=null&&t>TGEN;};
  const preSeasonCutoff=c=>{const t=seasonStart(c);if(t==null)return null;
    const d=new Date(t);d.setMonth(d.getMonth()-1);return d.getTime();};

  const FLOW=[],RAW=[]; /* arrivées allouées : [0=FR|1=INT, ts, 0=France|1=Asie, pcs, 0=stock|1=PO] */
  prog(.05,'Lecture des sources…');await tick();
  const BC=S.srcFiles.bc, BF=S.srcFiles.bf, ST=S.srcFiles.st;
  const wrap=f=>{const heads=f.aoa[0];return f.aoa.slice(1).map(arr=>{
    const obj={};heads.forEach((h,i)=>{if(h!=null&&obj[h]===undefined)obj[h]=arr[i];});return {obj,arr};});};
  const bc=wrap(BC), bf=wrap(BF), st=wrap(ST);

  /* ---- STOCK : Stock Interne, sites W ---- */
  const gSite=pick(st,['SITE'],'A'), gArt=pick(st,['ARTICLE','SKU'],'E'),
        gStk=pick(st,['STOCK INTERNE'],'H'), gStkD=pick(st,['STOCK DISPONIBLE'],'L'),
        gColl=pick(st,['COLLECTION','DERNIERE COLLECTION'],'D'),
        gStat=pick(st,['STATUS STOCK','STATUT STOCK'],'G');
  const stock={}, collBySku={};
  for(const r of st){
    const site=NRM(gSite(r)); if(!site.startsWith('W'))continue;
    if(R.stockStatuses&&R.stockStatuses.length&&!R.stockStatuses.includes(String(gStat(r)||'').trim()))continue;
    const sku=String(gArt(r)||'').trim(); if(!sku)continue;
    const coll=String(gColl(r)||'').trim(); if(coll&&!collBySku[sku]&&/\d{4}-\d{2}/.test(coll))collBySku[sku]=coll;
    let grp;
    if(R.sitesLog.includes(site))grp='LOG'; else if(R.sitesFRo.includes(site))grp='FRO';
    else if(site===R.siteSF)grp='SF'; else if(site===R.siteDT)grp='DT'; else grp='ASO';
    const useDispo=(grp==='LOG'||grp==='FRO')?R.frStockCol==='D':R.asiaStockCol==='D';
    const q=useDispo?num(gStkD(r)):num(gStk(r));
    if(q>0)(stock[sku]=stock[sku]||{LOG:0,FRO:0,SF:0,DT:0,ASO:0})[grp]+=q;
  }
  prog(.15,'Construction de l\u2019offre (stock + PO)…');await tick();

  /* ---- BACKLOG FOURNISSEUR ---- */
  const fFlux=pick(bf,['TYPE FLUX'],'B'), fInt=pick(bf,['INTERSITE'],'A'),
        fDrop=pick(bf,['DROPPÉ','DROPPE'],'I'), fRec=pick(bf,['SITE RECEPTION','SITE RÉCEPTION'],'D'),
        fArt=pick(bf,['ARTICLE','SKU'],'G'), fPo=pick(bf,['N° COMMANDE','N°COMMANDE','NO COMMANDE'],'L'),
        fEta=pick(bf,['DATE LIVRAISON'],'O'), fXf=pick(bf,['DATE EXPÉDITION','DATE EXPEDITION'],'N'),
        fQ=pick(bf,['QTÉ À LIVRER','QTE A LIVRER'],'R'), fCollP=pick(bf,['COLLECTION'],'E');
  const pos=[];
  for(const r of bf){
    if(NRM(fFlux(r))!=='BL FOURNISSEUR')continue;
    if(NRM(fInt(r))==='OUI')continue;
    if(NRM(fDrop(r))==='OUI')continue;
    const rec=NRM(fRec(r)); if(!rec.startsWith('W'))continue;
    const sku=String(fArt(r)||'').trim(); const q=num(fQ(r)); if(!sku||q<=0)continue;
    let eta=toT(fEta(r)); const xf=toT(fXf(r));
    const rawEta=eta; if(eta!=null&&eta<TARR)eta=TARR;
    const dest=(R.sitesLog.includes(rec)||R.sitesFRo.includes(rec))?'FR':'ASIE';
    const coll=String(fCollP(r)||'').trim();
    if(coll&&!collBySku[sku]&&/\d{4}-\d{2}/.test(coll))collBySku[sku]=coll;
    pos.push({sku,q,left:q,eta:eta==null?TARR:eta,rawEta,xf,dest,po:String(fPo(r)||'').trim()});
  }

  /* ---- BACKLOG CLIENT : groupes commande × collection ---- */
  prog(.25,'Backlog client (groupes commande × collection)…');await tick();
  const cNet=pick(bc,['MAINNETWORK'],'B'), cColl=pick(bc,['COLLECTION'],'D'),
        cSku=pick(bc,['SKU'],'F'), cDesig=pick(bc,['DESIGNATION','DÉSIGNATION'],'L'),
        cDrop=pick(bc,['DROPPÉ','DROPPE'],'M'), cGrpC=pick(bc,['GROUP CODE'],'N'),
        cCodM=pick(bc,['CODE CLIENT CMD.','CODE CLIENT CMD'],'O'), cMag=pick(bc,['NOM CLIENT CMD.','NOM CLIENT CMD'],'P'),
        cCodC=pick(bc,['CODE CLIENT','CLIENT'],'Q'), cCli=pick(bc,['NOM CLIENT','CLIENT FACTURÉ'],'R'),
        cVille=pick(bc,['VILLE'],'T'), cGrp=pick(bc,['NOM GROUPEMENT','GROUPEMENT'],'U'),
        cOrd=pick(bc,['N° COMMANDE','N°COMMANDE','NO COMMANDE'],'V'), cRef=pick(bc,['REF. COMMANDE','REF COMMANDE'],'W'),
        cDCmd=pick(bc,['DATE COMMANDE','DATE DE COMMANDE'],'X'), cDL=pick(bc,['DATE LIVRAISON'],'Y'),
        cRep=pick(bc,['REPRESENTANT 1','REPRÉSENTANT 1','REPRESENTANT'],'Z'),
        cQ=pick(bc,['QUANTITE','QUANTITÉ'],'AB'), cMt=pick(bc,['PRIX EUR','MONTANT EUR','MONTANT'],'AH');
  const orders={}; let demTot=0;
  for(const r of bc){
    const ord=String(cOrd(r)||'').trim(); if(!ord)continue;
    const net=NRM(cNet(r));
    let mod,show;
    if(R.netsFR.includes(net)){mod='FR';show=true;}
    else if(R.netsFRdom.includes(net)){mod='FR';show=false;}
    else {mod='INT';show=true;}
    const coll=String(cColl(r)||'').trim(); if(coll)COLLSET.add(coll);
    const key=ord+'|'+coll+'|'+mod;
    const o=orders[key]=orders[key]||{ord,coll,mod,show,nets:{},dl:null,cli:'',mag:'',ref:'',codc:null,grpc:null,
      grp:'',codm:null,ville:'',rep:'',dcmd:null,mt:0,q:0,lines:[]};
    if(net)o.nets[net]=(o.nets[net]||0)+1;
    o.mt+=num(cMt(r));
    const fill=(k,v)=>{if(!o[k]&&v!=null&&v!=='')o[k]=v;};
    fill('cli',String(cCli(r)||'').trim());fill('mag',String(cMag(r)||'').trim());
    fill('ref',String(cRef(r)||'').trim());fill('codc',cCodC(r));fill('grpc',cGrpC(r));
    fill('grp',String(cGrp(r)||'').trim());fill('codm',cCodM(r));fill('ville',String(cVille(r)||'').trim());
    fill('rep',String(cRep(r)||'').trim());if(!o.dcmd)o.dcmd=toT(cDCmd(r));
    /* ligne valide = non droppée, qté>0, date livraison présente */
    if(NRM(cDrop(r))==='OUI')continue;
    const q=num(cQ(r)); if(q<=0)continue;
    const dl=toT(cDL(r)); if(dl==null)continue;
    const sku=String(cSku(r)||'').trim(); if(!sku)continue;
    if(o.dl==null||dl<o.dl)o.dl=dl;
    o.q+=q; demTot+=q;
    if(coll&&!collBySku[sku]&&/\d{4}-\d{2}/.test(coll))collBySku[sku]=coll;
    o.lines.push({sku,q,left:q,desig:String(cDesig(r)||'').trim(),alloc:[]});
  }
  const ctrl={demande:demTot};

  /* ---- ALLOCATION SÉQUENTIELLE : FRANCE puis INTERNATIONAL ---- */
  const stockLeft=JSON.parse(JSON.stringify(stock));
  const posBySku={}; for(const p of pos)(posBySku[p.sku]=posBySku[p.sku]||[]).push(p);
  const stockLabel={LOG:'Stock Logtex',FRO:'Stock France (WHSLM/WFIFR)',SF:'Stock SF Chine',DT:'Stock DT Thaïlande',ASO:'Stock Asie (autre)'};
  function candidates(mod,sku,isSS27){
    const stq=stockLeft[sku]||{}, out=[];
    const push=(kind,grp,arr,poRef)=>out.push({kind,grp,arr,poRef});
    if(mod==='FR'){
      if(stq.LOG>0)push('S','LOG',TARR+R.frStockDelay*DAY);
      if(stq.FRO>0)push('S','FRO',TARR+R.frStockDelay*DAY);
      for(const p of posBySku[sku]||[]){ if(p.left<=0)continue;
        if(isSS27)push('P',p.dest==='FR'?'FR':'ASIE',(p.xf!=null?p.xf:p.rawEta!=null?p.rawEta:p.eta)+R.ss27PoDelay*DAY,p);
        else if(p.dest==='FR')push('P','FR',p.eta+R.frPoDelay*DAY,p);
        else push('P','ASIE',Math.max((p.xf!=null?p.xf:p.eta),TARR)+R.frAsiaDelay*DAY,p);}
      if(R.frUsesAsiaStock)for(const g of R.frAsiaGroups)
        if(stq[g]>0)push('S',g,TARR+R.frAsiaDelay*DAY);
    }else{
      if(stq.SF>0)push('S','SF',TARR+R.intPrepDelay*DAY);
      if(stq.DT>0)push('S','DT',TARR+R.intPrepDelay*DAY);
      if(stq.ASO>0)push('S','ASO',TARR+R.intPrepDelay*DAY);
      for(const p of posBySku[sku]||[]){ if(p.left<=0)continue;
        push('P',p.dest==='ASIE'?'ASIE':'FR',p.eta+(p.dest==='ASIE'?R.intPoAsiaDelay:R.intFrDelay)*DAY,p);}
      if(stq.LOG>0)push('S','LOG',TARR+R.intFrDelay*DAY);
      if(stq.FRO>0)push('S','FRO',TARR+R.intFrDelay*DAY);
    }
    out.sort((a,b)=>a.arr-b.arr||(a.kind==='S'?-1:1)-(b.kind==='S'?-1:1));
    return out;
  }
  function take(c,sku,need){
    if(c.kind==='S'){const st=stockLeft[sku];const t=Math.min(need,st[c.grp]);st[c.grp]-=t;return t;}
    const t=Math.min(need,c.poRef.left);c.poRef.left-=t;return t;
  }
  const runModule=async(mod,pct)=>{
    prog(pct,'Allocation module '+(mod==='FR'?'FRANCE':'INTERNATIONAL')+'…');await tick();
    const os=Object.values(orders).filter(o=>o.mod===mod&&o.lines.length);
    const byCli={}; os.forEach(o=>byCli[o.cli]=(byCli[o.cli]||0)+o.mt);
    const rank=Object.fromEntries(Object.entries(byCli).sort((a,b)=>b[1]-a[1]).map((x,i)=>[x[0],i]));
    const top=new Set(Object.keys(rank).filter(c=>rank[c]<R.topClients));
    const domKey=o=>R.domFirst?(o.show?1:0):0;
    const KEYFN={dom:o=>domKey(o),top:o=>top.has(o.cli)?0:1,dl:o=>o.dl,coll:o=>o.coll,
      dcmd:o=>o.dcmd!=null?o.dcmd:Infinity,ord:o=>o.ord,rank:o=>rank[o.cli]!=null?rank[o.cli]:9999};
    const KEYS=(R.sortKeys&&R.sortKeys.length?R.sortKeys:['dom','top','dl','coll','dcmd']);
    const pri=o=>KEYS.map(k=>KEYFN[k](o));
    os.sort((a,b)=>{const pa=pri(a),pb=pri(b);
      for(let i=0;i<pa.length;i++){if(pa[i]<pb[i])return -1;if(pa[i]>pb[i])return 1;}
      return a.ord.localeCompare(b.ord);});
    /* paliers : top clients = séquentiel (palier singleton) ; autres = groupés par priorité */
    const fair=R.fairShare&&R.fairShare[mod];
    const tiers=[];let cur=null,curKey='';
    for(const o of os){
      const isTop=top.has(o.cli)&&domKey(o)===0;
      if(!fair||isTop){tiers.push([o]);curKey='';continue;}
      const k=JSON.stringify(pri(o));
      if(k!==curKey){cur=[];tiers.push(cur);curKey=k;}cur.push(o);}
    /* demandes par SKU dans un palier */
    const allocTier=(tier,pass)=>{
      const isSS27=isFut(tier[0].coll)&&mod==='FR';
      const limit=tier[0].dl+R.grace*DAY;
      const bySku={};
      for(const o of tier)for(const l of o.lines)
        if(l.left>0)(bySku[l.sku]=bySku[l.sku]||[]).push(l);
      for(const sku of Object.keys(bySku)){
        for(const c of candidates(mod,sku,isSS27)){
          const lines=bySku[sku].filter(l=>l.left>0);
          if(!lines.length)break;
          if(pass===1&&c.arr>limit)continue;
          const need=lines.reduce((a,l)=>a+l.left,0);
          const avail=c.kind==='S'?stockLeft[sku][c.grp]:c.poRef.left;
          if(avail<=0)continue;
          const give=Math.min(need,avail);
          /* partage proportionnel au besoin (plus forts restes) */
          let shares;
          if(give>=need)shares=lines.map(l=>l.left);
          else{
            const raw=lines.map(l=>give*l.left/need);
            shares=raw.map(Math.floor);
            let rem=give-shares.reduce((a,b)=>a+b,0);
            const order=raw.map((v,i)=>[v-Math.floor(v),i]).sort((a,b)=>b[0]-a[0]);
            for(let j=0;j<order.length&&rem>0;j++){shares[order[j][1]]++;rem--;}
          }
          lines.forEach((l,i)=>{const t=Math.min(shares[i],l.left);
            if(t>0){take(c,sku,t);l.left-=t;
              FLOW.push([mod==='FR'?0:1,c.arr,(c.grp==='LOG'||c.grp==='FRO'||c.grp==='FR')?0:1,t,c.kind==='S'?0:1]);
              l.alloc.push({kind:c.kind,grp:c.grp,arr:c.arr,q:t,po:c.poRef?c.poRef.po:null});}});
        }
      }
    };
    if(R.passMode==='order'){for(const t of tiers){allocTier(t,1);allocTier(t,2);}}
    else {for(const t of tiers)allocTier(t,1); for(const t of tiers)allocTier(t,2);}
  };
  await runModule('FR',.4); await runModule('INT',.55);

  /* ---- AGRÉGATION ---- */
  prog(.68,'Agrégation par commande…');await tick();
  const pfr=[],pint=[],detFR={},detIN={};
  let sumOT=0,sumLate=0,sumCanc=0;
  for(const o of Object.values(orders)){
    const mod=o.mod, limit=o.dl!=null?o.dl+R.grace*DAY:null;
    let aStk=0,aProd=0,prio=0,ot=0,late=0,canc=0,arrs=[],arrsOT=[],arrsLate=[],posSet=new Set();
    const det=[];
    for(const l of o.lines){
      let lot=0,llate=0;
      const srcs=[];
      for(const a of l.alloc){
        if(R.debugRaw)RAW.push([o.ord,l.sku,a.kind,a.grp,a.arr,a.q,a.po||null,mod]);
        if(a.kind==='S')aStk+=a.q; else {aProd+=a.q; if(a.po)posSet.add(a.po);}
        const prioGrp=mod==='FR'?(a.grp==='LOG'):(a.grp==='SF'||a.grp==='DT');
        if(a.kind==='S'&&prioGrp)prio+=a.q;
        if(limit!=null&&a.arr<=limit){lot+=a.q;arrsOT.push(a.arr);}else{llate+=a.q;arrsLate.push(a.arr);}
        arrs.push(a.arr);
        const lbl=a.kind==='S'?stockLabel[a.grp]:('PO '+(a.po||'?')+' → '+(a.grp==='ASIE'?'Asie':'Logtex'));
        srcs.push(lbl+' · '+a.q+' pcs · '+dfr(a.arr));
      }
      ot+=lot; late+=llate; if(l.left>0)canc+=l.left;
      det.push([l.sku,l.desig,l.q,l.q-l.left,srcs.join('  ;  '),lot,llate,l.left]);
    }
    if(mod==='FR'||o.show){sumOT+=ot;sumLate+=late;sumCanc+=canc;}
    if(!o.show)continue;
    const coll=o.coll||'';
    const eta1=arrs.length?Math.min(...arrs):null, etaC=arrs.length?Math.max(...arrs):null;
    const a1t=arrsOT.length?Math.min(...arrsOT):null,a2t=arrsOT.length?Math.max(...arrsOT):null;
    const a1r=arrsLate.length?Math.min(...arrsLate):null,a2r=arrsLate.length?Math.max(...arrsLate):null;
    const stat=o.q<=0||canc>=o.q?'⚫ Annulé':prio>=o.q?'🟢 Pousser tout':prio>0?'🟡 Pousser partiel':'⚪ Rien à pousser';
    const src=(o.q<=0||canc>=o.q)?'Aucune source':(aStk>0&&aProd>0?'Stock + Prod':aStk>0?'Stock':aProd>0?'Prod':'Aucune source');
    const arriv=(aStk+aProd)-prio;
    let syn;
    if(stat==='⚫ Annulé')syn='❌ Annulée — plus rien à livrer';
    else if(mod==='FR'){
      if(stat==='🟢 Pousser tout')syn='✅ 100 % dispo à Logtex — '+nUS(prio)+' pcs à pousser maintenant';
      else if(stat==='🟡 Pousser partiel')syn='🟡 '+nUS(prio)+' pcs dispo à Logtex · '+nUS(arriv)+' pcs en arrivage d\x27ici le '+(etaC?dfr(etaC):'?');
      else syn='⏳ Rien à Logtex — '+nUS(arriv)+' pcs attendues entre le '+(eta1?dfr(eta1):'?')+' et le '+(etaC?dfr(etaC):'?');
    }else{
      if(stat==='🟢 Pousser tout')syn='✅ 100 % dispo usine SF/DT — '+nUS(prio)+' pcs livrables ~ '+dfr(TGEN+R.intPrepDelay*DAY)+' (+'+R.intPrepDelay+' j préparation)';
      else if(stat==='🟡 Pousser partiel')syn='🟡 '+nUS(prio)+' pcs dispo SF/DT (livrables ~ '+dfr(TGEN+R.intPrepDelay*DAY)+') · '+nUS(arriv)+' pcs en arrivage d\x27ici le '+(etaC?dfr(etaC):'?');
      else syn='⏳ Rien de dispo SF/DT — '+nUS(arriv)+' pcs attendues entre le '+(eta1?dfr(eta1):'?')+' et le '+(etaC?dfr(etaC):'?');
    }
    if(stat!=='⚫ Annulé'&&canc>0)syn+=' · '+nUS(canc)+' pcs annulées';
    let rechu=null;
    const isAnomaly=isFut(coll)&&o.dl!=null&&o.dl<preSeasonCutoff(coll);
    const rechuHidden=isAnomaly||(mod==='FR'&&stat==='⚫ Annulé')||(mod==='INT'&&stat==='🟢 Pousser tout');
    if(!rechuHidden&&o.dl!=null&&o.dl<TGEN)rechu=Math.round((TGEN-o.dl)/DAY);
    const rprev=(etaC!=null&&o.dl!=null)?Math.round((etaC-o.dl)/DAY):null;
    const nets=Object.entries(o.nets).sort((a,b)=>b[1]-a[1]);
    const cat=nets.length?nets[0][0]:(mod==='FR'?'WHOLESALE FRANCE':'WHOLESALE INTERNATIONAL');
    const row=[coll,cat,o.cli,o.ord,o.q,prio,o.q?+(prio/o.q).toFixed(4):0,stat,syn,
      eta1?dstr(eta1):null,etaC?dstr(etaC):null,o.dl!=null?dstr(o.dl):null,rechu,+o.mt.toFixed(2),
      ot,late,canc,o.q?+(canc/o.q).toFixed(4):0,aStk,aProd,src,0,
      a1t?dstr(a1t):null,a2t?dstr(a2t):null,a1r?dstr(a1r):null,a2r?dstr(a2r):null,
      o.mag||o.cli,o.ref,o.codc,o.grpc,o.grp,o.codm,o.ville,o.rep,o.dcmd?dstr(o.dcmd):null,
      [...posSet].sort().join(' \u00b7 ')];
    if(mod==='FR'){row.push(o.q?+(((o.q-canc)/o.q)).toFixed(4):0);row.push(rprev);pfr.push(row);
      (detFR[o.ord]=detFR[o.ord]||[]).push(...det);o._row=row;}
    else{row.push(rprev);pint.push(row);(detIN[o.ord]=detIN[o.ord]||[]).push(...det);o._row=row;}
  }
  const statOrder=s=>s.startsWith('🟢')?0:s.startsWith('🟡')?1:s.startsWith('⚪')?2:3;
  const srt=(a,b)=>statOrder(a[7])-statOrder(b[7])||b[6]-a[6]||b[13]-a[13];
  pfr.sort(srt);pint.sort(srt);

  /* ---- RESTE À ALLOUER ---- */
  prog(.8,'Reste à allouer & substitutions…');await tick();
  const rest=[],restPool=[];
  const grpSrc={LOG:'Logtex (WLOGM)',FRO:'Autres FR (WHSLM/WFIFR)',SF:'SF Chine (WSFCN)',DT:'DT Thaïlande (WDTTH)',ASO:'Autres Asie'};
  for(const sku of Object.keys(stockLeft)){
    const coll=collBySku[sku]||'';
    for(const g of ['LOG','FRO','SF','DT','ASO']){
      const q=stockLeft[sku][g]||0; if(q<=0)continue;
      restPool.push({sku,coll,stock:true,q,left:q,eta:null,grp:g});
      if(COLLSET.has(coll))rest.push([sku,coll,'',grpSrc[g],q,'Maintenant',null]);
    }
  }
  for(const p of pos){ if(p.left<=0)continue;
    const coll=collBySku[p.sku]||'';
    restPool.push({sku:p.sku,coll,stock:false,q:p.left,left:p.left,eta:p.rawEta!=null?p.rawEta:p.eta,grp:p.dest});
    if(COLLSET.has(coll))
      rest.push([p.sku,coll,'',p.dest==='FR'?'PO → France':'PO → Asie',p.left,'À terme',dstr(p.rawEta!=null?p.rawEta:p.eta)]);
  }
  rest.sort((a,b)=>String(a[0]).localeCompare(String(b[0])));

  /* ---- SUBSTITUTIONS ---- */
  const desigBySku={};
  for(const o of Object.values(orders))for(const l of o.lines)if(l.desig&&!desigBySku[l.sku])desigBySku[l.sku]=l.desig;
  function base(sku){const i=sku.lastIndexOf('_');return i>0?sku.slice(0,i):sku;}
  function size(sku){const i=sku.lastIndexOf('_');return i>0?sku.slice(i+1):'';}
  function model(sku){const d=desigBySku[sku]||'';return d.split(/\s+/)[0]||null;}
  const poolBySku={},poolByModel={};
  for(const e of restPool){(poolBySku[base(e.sku)]=poolBySku[base(e.sku)]||[]).push(e);
    const m=model(e.sku);if(m)(poolByModel[m+'|'+e.coll]=poolByModel[m+'|'+e.coll]||[]).push(e);}
  const subHead=['COMMANDE','CLIENT','STATUT CMD','SKU MANQUANT','DÉSIGNATION','QTÉ MANQUANTE','RANG','TYPE DE SUBSTITUTION','SKU SUBSTITUT','DÉSIGNATION SUBSTITUT','PCS DISPO MAINTENANT','PCS À TERME','ETA À TERME','QTÉ PROPOSÉE','QTÉ RETENUE (SAISIE)'];
  const okGrp=(e,mod)=>mod==='FR'?(e.stock?(e.grp==='LOG'||e.grp==='FRO'):e.grp==='FR')
                                 :(e.stock?(e.grp==='SF'||e.grp==='DT'||e.grp==='ASO'):e.grp==='ASIE');
  function buildSubst(mod){
    const rows=[];let manq=0,prop=0,now=0;
    const os=Object.values(orders).filter(o=>o.mod===mod&&o.show&&o._row);
    for(const o of os){
      for(const l of o.lines){
        if(l.left<=0)continue;
        manq+=l.left;const coll=o.coll||'';
        let need=l.left,got=0,gotNow=0,nCand=0;
        const propose=(e,rang,type)=>{
          if(need<=0||e.left<=0||nCand>=R.substMaxCand)return;
          nCand++;
          if(e.coll!==coll||!coll)return;
          if(!okGrp(e,mod))return;
          const t=Math.min(need,e.left);e.left-=t;need-=t;got+=t;
          if(e.stock)gotNow+=t;
          rows.push([o.ord,o.cli,o._row[7],l.sku,l.desig,l.left,rang,type,e.sku,desigBySku[e.sku]||'',
            e.stock?t:0,e.stock?0:t,e.eta?dstr(e.eta):null,t,null]);
        };
        const sib=(poolBySku[base(l.sku)]||[]).filter(e=>e.sku!==l.sku&&e.left>0&&e.coll===coll);
        const mySz=parseFloat(size(l.sku))||0;
        sib.sort((a,b)=>Math.abs((parseFloat(size(a.sku))||0)-mySz)-Math.abs((parseFloat(size(b.sku))||0)-mySz)||(b.stock-a.stock));
        for(const e of sib)propose(e,1,'Même article, autre taille');
        const r1got=got;
        if(need>0&&!(R.substR2OnlyIfNoR1&&r1got>0)){const m=model(l.sku);
          if(m){const cand=(poolByModel[m+'|'+coll]||[]).filter(e=>base(e.sku)!==base(l.sku)&&e.left>0);
            cand.sort((a,b)=>(b.stock-a.stock));
            let n2=0;
            for(const e of cand){ if(n2>=R.substR2Max)break;
              if(R.substR2SameSize&&size(e.sku)!==size(l.sku))continue;
              const before=got; propose(e,2,'Même modèle, autre coloris (accord client)');
              if(got>before)n2++; }}}
        prop+=got;now+=gotNow;
        o._row[21]=(o._row[21]||0)+got;
        o._subNow=(o._subNow||0)+gotNow;
      }
      if(o._subNow>0&&!String(o._row[8]).includes('🔄')){
        o._row[8]+=' · 🔄 '+nUS(o._subNow)+' pcs substituables dispo';}
    }
    return {stats:['Pcs manquantes module :',manq,'Pcs proposées :',prop,'dont dispo maintenant :',now],head:subHead,rows};
  }
  const subFR=buildSubst('FR'), subIN=buildSubst('INT');

  ctrl.onT=sumOT;ctrl.late=sumLate;ctrl.canc=sumCanc;
  prog(.95,'Rendu…');await tick();
  const ORDDBG=R.debugRaw?Object.values(orders).map(o=>[o.ord,o.cli,o.coll,o.dl,o.mt,o.show?1:0,o.mod||null,o.dcmd||null]):null;
  const d={arrFlow:FLOW,rawAlloc:R.debugRaw?RAW:null,ordersDbg:ORDDBG,fileDate:dfr(TGEN)+' · arrivées à partir du '+dfr(TARR)+' · collections '+([...COLLSET].sort().join(', ')||'—'),
    pfrHead:S.heads.pfr,pfr,pintHead:S.heads.pint,pint,detFR,detIN,subFR,subIN,
    restHead:S.heads.rest||['SKU','COLLECTION','DESCRIPTION ARTICLE','SOURCE','PCS','DISPO','ETA'],
    rest,restStats:[],macroHead:S.heads.macro,macro:[],methode:S.methode};
  for(const r of d.rest)r[2]=desigBySku[r[0]]||'';
  S.ctrl=ctrl;
  prog(1,'Terminé — '+nUS(ctrl.demande)+' pcs de demande retenue');
  applyData(d,'(recalcul V10 : '+nUS(ctrl.demande)+' pcs retenues · '+nUS(ctrl.onT)+' à temps · '+nUS(ctrl.late)+' retard · '+nUS(ctrl.canc)+' annulées)');
  setTimeout(()=>{$('#prog').style.display='none';$('#loadZone').classList.remove('on');},1200);
}

});
</script>
{% endblock %}
