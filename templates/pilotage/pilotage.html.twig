   (top.length?top.map(o=>`<tr><td><b>${esc(o.sku)}</b><div class="mini">${esc(o.des)} — manque ${fmt(o.pcs)} pcs</div></td>`+
     `<td class="num">${fmt(o.cmds.size)}</td><td class="num late">${fmtE(o.eur)}</td></tr>`).join('')
   :'<tr><td colspan="3" class="mut">Aucune annulation dans le périmètre filtré.</td></tr>')+'</tbody>';
}
/* ---------- prochaine arrivée majeure ---------- */
function renderMacNext(all){
  const el=$('#macNext'); if(!el)return;
  let flow=S.arrFlow&&S.arrFlow.length?S.arrFlow:flowFromDetails();
  const now=Date.now(),wk=t=>{const d=new Date(t);d.setHours(0,0,0,0);return d.getTime()-((d.getDay()+6)%7)*86400000;};
  const by={};flow.forEach(([m,t,asie,q])=>{if(t<now)return;const w=wk(t);(by[w]=by[w]||[0,0])[asie]+=q;});
  const ws=Object.keys(by).map(Number);
  if(!ws.length){el.innerHTML='';return;}
  const best=ws.sort((a,b)=>(by[b][0]+by[b][1])-(by[a][0]+by[a][1]))[0];
  const [pF,pA]=by[best],tot=pF+pA;
  const done=all.filter(r=>{const t=pdate(r[C.ETAC]);const st=String(r[C.STAT]||'');
    return t!=null&&t>=best&&t<best+7*86400000&&!st.includes('🟢')&&!st.includes('⚫');});
  const dE=done.reduce((a,r)=>a+(r[C.MT]||0),0);
  const dd2=t=>{const d=new Date(t);return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+'/'+d.getFullYear();};
  const iso=(t=>{const d=new Date(t),th=new Date(d);th.setDate(d.getDate()+3);
    const y0=new Date(th.getFullYear(),0,1);return 'S'+String(Math.ceil(((th-y0)/86400000+1)/7)).padStart(2,'0');})(best);
  const wISO=best.toString();
  el.innerHTML=`<h2 class="sec">Prochaine arrivée majeure</h2>
   <div class="act" style="border-top-color:var(--vert)">
    <div class="t">📦 ${iso} — semaine du ${dd2(best)} · ${fmt(tot)} pcs (${pA>pF?'majorité Asie':'majorité France'})</div>
    <div class="big">complète ${fmt(done.length)} commande${done.length>1?'s':''}</div>
    <div class="sub">${fmtE(dE)} libérés à l\u2019expédition</div>
    <a id="mnGo" style="cursor:pointer">Voir ces commandes →</a></div>`;
  const d0=new Date(best);
  const isoD=d0.getFullYear()+'-'+String(d0.getMonth()+1).padStart(2,'0')+'-'+String(d0.getDate()).padStart(2,'0');
  $('#mnGo').onclick=()=>goTab('pfr',{etaw:isoD});
}
/* ---------- comparaison avec le calcul précédent ---------- */
function loadPrevWb(file){
  const rd=new FileReader();
  rd.onload=e=>{try{
    const wb=XLSX.read(new Uint8Array(e.target.result),{type:'array'});
    const take=n=>{const sh=wb.Sheets[n];return sh?XLSX.utils.sheet_to_json(sh,{header:1,raw:true}).slice(1):[];};
    const rows=[...take('PILOTAGE FRANCE'),...take('PILOTAGE INTERNATIONAL')];
    if(!rows.length){showModal('alert','Feuilles PILOTAGE introuvables dans ce classeur.');return;}
    const map={};rows.forEach(r=>{if(r&&r[C.ORD]!=null)map[String(r[C.ORD])+'|'+r[C.COLL]]=r;});
    S.prev={name:file.name,map};renderMacro();
  }catch(err){showModal('alert','Lecture impossible : '+err.message);}};
  rd.readAsArrayBuffer(file);
}
function renderMacPrev(fr,int){
  const el=$('#macPrev'); if(!el)return;
  if(!S.prev){el.innerHTML='';return;}
  const cur={};[...fr,...int].forEach(r=>{cur[String(r[C.ORD])+'|'+r[C.COLL]]=r;});
  const P=S.prev.map;
  let nNew=0,eNew=0,toGreen=0,toEchu=0,cancPlus=0,cancMoins=0;
  const num=v=>{const n=parseFloat(v);return isNaN(n)?0:n;};
  for(const k in cur){const r=cur[k],p=P[k];
    if(!p){nNew++;eNew+=r[C.MT]||0;continue;}
    const pg=String(p[C.STAT]||'').includes('🟢'),cg=String(r[C.STAT]||'').includes('🟢');
    if(!pg&&cg)toGreen++;
    if(!(num(p[C.RECHU])>0)&&(r[C.RECHU]||0)>0)toEchu++;
    const d=(r[C.QCANC]||0)-num(p[C.QCANC]);
    if(d>0)cancPlus+=d; else cancMoins-=d;}
  el.innerHTML=`<h2 class="sec" style="margin-top:0">Depuis ${esc(S.prev.name.replace(/\.xlsx$/i,''))}</h2>
   <div class="twrap" style="max-height:none;margin-bottom:14px"><table>
    <thead><tr><th>Mouvement</th><th>Volume</th></tr></thead><tbody>
    <tr><td>Nouvelles commandes entrées</td><td class="num">+${fmt(nNew)} cmd · ${fmtE(eNew)}</td></tr>
    <tr><td>Passées 🟢 prêtes à envoyer</td><td class="num early">+${fmt(toGreen)} cmd</td></tr>
    <tr><td>Basculées en retard échu</td><td class="num late">+${fmt(toEchu)} cmd</td></tr>
    <tr><td>Annulations apparues</td><td class="num late">+${fmt(cancPlus)} pcs</td></tr>
    <tr><td>Annulations résolues</td><td class="num early">−${fmt(cancMoins)} pcs</td></tr>
    </tbody></table></div>`;
}

/* ---------- helpers filtres ---------- */
function selOpt(list,ph){const u=[...new Set(list.filter(x=>x!=null&&x!==''))].sort();
  return `<option value="">${ph}</option>`+u.map(v=>`<option value="${esc(v)}">${esc(v)}</option>`).join('');}
function bindBar(panel,key,cb){
  $$(panel+' [data-f]').forEach(el=>{
    const apply=()=>{S.filters[key][el.dataset.f]=el.value;S.page[key]=0;cb();
      /* le re-rendu recrée la barre : on rend le focus au même champ, curseur en fin */
      const nel=document.querySelector(panel+' [data-f="'+el.dataset.f+'"]');
      if(nel&&nel.tagName==='INPUT'){nel.focus();const L=nel.value.length;try{nel.setSelectionRange(L,L);}catch(e){}}};
    if(el.tagName==='INPUT'){
      let t;
      el.oninput=()=>{clearTimeout(t);t=setTimeout(apply,350);};
      el.onkeydown=e=>{if(e.key==='Enter'){clearTimeout(t);apply();}};
    } else el.onchange=apply;
  });
}
function chipHtml(key,cb){
  const f=S.filters[key],act=Object.entries(f).filter(([,v])=>v);
  if(!act.length)return '';
  return act.map(([k,v])=>`<span class="chip" data-ck="${esc(k)}">${esc(v)}</span>`).join(' ')+
   ` <button class="btn ghost" data-creset>Réinitialiser</button>`;
}
function bindChips(panel,key,cb){
  $$(panel+' .chip[data-ck]').forEach(c=>c.onclick=()=>{delete S.filters[key][c.dataset.ck];syncBar(panel,key);cb();});
  const r=$(panel+' [data-creset]'); if(r)r.onclick=()=>{S.filters[key]={};syncBar(panel,key);cb();};
}
function syncBar(panel,key){$$(panel+' [data-f]').forEach(el=>{el.value=S.filters[key][el.dataset.f]||'';});}

/* ---------- MACRO VIEW ---------- */
function macroRows(){
  const f=S.filters.macro||{};
  const test=(r,seg)=>{
    if(f.seg&&f.seg!==seg)return false;
    if(f.coll&&r[C.COLL]!==f.coll)return false;
    if(f.stat&&r[C.STAT]!==f.stat)return false;
    if(f.grp&&r[C.GRP]!==f.grp)return false;
    if(f.q){const q=f.q.toLowerCase();
      if(!String(r[C.CLI]||'').toLowerCase().includes(q)&&!String(r[C.ORD]||'').toLowerCase().includes(q)&&
         !String(r[C.MAG]||'').toLowerCase().includes(q))return false;}
    return true;};
  return {fr:S.pfr.filter(r=>test(r,'France')),int:S.pint.filter(r=>test(r,'International'))};
}
function agg(rows,mod){
  const a={pcs:0,mt:0,cmd:rows.length,pretP:0,pretC:0,pretE:0,partP:0,partC:0,cancP:0,cancC:0,
    lateN:0,lateSum:0,otP:0,lateP:0,subQ:0};
  const ri=RPREV(mod==='France'?'pfr':'pint');
  for(const r of rows){
    a.pcs+=r[C.Q]||0;a.mt+=r[C.MT]||0;a.otP+=r[C.QOT]||0;a.lateP+=r[C.QLATE]||0;a.cancP+=r[C.QCANC]||0;a.subQ+=r[C.SUBQ]||0;
    if(r[C.QCANC]>0)a.cancC++;
    const st=String(r[C.STAT]||'');
    if(st.includes('🟢')){a.pretP+=r[C.DISPO]||0;a.pretC++;a.pretE+=r[C.MT]||0;}
    else if(st.includes('🟡')){a.partP+=r[C.DISPO]||0;a.partC++;}
    const rp=r[ri]; if(typeof rp==='number'&&rp>0){a.lateN++;a.lateSum+=rp;}
  }
  a.lateAvg=a.lateN?a.lateSum/a.lateN:0;
  return a;
}
function renderMacro(){
