    <div class="fg"><label>Type de substitution</label><select data-f="type">${selOpt(types,'Tous')}</select></div>
    <div class="fg"><label>Dispo</label><select data-f="dispo"><option value="">Toutes</option><option value="now">Dispo maintenant</option><option value="later">À terme uniquement</option></select></div>
