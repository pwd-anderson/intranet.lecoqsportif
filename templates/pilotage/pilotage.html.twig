  <div class="mut" data-count style="margin:-4px 0 8px 4px"></div>
  <div class="twrap"><table data-tbl></table></div><div class="pgn" data-pgn></div>`;
  $('#sbFR').onclick=()=>{S.substTab='FR';S.page.subst=0;renderSubst();};
  $('#sbIN').onclick=()=>{S.substTab='IN';S.page.subst=0;renderSubst();};
  syncBar('#p-subst','subst');bindBar('#p-subst','subst',()=>renderSubstTable());
  $('#sbExp').onclick=()=>exportSubst();
