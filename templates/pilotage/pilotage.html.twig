{% extends 'base.html.twig' %}

{% block stylesheets %}
{{ parent() }}
<style>
:root{
  --gold:#40A2ED;--gold-d:#2B84D4;--gold-dd:#172B4C;
  --gold-l1:#EEF6FD;--gold-l2:#DCEDFB;--gold-l3:#B8DBF6;
  --ink:#172B4C;--soft:#4C5C7A;--faint:#8B98B3;
  --paper:#F5F7FA;--card:#FFFFFF;--line:#E4E9F1;--line2:#CBD5E3;
  --green:#2E7D32;--green-bg:#E6F2E7;
  --amber:#B26A00;--amber-bg:#FBF0DD;
  --red:#B3261E;--red-bg:#FBE6E4;
  --sh:0 1px 2px rgba(23,43,76,.06),0 4px 14px rgba(23,43,76,.07);
  --sh2:0 10px 36px rgba(23,43,76,.18);
}
.pilotage-wrap *{box-sizing:border-box}
.pilotage-wrap{font-family:system-ui,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;background:var(--paper);color:var(--ink);font-size:13.5px;-webkit-font-smoothing:antialiased;min-height:calc(100vh - 60px);padding-bottom:60px}
.pilotage-wrap .num{font-variant-numeric:tabular-nums}
.pil-header{background:#fff;border-bottom:3px solid var(--gold);padding:0 26px;display:flex;align-items:center;gap:16px;height:66px;box-shadow:0 1px 4px rgba(31,27,16,.06);flex-wrap:wrap}
.pil-brand h2{font-size:18px;font-weight:800;letter-spacing:-.01em;line-height:1.05;margin:0}
.pil-brand .sub{font-size:10px;color:var(--faint);letter-spacing:.14em;text-transform:uppercase;margin-top:2px}
.hspacer{flex:1}
.hmeta{text-align:right;font-size:11.5px;color:var(--soft);line-height:1.5}
.hmeta strong{color:var(--ink)}
.pil-btn{border:1px solid var(--line2);background:#fff;border-radius:8px;padding:8px 14px;font-size:12.5px;font-weight:600;color:var(--ink);transition:.15s;display:inline-flex;align-items:center;gap:7px;cursor:pointer;font-family:inherit}
.pil-btn:hover:not(:disabled){border-color:var(--gold-d);color:var(--gold-dd);background:var(--gold-l1)}
.pil-btn.primary{background:var(--gold);border-color:var(--gold);color:#FFFFFF}
.pil-btn.primary:hover:not(:disabled){background:var(--gold-d);border-color:var(--gold-d);color:#fff}
.pil-btn.ghost{border-color:transparent;background:transparent}
.pil-btn:disabled{opacity:.45;cursor:not-allowed}
.pil-main{max-width:1620px;margin:0 auto;padding:20px 26px 40px}
.pil-section{margin-bottom:20px}
.ey{font-size:10.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--faint);margin-bottom:8px}
.pil-card{background:var(--card);border:1px solid var(--line);border-radius:12px;box-shadow:var(--sh)}

/* ── Zone de chargement ── */
#pil-load-zone{border:2px dashed var(--line2);border-radius:12px;background:var(--card);padding:32px 24px;text-align:center}
#pil-load-zone h3{font-size:15px;font-weight:700;margin-bottom:6px}
#pil-load-zone p{color:var(--soft);font-size:12.5px;margin-bottom:18px}
#dropzone{border:2px dashed var(--line2);border-radius:12px;background:var(--card);padding:32px 24px;text-align:center;transition:.18s}
#dropzone.over{border-color:var(--gold);background:var(--gold-l1)}
#dropzone h2{font-size:15px;font-weight:700;margin-bottom:6px}
#dropzone p{color:var(--soft);font-size:12.5px;margin-bottom:18px}
.pil-section .tabs{border-bottom:none;padding:0 12px}
#chip-clients.ok,#chip-fourn.ok,#chip-stock.ok{background:var(--green-bg);color:var(--green)}
.pil-coll-wrap{display:flex;align-items:flex-start;justify-content:center;gap:18px;flex-wrap:wrap;margin-bottom:18px}
.pil-coll-label{font-size:12px;font-weight:700;color:var(--soft);text-align:left;margin-bottom:6px}
#pil-collections{border:1px solid var(--line2);border-radius:8px;padding:4px;font-size:12.5px;min-width:200px;background:#fff}
#pil-collections option{padding:5px 10px;border-radius:5px;cursor:pointer}
#pil-collections option:checked{background:var(--gold-l2);color:var(--ink)}
.pil-bar{height:6px;background:var(--gold-l2);border-radius:99px;overflow:hidden;margin-top:18px;display:none}
.pil-bar.on{display:block}
.pil-bar i{display:block;height:100%;background:var(--gold);width:0;transition:width .3s}
.pil-status{margin-top:10px;font-size:12px;color:var(--soft);min-height:16px}

/* ── KPI ── */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.kpi{padding:15px 17px}
.kpi .lab{font-size:10.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--faint)}
.kpi .val{font-size:25px;font-weight:800;margin-top:7px;letter-spacing:-.02em}
.kpi .sub{font-size:11.5px;color:var(--soft);margin-top:3px}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:1080px){.grid2{grid-template-columns:1fr}}

/* ── Tables ── */
table{border-collapse:collapse;width:100%;font-size:12.5px}
th{background:var(--gold-l1);color:var(--gold-dd);font-size:10.5px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:2;white-space:nowrap}
th.s{cursor:pointer;user-select:none}
th.s:hover{background:var(--gold-l2)}
td{padding:7px 10px;border-bottom:1px solid var(--line)}
tbody tr:hover{background:var(--gold-l1)}
tbody tr.clickable{cursor:pointer}
.r{text-align:right}.c{text-align:center}
.tw{overflow:auto;max-height:600px;border-radius:12px}
.pill{display:inline-block;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:700;white-space:nowrap}
.p-g{background:var(--green-bg);color:var(--green)}
.p-a{background:var(--amber-bg);color:var(--amber)}
.p-r{background:var(--red-bg);color:var(--red)}
.p-n{background:#3D3A32;color:#fff}
tbody tr.cancel{background:#FFF3C4}
tbody tr.cancel:hover{background:#FFE699}
.cov{display:flex;align-items:center;gap:7px;min-width:110px}
.cov .track{flex:1;height:7px;background:#EFEADC;border-radius:99px;overflow:hidden}
.cov .fill{height:100%;border-radius:99px;background:var(--gold)}
.cov .fill.hi{background:var(--green)}
.cov .fill.lo{background:var(--red)}
.cov span{font-size:11.5px;font-weight:700;width:36px;text-align:right}
.late{color:var(--red);font-weight:700}
.ontime{color:var(--green);font-weight:700}
.toolbar{display:flex;gap:9px;flex-wrap:wrap;align-items:center;padding:12px 14px;border-bottom:1px solid var(--line)}
.toolbar input[type=search],.toolbar input[type=date],.toolbar select{border:1px solid var(--line2);border-radius:8px;padding:7px 11px;font-size:12.5px;background:#fff;color:var(--ink);font-family:inherit}
.toolbar input[type=search]{min-width:230px}
.toolbar .sp{flex:1}
.count{font-size:11.5px;color:var(--faint);font-weight:600}
.pager{display:flex;gap:7px;align-items:center;justify-content:flex-end;padding:10px 14px;font-size:12px;color:var(--soft)}
.pager button{border:1px solid var(--line2);background:#fff;border-radius:7px;padding:4px 10px;font-size:12px;cursor:pointer;font-family:inherit}
.pager button:disabled{opacity:.4}

/* ── Drawer ── */
#pil-drawer{position:fixed;top:0;right:0;height:100%;width:min(1080px,94vw);background:var(--card);box-shadow:var(--sh2);transform:translateX(101%);transition:transform .22s ease;z-index:1000;display:flex;flex-direction:column}
#pil-drawer.open{transform:none}
.dhead{padding:16px 20px;border-bottom:1px solid var(--line);display:flex;align-items:flex-start;gap:14px}
.dhead h3{font-size:16px;font-weight:800}
.dhead .m{font-size:12px;color:var(--soft);margin-top:4px}
.dbody{overflow:auto;padding:16px 20px 40px;flex:1}
.dgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin-bottom:16px}
.dbox{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--gold-l1)}
.dbox .l{font-size:10px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--faint)}
.dbox .v{font-size:17px;font-weight:800;margin-top:4px}
.ov{position:fixed;inset:0;background:rgba(31,27,16,.34);opacity:0;pointer-events:none;transition:.2s;z-index:999}
.ov.on{opacity:1;pointer-events:auto}
details.rules{padding:14px 18px}
details.rules summary{cursor:pointer;font-weight:700;color:var(--gold-dd);font-size:13px}
details.rules ul{margin:12px 0 0 18px;color:var(--soft);line-height:1.75;font-size:12.5px}
details.rules b{color:var(--ink)}
.hide{display:none!important}
.tabs{display:flex;gap:5px;border-bottom:1px solid var(--line);padding:0 14px}
.tab{padding:11px 15px;font-size:12.5px;font-weight:700;color:var(--faint);border-bottom:2px solid transparent;background:none;border-top:none;border-left:none;border-right:none;cursor:pointer;font-family:inherit}
.tab.on{color:var(--gold-dd);border-bottom-color:var(--gold)}
.pil-foot{text-align:center;color:var(--faint);font-size:11.5px;padding:22px}
</style>
{% endblock %}

{% block body %}
<div class="pilotage-wrap">

  <!-- En-tête -->
  <div class="pil-header">
    <div class="pil-brand">
      <h2>Pilotage Livraisons</h2>
      <div class="sub">Backlog clients × Production × Stock — données live</div>
    </div>
    <div class="hspacer"></div>
    <div class="hmeta" id="hmeta"></div>
    <button class="pil-btn" id="btnReset" disabled>Réinitialiser</button>
    <button class="pil-btn primary" id="btnExport" disabled>Exporter Excel</button>
  </div>

  <div class="pil-main">

    <!-- Zone de chargement -->
    <div class="pil-section" id="importSec">
      <div class="ey">Paramètres de chargement</div>

      <div class="tabs" style="border:1px solid var(--line);border-bottom:none;border-radius:12px 12px 0 0;background:var(--card)">
        <button class="tab on" id="tabApi" type="button">Données live (ERP)</button>
        <button class="tab" id="tabFile" type="button">Import fichiers (test)</button>
      </div>

      <div id="pil-load-zone" style="border-radius:0 0 12px 12px;border-top:none">
        <h3>Sélectionnez les collections à analyser</h3>
        <p>Les données sont chargées en temps réel depuis l'ERP — aucun fichier à importer.</p>
        <div class="pil-coll-wrap">
          <div>
            <div class="pil-coll-label">Collections (Ctrl+clic pour sélection multiple)</div>
            <select id="pil-collections" multiple size="4">
              <option value="2026-02-FW" selected>FW26 — 2026-02-FW</option>
              <option value="2027-01-SS" selected>SS27 — 2027-01-SS</option>
              <option value="2027-02-FW">FW27 — 2027-02-FW</option>
            </select>
          </div>
        </div>
        <button class="pil-btn primary" id="btnLoad">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/></svg>
          Charger les données
        </button>
        <div class="pil-bar" id="pbar"><i></i></div>
        <div class="pil-status" id="pstatus"></div>
      </div>

      <div id="dropzone" class="hide" style="border-radius:0 0 12px 12px;border-top:none">
        <h2>Déposez vos 3 fichiers ici</h2>
        <p>Backlog client, backlog fournisseur et stock (.xlsx, .xls ou .csv) — glissez-déposez ou parcourez.</p>
        <input type="file" id="fileInput" multiple accept=".xlsx,.xls,.csv" class="hide">
        <button class="pil-btn primary" id="btnPick" type="button">Parcourir…</button>
        <div style="display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:16px">
          <span class="pill p-n" id="chip-clients">Backlog client</span>
          <span class="pill p-n" id="chip-fourn">Backlog fournisseur</span>
          <span class="pill p-n" id="chip-stock">Stock</span>
        </div>
        <div class="pil-bar" id="pbarFile"><i></i></div>
        <div class="pil-status" id="pstatusFile"></div>
      </div>
      <div class="pil-card" style="margin-top:14px">
        <details class="rules">
          <summary>Règles de calcul appliquées</summary>
          <ul>
            <li><b>Périmètre</b> — réseaux Wholesale France et International uniquement ; samples (SMS / SPL) exclus.</li>
            <li><b>Sources fournisseur retenues</b> — lignes « BL Fournisseur » (en production) et transferts partis de WSFCN / WDTTH (hubs Asie).</li>
            <li><b>ETA</b> = date IC + <b>80 jours</b> de transit (fournisseur I.K.S. : 30 jours). Si la date de départ est absente : date IC estimée = date de la PO + 3 mois.</li>
            <li><b>Couverture d'une ligne</b>, dans l'ordre : 1) stock du site du client (statut A1) ; 2) stock des hubs Asie (ETA = aujourd'hui + 80 j) ; 3) PO fournisseur par ETA croissante ; 4) le reste est <b>à annuler</b>.</li>
            <li><b>FFOB</b> — commandes dont le site est WSFCN, WDTTH ou WFIFR : date XF fait foi, stock hub disponible immédiatement.</li>
            <li><b>Statut commande</b> — % en retard = qté retard ÷ (à temps + retard) : 🟢 On time si 0 %, 🔴 Critique si ≥ 50 %, 🟠 Partiellement en retard entre les deux. Si aucune source et collection FW26 lancée : ⚫ À annuler.</li>
          </ul>
        </details>
      </div>
    </div>

    <!-- App (masquée jusqu'au chargement) -->
    <div id="pil-app" class="hide">
      <div class="pil-section">
        <div class="ey">Synthèse direction — vue d'ensemble</div>
        <div class="kpis" id="kpis"></div>
      </div>

      <div class="pil-section">
        <div class="grid2">
          <div class="pil-card">
            <div style="padding:13px 16px;border-bottom:1px solid var(--line);font-weight:800;font-size:13px">Ponctualité des livraisons</div>
            <div class="tw" style="max-height:none"><table id="tPonct"></table></div>
          </div>
          <div class="pil-card">
            <div style="padding:13px 16px;border-bottom:1px solid var(--line);font-weight:800;font-size:13px">Répartition France / International</div>
            <div class="tw" style="max-height:none"><table id="tRepart"></table></div>
          </div>
        </div>
      </div>

      <div class="pil-section">
        <div class="grid2">
          <div class="pil-card">
            <div style="padding:13px 16px;border-bottom:1px solid var(--line);font-weight:800;font-size:13px">Top 5 clients — Wholesale France</div>
            <div class="tw" style="max-height:none"><table id="tTopFR"></table></div>
          </div>
          <div class="pil-card">
            <div style="padding:13px 16px;border-bottom:1px solid var(--line);font-weight:800;font-size:13px">Top 5 clients — International</div>
            <div class="tw" style="max-height:none"><table id="tTopINT"></table></div>
          </div>
        </div>
      </div>

      <div class="pil-section">
        <div class="ey">Pilotage livraisons — une ligne par commande <span style="text-transform:none;letter-spacing:0;font-weight:600">(cliquez une commande pour voir son détail et ses PO)</span></div>
        <div class="pil-card">
          <div class="toolbar">
            <input type="search" id="fSearch" placeholder="Rechercher un client, une commande, une PO…">
            <select id="fCat"><option value="">Toutes catégories</option></select>
            <select id="fStat"><option value="">Tous statuts</option></select>
            <select id="fColl"><option value="">Toutes collections</option></select>
            <label style="font-size:12px;color:var(--soft);display:flex;align-items:center;gap:6px"><input type="checkbox" id="fCancel"> Avec qté à annuler</label>
            <div class="sp"></div>
            <span class="count" id="cPil"></span>
            <button class="pil-btn" id="btnCsvPil">Export CSV</button>
          </div>
          <div class="tw"><table id="tPil"></table></div>
          <div class="pager" id="pgPil"></div>
        </div>
      </div>

      <div class="pil-section">
        <div class="ey">Détail par article</div>
        <div class="pil-card">
          <div class="toolbar">
            <input type="search" id="dSearch" placeholder="Rechercher un SKU, une commande, un client…">
            <select id="dStat"><option value="">Tous statuts</option></select>
            <div class="sp"></div>
            <span class="count" id="cDet"></span>
            <button class="pil-btn" id="btnCsvDet">Export CSV</button>
          </div>
          <div class="tw"><table id="tDet"></table></div>
          <div class="pager" id="pgDet"></div>
        </div>
      </div>
    </div>{# /#pil-app #}

    <div class="pil-foot">le coq sportif · pilotage livraisons — données live depuis l'ERP</div>
  </div>{# /.pil-main #}
</div>{# /.pilotage-wrap #}

<div class="ov" id="ov"></div>
<aside id="pil-drawer">
  <div class="dhead">
    <div style="flex:1">
      <h3 id="dTitle">—</h3>
      <div class="m" id="dMeta"></div>
    </div>
    <button class="pil-btn ghost" id="dClose">✕</button>
  </div>
  <div class="dbody">
    <div class="dgrid" id="dKpi"></div>
    <div class="ey">Sources — PO fournisseur et stock</div>
    <div class="pil-card" style="margin-bottom:18px"><div class="tw" style="max-height:none"><table id="dSrc"></table></div></div>
    <div class="ey">Lignes de la commande</div>
    <div class="pil-card"><div class="tw" style="max-height:none"><table id="dLines"></table></div></div>
  </div>
</aside>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function(){
"use strict";

/* ── Routes API ─────────────────────────────────────────────────────────── */
const URL_CLIENT = '{{ path('app_pilotage_backlog_client_json') }}';
const URL_FOURN  = '{{ path('app_pilotage_backlog_fournisseur_json') }}';
const URL_STOCK  = '{{ path('app_pilotage_stock_json') }}';

/* ── Constantes / règles (identiques à l'outil PM) ──────────────────────── */
const R={TRANSIT:80,TRANSIT_IKS:30,XF_DEF:90,
  COLLECTIONS:['2026-02-FW','2027-01-SS','2027-02-FW'],
  COLL_PROD_LANCEE:['2026-02-FW'],
  HUBS:['WSFCN','WDTTH'],DIRECT:'WFIFR',FFOB_SITES:['WSFCN','WDTTH','WFIFR'],SAMPLE:/_(SMS|SPL)/i};
const DAY=86400000;
let TODAY=new Date(); TODAY.setHours(0,0,0,0);

/* ── Utilitaires ─────────────────────────────────────────────────────────── */
const norm=s=>String(s==null?'':s).normalize('NFD').replace(/[̀-ͯ]/g,'').toUpperCase().replace(/\s+/g,' ').trim();
const nf=new Intl.NumberFormat('fr-FR');
const ef=new Intl.NumberFormat('fr-FR',{style:'currency',currency:'EUR',maximumFractionDigits:0});
const fmtN=v=>v==null||isNaN(v)?'':nf.format(Math.round(v));
const fmtE=v=>v==null||isNaN(v)?'':ef.format(v);
const fmtP=v=>v==null||isNaN(v)?'':Math.round(v*100)+'%';
const fmtD=d=>!d?'':String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+'/'+d.getFullYear();
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const addD=(d,n)=>d?new Date(d.getTime()+n*DAY):null;
const diffD=(a,b)=>(a&&b)?Math.round((a-b)/DAY):null;

function toDate(v){
  if(v==null||v==='')return null;
  if(v instanceof Date)return isNaN(v)?null:new Date(v.getFullYear(),v.getMonth(),v.getDate());
  if(typeof v==='number'){const d=new Date(Date.UTC(1899,11,30)+v*DAY);return isNaN(d)?null:new Date(d.getUTCFullYear(),d.getUTCMonth(),d.getUTCDate());}
  const s=String(v).trim();
  let m=s.match(/^(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{2,4})/);
  if(m){let y=+m[3];if(y<100)y+=2000;return new Date(y,+m[2]-1,+m[1]);}
  m=s.match(/^(\d{4})[\-\/](\d{1,2})[\-\/](\d{1,2})/);
  if(m)return new Date(+m[1],+m[2]-1,+m[3]);
  const d=new Date(s);return isNaN(d)?null:new Date(d.getFullYear(),d.getMonth(),d.getDate());
}
const toNum=v=>{if(v==null||v==='')return 0;if(typeof v==='number')return v;
  const n=parseFloat(String(v).replace(/\s/g,'').replace(',','.'));return isNaN(n)?0:n;};

function colMap(row){const m={};for(const k in row)m[norm(k)]=k;return m;}
const G=(row,map,...names)=>{for(const n of names){const k=map[norm(n)];if(k!==undefined&&row[k]!=null&&row[k]!=='')return row[k];}return null;};

/* ── État ───────────────────────────────────────────────────────────────── */
const S={clients:null,fourn:null,stock:null,detail:[],orders:[],srcByOrder:new Map(),
  pilPage:0,detPage:0,pilSort:{k:'eur',dir:-1},PER:150};

/* ── Barre de progression ───────────────────────────────────────────────── */
function prog(p,txt){
  const b=document.getElementById('pbar');
  b.classList.add('on');
  b.querySelector('i').style.width=(p*100)+'%';
  document.getElementById('pstatus').textContent=txt||'';
}

/* ── Chargement via API ─────────────────────────────────────────────────── */
document.getElementById('btnLoad').addEventListener('click', async function(){
  const selected=Array.from(document.getElementById('pil-collections').selectedOptions).map(o=>o.value);
  if(!selected.length){prog(0,'Veuillez sélectionner au moins une collection.');return;}
  this.disabled=true;
  prog(.05,'Connexion à l\'ERP…');
  const params=selected.map(c=>'collections[]='+encodeURIComponent(c)).join('&');
  try{
    prog(.1,'Chargement du backlog client…');
    const [clientData,fournData,stockData]=await Promise.all([
      fetch(URL_CLIENT+'?'+params).then(r=>{if(!r.ok)throw new Error('Backlog client : HTTP '+r.status);return r.json();}),
      fetch(URL_FOURN).then(r=>{if(!r.ok)throw new Error('Backlog fournisseur : HTTP '+r.status);return r.json();}),
      fetch(URL_STOCK).then(r=>{if(!r.ok)throw new Error('Stock : HTTP '+r.status);return r.json();}),
    ]);
    prog(.35,'Données reçues — '+fmtN(clientData.length)+' lignes client, '+fmtN(fournData.length)+' lignes fourn., '+fmtN(stockData.length)+' références stock…');
    S.clients=clientData; S.fourn=fournData; S.stock=stockData;
    setTimeout(compute,60);
  }catch(err){
    prog(0,'Erreur : '+err.message);
    this.disabled=false;
  }
});

