/* ---------- PILOTAGES ---------- */
function pilRows(mod){
  const rows=mod==='pfr'?S.pfr:S.pint, f=S.filters[mod]||{};
  return rows.filter(r=>{
    if(f.coll&&r[C.COLL]!==f.coll)return false;
    if(f.stat&&r[C.STAT]!==f.stat)return false;
    if(f.src&&r[C.SRC]!==f.src)return false;
    if(f.grp&&r[C.GRP]!==f.grp)return false;
    if(f.rep&&r[C.REP]!==f.rep)return false;
    if(f.ponc){
      if(f.ponc==='ontime'&&!((r[C.QOT]||0)>0&&(r[C.QLATE]||0)===0&&(r[C.QCANC]||0)===0))return false;
      if(f.ponc==='late'&&!((r[C.QLATE]||0)>0))return false;
      if(f.ponc==='canc'&&!((r[C.QCANC]||0)>0))return false;
      if(f.ponc==='subst'&&!((r[C.SUBQ]||0)>0))return false;
      if(f.ponc==='echu'&&!((r[C.RECHU]||0)>0))return false;
    }
    if(f.win){const t=pdate(r[C.DDEM]);const now=new Date();now.setHours(0,0,0,0);
      const lim=now.getTime()+(+f.win)*86400000;
      if(t==null||t<now.getTime()||t>lim)return false;
      const st=String(r[C.STAT]||''); if(!(st.includes('🟡')||st.includes('⚪')))return false;}
    if(f.etaw){const w0=pdate(f.etaw),t=pdate(r[C.ETAC]);
      if(w0==null||t==null||t<w0||t>=w0+7*86400000)return false;}
    if(f.q){const q=f.q.toLowerCase();
      const hay=[r[C.ORD],r[C.CLI],r[C.MAG],r[C.VILLE],r[C.REF],r[C.CODC],r[C.GRP],r[C.PO],r[C.REP]].map(x=>String(x||'').toLowerCase()).join('¦');
      if(!hay.includes(q))return false;}
    return true;
  });
}
function renderPil(mod){
  const p=$('#p-'+mod), rows=mod==='pfr'?S.pfr:S.pint, H=S.heads[mod];
  const f=S.filters[mod]||{};
  const colls=[...new Set(rows.map(r=>r[C.COLL]))].sort();
  const stats=[...new Set(rows.map(r=>r[C.STAT]))].sort();
  const srcs=[...new Set(rows.map(r=>r[C.SRC]))].filter(Boolean).sort();
  const grps=[...new Set(rows.map(r=>r[C.GRP]))].filter(Boolean).sort();
  const reps=[...new Set(rows.map(r=>r[C.REP]))].filter(Boolean).sort();
  p.innerHTML=`
  <div class="fbar">
    <div class="fg"><label>Recherche</label><input type="text" data-f="q" placeholder="N° commande, client, ville, PO, réf…"></div>
    <div class="fg"><label>Collection</label><select data-f="coll">${selOpt(colls,'Toutes')}</select></div>
    <div class="fg"><label>Statut</label><select data-f="stat">${selOpt(stats,'Tous')}</select></div>
    <div class="fg"><label>Ponctualité</label><select data-f="ponc"><option value="">Toutes</option>
      <option value="ontime">100 % à temps</option><option value="late">Avec retard</option>
      <option value="canc">Avec annulation</option><option value="subst">Avec substituables</option></select></div>
    <div class="fg"><label>Source</label><select data-f="src">${selOpt(srcs,'Toutes')}</select></div>
    <div class="fg"><label>Groupement</label><select data-f="grp">${selOpt(grps,'Tous')}</select></div>
    <div class="fg"><label>Représentant</label><select data-f="rep">${selOpt(reps,'Tous')}</select></div>
    <div class="sp"></div><div data-chips></div>
    <button class="btn ghost" data-tog>${S.full[mod]?'Vue synthèse':'Vue complète'}</button>
    <button class="btn" data-exp>⬇ Export vue filtrée</button>
  </div>
  <div class="mut" data-count style="margin:-4px 0 8px 4px"></div>
  <div class="twrap"><table data-tbl></table></div>
  <div class="pgn" data-pgn></div>`;
  syncBar('#p-'+mod,mod);
  bindBar('#p-'+mod,mod,()=>renderPilTable(mod));
  p.querySelector('[data-tog]').onclick=()=>{S.full[mod]=!S.full[mod];renderPil(mod);renderPilTable(mod);};
  p.querySelector('[data-exp]').onclick=()=>exportPil(mod);
  renderPilTable(mod);
}
function pilCols(mod){
  if(S.full[mod])return S.heads[mod].map((h,i)=>i);
  const base=[C.COLL,C.CLI,C.ORD,C.Q,C.DISPO,C.PC,C.STAT,C.SYN,C.ETA1,C.ETAC,C.DDEM,C.MT,RPREV(mod),C.SUBQ];
  return base;
}
function renderPilTable(mod){
  const p=$('#p-'+mod);
  let rows=pilRows(mod);
  const cols=pilCols(mod), H=S.heads[mod];
  const st=S.sort[mod];
  if(st){rows=[...rows].sort((a,b)=>{const x=a[st.i],y=b[st.i];
    if(x==null&&y==null)return 0;if(x==null)return 1;if(y==null)return -1;
    const c=typeof x==='number'&&typeof y==='number'?x-y:String(x).localeCompare(String(y),'fr');
    return st.d?-c:c;});}
  const per=100, pg=S.page[mod]||0, npg=Math.max(1,Math.ceil(rows.length/per));
  const view=rows.slice(pg*per,(pg+1)*per);
  const totQ=rows.reduce((s,r)=>s+(r[C.Q]||0),0), totM=rows.reduce((s,r)=>s+(r[C.MT]||0),0);
  p.querySelector('[data-count]').textContent=`${nf.format(rows.length)} commandes · ${nf.format(totQ)} pcs · ${nf2.format(totM)} € — clique sur une commande pour le détail`;
  p.querySelector('[data-chips]').innerHTML=chipHtml(mod,()=>{renderPil(mod);});
  bindChips('#p-'+mod,mod,()=>{renderPil(mod);});
  const th=cols.map(i=>`<th data-i="${i}">${esc(H[i]||'')}${st&&st.i===i?`<span class="arr"> ${st.d?'▼':'▲'}</span>`:''}</th>`).join('');
  const td=(r,i)=>{
    const v=r[i];
    if(i===C.STAT)return `<td><span class="badge ${statCls(v)}">${esc(v)}</span></td>`;
    if(i===C.SYN)return `<td class="syn">${esc(v)}</td>`;
    if(i===C.MT)return `<td class="num">${fmtE(v)}</td>`;
    if(i===C.PC||i===C.PCANC||i===PCT(mod))return `<td class="num">${fmtPct(v)}</td>`;
    if(i===C.ETA1||i===C.ETAC||i===C.DDEM||i===C.DCMD||(i>=C.A1T&&i<=C.A2R))return `<td>${fmtD(v)}</td>`;
    if(i===RPREV(mod)||i===C.RECHU){if(v==null||v==='')return '<td></td>';
      return `<td class="num ${v>0?'late':'early'}">${v>0?'+':''}${fmt(v)} j</td>`;}
    if(i===C.SUBQ)return v>0?`<td class="num"><span class="substTag" data-sub="${esc(r[C.ORD])}">🔁 ${fmt(v)}</span></td>`:'<td class="num"></td>';
    if(typeof v==='number')return `<td class="num">${fmt(v)}</td>`;
    return `<td>${esc(v)}</td>`;
  };
  p.querySelector('[data-tbl]').innerHTML=`<thead><tr>${th}</tr></thead><tbody>`+
    view.map(r=>`<tr class="click" data-ord="${esc(r[C.ORD])}">${cols.map(i=>td(r,i)).join('')}</tr>`).join('')+'</tbody>';
  p.querySelectorAll('thead th').forEach(h=>h.onclick=()=>{const i=+h.dataset.i;
    S.sort[mod]=st&&st.i===i?{i,d:!st.d}:{i,d:false};renderPilTable(mod);});
  p.querySelectorAll('tbody tr[data-ord]').forEach(tr=>tr.onclick=e=>{
    if(e.target.dataset.sub){goSubst(e.target.dataset.sub,mod==='pfr'?'FR':'IN');e.stopPropagation();return;}
    openDrawer(tr.dataset.ord,mod);});
  p.querySelector('[data-pgn]').innerHTML=`<button ${pg===0?'disabled':''} data-pp>◀ Précédent</button>
    Page ${pg+1} / ${npg} <button ${pg>=npg-1?'disabled':''} data-pn>Suivant ▶</button>`;
  const pp=p.querySelector('[data-pp]'),pn=p.querySelector('[data-pn]');
  if(pp)pp.onclick=()=>{S.page[mod]=pg-1;renderPilTable(mod);};
  if(pn)pn.onclick=()=>{S.page[mod]=pg+1;renderPilTable(mod);};
}

/* ---------- TIROIR COMMANDE ---------- */
let curOrd=null,curMod=null;
function openDrawer(ord,mod){
  curOrd=ord;curMod=mod;
  const rows=mod==='pfr'?S.pfr:S.pint;
  const r=rows.find(x=>x[C.ORD]===ord); if(!r)return;
  const det=(mod==='pfr'?S.detFR:S.detIN)[ord]||[];
  const sub=(mod==='pfr'?S.subFR:S.subIN).rows.filter(s=>s[0]===ord);
  $('#dTitle').textContent=ord+' — '+(r[C.CLI]||'');
  $('#dStat').innerHTML=`<span class="badge ${statCls(r[C.STAT])}">${esc(r[C.STAT])}</span>`;
  const it=(k,v)=>v==null||v===''?'':`<div class="it"><div class="k">${k}</div><div class="v">${v}</div></div>`;
  const rp=r[RPREV(mod)];
  $('#dBody').innerHTML=`
   <div class="synbox">${esc(r[C.SYN])}</div>
   <div class="dact">
     <button class="btn gold" id="dExp">⬇ Détail commande (Excel)</button>
     ${sub.length?`<button class="btn" id="dSub">🔁 Substitutions possibles (${sub.length} lignes · ${fmt(r[C.SUBQ])} pcs)</button>`:''}
     <button class="btn ghost" id="dCsv">⬇ Lignes (CSV)</button>
   </div>
   <div class="kv">
    ${it('Qté restante à livrer',fmt(r[C.Q])+' pcs')}
    ${it(mod==='pfr'?'Dispo Logtex (allouées)':'Dispo SF/DT (allouées)',fmt(r[C.DISPO])+' pcs · '+fmtPct(r[C.PC]))}
    ${it('Montant',fmtE(r[C.MT]))}
    ${it('À temps / retard / annulé',fmt(r[C.QOT])+' / '+fmt(r[C.QLATE])+' / '+fmt(r[C.QCANC]))}
    ${it('Alloué stock / prod',fmt(r[C.ASTK])+' / '+fmt(r[C.APROD])+' ('+esc(r[C.SRC]||'')+')')}
    ${it('Date demandée',fmtD(r[C.DDEM]))}
    ${it('ETA prochaine arrivée',fmtD(r[C.ETA1]))}
    ${it('ETA commande complète',fmtD(r[C.ETAC]))}
    ${it('Retard échu (vs aujourd\u2019hui)',r[C.RECHU]!=null&&r[C.RECHU]!==''?fmt(r[C.RECHU])+' j':'')}
    ${it('Retard prévisionnel (ETA vs demandée)',rp!=null&&rp!==''?(rp>0?'+':'')+fmt(rp)+' j':'')}
    ${mod==='pfr'?it('% couverture à terme',fmtPct(r[PCT(mod)])):''}
    ${it('Fenêtre à temps',r[C.A1T]?fmtD(r[C.A1T])+' → '+fmtD(r[C.A2T]):'')}
    ${it('Fenêtre retard',r[C.A1R]?fmtD(r[C.A1R])+' → '+fmtD(r[C.A2R]):'')}
    ${it('PO rattachés',esc(r[C.PO]))}
   </div>
   <h2 class="sec" style="margin-top:4px">Client</h2>
   <div class="kv">
    ${it('Client facturé',esc(r[C.CLI]))}${it('Magasin / client cmd',esc(r[C.MAG]))}
    ${it('Réf. cmd client',esc(r[C.REF]))}${it('Code client',esc(r[C.CODC]))}
    ${it('Groupement',esc(r[C.GRP])+(r[C.GRPC]?' ('+esc(r[C.GRPC])+')':''))}
    ${it('Code magasin',esc(r[C.CODM]))}${it('Ville livraison',esc(r[C.VILLE]))}
    ${it('Représentant',esc(r[C.REP]))}${it('Date commande',fmtD(r[C.DCMD]))}
    ${it('Collection',esc(r[C.COLL]))}${it('Catégorie',esc(r[C.CAT]))}
   </div>
   <h2 class="sec">Détail par article (${det.length} lignes)</h2>
   <div class="mut" id="dSum" style="margin:-3px 0 8px"></div>
   <div class="fbar"><div class="fg"><label>Filtrer</label><input type="text" id="dQ" placeholder="SKU, désignation, source…"></div>
    <div class="fg"><label>Ligne</label><select id="dF"><option value="">Toutes</option><option value="arr">En arrivage</option><option value="ot">À temps</option><option value="late">Retard</option><option value="canc">Annulé</option></select></div></div>
   <div class="twrap" style="max-height:46vh"><table id="dTbl"></table></div>`;
  /* découpe des sources : ce qui est déjà au départ (Logtex en France, SF/DT à l'international)
     contre ce qui est encore en arrivage, avec sa date */
  const dispoRx=mod==='pfr'?/^Stock Logtex/:/^Stock (SF|DT)/;
  const segs=str=>String(str||'').split(';').map(t=>t.trim()).filter(Boolean).map(t=>{
    const m=/·\s*([\d,]+)\s*pcs\s*·\s*(\d{2})\/(\d{2})\/(\d{4})/.exec(t);
    return m?{txt:t,q:parseInt(m[1].replace(/,/g,''),10),ts:new Date(+m[4],+m[3]-1,+m[2]).getTime(),d:m[2]+'/'+m[3]+'/'+m[4],dispo:dispoRx.test(t)}:null;
  }).filter(Boolean);
  const parsed=det.map(l=>{const sg=segs(l[4]);
    const dq=sg.filter(x=>x.dispo).reduce((a,x)=>a+x.q,0);
    const ar=sg.filter(x=>!x.dispo);
    return {sg,dq,aq:ar.reduce((a,x)=>a+x.q,0),amin:ar.length?Math.min(...ar.map(x=>x.ts)):null};});
  const totD=parsed.reduce((a,x)=>a+x.dq,0),totA=parsed.reduce((a,x)=>a+x.aq,0);
  const amins=parsed.filter(x=>x.amin!=null).map(x=>x.amin);
  const fmtTs=t=>{const d=new Date(t);return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+'/'+d.getFullYear();};
  $('#dSum').textContent=fmt(totD)+' pcs déjà '+(mod==='pfr'?'à Logtex':'en SF/DT')
    +(totA?' · '+fmt(totA)+' pcs en arrivage (première le '+fmtTs(Math.min(...amins))+')':' · rien en arrivage');
  const dispoLab=mod==='pfr'?'Dispo Logtex':'Dispo SF/DT';
  const srcHtml=sg=>sg.map(x=>x.dispo?esc(x.txt):`<span class="segArr">${esc(x.txt)}</span>`).join('<span class="mut"> ; </span>');
  const draw=()=>{
    const q=($('#dQ').value||'').toLowerCase(), ff=$('#dF').value;
    let lines=det.map((l,i)=>[l,parsed[i]]).filter(([l,p])=>{
      if(q&&!(String(l[0]).toLowerCase().includes(q)||String(l[1]||'').toLowerCase().includes(q)||String(l[4]||'').toLowerCase().includes(q)))return false;
      if(ff==='ot'&&!(l[5]>0))return false; if(ff==='late'&&!(l[6]>0))return false; if(ff==='canc'&&!(l[7]>0))return false;
      if(ff==='arr'&&!(p.aq>0))return false;
      return true;});
    $('#dTbl').innerHTML=`<thead><tr><th>SKU</th><th>Désignation</th><th>Qté</th><th>Allouée</th><th>${dispoLab}</th><th>En arrivage</th><th>Sources → arrivées</th><th>À temps</th><th>Retard</th><th>Annulé</th></tr></thead><tbody>`+
     lines.map(([l,p])=>`<tr><td><b>${esc(l[0])}</b></td><td style="white-space:normal">${esc(l[1])}</td><td class="num">${fmt(l[2])}</td><td class="num">${fmt(l[3])}</td>`+
      `<td class="num">${p.dq?fmt(p.dq):''}</td>`+
      `<td class="num">${p.aq?`<span class="arrq">${fmt(p.aq)}</span><div class="mut" style="font-size:10.5px">dès le ${fmtTs(p.amin)}</div>`:''}</td>`+
      `<td style="white-space:normal;max-width:330px">${srcHtml(p.sg)}</td>`+
      `<td class="num ${l[5]>0?'early':''}">${fmt(l[5])}</td><td class="num ${l[6]>0?'late':''}">${fmt(l[6])}</td><td class="num ${l[7]>0?'late':''}">${fmt(l[7])}</td></tr>`).join('')+'</tbody>';
  };
  $('#dQ').oninput=draw;$('#dF').onchange=draw;draw();
  $('#dExp').onclick=()=>exportOrder(ord,mod);
  $('#dCsv').onclick=()=>{
    const head=['N° COMMANDE','SKU','DÉSIGNATION','QTÉ','ALLOUÉE','DISPO','EN ARRIVAGE','1RE ARRIVÉE','SOURCES → ARRIVÉES','À TEMPS','RETARD','ANNULÉ'];
    const csv=[head.join(';'),...det.map((l,i)=>[ord,l[0],l[1],l[2],l[3],parsed[i].dq,parsed[i].aq,parsed[i].amin?fmtTs(parsed[i].amin):'',l[4],l[5],l[6],l[7]].map(x=>'"'+String(x??'').replace(/"/g,'""')+'"').join(';'))].join('\r\n');
    dlBlob(new Blob(['\ufeff'+csv],{type:'text/csv'}),`Detail_${ord}.csv`);
  };
  const ds=$('#dSub'); if(ds)ds.onclick=()=>{closeDrawer();goSubst(ord,mod==='pfr'?'FR':'IN');};
  $('#ovl').style.display='block';$('#drawer').classList.add('open');
}
function closeDrawer(){$('#ovl').style.display='none';$('#drawer').classList.remove('open');}

