  $('#fdate').textContent=d.fileDate; $('#srcMode').textContent=' '+label;
  S.filters={pfr:{},pint:{},subst:{},rest:{},macro:{}}; S.sort={}; S.page={pfr:0,pint:0,subst:0,rest:0};
  PIL.classList.add('has-data');
  S._autoRun=false;
  renderAll();
}
function renderAll(){renderMacro();renderPil('pfr');renderPil('pint');renderSubst();renderRest();renderArr();renderMeth();}


/* ---------- Arrivées par semaine (Logtex/France vs Asie) ---------- */
function flowFromDetails(){
  /* classeur rechargé : on reconstruit le flux depuis les détails de sources */
  const out=[],rx=/·\s*([\d,]+)\s*pcs\s*·\s*(\d{2})\/(\d{2})\/(\d{4})/;
  const scan=(det,m)=>{for(const k in det){const s=det[k];if(!s)continue;
    for(const seg of String(s).split(';')){const mm=rx.exec(seg);if(!mm)continue;
      const q=parseInt(mm[1].replace(/,/g,''),10);
      const t=new Date(+mm[4],+mm[3]-1,+mm[2]).getTime();
      const asie=/SF|DT|Asie|Chine|Tha/i.test(seg)?1:0;
      out.push([m,t,asie,q,/PO\s/.test(seg)?1:0]);}}};
  scan(S.detFR||{},0);scan(S.detIN||{},1);
  return out;
}
function renderArr(){
  const p=$('#p-arr');if(!p)return;
  let flow=S.arrFlow&&S.arrFlow.length?S.arrFlow:flowFromDetails();
  if(!flow.length){p.innerHTML='<div class="note">Aucun flux d\u2019arrivée : lance un calcul depuis les 3 fichiers sources.</div>';return;}
  const f=S.filters.arr||(S.filters.arr={mod:'0'});
  const modSel=f.mod==null?'0':f.mod;
  const rows=flow.filter(r=>String(r[0])===modSel);
  /* agrégat par semaine (lundi) */
  const wk=t=>{const d=new Date(t);d.setHours(0,0,0,0);return d.getTime()-((d.getDay()+6)%7)*86400000;};
  const by={};let totF=0,totA=0;
  for(const [,t,asie,q] of rows){const w=wk(t);(by[w]=by[w]||[0,0])[asie]+=q;if(asie)totA+=q;else totF+=q;}
  let weeks=Object.keys(by).map(Number).sort((a,b)=>a-b);
  if(weeks.length){/* semaines vides comprises, pour ne pas déformer la frise */
    const all=[];for(let w=weeks[0];w<=weeks[weeks.length-1];w=wk(w+7.5*86400000)){all.push(w);by[w]=by[w]||[0,0];}
    weeks=all;}
  if(!weeks.length){p.innerHTML='<div class="note">Rien à afficher pour ce module.</div>';return;}
  const isoW=t=>{const d=new Date(t);const th=new Date(d);th.setDate(d.getDate()+3);
    const y0=new Date(th.getFullYear(),0,1);return 'S'+String(Math.ceil(((th-y0)/86400000+1)/7)).padStart(2,'0');};
  const dd=t=>{const d=new Date(t);return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0');};
  const max=Math.max(...weeks.map(w=>by[w][0]+by[w][1]));
  /* barres empilées en SVG */
  const BW=34,GAP=12,H=230,PADL=52,PADB=34,PADT=12;
  const width=PADL+weeks.length*(BW+GAP)+10;
  const y=v=>PADT+(H-PADT-PADB)*(1-v/max);
  let g='';
  const grid=4;for(let i=0;i<=grid;i++){const v=max*i/grid,yy=y(v);
    g+=`<line x1="${PADL-4}" y1="${yy}" x2="${width}" y2="${yy}" stroke="var(--line2)"/>`+
       `<text x="${PADL-8}" y="${yy+4}" text-anchor="end" font-size="10" fill="var(--mut)">${nf.format(Math.round(v))}</text>`;}
  weeks.forEach((w,i)=>{const [fr,as]=by[w];const x=PADL+i*(BW+GAP);
    const yF=y(fr),yA=y(fr+as);
    g+=`<g><title>${isoW(w)} — semaine du ${dd(w)} : ${nf.format(fr)} pcs France · ${nf.format(as)} pcs Asie</title>`+
       (fr?`<rect x="${x}" y="${yF}" width="${BW}" height="${y(0)-yF}" fill="var(--gold)" rx="2"/>`:'')+
       (as?`<rect x="${x}" y="${yA}" width="${BW}" height="${yF-yA}" fill="#5b6572" rx="2"/>`:'')+
       `</g><text x="${x+BW/2}" y="${H-PADB+14}" text-anchor="middle" font-size="10" fill="var(--ink2)" font-weight="600">${isoW(w)}</text>`+
       `<text x="${x+BW/2}" y="${H-PADB+26}" text-anchor="middle" font-size="9.5" fill="var(--mut)">${dd(w)}</text>`;});
  /* tableau récapitulatif avec cumul */
  let cum=0;const tot=totF+totA;
  const trows=weeks.map(w=>{const [fr,as]=by[w];cum+=fr+as;
    return `<tr><td>${isoW(w)} — du ${dd(w)}</td><td class="num">${nf.format(fr)}</td><td class="num">${nf.format(as)}</td>`+
           `<td class="num"><b>${nf.format(fr+as)}</b></td><td class="num">${nf.format(cum)}</td>`+
           `<td class="num">${tot?Math.round(100*cum/tot):0} %</td></tr>`;}).join('');
  p.innerHTML=`
  <div class="fbar">
    <div class="fg"><label>Module</label>
      <select data-f="mod"><option value="0">France (+ réseaux domestiques)</option><option value="1">International</option></select></div>
    <div class="sp"></div>
    <button class="btn ghost" id="arrXls">&#8595; Export Excel</button>
  </div>
  <div class="cards">
    <div class="card v"><div class="lab">Arrivées France / Logtex</div><div class="val">${nf.format(totF)} pcs</div><div class="det">stock + PO vers sites FR</div></div>
    <div class="card n"><div class="lab">Arrivées via Asie</div><div class="val">${nf.format(totA)} pcs</div><div class="det">SF / DT / autres Asie</div></div>
    <div class="card"><div class="lab">Étalement</div><div class="val">${weeks.length} semaines</div><div class="det">du ${dd(weeks[0])} au ${dd(weeks[weeks.length-1])}</div></div>
  </div>
  <div class="arrchart">
    <div class="arrleg"><span><i style="background:var(--gold)"></i>France / Logtex</span><span><i style="background:#5b6572"></i>Asie (SF/DT)</span></div>
    <svg width="${width}" height="${H}" viewBox="0 0 ${width} ${H}">${g}</svg>
  </div>
  <div class="twrap" style="max-height:420px"><table>
    <thead><tr><th>Semaine</th><th>France / Logtex</th><th>Asie</th><th>Total</th><th>Cumul</th><th>% du flux</th></tr></thead>
    <tbody>${trows}</tbody></table></div>`;
  bindBar('#p-arr','arr',renderArr);
  $('#arrXls').onclick=()=>{let c=0;
    dlWb('Arrivees_par_semaine',[['ARRIVEES '+(modSel==='0'?'FRANCE':'INTL'),
      [['SEMAINE','FRANCE/LOGTEX','ASIE','TOTAL','CUMUL'],
       ...weeks.map(w=>{const[fr,as]=by[w];c+=fr+as;return [isoW(w)+' — '+dd(w),fr,as,fr+as,c];})]]]);};
}


/* ---------- « À pousser maintenant » : détail + export Excel ---------- */
function pushRows(){
  /* commandes 100 % dispo, dans le périmètre filtré de la Macro View */
  const {fr,int}=macroRows();
  return [...fr,...int].filter(r=>String(r[C.STAT]||'').includes('🟢'));
}
function pushLines(rows){
  /* une ligne par commande × SKU, toutes infos client et produit */
  const out=[];
  rows.forEach(r=>{
    const mod=fr_has(r)?'pfr':'pint';
    const det=(mod==='pfr'?S.detFR:S.detIN)[r[C.ORD]]||[];
    const nl=det.length||1;
    if(!det.length){out.push({r,mod,sku:'',des:'',q:r[C.Q]||0,al:r[C.Q]||0,src:'',nl});return;}
    det.forEach(l=>out.push({r,mod,sku:l[0],des:l[1],q:l[2]||0,al:l[3]||0,src:l[4]||'',nl}));
  });
  return out;
}
function fr_has(r){return S.pfr.indexOf(r)>=0;}
