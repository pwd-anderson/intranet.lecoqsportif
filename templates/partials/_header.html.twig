<header class="main-header">
    <div class="d-flex align-items-center logo-box justify-content-start">
        <a href="{{ path('app_home') }}" class="logo">
            <!-- logo-->
            <div class="logo-mini w-70">
                <img src="{{ asset('assets/images/logo_main.png') }}" alt="logo">
            </div>
            <div class="logo-lg p-2">
                <img src="{{ asset('assets/images/logo_3.png') }}" alt="logo">
            </div>
        </a>
    </div>

    <nav class="navbar navbar-static-top">
        <div class="app-menu">
            <ul class="header-megamenu nav">
                <li class="btn-group nav-item">
                    <a href="#" class="waves-effect waves-light nav-link push-btn btn-outline no-border" data-toggle="push-menu" role="button">
                        <img src="{{ asset('assets/images/svg-icon/collapse.svg') }}" class="img-fluid svg-icon" alt="">
                    </a>
                </li>

                {% set _route = app.request.attributes.get('_route') %}

                {% if _route == 'app_home' %}
                    <li class="nav-item dropdown d-flex align-items-center me-3">
                        <form id="network-switcher">
                            <select name="network" class="form-select form-select-sm" style="width: auto;">
                                {% if not is_stat_excluded('dashboard_filter_global') %}<option value="global">Global</option>{% endif %}
                                {% if not is_stat_excluded('dashboard_filter_boutique') %}<option value="boutique">Boutique</option>{% endif %}
                                {% if not is_stat_excluded('dashboard_filter_ecom') %}<option value="ecom">E-com</option>{% endif %}
                                {% if not is_stat_excluded('dashboard_filter_wholesale_fr') %}<option value="wholesale_fr">Wholesale France</option>{% endif %}
                                {% if not is_stat_excluded('dashboard_filter_wholesale_eu') %}<option value="wholesale_eu">Wholesale Europe</option>{% endif %}
                                {% if not is_stat_excluded('dashboard_filter_wholesale_int') %}<option value="wholesale_int">Distributeur International</option>{% endif %}
                            </select>
                        </form>
                    </li>
                {% endif %}

                {% if _route in ['app_home', 'app_dashboard_sellout'] and not is_stat_excluded('app_dashboard_sellout') %}
                    <li class="nav-item d-flex align-items-center me-3">
                        <a href="{{ path('app_dashboard_sellout') }}"
                           class="btn btn-sm {{ _route == 'app_dashboard_sellout' ? 'btn-primary' : 'btn-outline-primary' }}">
                            <i class="fa fa-store me-1"></i> Sell Out
                        </a>
                    </li>
                {% endif %}
                {% if _route == 'app_dashboard_sellout' %}
                    <li class="nav-item d-flex align-items-center me-3">
                        <a href="{{ path('app_home') }}" class="btn btn-sm btn-outline-secondary">
                            <i class="fa fa-arrow-left me-1"></i> Sell In
                        </a>
                    </li>
                {% endif %}
                <!-- Ajoute les autres boutons et champs de recherche ici si tu veux tout le header -->
            </ul>
        </div>

        <div class="navbar-custom-menu r-side">
            <ul class="nav navbar-nav">

                <li class="nav-item d-flex align-items-center me-3">
                    <small class="text-muted" id="header-eur-usd" style="white-space: nowrap;"></small>
                </li>

                <li class="nav-item dropdown d-flex align-items-center me-3">
                    <form id="language-switcher">
                        <select name="locale" class="form-select form-select-sm" style="width: auto;">
                            <option value="fr" {% if app.request.locale == 'fr' %}selected{% endif %}>FR</option>
                            <option value="en" {% if app.request.locale == 'en' %}selected{% endif %}>EN</option>
                        </select>
                    </form>
                </li>

                <li class="btn-group nav-item d-lg-inline-flex d-none">
                    <a href="#" data-provide="fullscreen" class="waves-effect waves-light nav-link btn-outline no-border full-screen" title="Full Screen">
                        <img src="{{ asset('assets/images/svg-icon/fullscreen.svg') }}" class="img-fluid svg-icon" alt="">
                    </a>
                </li>
            </ul>
        </div>
    </nav>
</header>
{% block javascripts %}
    <script>
        // Taux EUR/USD dans le header
        fetch("{{ path('api_dashboard_exchange_rate', { currency: 'EUR' }) }}")
            .then(r => r.json())
            .then(data => {
                const taux = Number(data?.taux_courant || 0);
                if (taux > 0) {
                    document.getElementById('header-eur-usd').textContent = 'Taux moyen du mois : 1 EUR = ' + taux.toFixed(3) + ' USD';
                }
            })
            .catch(() => {});

document.querySelector('#language-switcher select').addEventListener('change', function () {
            const selectedLocale = this.value;
            const currentPath = window.location.pathname;
            const pathParts = currentPath.split('/').filter(p => p);

            // remplace le premier segment si c’est une locale, sinon ajoute
            if (['fr', 'en', 'de'].includes(pathParts[0])) {
                pathParts[0] = selectedLocale;
            } else {
                pathParts.unshift(selectedLocale);
            }

            const newPath = '/' + pathParts.join('/');
            window.location.href = newPath;
        });
    </script>
{% endblock %}
