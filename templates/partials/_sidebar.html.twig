{% set path = app.request.pathinfo|replace({'/fr': '', '/en': ''}) %}
{% set currentRoute = app.request.attributes.get('_route') %}
<aside class="main-sidebar mt-2">
    <section class="sidebar position-relative">
        <div class="user-profile px-30 py-15">
            <div class="d-flex align-items-center">
                <div class="image">
                    <img src="{{ asset('assets/images/avatar/1.jpg') }}" class="avatar avatar-lg" alt="User Image">
                </div>
                <div class="info ms-10">
                    <p class="mb-0">{{ 'sidebar.hello'|trans }}</p>
                    {% if app.user %}
                        <h5 class="mb-0">
                            {{ app.user.firstname|default('') }} {{ app.user.lastname|default('') }}
                        </h5>
                    {% else %}
                        <h5 class="mb-0">Utilisateur local</h5>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="multinav">
            <div class="multinav-scroll" style="height: 100%;">
                <ul class="sidebar-menu" data-widget="tree">
                    <li class="{% if path == '/' %}active{% endif %}"><a href="{{ path('app_home') }}"><img src="{{ asset('assets/images/svg-icon/dashboard.svg') }}" class="svg-icon" alt=""><span>{{ 'sidebar.accueil'|trans }}</span></a></li>

                    {# Block Menu #}
                    <li class="header">Menus</li>
                    <li class="treeview {% if path starts with '/management' %}active{% endif %}">
                        <a href="#">
                            <img src="{{ asset('assets/images/svg-icon/management.svg') }}" class="svg-icon" alt="">
                            <span>{{ 'sidebar.menu.management'|trans }}</span>
                            <span class="pull-right-container"><i class="fa fa-angle-right pull-right"></i></span>
                        </a>
                        <ul class="treeview-menu">
                            <li class="{% if currentRoute == 'app_ca_marges_year' %}active{% endif %}"><a href="{{ path('app_ca_marges_year') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.management.ca_marges'|trans }}</a></li>
                        </ul>
                    </li>
                    <li class="treeview  {% if path starts with '/sales' %}active{% endif %}">
                        <a href="#">
                            <img src="{{ asset('assets/images/svg-icon/ecommerce.svg') }}" class="svg-icon" alt="">
                            <span>{{ 'sidebar.menu.sales'|trans }}</span>
                            <span class="pull-right-container"><i class="fa fa-angle-right pull-right"></i></span>
                        </a>
                        <ul class="treeview-menu">
                            <li class="{% if currentRoute == 'app_sales_livraison_non_facturees' %}active{% endif %}"><a href="{{ path('app_sales_livraison_non_facturees') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.delivery_without_invoice'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_backlog_clients_x3' %}active{% endif %}"><a href="{{ path('app_sales_backlog_clients_x3') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.backlog_clients_x3'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_backlog_clients' %}active{% endif %}"><a href="{{ path('app_sales_backlog_clients') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.backlog_clients'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_kpi_retail' %}active{% endif %}"><a href="{{ path('app_kpi_retail') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.kpi_deck_retail'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_kpi_retail_x3' %}active{% endif %}"><a href="{{ path('app_kpi_retail_x3') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.kpi_deck_retail_x3'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_commandes_a_facturer' %}active{% endif %}"><a href="{{ path('app_sales_commandes_a_facturer') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.commandes_a_facturer'|trans|nl2br }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_commandes_a_facturer_x3' %}active{% endif %}"><a href="{{ path('app_sales_commandes_a_facturer_x3') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.commandes_a_facturer_x3'|trans|nl2br }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_reassort' %}active{% endif %}"><a href="{{ path('app_sales_reassort') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.reassort_magasin'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_excess_for_sales' %}active{% endif %}"><a href="{{ path('app_sales_excess_for_sales') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.excess_for_sales'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_poid_famille_par_variant' %}active{% endif %}"><a href="{{ path('app_sales_poid_famille_par_variant') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.poids_tailles'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_sales_best_demand_per_style' %}active{% endif %}"><a href="{{ path('app_sales_best_demand_per_style') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.sales.best_demand_per_style'|trans }}</a></li>
                        </ul>
                    </li>

                    <li class="treeview  {% if path starts with '/purchase' %}active{% endif %}">
                        <a href="#">
                            <img src="{{ asset('assets/images/svg-icon/purchase.svg') }}" class="svg-icon" alt="">
                            <span>{{ 'sidebar.menu.purchasing'|trans }}</span>
                            <span class="pull-right-container"><i class="fa fa-angle-right pull-right"></i></span>
                        </a>
                        <ul class="treeview-menu">
                            <li class="{% if currentRoute == 'app_backlog_fournisseur_x3' %}active{% endif %}"><a href="{{ path('app_backlog_fournisseur_x3') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.purchase.backlog_fournisseur_x3'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_backlog_fournisseur' %}active{% endif %}"><a href="{{ path('app_backlog_fournisseur') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.purchase.backlog_fournisseur'|trans }}</a></li>
                        </ul>
                    </li>

                    <li class="treeview  {% if path starts with '/stock' %}active{% endif %}">
                        <a href="#">
                            <img src="{{ asset('assets/images/svg-icon/stocks.svg') }}" class="svg-icon" alt="">
                            <span>{{ 'sidebar.menu.stock'|trans }}</span>
                            <span class="pull-right-container"><i class="fa fa-angle-right pull-right"></i></span>
                        </a>
                        <ul class="treeview-menu">
                            <li class="{% if currentRoute == 'app_stock_a_terme_x3' %}active{% endif %}"><a href="{{ path('app_stock_a_terme_x3') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.stock.stock_a_terme_x3'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_stock_allocation' %}active{% endif %}"><a href="{{ path('app_stock_allocation') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.stock.stock_allocation'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_stock_composant' %}active{% endif %}"><a href="{{ path('app_stock_composant') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.stock.stock_composant'|trans }}</a></li>
                            <li class="{% if currentRoute == 'app_stock_produits' %}active{% endif %}"><a href="{{ path('app_stock_produits') }}"><i class="icon-Commit"></i>{{ 'sidebar.stat.stock.stock_produits'|trans }}</a></li>
                        </ul>
                    </li>

                </ul>

                <div class="sidebar-widgets">
                    <div class="copyright text-start m-25">
                        <p><strong class="d-block">Lecoqsportif</strong> © {{ "now"|date("Y") }} All Rights Reserved</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</aside>
