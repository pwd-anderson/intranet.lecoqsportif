{% extends 'base.html.twig' %}
{% block title %}KPI eCommerce{% endblock %}
{% block stylesheets %}
    {{ parent() }}
    <style>

    </style>
{% endblock %}

{% block body %}
    <section class="content">

        <div class="box py-3 px-3"> <!-- padding top/bottom ajouté ici -->
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <h3 class="mb-0">KPI eCommerce</h3>
                <div class="col-md-3 col-12 mt-3 mt-md-0 text-uppercase">
                    <div class="form-group mb-0">
                        <select class="form-control select2 fs-18">
                            <option selected="selected">overview week 40 e-com</option>
                            <option>overview week 39 e-com</option>
                            <option>overview week 38 e-com</option>
                            <option>overview week 37 e-com</option>
                            <option>overview week 36 e-com</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-6 col-12">
                <h4 class="mx-3">Eshop</h4>
                <div class="row">
                    <div class="col-12 col-md-12">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-25">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">CA HT</p>
                                <p class="fs-40 m-0">
                                    <strong class="countnm">{{ eshop.ca_ht }}</strong> <span>€</span>
                                </p>
                                <p class="mb-1 fs-18 fw-semibold">
                                    <span class="{{ eshop.variation_ca < 0 ? 'text-danger' : 'text-success' }}">
                                        {{ eshop.variation_ca }}%
                                    </span> vs N-1
                                </p>
                            </div>
                        </a>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12 col-md-4">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">panier moyen</p>
                                <p class="fs-40">
                                    <strong class="countnm">{{ eshop.panier_moyen }}</strong><span>€</span>
                                </p>
                                <p class="mb-1 fs-18 fw-semibold"><span class="text-danger">{{ eshop.panier_variation }}%</span> vs N-1</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">taux de conversion</p>
                                <p class="fs-40 text-success">
                                    <strong class="countnm per">{{ eshop.conversion }}</strong>
                                </p>
                                <p class="mb-1 fs-18 fw-semibold"><span class="text-danger">{{ eshop.conversion_variation }} pts</span> vs N-1</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">trafic (hors paid)</p>
                                <p class="fs-40 text-danger">
                                    <strong>{{ eshop.trafic }}</strong>
                                </p>
                                <p class="mb-1 fs-18 fw-semibold"><span class="text-danger">{{ eshop.trafic_variation }}%</span> vs N-1</p>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 col-md-4">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">roas (paid)</p>
                                <p class="fs-40">
                                    <strong>{{ eshop.roas }}</strong>
                                </p>
                                <p class="mb-1 fs-18 fw-semibold"><span class="text-danger">{{ eshop.roas_variation }}%</span> vs N-1</p>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">cac</p>
                                <p class="fs-40 text-success">
                                    <strong>{{ eshop.cac }} €</strong>
                                </p>
                                <p class="py-3 fs-18 fw-semibold"><span class="text-danger"></span></p>
                            </div>
                        </a>
                    </div>
                    <div class="col-12 col-md-4">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">ca via email</p>
                                <p class="fs-40 text-danger">
                                    <strong>{{ eshop.email_percent }}%</strong>
                                </p>
                                <p class="mb-1 fs-18 fw-semibold"><span class="text-danger">+{{ eshop.email_variation }}pts</span> vs N-1</p>
                            </div>
                        </a>
                    </div>
                </div>

                <div class="row">
                    <h4 class="mx-3">Marketplace</h4>
                    <div class="col-12 col-md-12">
                        <a class="box box-link-pop text-center" href="javascript:void(0)">
                            <div class="box-body py-10">
                                <p class="mt-1 text-muted text-uppercase fs-18 fw-bold">ca net ht</p>
                                <p class="fs-40">
                                    <strong class="countnm">{{ eshop.marketplace_ca }}</strong> €
                                </p>
                                <p class="mb-1 fs-18 fw-semibold"><span class="text-danger">{{ eshop.marketplace_variation }}%</span> vs N-1</p>
                            </div>
                        </a>
                    </div>
                </div>
                <!-- /.row -->
            </div>

            <div class="col-12 col-xl-4">
                <h5 class="mx-3 text-uppercase">top 3 articles textile (CA TTC)</h5>
                <div class="box h-250">
                    <div class="box-body">
                        {% for product in products.textile %}
                            <div class="d-flex align-items-center mb-30">
                                <div class="me-15 bg-lightest h-50 w-50 l-h-50 rounded text-center">
                                    <img src="{{ asset('assets/images/product/' ~ product.image) }}" class="h-30" alt="">
                                </div>
                                <div class="d-flex flex-column flex-grow-1 me-2 fw-500">
                                    <a href="#" class="text-dark hover-primary mb-1 fs-16">{{ product.id }}</a>
                                    <span class="text-primary">{{ product.label }}</span>
                                </div>
                                <span class="badge badge-xl badge-warning-light">
                                    <span class="fw-600 text-dark">{{ product.price }}</span>
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <h5 class="mx-3 text-uppercase">top 3 articles footwear (CA TTC)</h5>
                <div class="box  h-250">
                    <div class="box-body">
                        {% for product in products.footwear %}
                            <div class="d-flex align-items-center mb-30">
                                <div class="me-15 bg-lightest h-50 w-50 l-h-50 rounded text-center">
                                    <img src="{{ asset('assets/images/product/' ~ product.image) }}" class="h-30" alt="">
                                </div>
                                <div class="d-flex flex-column flex-grow-1 me-2 fw-500">
                                    <a href="#" class="text-dark hover-primary mb-1 fs-16">{{ product.id }}</a>
                                    <span class="text-primary">{{ product.label }}</span>
                                </div>
                                <span class="badge badge-xl badge-warning-light">
                                    <span class="fw-600 text-dark">{{ product.price }}</span>
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <div class="box p-3 h-210">
                    <div class="row">
                        <div class="col-6">
                            <h5 class="text-success">WINNER</h5>
                            <p class="small">
                                CA en progression vs LW (+8%) avec 2J de French days vs 5J LW => dernier jour + fort que premier jour
                            </p>
                            <p class="small">
                                Jackets passe en 3e caté qui performe en CA (à la place des t-shirts)
                            </p>
                            <p class="small">
                                TRI SP FZ Hybride N°1 M sky captain<br>
                                TOP PERF et hors sélection French days
                            </p>
                        </div>
                        <div class="col-6">
                            <h5 class="text-danger">LOOSER</h5>
                            <p class="small">
                                Footwear dont la PDM tombe à 42%<br>
                                (-5 points vs trend précédente semaine hors French days) => sélection french majoritairement sur textile
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/vendor_components/select2/dist/js/select2.full.js') }}"></script>
    <script>
        $(document).ready(function () {
            "use strict";
            //Initialize Select2 Elements
            $('.select2').select2();

            $('.countnm').each(function () {
                const $this = $(this);
                const target = parseFloat($this.text());

                $this.prop('Counter', 0).animate({
                    Counter: target
                }, {
                    duration: 1500,
                    easing: 'swing',
                    step: function (now) {
                        // Pendant l'animation, arrondir sans format
                        $this.text(Math.ceil(now));
                    },
                    complete: function () {
                        // À la fin de l'animation : formater avec séparateur
                        $this.text(new Intl.NumberFormat('fr-FR').format(target));
                    }
                });
            });
        });

    </script>

{% endblock %}
