{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    <style>
        .form-section {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 18px 20px;
            margin-bottom: 20px;
        }
        .form-section h5 {
            font-size: 14px;
            font-weight: 600;
            color: #024185;
            margin-bottom: 14px;
            padding-bottom: 8px;
            border-bottom: 1px solid #dee2e6;
        }
        .paste-zone {
            min-height: 80px;
            max-height: 150px;
            overflow: auto;
            border: 2px dashed #adb5bd;
            border-radius: 6px;
            padding: 10px 12px;
            background: #fff;
            cursor: text;
            font-size: 13px;
            color: #555;
            white-space: pre;
            word-break: keep-all;
        }
        .paste-zone:focus {
            outline: none;
            border-color: #024185;
        }
        .paste-zone:empty:before {
            content: attr(data-placeholder);
            color: #adb5bd;
        }
        #lignesTable thead th {
            background-color: #024185;
            color: #fff;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 1;
        }
        #lignesTable td { padding: 3px 4px; }
        #lignesTable td input {
            width: 100%;
            border: none;
            background: transparent;
            font-size: 13px;
            padding: 2px 4px;
        }
        #lignesTable td input:focus {
            outline: 1px solid #024185;
            background: #fff;
            border-radius: 2px;
        }
        #lignesTable tbody tr:nth-child(odd) { background-color: #f8f9fa; }
        #lignesTable tbody tr:hover { background-color: #e8f0fb; }
        .balance-ok  { color: #198754; font-weight: 600; }
        .balance-nok { color: #dc3545; font-weight: 600; }
    </style>
{% endblock %}

{% block body %}
<section class="content">
    <div class="row">
        <div class="col-12">
            <div class="box">

                <div class="box-header with-border d-flex justify-content-between align-items-center">
                    <h3 class="box-title mb-0">{{ title }}</h3>
                </div>

                <div class="box-body">

                    {# ===== LOADING ===== #}
                    <div id="listes-loading" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status" style="width:2rem;height:2rem;">
                            <span class="visually-hidden">Chargement…</span>
                        </div>
                        <p class="text-muted small mt-2 mb-0">Chargement des listes…</p>
                    </div>

                    {# ===== CONTENU (masqué pendant le loading) ===== #}
                    <div id="listes-content" style="display:none">

                    {# ===== ENTÊTE ===== #}
                    <div class="form-section">
                        <h5>Entête de la pièce</h5>
                        <div class="row g-3">

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Société <span class="text-danger">*</span></label>
                                <select id="societe" class="form-select form-select-sm">
                                    <option value="">-- Choisir --</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Site <span class="text-danger">*</span></label>
                                <select id="site" class="form-select form-select-sm">
                                    <option value="">-- Choisir --</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Date <span class="text-danger">*</span></label>
                                <input type="date" id="date" class="form-control form-control-sm">
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Type <span class="text-danger">*</span></label>
                                <select id="type" class="form-select form-select-sm">
                                    <option value="">-- Choisir --</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Journal <span class="text-danger">*</span></label>
                                <select id="journal" class="form-select form-select-sm">
                                    <option value="">-- Choisir --</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Devise <span class="text-danger">*</span></label>
                                <select id="devise" class="form-select form-select-sm">
                                    <option value="">-- Choisir --</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">BPRVCR <span class="text-danger">*</span></label>
                                <input type="text" id="bprvcr" class="form-control form-control-sm" placeholder="Document d'origine">
                            </div>

                            <div class="col-md-2">
                                <label class="form-label small fw-semibold">Extourne</label>
                                <select id="extourne" class="form-select form-select-sm" onchange="toggleDateExtourne()">
                                    <option value="non">Non</option>
                                    <option value="oui">Oui</option>
                                </select>
                            </div>

                            <div class="col-md-2" id="date-extourne-wrapper" style="display:none">
                                <label class="form-label small fw-semibold">Date extourne <span class="text-danger">*</span></label>
                                <input type="date" id="date_extourne" class="form-control form-control-sm">
                            </div>

                        </div>
                    </div>

                    {# ===== LIGNES ===== #}
                    <div class="form-section">
                        <h5>Lignes de la pièce</h5>

                        <p class="text-muted small mb-2">
                            Copiez vos lignes depuis Excel (colonnes : Compte, Tiers, Débit, Crédit, Libellé, Axe1, Axe2, Taxe) et collez ci-dessous.
                        </p>

                        <div id="pasteZone"
                             class="paste-zone mb-2"
                             contenteditable="true"
                             data-placeholder="Coller vos lignes Excel ici..."></div>

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <button class="btn btn-secondary btn-sm" onclick="chargerLignes()">Charger les lignes</button>
                            <button class="btn btn-outline-danger btn-sm" onclick="resetLignes()">Vider</button>
                            <span id="balanceInfo" class="ms-3 small"></span>
                        </div>

                        <div style="max-height: 400px; overflow-y: auto; overflow-x: auto;">
                            <table class="table table-bordered table-sm" id="lignesTable" style="margin-bottom:0; min-width:900px;">
                                <thead>
                                    <tr>
                                        <th>Réf. pièce</th>
                                        <th style="width:100px">Compte</th>
                                        <th style="width:160px">Axe analytique</th>
                                        <th style="width:100px">Tiers</th>
                                        <th>Libellé</th>
                                        <th style="width:100px">Débit</th>
                                        <th style="width:100px">Crédit</th>
                                        <th style="width:70px">Taxe</th>
                                        <th style="width:36px"></th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>

                    {# ===== ACTIONS ===== #}
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary btn-sm" onclick="valider()">Valider</button>
                        <button class="btn btn-success btn-sm" id="genererBtn" disabled onclick="generer()">Générer XML</button>
                        <button class="btn btn-danger btn-sm" onclick="resetAll()">Reset</button>
                    </div>

                    </div>{# /listes-content #}

                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/tom-select.complete.min.js') }}"></script>
    <script>
    const LISTES_URL    = '{{ listesUrl }}';
    const GENERATE_URL  = '{{ generateUrl }}';
    const VALIDATE_URL  = '{{ path('app_module_import_od_validate_lignes') }}';

    const tsInstances = {};

    function initTomSelect(selectId, values, defaultValue = null) {
        const ts = new TomSelect('#' + selectId, {
            valueField: 'v',
            labelField: 'v',
            searchField: 'v',
            options: values.map(v => ({ v })),
            placeholder: '-- Choisir --',
            maxOptions: 1000,
        });
        if (defaultValue) ts.setValue(defaultValue);
        tsInstances[selectId] = ts;
        return ts;
    }

    function getTsValue(selectId) {
        return tsInstances[selectId] ? tsInstances[selectId].getValue() : document.getElementById(selectId).value;
    }

    function toggleDateExtourne() {
        const isOui = document.getElementById('extourne').value === 'oui';
        const wrapper = document.getElementById('date-extourne-wrapper');
        wrapper.style.display = isOui ? '' : 'none';
        document.getElementById('date_extourne').value = isOui ? document.getElementById('date_extourne').value : '';
    }

    document.addEventListener('DOMContentLoaded', () => {
        fetch(LISTES_URL)
            .then(r => r.json())
            .then(data => {
                initTomSelect('societe', data.societes);
                initTomSelect('site',    data.sites);
                initTomSelect('type',    data.types);
                initTomSelect('journal', data.journaux);
                initTomSelect('devise',  data.devises, 'EUR');

                document.getElementById('listes-loading').style.display = 'none';
                document.getElementById('listes-content').style.display = '';
            })
            .catch(() => {
                document.getElementById('listes-loading').innerHTML =
                    '<p class="text-danger small">❌ Erreur lors du chargement des listes.</p>';
            });
    });

    // -------------------------------------------------------
    // Charger les lignes depuis le copier-coller Excel
    // -------------------------------------------------------
    function chargerLignes() {
        const text = document.getElementById('pasteZone').innerText.trim();
        if (!text) return;

        const tbody = document.querySelector('#lignesTable tbody');
        tbody.innerHTML = '';

        text.split(/\n/).forEach(row => {
            if (!row.trim()) return;
            ajouterLigne(row.split(/\t/));
        });

        updateBalance();
        document.getElementById('genererBtn').disabled = false;
    }

    function ajouterLigne(cols = []) {
        const keys  = ['RefPiece', 'Compte', 'Axe', 'Tiers', 'Libelle', 'Debit', 'Credit', 'Taxe'];
        const tbody = document.querySelector('#lignesTable tbody');
        const tr    = document.createElement('tr');

        keys.forEach((key, i) => {
            const td    = document.createElement('td');
            const input = document.createElement('input');
            input.value = (cols[i] || '').trim();
            if (key === 'Debit' || key === 'Credit') {
                input.style.textAlign = 'right';
                input.addEventListener('input', updateBalance);
            }
            td.appendChild(input);
            tr.appendChild(td);
        });

        const tdDel = document.createElement('td');
        tdDel.style.textAlign = 'center';
        tdDel.innerHTML = '<button class="btn btn-outline-danger btn-sm py-0 px-1" onclick="this.closest(\'tr\').remove(); updateBalance();">✕</button>';
        tr.appendChild(tdDel);

        tbody.appendChild(tr);
    }

    // -------------------------------------------------------
    // Balance Débit / Crédit
    // -------------------------------------------------------
    function updateBalance() {
        let debit = 0, credit = 0;

        document.querySelectorAll('#lignesTable tbody tr').forEach(tr => {
            const inputs = tr.querySelectorAll('input');
            debit  += parseFloat((inputs[5].value || '0').replace(',', '.')) || 0;
            credit += parseFloat((inputs[6].value || '0').replace(',', '.')) || 0;
        });

        const diff = Math.round((debit - credit) * 100) / 100;
        const fmt  = n => n.toLocaleString('fr-FR', { minimumFractionDigits: 2 });
        const el   = document.getElementById('balanceInfo');

        if (diff === 0 && debit > 0) {
            el.innerHTML = `<span class="balance-ok">✔ Équilibré — Débit : ${fmt(debit)} | Crédit : ${fmt(credit)}</span>`;
        } else {
            el.innerHTML = `<span class="balance-nok">✘ Déséquilibre : ${fmt(diff)} — Débit : ${fmt(debit)} | Crédit : ${fmt(credit)}</span>`;
        }
    }

    // -------------------------------------------------------
    // Récupérer les lignes JSON
    // -------------------------------------------------------
    function getLignes() {
        return Array.from(document.querySelectorAll('#lignesTable tbody tr')).map(tr => {
            const inputs = tr.querySelectorAll('input');
            return {
                RefPiece: inputs[0].value.trim(),
                Compte:   inputs[1].value.trim(),
                Axe:      inputs[2].value.trim(),
                Tiers:    inputs[3].value.trim(),
                Libelle:  inputs[4].value.trim(),
                Debit:    inputs[5].value.trim(),
                Credit:   inputs[6].value.trim(),
                Taxe:     inputs[7].value.trim(),
            };
        });
    }

    function getEntete() {
        return {
            societe:       getTsValue('societe'),
            site:          getTsValue('site'),
            date:          document.getElementById('date').value,
            type:          getTsValue('type'),
            journal:       getTsValue('journal'),
            devise:        getTsValue('devise'),
            bprvcr:        document.getElementById('bprvcr').value,
            extourne:      document.getElementById('extourne').value,
            date_extourne: document.getElementById('date_extourne').value,
        };
    }

    // -------------------------------------------------------
    // Validation
    // -------------------------------------------------------
    function validateEntete() {
        const required = [
            { id: 'societe',  label: 'Société',  ts: true },
            { id: 'site',     label: 'Site',     ts: true },
            { id: 'date',     label: 'Date',     ts: false },
            { id: 'type',     label: 'Type',     ts: true },
            { id: 'journal',  label: 'Journal',  ts: true },
            { id: 'devise',   label: 'Devise',   ts: true },
            { id: 'bprvcr',   label: 'Référence externe', ts: false },
        ];

        const manquants = required
            .filter(f => !(f.ts ? getTsValue(f.id) : document.getElementById(f.id).value).trim())
            .map(f => `<li>${f.label}</li>`);

        if (document.getElementById('extourne').value === 'oui' && !document.getElementById('date_extourne').value.trim()) {
            manquants.push('<li>Date extourne</li>');
        }

        if (manquants.length) {
            showModal('warning',
                `Les champs obligatoires suivants ne sont pas remplis :<ul class="mb-0 mt-2">${manquants.join('')}</ul>`,
                'Champs manquants'
            );
            return false;
        }
        return true;
    }

    async function valider() {
        const lignes = getLignes();
        if (!lignes.length) { showModal('warning', 'Aucune ligne à valider.'); return; }
        if (!validateEntete()) return;

        const btn = document.querySelector('button[onclick="valider()"]');
        const originalLabel = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Validation…';

        try {
            const resp = await fetch(VALIDATE_URL, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ lignes }),
            });
            const data = await resp.json();

            if (data.success) {
                showModal('info', `${lignes.length} ligne(s) validée(s) avec succès.`, 'Validation OK');
                document.getElementById('genererBtn').disabled = false;
            } else {
                const errEntries = Object.entries(data.errors || {});
                const total = errEntries.length;
                const shown = errEntries.slice(0, 10);
                const errLines = shown.map(([lineNum, msgs]) =>
                    `<li><strong>Ligne ${lineNum}</strong> : ${msgs.join(' — ')}</li>`
                ).join('');
                const more = total > 10 ? `<p class="text-muted small mt-2 mb-0">… et ${total - 10} autre(s) erreur(s).</p>` : '';
                showModal('warning',
                    `${total} ligne(s) en erreur :<ul class="mb-0 mt-2">${errLines}</ul>${more}`,
                    'Erreurs de validation'
                );
            }
        } catch (e) {
            showModal('alert', 'Erreur réseau lors de la validation : ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalLabel;
        }
    }

    async function generer() {
        const lignes = getLignes();
        if (!lignes.length) { showModal('warning', 'Aucune ligne à traiter.'); return; }
        if (!validateEntete()) return;

        const btn = document.getElementById('genererBtn');
        btn.disabled = true;
        btn.textContent = 'Envoi en cours…';

        try {
            const resp = await fetch(GENERATE_URL, {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify({ entete: getEntete(), lignes }),
            });
            const data = await resp.json();

            if (data.success) {
                showModal('info', data.message + '<br><code class="small">symfony console app:sales:webservices:execute</code>', 'Import généré');
            } else {
                showModal('alert', data.message || 'Une erreur inconnue est survenue.');
            }
        } catch (e) {
            showModal('alert', 'Erreur réseau : ' + e.message);
        } finally {
            btn.disabled = false;
            btn.textContent = 'Générer XML';
        }
    }

    // -------------------------------------------------------
    // Reset
    // -------------------------------------------------------
    function resetLignes() {
        document.getElementById('pasteZone').innerHTML = '';
        document.querySelector('#lignesTable tbody').innerHTML = '';
        document.getElementById('balanceInfo').innerHTML = '';
    }

    function resetAll() {
        ['societe','site','type','journal','devise'].forEach(id => {
            if (tsInstances[id]) tsInstances[id].clear();
        });
        ['date','date_extourne','bprvcr']
            .forEach(id => document.getElementById(id).value = '');
        document.getElementById('extourne').value = 'non';
        document.getElementById('date-extourne-wrapper').style.display = 'none';
        resetLignes();
    }
    </script>
{% endblock %}
