// ── Chargement initial ────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    fetch(ROUTES.apiShow)
        .then(r => r.json())
        .then(data => {
            if (data.error) throw new Error(data.error);

            document.title = data.numero + ' — MDF';

            renderStepper(data.statut);

            if (MODE === 'form') {
                prefillForm(data);
                document.getElementById('mdf-form-content').style.display = '';
                document.getElementById('mdf-form-block-2').style.display = '';
                document.getElementById('mdf-form-block-3').style.display = '';
                document.getElementById('mdf-form-actions').style.display = '';
            } else if (MODE === 'validation') {
                renderReadOnly(data);
                initValidation(data);
                document.getElementById('mdf-ro-content').style.display = '';
            } else if (MODE === 'preuves') {
                renderReadOnly(data);
                initPreuves(data);
                document.getElementById('mdf-ro-content').style.display = '';
            }

            document.getElementById('edit-loading').style.display = 'none';
        })
        .catch(err => {
            document.getElementById('edit-loading').innerHTML =
                `<div class="alert alert-danger">Impossible de charger le MDF : ${err.message}</div>`;
        });
});
</script>
