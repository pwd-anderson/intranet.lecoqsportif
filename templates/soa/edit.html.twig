        <div class="row g-4">
            <div class="col-md-5">
                <div class="soa-label mb-2">Justificatifs uploadés</div>
                <div id="proofs-list">${renderProofsList()}</div>
                <div class="upload-zone mt-2" id="upload-zone" onclick="document.getElementById('proof-input').click()">
                    <i class="fa fa-cloud-upload fa-lg mb-1" style="display:block;"></i>
                    Cliquer pour ajouter un fichier
                </div>
                <input type="file" id="proof-input" style="display:none;" onchange="uploadFile(this)">
            </div>
            <div class="col-md-7">
                <div class="soa-label mb-2">Quantités vendues</div>
                <div style="overflow-x:auto;">
                    <table class="preuve-table">
                        <thead><tr>
                            <th>Article</th>
                            <th>Désignation</th>
                            <th style="text-align:right;">Montant SOA</th>
                            <th style="text-align:right;color:#adb5bd;">Qté prévue</th>
                            <th style="text-align:right;">Qté vendue</th>
                        </tr></thead>
                        <tbody>${lignesHtml}</tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="mt-4 text-end">
            <button class="btn btn-primary px-5" id="btn-submit-preuves" onclick="submitPreuves()" disabled>
                <i class="fa fa-paper-plane me-2"></i>Soumettre pour validation finale
            </button>
        </div>
    </div>`;

    checkSubmitBtn();
}

function renderProofsList() {
    if (uploadedProofs.length === 0) {
        return '<p class="text-secondary fst-italic" style="font-size:12px;">Aucun fichier uploadé.</p>';
    }
    return uploadedProofs.map(p => `
        <div class="proof-file-item" id="proof-item-${p.id}">
            <i class="fa fa-file text-secondary"></i>
            <a href="${p.download_url}" class="file-name text-decoration-none">${p.nom_fichier}</a>
            <span class="file-size">${fmtSize(p.taille)}</span>
            <button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="deleteProof(${p.id})" title="Supprimer">
                <i class="fa fa-trash"></i>
            </button>
        </div>
    `).join('');
}

function checkSubmitBtn() {
    const btn = document.getElementById('btn-submit-preuves');
    if (!btn) return;
    const hasFiles  = uploadedProofs.length > 0;
    const allFilled = [...document.querySelectorAll('.qte-input')].every(inp => {
        const v = parseInt(inp.value, 10);
        return v > 0 && v <= parseInt(inp.dataset.qteMax, 10);
    });
    btn.disabled = !(hasFiles && allFilled);
    btn.title = !hasFiles ? 'Uploadez au moins un justificatif'
               : !allFilled ? 'Renseignez toutes les quantités vendues (entre 1 et qté max)' : '';
}

function uploadFile(input) {
    const file = input.files[0];
    if (!file) return;
    const zone = document.getElementById('upload-zone');
    zone.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Upload en cours…';
    zone.style.pointerEvents = 'none';

    const fd = new FormData();
    fd.append('file', file);

    fetch(ROUTES.api_upload, { method: 'POST', body: fd })
    .then(r => r.json())
    .then(res => {
        zone.innerHTML = '<i class="fa fa-cloud-upload fa-lg mb-1" style="display:block;"></i>Cliquer pour ajouter un fichier';
        zone.style.pointerEvents = '';
        input.value = '';
        if (res.error) { showAlert(res.error); return; }
        uploadedProofs.push(res);
        document.getElementById('proofs-list').innerHTML = renderProofsList();
        checkSubmitBtn();
    })
    .catch(() => {
        zone.innerHTML = '<i class="fa fa-cloud-upload fa-lg mb-1" style="display:block;"></i>Cliquer pour ajouter un fichier';
        zone.style.pointerEvents = '';
        showAlert('Erreur réseau lors de l\'upload.', 'Erreur réseau');
    });
}

function deleteProof(docId) {
    showConfirm('Supprimer ce fichier ?', () => _doDeleteProof(docId), 'Supprimer le fichier');
}
function _doDeleteProof(docId) {
    const url = '{{ path("api_soa_delete_proof", {id: 0, docId: 0}) }}'
        .replace('/api/0/', '/api/' + SOA_ID + '/')
        .replace('/proof/0/', '/proof/' + docId + '/');

    fetch(url, { method: 'POST' })
    .then(r => r.json())
    .then(res => {
        if (res.error) { showAlert(res.error); return; }
        uploadedProofs = uploadedProofs.filter(p => p.id !== docId);
        document.getElementById('proofs-list').innerHTML = renderProofsList();
        checkSubmitBtn();
    })
    .catch(() => showAlert('Erreur réseau.', 'Erreur réseau'));
}

function submitPreuves() {
    const lignes = [...document.querySelectorAll('.qte-input')].map(inp => ({
        product_id: parseInt(inp.dataset.productId, 10),
        qte_vendue: parseInt(inp.value, 10),
    }));

    fetch(ROUTES.api_submit, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lignes }),
    })
    .then(r => r.json())
    .then(res => {
        if (res.error) { showAlert(res.error); return; }
        window.location.href = ROUTES.show;
    })
    .catch(() => showAlert('Erreur réseau.', 'Erreur réseau'));
}

// ── Chargement initial ────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    fetch(ROUTES.apiShow)
        .then(r => r.json())
        .then(data => {
            if (data.error) throw new Error(data.error);

            document.getElementById('bc-show').textContent = data.numero;
            document.title = data.numero + ' — SOA';

            renderStepper(data.statut);
            renderReadOnly(data);

            if (SOA_MODE === 'validation') {
                initValidation(data);
            } else {
                initPreuves(data);
            }

            document.getElementById('edit-loading').style.display = 'none';
            document.getElementById('soa-ro-content').style.display = '';
        })
        .catch(err => {
            document.getElementById('edit-loading').innerHTML =
                `<div class="alert alert-danger">Impossible de charger le SOA : ${err.message}</div>`;
        });
});
</script>
{% endif %}

{% endblock %}
