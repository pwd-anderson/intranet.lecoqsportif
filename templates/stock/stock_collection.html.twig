{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Import ag-Grid CSS #}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }
        .ag-text-field-input {
            color: #000000 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">

                <div class="box">

                    <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                        <h3 class="box-title mb-0">Stock LogTex</h3>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            <button id="exportBtn" class="btn btn-primary btn-sm" type="button" onclick="exportStockLogTexExcel()">Excel</button>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>

                </div>

                {% set blocks = [
                    {title: 'Stock – Tous statuts', status: 'ALL', grid: 'grid_all'},
                    {title: 'Stock – A1', status: 'A1', grid: 'grid_a1'},
                    {title: 'Stock – A2', status: 'A2', grid: 'grid_a2'},
                    {title: 'Stock – R',  status: 'R',  grid: 'grid_r'}
                ] %}

                {% for block in blocks %}

                    <div class="box mb-4">

                        <div class="box-header with-border">
                            <h4 class="box-title mb-0">{{ block.title }}</h4>
                        </div>

                        <div class="box-body border-bottom py-2">
                            <div class="d-flex align-items-center gap-3">
                                <label class="mb-0 small fw-bold text-muted">
                                    Location :
                                </label>

                                <select class="form-select form-select-sm locationSelect"
                                        data-status="{{ block.status }}"
                                        data-grid="{{ block.grid }}"
                                        style="width:200px;">
                                    <option value="">Toutes</option>
                                    <option value="LCSI1">LCSI1</option>
                                    <option value="LCSI2">LCSI2</option>
                                    <option value="LCSI3">LCSI3</option>
                                </select>
                            </div>
                        </div>

                        <div class="box-body pt-2">
                            <div id="{{ block.grid }}" class="ag-theme-alpine" style="height: 269px;"></div>
                        </div>

                    </div>

                {% endfor %}

            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-community.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx-js-style@1.2.0/dist/xlsx.bundle.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', () => {

            function buildColumnDefs(keys) {

                const defs = keys.map(function(key) {

                    const isText = key === 'FAMILLE';
                    const isTotal = key === 'TOTAL';
                    const isPinned = isText || isTotal;

                    return {
                        field: key,
                        headerName: key,
                        sortable: true,
                        filter: isText ? 'agTextColumnFilter' : 'agNumberColumnFilter',
                        pinned: isPinned ? 'left' : undefined,
                        resizable: true,
                        flex: 0,
                        minWidth: 120,

                        // ✅ format integer sur toutes les colonnes sauf FAMILLE
                        ...(isText ? {} : {
                            valueFormatter: window.integerFormatter,
                            comparator: window.integerComparator
                        }),

                        cellStyle: function(params) {

                            const baseStyle = {
                                borderRight: "0.2px solid #CECECEFF",
                                borderBottom: "0.2px solid #CECECEFF",
                                textAlign: isText ? 'center' : 'right'
                            };

                            if (params.node.rowPinned && params.data?.FAMILLE === 'Total général') {
                                return { ...baseStyle, background: '#a4d8ed', fontWeight: 'bold', color: '#090909' };
                            }

                            if (params.node.rowPinned && params.data?.FAMILLE === 'Poids du stock') {
                                return { ...baseStyle, background: 'white', fontWeight: 'bold', color: '#000000' };
                            }

                            if (isTotal) {
                                return { ...baseStyle, fontWeight: 'bold' };
                            }

                            return baseStyle;
                        },

                        cellRenderer: function(params) {
                            if (isText) return params.value;

                            if (params.node.rowPinned && params.data?.FAMILLE === 'Poids du stock') {
                                if (params.value === null || params.value === undefined) return '';
                                return Number(params.value).toFixed(1) + ' %';
                            }

                            // ✅ important : on laisse AgGrid afficher le valueFormatter
                            return params.valueFormatted ?? params.value;
                        }
                    };
                });

                // FAMILLE en premier
                const familleCol = defs.find(c => c.field === 'FAMILLE');
                const totalCol   = defs.find(c => c.field === 'TOTAL');

                const otherCols = defs.filter(c =>
                    c.field !== 'FAMILLE' && c.field !== 'TOTAL'
                );

                return [
                    ...(familleCol ? [familleCol] : []),
                    ...(totalCol ? [totalCol] : []),
                    ...otherCols
                ];
            }

            function setTotalsAndWeightRow(gridOptions, totalColumns) {

                const totalsRow = { FAMILLE: 'Total général' };
                totalColumns.forEach(col => totalsRow[col] = 0);

                gridOptions.api.forEachNodeAfterFilterAndSort(node => {
                    totalColumns.forEach(col => {
                        totalsRow[col] += Number(node.data?.[col]) || 0;
                    });
                });

                const grandTotal = Number(totalsRow.TOTAL) || 0;

                const poidsRow = { FAMILLE: 'Poids du stock' };
                totalColumns.forEach(col => {
                    if (col === 'TOTAL') {
                        poidsRow[col] = null;
                    } else {
                        poidsRow[col] = grandTotal > 0 ? (totalsRow[col] / grandTotal) * 100 : null;
                    }
                });

                gridOptions.api.setPinnedBottomRowData([totalsRow, poidsRow]);
            }

            function loadGrid(gridId, location = '', status = 'ALL') {

                let url = `{{ dataUrl }}?status=${encodeURIComponent(status)}`;
                if (location) url += `&location=${encodeURIComponent(location)}`;

                fetch(url)
                    .then(res => res.json())
                    .then(data => {

                        const gridDiv = document.getElementById(gridId);

                        if (!data || !data.length) {
                            if (gridDiv.__gridOptions) {
                                gridDiv.__gridOptions.api.setRowData([]);
                                gridDiv.__gridOptions.api.setPinnedBottomRowData([]);
                            }
                            return;
                        }

                        const keys = Object.keys(data[0]);

                        // ✅ colonnes dynamiques : tout sauf FAMILLE = quantités
                        const integerColumns = keys.filter(k => k !== 'FAMILLE');
                        const numericColumns = []; // on force integer pour quantités
                        const totalColumns   = integerColumns;

                        const columnDefs = buildColumnDefs(keys);

                        // 🔥 Première création
                        if (!gridDiv.__gridOptions) {

                            const agGridConfig = {
                                columnDefs: columnDefs,
                                dataUrl: null,                 // on ne laisse pas common refetch
                                numericColumns: numericColumns,
                                integerColumns: integerColumns, // ✅ comme anciennes stats
                                totalColumns: []               // ✅ on gère pinned nous-mêmes
                            };

                            const gridOptions = window.AgGridCommon.initGrid('#' + gridId, agGridConfig);
                            gridDiv.__gridOptions = gridOptions;

                            gridOptions.api.setRowData(data);

                            // pinned
                            setTotalsAndWeightRow(gridOptions, totalColumns);

                            // recalcul pinned si filtre/tri
                            gridOptions.api.addEventListener('filterChanged', () => {
                                setTotalsAndWeightRow(gridOptions, totalColumns);
                            });
                            gridOptions.api.addEventListener('sortChanged', () => {
                                setTotalsAndWeightRow(gridOptions, totalColumns);
                            });

                            // ✅ Fit columns seulement si peu de colonnes
                            setTimeout(() => {
                                const MAX_COLS_TO_FIT = 8;
                                const displayedCols = gridOptions.columnApi.getAllDisplayedColumns().length;
                                if (displayedCols <= MAX_COLS_TO_FIT) {
                                    gridOptions.api.sizeColumnsToFit();
                                }
                            }, 50);

                            return;
                        }

                        // 🔁 Reload (location/status change)
                        const gridOptions = gridDiv.__gridOptions;

                        // ⚠️ Update defs (collections peuvent changer)
                        gridOptions.api.setColumnDefs(columnDefs);

                        // ⚠️ Re-appliquer formatters via AgGridCommon (car setColumnDefs reset)
                        integerColumns.forEach(fieldName => {
                            const col = columnDefs.find(c => c.field === fieldName);
                            if (col) {
                                col.valueFormatter = window.integerFormatter;
                                col.comparator = window.integerComparator;
                            }
                        });

                        gridOptions.api.setRowData(data);
                        setTotalsAndWeightRow(gridOptions, totalColumns);

                        // ✅ Fit columns si peu de colonnes
                        setTimeout(() => {
                            const MAX_COLS_TO_FIT = 8;
                            const displayedCols = gridOptions.columnApi.getAllDisplayedColumns().length;
                            if (displayedCols <= MAX_COLS_TO_FIT) {
                                gridOptions.api.sizeColumnsToFit();
                            }
                        }, 0);

                    })
                    .catch(err => console.error(err));
            }

            // 🔥 Init des 4 blocs
            document.querySelectorAll('.locationSelect').forEach(select => {

                const gridId = select.dataset.grid;
                const status = select.dataset.status;

                loadGrid(gridId, '', status);

                select.addEventListener('change', function() {
                    loadGrid(gridId, this.value, status);
                });
            });

        });

        window.exportStockLogTexExcel = function () {
            const blocks = [
                { id: 'grid_all', title: 'Stock – Tous statuts' },
                { id: 'grid_a1',  title: 'Stock – A1' },
                { id: 'grid_a2',  title: 'Stock – A2' },
                { id: 'grid_r',   title: 'Stock – R' }
            ];

            // sécurité: si la lib n'est pas chargée, tu le vois direct
            if (!window.XLSX) {
                console.error('XLSX introuvable: tu as bien chargé xlsx-js-style ?');
                return;
            }

            const wb = XLSX.utils.book_new();
            const ws = XLSX.utils.aoa_to_sheet([]);

            let rowCursor = 1; // lignes Excel (1-based)

            blocks.forEach((block, idx) => {
                const gridDiv = document.getElementById(block.id);
                if (!gridDiv?.__gridOptions) return;

                const api = gridDiv.__gridOptions.api;
                const columnApi = gridDiv.__gridOptions.columnApi;

                const colKeys = columnApi.getAllDisplayedColumns().map(c => c.getColId());
                const colCount = colKeys.length;

                // 2 lignes vides entre tableaux (sauf le 1er)
                if (idx > 0) rowCursor += 2;

                // ====== TITRE ======
                XLSX.utils.sheet_add_aoa(ws, [[block.title]], { origin: `A${rowCursor}` });

                // style titre
                ws[`A${rowCursor}`].s = {
                    font: { bold: true, sz: 14, color: { rgb: "FFFFFF" } },
                    fill: { patternType: "solid", fgColor: { rgb: "024185" } },
                    alignment: { horizontal: "center", vertical: "center" }
                };

                // merge A..lastCol
                ws["!merges"] = ws["!merges"] || [];
                ws["!merges"].push({
                    s: { r: rowCursor - 1, c: 0 },
                    e: { r: rowCursor - 1, c: Math.max(colCount - 1, 0) }
                });

                rowCursor += 2; // une ligne vide après titre

                // ====== HEADER ======
                XLSX.utils.sheet_add_aoa(ws, [colKeys], { origin: `A${rowCursor}` });

                // style header
                for (let c = 0; c < colCount; c++) {
                    const cellAddr = XLSX.utils.encode_cell({ r: rowCursor - 1, c });
                    if (!ws[cellAddr]) continue;
                    ws[cellAddr].s = {
                        font: { bold: true, color: { rgb: "FFFFFF" } },
                        fill: { patternType: "solid", fgColor: { rgb: "5B9BD5" } },
                        alignment: { horizontal: "center", vertical: "center" }
                    };
                }

                rowCursor++;

                // ====== ROWS (avec filtres/tri appliqués) ======
                api.forEachNodeAfterFilterAndSort(node => {
                    const row = colKeys.map(k => node.data?.[k]);
                    XLSX.utils.sheet_add_aoa(ws, [row], { origin: `A${rowCursor}` });
                    rowCursor++;
                });

                // ====== PINNED ROWS (Total + Poids) ======
                const pinnedCount = api.getPinnedBottomRowCount();
                for (let i = 0; i < pinnedCount; i++) {
                    const pinned = api.getPinnedBottomRow(i);
                    const row = colKeys.map(k => {

                        const value = pinned.data?.[k];

                        // 🎯 Si c’est la ligne "Poids du stock"
                        if (pinned.data?.FAMILLE === 'Poids du stock' && typeof value === 'number') {

                            // On convertit en vrai pourcentage Excel
                            return value / 100; // Excel attend 0.25 pour 25%
                        }

                        return value;
                    });
                    XLSX.utils.sheet_add_aoa(ws, [row], { origin: `A${rowCursor}` });

                    // style pinned (gris)
                    for (let c = 0; c < colCount; c++) {
                        const cellAddr = XLSX.utils.encode_cell({ r: rowCursor - 1, c });
                        if (!ws[cellAddr]) continue;
                        const isPoids = pinned.data?.FAMILLE === 'Poids du stock';

                        ws[cellAddr].s = {
                            font: { bold: true },
                            fill: { patternType: "solid", fgColor: { rgb: "EAEAEA" } },
                            numFmt: isPoids ? "0.0%" : "#,##0"
                        };
                    }

                    rowCursor++;
                }
            });

            // Largeurs colonnes (optionnel)
            ws["!cols"] = ws["!cols"] || [];
            // on met une largeur "propre" par défaut
            const maxCols = 50;
            for (let i = 0; i < maxCols; i++) ws["!cols"][i] = { wch: 16 };

            XLSX.utils.book_append_sheet(wb, ws, "Stock");
            XLSX.writeFile(wb, "Stock_LogTex.xlsx");
        };

        window.onBtExportExcel = function () {

            const blocks = [
                { id: 'grid_all', title: 'Stock – Tous statuts' },
                { id: 'grid_a1',  title: 'Stock – A1' },
                { id: 'grid_a2',  title: 'Stock – A2' },
                { id: 'grid_r',   title: 'Stock – R' }
            ];

            window.AgGridCommon.exportAllGridsOneSheet(
                blocks,
                'Stock_LogTex.xlsx'
            );
        };
    </script>
{% endblock %}
