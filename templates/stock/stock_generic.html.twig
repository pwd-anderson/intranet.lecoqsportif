{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Import ag-Grid CSS #}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/excel-loader.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }
        .ag-text-field-input {
            color: #000000 !important;
        }

        .statusLate {
            background-color: #f8d7da !important;
            color: #721c24 !important;
            font-weight: bold;
        }

        .grid-wrapper {
            position: relative;
            min-height: 1000px;
        }

        .grid-custom-loader {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            z-index: 10;
        }

        .grid-loader-spinner {
            width: 42px;
            height: 42px;
            border: 4px solid #d9d9d9;
            border-top: 4px solid #024185;
            border-radius: 50%;
            animation: gridSpin 0.8s linear infinite;
            margin-bottom: 12px;
        }

        .grid-loader-text {
            font-size: 14px;
            color: #555;
        }

        @keyframes gridSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .grid-actions-hidden {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .grid-actions-visible {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            transition: opacity 0.2s ease-in-out;
        }

        {# ##### Grid loader avec % ##### #}
        .grid-loader-bar-track {
            height: 8px;
            background: #e0e0e0;
            border-radius: 99px;
            overflow: hidden;
        }

        .grid-loader-bar-fill {
            height: 100%;
            width: 0%;
            background: #024185;
            border-radius: 99px;
            transition: width 0.3s ease;
        }

        .grid-loader-percent-text {
            font-size: 13px;
            color: #024185;
            font-weight: 600;
            margin-top: 6px;
        }

        {# colonne photo #}
        .best-demand-photo-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 0 !important;
        }

        .ag-theme-alpine .ag-cell.best-demand-photo-cell {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .best-demand-photo-cell img {
            width: 118px;
            height: 85px;
            object-fit: contain;
            display: block;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div id="gridOuterContainer" class="grid-outer-container">
                        <div id="gridInnerContainer" class="grid-inner-container">

                            <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                                <h3 class="box-title mb-0">{{ title }}</h3>
                                <div id="gridActions" class="d-flex align-items-center gap-2 mt-2 mt-md-0 grid-actions-hidden">
                                    {% if type == 'stock_composant' %}
                                        <select id="familleSelect"
                                                class="form-select form-select-sm"
                                                style="width:200px;">
                                            <option value="">Toutes les familles</option>
                                        </select>
                                    {% endif %}
                                    {% if type == 'stock_allocation' %}
                                        <select id="siteGroupSelect"
                                                class="form-select form-select-sm"
                                                style="width:220px;">
                                            <option value="">Global</option>
                                            <option value="central">Entrepôts centraux</option>
                                            <option value="magasins">Magasins</option>
                                            <option value="concept_stores">Concept Stores</option>
                                            <option value="factory_outlets">Factory Outlets</option>
                                        </select>
                                    {% endif %}
                                    {% if type == 'stock_produits' %}
                                        <select id="collectionSelect" class="form-select form-select-sm" style="width:160px;">
                                            {# Plus d'option "Toutes les collections" — choix obligatoire #}
                                        </select>

                                        <select id="familleSelect" class="form-select form-select-sm" style="width:160px;">
                                            <option value="">Toutes les familles</option>
                                        </select>

                                        <select id="genreSelect" class="form-select form-select-sm" style="width:160px;">
                                            <option value="">Tous les genres</option>
                                        </select>
                                    {% endif %}
                                    <button id="saveGridConfigBtn" class="waves-effect waves-light btn btn-sm  bg-gradient-success" type="button">Save</button>
                                    <button id="resetGridConfigBtn" class="waves-effect waves-light btn btn-sm  bg-gradient-secondary" type="button">Reset</button>
                                    <button id="exportBtn" class="btn btn-primary btn-sm" type="button" onclick="onBtExportExcel()">Excel</button>
                                    <span id="rowCount" class="text-muted small"></span>
                                </div>
                            </div>
                            <!-- /.box-header -->

                            <div class="box-body">
                                <div class="table-responsive-sm">
                                    <div id="myGridWrapper" class="grid-wrapper">
                                        <div id="gridCustomLoader" class="grid-custom-loader">
                                            <div class="grid-loader-spinner"></div>
                                            <div class="grid-loader-text">Chargement de la grille...</div>
                                            <div class="grid-loader-bar-track" style="width: 220px; margin-top: 12px;">
                                                <div id="gridLoaderBarFill" class="grid-loader-bar-fill"></div>
                                            </div>
                                            <div id="gridLoaderPercent" class="grid-loader-percent-text">0%</div>
                                        </div>

                                        <div id="myGrid" class="ag-theme-alpine" style="height: 1000px; visibility: hidden;"></div>
                                    </div>
                                </div>
                            </div>

                        </div>  {# /gridInnerContainer #}
                    </div>  {# /gridOuterContainer #}

                </div>  {# /box #}
            </div>
        </div>
        {{ include('components/_excel_loader.html.twig') }}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-community.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=2.0"></script>
    <script src="{{ asset('assets/js/pages/exceljs.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/fileSaver.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/excel-export-standard.js') }}"></script>
    <script src="{{ asset('assets/js/pages/excel-export-with-photo.js') }}"></script>

    <script>
        const currentYear = new Date().getFullYear();
        const gridWidthMode = '{{ gridWidthMode|default("full") }}';

        const columnDefs = {{ columns|json_encode|raw }};

        columnDefs.forEach(col => {

            // helper pour ajouter une classe sans écraser
            function addCellClass(col, newClass) {

                if (!col.cellClass) {
                    col.cellClass = newClass;
                    return;
                }

                if (Array.isArray(col.cellClass)) {
                    col.cellClass.push(newClass);
                } else {
                    col.cellClass = [col.cellClass, newClass];
                }
            }

            // Format % pour dépréciation
            if (col.field === 'TAUX_DEPRECIATION') {
                col.valueFormatter = 'percentFormatter';
                col.comparator = 'percentComparator';
                addCellClass(col, 'excelPercentColumn');
            }

            // Colonne réévaluation en vert clair
            if (col.field === 'VALEUR_REEVALUATION') {
                addCellClass(col, 'excelReevalColumn');
            }

            if (col.field === 'PHOTO') {
                col.width = 120;
                col.minWidth = 120;
                col.maxWidth = 120;
                col.sortable = false;
                col.filter = false;
                col.resizable = false;
                col.cellClass = 'best-demand-photo-cell';

                col.cellRenderer = function (params) {
                    if (!params.value) {
                        return '';
                    }

                    const escapedUrl = String(params.value).replace(/"/g, '&quot;');

                    return `
            <img
            src="${escapedUrl}"
            alt="photo article"
            style="width:118px; height:85px; object-fit:contain; display:block;"
            data-fallback-step="0"
            onerror="
                const step = parseInt(this.dataset.fallbackStep, 10);
                if (step === 0) {
                    this.dataset.fallbackStep = '1';
                    this.src = this.src.replace('_2.jpg', '_new_1.jpg');
                } else if (step === 1) {
                    this.dataset.fallbackStep = '2';
                    this.src = this.src.replace('_new_1.jpg', '_1.jpg');
                } else {
                    this.style.display = 'none';
                }
            "
        />
        `;
                };
            }

        });

        const agGridConfig = {
            columnDefs: columnDefs,
            dataUrl: '{{ dataUrl }}',
            numericColumns: {{ numericColumns|json_encode|raw }},
            integerColumns: {{ integerColumns|json_encode|raw }},
            totalColumns: {{ totalColumns|json_encode|raw }},
            headerClass: 'excelHeaderBlue',
            stateKey: 'aggrid-state-{{ type }}-user-{{ app.user.id|default("local") }}-v1',
            getRowHeight: function () {
                return '{{ type }}' === 'stock_produits' ? 90 : 42;
            },

            excelStyles: [
                {
                    id: 'excelHeaderBlue',
                    font: { bold: true, color: '#FFFFFF' },
                    alignment: { horizontal: 'Center' },
                    interior: { color: '#024185', pattern: 'Solid' }
                },

                {
                    id: 'excelPercentColumn',
                    interior: { color: '#baedbc', pattern: 'Solid' },
                    font: { color: '#1B5E20' }
                }
            ]
        };

        document.addEventListener('DOMContentLoaded', () => {
            window.gridOptions = window.AgGridCommon.initGrid('#myGrid', agGridConfig);
            window.AgGridCommon.patchSidebarCheckboxes('#myGrid');

            const saveConfigModalEl = document.getElementById('modal-save-config-aggrid');
            const saveConfigModal = new bootstrap.Modal(saveConfigModalEl);

            window.onBtExportExcel = async function () {

                await ExcelExportStandard.export(
                    window.gridOptions,
                    '{{ title|replace({" ": "_"}) }}.xlsx',
                    {
                        processCellCallback: (p) => {
                            const field = p.column.getColId();
                            if (field === 'TAUX_DEPRECIATION') {
                                if (p.value == null || p.value === '') return '';
                                return (Number(p.value) * 100).toFixed(0) + ' %';
                            }
                            return p.value;
                        }
                    }
                );
            };

            document.getElementById('saveGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.saveGridState(window.gridOptions, agGridConfig.stateKey);
                saveConfigModal.show();
            });

            document.getElementById('resetGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.clearGridState(agGridConfig.stateKey);
                location.reload();
            });

            // === Init filtres stock_produits ===
            if ('{{ type }}' === 'stock_produits') {
                const collectionSelect = document.getElementById('collectionSelect');
                const familleSelectSP  = document.getElementById('familleSelect');
                const genreSelect      = document.getElementById('genreSelect');

                // Charger les collections
                if (collectionSelect) {
                    fetch('{{ path("stock_collections_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(collection => {
                                const option = document.createElement('option');
                                option.value = collection;
                                option.textContent = collection;
                                if (collection === '2026-01-SS') {
                                    option.selected = true;
                                }
                                collectionSelect.appendChild(option);
                            });
                        });
                }

                // Charger les familles (réutilise stock_familles_json existant)
                if (familleSelectSP) {
                    fetch('{{ path("stock_familles_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(famille => {
                                const option = document.createElement('option');
                                option.value = famille;
                                option.textContent = famille;
                                familleSelectSP.appendChild(option);
                            });
                        });
                }

                // Charger les genres
                if (genreSelect) {
                    fetch('{{ path("stock_genres_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(genre => {
                                const option = document.createElement('option');
                                option.value = genre;
                                option.textContent = genre;
                                genreSelect.appendChild(option);
                            });
                        });
                }

                // Recharger la grille avec les filtres
                [collectionSelect, familleSelectSP, genreSelect].forEach(select => {
                    if (select) {
                        select.addEventListener('change', reloadGridWithProduitsFilters);
                    }
                });
            }

            // Existant — à scoper :
            if ('{{ type }}' === 'stock_composant') {
                const familleSelect = document.getElementById('familleSelect');

                if (familleSelect) {
                    fetch('{{ path("stock_familles_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(famille => {
                                const option = document.createElement('option');
                                option.value = famille;
                                option.textContent = famille;
                                familleSelect.appendChild(option);
                            });
                        });

                    familleSelect.addEventListener('change', function () {
                        reloadGridWithFamille(this.value);
                    });
                }
            }

            const siteGroupSelect = document.getElementById('siteGroupSelect');

            if (siteGroupSelect) {
                siteGroupSelect.addEventListener('change', function () {
                    reloadGridWithSiteGroup(this.value);
                });
            }

            window.AgGridCommon.setupAutoWidth(window.gridOptions, {
                widthMode: gridWidthMode,
            });

            window.AgGridCommon.setupAutoHeight(window.gridOptions, {
                gridSelector: '#myGrid',
                maxHeight: 1000,
            });
        });

        function reloadGridWithFamille(famille) {

            let url = '{{ dataUrl }}';

            if (famille) {
                url += '?famille=' + encodeURIComponent(famille);
            }

            window.AgGridCommon.reloadData(
                window.gridOptions,
                url,
                {{ totalColumns|json_encode|raw }}
            );
        }

        function reloadGridWithSiteGroup(siteGroup) {

            let url = '{{ dataUrl }}';

            if (siteGroup) {
                url += '?siteGroup=' + encodeURIComponent(siteGroup);
            }

            window.AgGridCommon.reloadData(
                window.gridOptions,
                url,
                {{ totalColumns|json_encode|raw }}
            );
        }

        function reloadGridWithProduitsFilters() {
            const collection = document.getElementById('collectionSelect')?.value || '';
            const famille    = document.getElementById('familleSelect')?.value || '';
            const genre      = document.getElementById('genreSelect')?.value || '';

            const url = new URL('{{ dataUrl }}', window.location.origin);

            if (collection) url.searchParams.set('collection', collection);
            if (famille)    url.searchParams.set('famille', famille);
            if (genre)      url.searchParams.set('genre', genre);

            window.AgGridCommon.reloadData(
                window.gridOptions,
                url.toString(),
                {{ totalColumns|json_encode|raw }}
            );
        }
    </script>
{% endblock %}
