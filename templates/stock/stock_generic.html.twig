{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Import ag-Grid CSS #}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }
        .ag-text-field-input {
            color: #000000 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">

                    <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                        <h3 class="box-title mb-0">{{ title }}</h3>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            </select>
                            {% if type == 'stock_composant' %}
                                <select id="familleSelect"
                                        class="form-select form-select-sm"
                                        style="width:200px;">
                                    <option value="">Toutes les familles</option>
                                </select>
                            {% endif %}
                            <button id="exportBtn" class="btn btn-primary btn-sm" type="button" onclick="onBtExportExcel()">Excel</button>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="table-responsive-sm">
                            <div id="myGrid" class="ag-theme-alpine" style="height: 1000px;"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-community.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=1.5"></script>

    <script>
        const currentYear = new Date().getFullYear();

        const columnDefs = {{ columns|json_encode|raw }};

        columnDefs.forEach(col => {

            // helper pour ajouter une classe sans écraser
            function addCellClass(col, newClass) {

                if (!col.cellClass) {
                    col.cellClass = newClass;
                    return;
                }

                if (Array.isArray(col.cellClass)) {
                    col.cellClass.push(newClass);
                } else {
                    col.cellClass = [col.cellClass, newClass];
                }
            }

            // Format % pour dépréciation
            if (col.field === 'TAUX_DEPRECIATION') {
                col.valueFormatter = 'percentFormatter';
                col.comparator = 'percentComparator';
                addCellClass(col, 'excelPercentColumn');
            }

            // Colonne réévaluation en vert clair
            if (col.field === 'VALEUR_REEVALUATION') {
                addCellClass(col, 'excelReevalColumn');
            }

        });

        const agGridConfig = {
            columnDefs: columnDefs,
            dataUrl: '{{ dataUrl }}',
            numericColumns: {{ numericColumns|json_encode|raw }},
            integerColumns: {{ integerColumns|json_encode|raw }},
            totalColumns: {{ totalColumns|json_encode|raw }},
            headerClass: 'excelHeaderBlue',

            excelStyles: [
                {
                    id: 'excelHeaderBlue',
                    font: { bold: true, color: '#FFFFFF' },
                    alignment: { horizontal: 'Center' },
                    interior: { color: '#024185', pattern: 'Solid' }
                },

                {
                    id: 'excelPercentColumn',
                    interior: { color: '#baedbc', pattern: 'Solid' },
                    font: { color: '#1B5E20' }
                }
            ]
        };

        document.addEventListener('DOMContentLoaded', () => {
            window.gridOptions = window.AgGridCommon.initGrid('#myGrid', agGridConfig);

            window.onBtExportExcel = function () {

                window.gridOptions.api.exportDataAsExcel({
                    fileName: '{{ title|replace({" ": "_"}) }}.xlsx',

                    // ✅ Utilise automatiquement le headerName venant de la DB (agridoption)
                    processHeaderCallback: p => p.column.getColDef().headerName,

                    // ✅ Gestion spéciale pour le %
                    processCellCallback: (p) => {
                        const field = p.column.getColId();

                        if (field === 'TAUX_DEPRECIATION') {
                            if (p.value == null || p.value === '') return '';
                            return (Number(p.value) * 100).toFixed(0) + ' %';
                        }

                        return p.value;
                    }
                });
            };

            const familleSelect = document.getElementById('familleSelect');

            if (familleSelect) {

                fetch('{{ path("stock_familles_json") }}')
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(famille => {
                            const option = document.createElement('option');
                            option.value = famille;
                            option.textContent = famille;
                            familleSelect.appendChild(option);
                        });
                    });

                familleSelect.addEventListener('change', function () {
                    reloadGridWithFamille(this.value);
                });
            }
        });

        function reloadGridWithFamille(famille) {

            let url = '{{ dataUrl }}';

            if (famille) {
                url += '?famille=' + encodeURIComponent(famille);
            }

            window.AgGridCommon.reloadData(
                window.gridOptions,
                url,
                {{ totalColumns|json_encode|raw }}
            );
        }
    </script>
{% endblock %}
