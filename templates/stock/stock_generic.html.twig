{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    {# Import ag-Grid CSS #}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }
        .ag-text-field-input {
            color: #000000 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">

                    <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                        <h3 class="box-title mb-0">{{ title }}</h3>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            </select>
                            {% if type == 'stock_composant' %}
                                <select id="familleSelect"
                                        class="form-select form-select-sm"
                                        style="width:200px;">
                                    <option value="">Toutes les familles</option>
                                </select>
                            {% endif %}
                            <button id="exportBtn" class="btn btn-primary btn-sm" type="button" onclick="onBtExportExcel()">Excel</button>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>
                    <!-- /.box-header -->
                    <div class="box-body">
                        <div class="table-responsive-sm">
                            <div id="myGrid" class="ag-theme-alpine" style="height: 1000px;"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-community.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}"></script>

    <script>
        const currentYear = new Date().getFullYear();

        const columnDefs = {{ columns|json_encode|raw }};

        // Helpers
        function getMonthIndexFromField(field) {
            // attend: STOCK_A_TERME_M, STOCK_A_TERME_M_1, STOCK_A_TERME_M_2 ...
            // -> 0 pour M, 1 pour M_1, etc.
            const m = field.match(/_M(?:_(\d+))?$/);
            if (!m) return null;
            return m[1] ? parseInt(m[1], 10) : 0;
        }

        function monthSuffix(idx) {
            return idx === 0 ? '_M' : `_M_${idx}`;
        }

        function num(v) {
            if (v === undefined || v === null || v === '') return 0;
            if (typeof v === 'string') {
                v = v
                    .replace(/\u202F/g, '') // narrow no-break space
                    .replace(/\u00A0/g, '') // no-break space
                    .replace(/\s/g, '')     // espaces
                    .replace(',', '.');     // virgule décimale
            }
            const n = Number(v);
            return Number.isFinite(n) ? n : 0;
        }

        // 1) On récupère les colonnes calculées STOCK_A_TERME et on les trie par mois
        const stockCols = columnDefs
            .filter(c => c.computed === true && c.field?.startsWith('STOCK_A_TERME'))
            .map(c => ({ col: c, idx: getMonthIndexFromField(c.field) }))
            .filter(x => x.idx !== null) // garde uniquement celles qui matchent _M / _M_1...
            .sort((a, b) => a.idx - b.idx);

        // 2) On injecte un valueGetter cumulatif
        stockCols.forEach((item, chainPos) => {
            const col = item.col;
            const monthIdx = item.idx;
            const suf = monthSuffix(monthIdx);

            col.valueGetter = params => {
                const data = params.data;
                if (!data) return 0;

                // cache par ligne
                if (!data.__stockATermeCache) data.__stockATermeCache = {};

                if (data.__stockATermeCache[col.field] !== undefined) {
                    return data.__stockATermeCache[col.field];
                }

                // base = Stock_actuel pour M, sinon valeur du mois précédent
                let base;
                if (chainPos === 0) {
                    base = num(data.Stock_actuel);
                } else {
                    const prevField = stockCols[chainPos - 1].col.field;
                    base = num(data.__stockATermeCache[prevField]);
                }

                const buy = num(data[`BUY_MOIS${suf}`]);
                const sales = num(data[`SALES_MOIS${suf}`]);
                const resaRetail = num(data[`RESA_RETAIL_MOIS${suf}`]);

                const value = base + buy - sales - resaRetail;

                data.__stockATermeCache[col.field] = value;
                return value;
            };

            col.aggFunc = 'sum';
            col.type = 'numericColumn';
        });

        const agGridConfig = {
            columnDefs: columnDefs,
            dataUrl: '{{ dataUrl }}',
            numericColumns: {{ numericColumns|json_encode|raw }},
            integerColumns: {{ integerColumns|json_encode|raw }},
            totalColumns: {{ totalColumns|json_encode|raw }}
        };

        document.addEventListener('DOMContentLoaded', () => {
            window.gridOptions = window.AgGridCommon.initGrid('#myGrid', agGridConfig);

            const familleSelect = document.getElementById('familleSelect');

            if (familleSelect) {

                fetch('{{ path("stock_familles_json") }}')
                    .then(res => res.json())
                    .then(data => {
                        data.forEach(famille => {
                            const option = document.createElement('option');
                            option.value = famille;
                            option.textContent = famille;
                            familleSelect.appendChild(option);
                        });
                    });

                familleSelect.addEventListener('change', function () {
                    reloadGridWithFamille(this.value);
                });
            }
        });

        function reloadGridWithFamille(famille) {

            let url = '{{ dataUrl }}';

            if (famille) {
                url += '?famille=' + encodeURIComponent(famille);
            }

            window.AgGridCommon.reloadData(
                window.gridOptions,
                url,
                {{ totalColumns|json_encode|raw }}
            );
        }
    </script>
{% endblock %}
