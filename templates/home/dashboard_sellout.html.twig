{% extends 'base.html.twig' %}

{% block stylesheets %}
    <style>
        .min-h-box     { min-height: 440px; }
        .max-h-box     { max-height: 440px; }

        @media (max-width: 767px) {
            .min-h-box { min-height: auto; }
        }

        .scroll-table {
            max-height: 440px;
            overflow-y: auto;
            scrollbar-width: none;
        }
        .scroll-table::-webkit-scrollbar { width: 0; background: transparent; }

        .top-product-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }
        .top-product-img {
            width: 55px;
            height: 55px;
            object-fit: cover;
            border-radius: 8px;
            flex-shrink: 0;
        }
        .top-product-info  { flex: 1; }
        .top-product-label {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .top-product-bar-container {
            width: 100%;
            height: 10px;
            background: #f1f1f1;
            border-radius: 6px;
            overflow: hidden;
        }
        .top-product-bar {
            height: 100%;
            background: linear-gradient(90deg, #0f9b8e, #ff6f59);
            border-radius: 6px;
            transition: width 0.6s ease;
        }
        .top-product-value {
            font-weight: 600;
            font-size: 14px;
            min-width: 90px;
            text-align: right;
        }

        .min-h-248-box { min-height: 280px; }
        .max-h-248-box { max-height: 280px; }

        .so-row1-box,
        .so-row1-box .box-body {
            height: 100%;
            display: flex;
            flex-direction: column;
        }

        .so-row1-col { margin-bottom: 22px; }

        .titre-evolution { margin-bottom: 2.8%; }
    </style>
{% endblock %}

{% block title %}Sell Out | {{ 'site.title'|trans }}{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">

            {# ── Row 1 : Ventes (barres + companion) | CA Famille | Ventes semaine ── #}

            {# Ventes hebdomadaires — barres groupées + companion annuel (large) #}
            <div class="col-lg-9 col-md-12 so-row1-col">
                <div class="box min-h-248-box so-row1-box">
                    <div class="box-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="box-title mb-0">Ventes {{ "now"|date("Y") }} vs {{ ("now"|date("Y")) - 1 }} <small>(semaine par semaine)</small></h6>
                            <span id="so-variation-ytd" class="small"></span>
                        </div>
                        <div class="d-flex gap-3">
                            <div style="flex: 3; min-width: 0;">
                                <div class="text-muted small mb-1">CA Hebdomadaire</div>
                                <div id="so-chart-weekly"></div>
                            </div>
                            <div style="flex: 1; min-width: 160px;">
                                <div class="text-muted small mb-1">CA Annuel</div>
                                <div id="so-chart-annuel"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Ventes de la semaine — barres par source #}
            <div class="col-lg-3 col-md-6 so-row1-col">
                <div class="box min-h-248-box so-row1-box">
                    <div class="box-body">
                        <h6 class="box-title">Ventes semaine <span id="so-semaine-num" class="text-info fw-bold">—</span></h6>
                        <div class="d-flex d-lg-block d-xl-flex align-items-end">
                            <h3 class="mb-0 me-5" id="so-ca-semaine">—</h3>
                            <p class="mb-0" id="so-variation-semaine"></p>
                        </div>
                        <div id="so-chart-semaine"></div>
                    </div>
                </div>
            </div>

            {# ── Row 2 : Top clients | Répartition famille | Top produits toggle ── #}

            {# Top clients #}
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body pt-10 pb-10">
                        <span class="text-muted small">CA par enseigne {{ "now"|date("Y") }}</span>
                        <div id="so-chart-top-clients" style="height:360px;"></div>
                    </div>
                </div>
            </div>

            {# Répartition CA par famille #}
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body text-center p-10">
                        <span class="text-muted small">Répartition CA {{ "now"|date("Y") }} par famille</span>
                        <div id="so-chart-famille" class="mb-20"></div>
                        <div id="so-table-famille"></div>
                    </div>
                </div>
            </div>

            {# Top produits — toggle FTW / Textile #}
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Top produits ({{ "now"|date("Y") }})</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button id="so-btn-top-ftw" class="btn btn-primary btn-sm active" onclick="soSwitchTopProduit('FTW')">Footwear</button>
                                <button id="so-btn-top-apl" class="btn btn-outline-primary btn-sm" onclick="soSwitchTopProduit('APL')">Textile</button>
                            </div>
                        </div>
                        <div id="so-chart-top-product" class="mt-3 top-product-container"></div>
                    </div>
                </div>
            </div>

            {# ── Row 3 : Backlog | Évolution 12 semaines ── #}

            {# Répartition backlog #}
            <div class="col-lg-4 col-md-6">
                <div class="box">
                    <div class="box-body text-center p-10">
                        <span class="text-muted small">Répartition backlog (INTERSPORT + SPORT2000)</span>
                        <div id="so-chart-backlog" class="mb-20"></div>
                        <div id="so-table-backlog"></div>
                    </div>
                </div>
            </div>

            {# Évolution CA 12 semaines — barres + companion totaux #}
            <div class="col-lg-8 col-md-6">
                <div class="box">
                    <div class="box-body">
                        <span class="text-muted small">Évolution du CA — 12 semaines glissantes</span>
                        <div class="d-flex gap-3 mt-1">
                            <div style="flex: 3; min-width: 0;">
                                <div id="so-chart-evolution"></div>
                            </div>
                            <div style="flex: 1; min-width: 140px;">
                                <div class="text-muted small mb-1">Total par année</div>
                                <div id="so-chart-evolution-totals"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </section>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('assets/js/dashboard.js') }}?v=3.1"></script>
    <script src="{{ asset('assets/js/dashboard_sellout.js') }}?v=2.2"></script>
    <script>
        $(function () {
            'use strict';

            window.Apex = { markers: { size: 0 } };

            window.sellOutRoutes = {
                ventesAnnuelles:   "{{ path('api_sellout_ventes_annuelles') }}",
                ventesSemaine:     "{{ path('api_sellout_ventes_semaine') }}",
                topClients:        "{{ path('api_sellout_top_clients') }}",
                familleCa:         "{{ path('api_sellout_famille_ca') }}",
                topProduits:       "{{ path('api_sellout_top_produits') }}",
                backlog:           "{{ path('api_sellout_backlog') }}",
                evolutionSemaines: "{{ path('api_sellout_evolution_semaines') }}"
            };

            loadSellOutDashboardData();
        });
    </script>
{% endblock %}
