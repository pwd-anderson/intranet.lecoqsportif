            {% for grp in ecom_groups %}
            <div class="row mb-3" style="display:flex; align-items:stretch;">
                <div class="col-12 mb-1 mt-2 d-flex align-items-center gap-2">
                    <span class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em">{{ grp.label }}</span>
                    {% if grp.stores is defined %}
                    <select id="ecom-{{ grp.id }}-filter" onchange="onEcomFilterChange('{{ grp.id }}')" style="border:1px solid #dee2e6;border-radius:4px;background:transparent;font-size:11px;color:#6c757d;cursor:pointer;padding:1px 6px;outline:none;appearance:auto;">
                        <option value="">Tous</option>
                        {% for store in grp.stores %}
                        <option value="{{ store.id }}">{{ store.label }}</option>
                        {% endfor %}
                    </select>
                    {% endif %}
                </div>
                <div class="col-lg-8" style="display:flex; flex-direction:column;">
                    <div class="box" style="flex:1; margin-bottom:0;">
                        <div class="box-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="box-title mb-0">Ventes {{ "now"|date("Y") }} <small>(EUR)</small></h6>
                                <span id="ecom-{{ grp.id }}-variation" class="small"></span>
                            </div>
                            <div class="d-flex gap-3">
                                <div style="flex: 3; min-width: 0;">
                                    <div class="text-muted small mb-1">CA Mensuel</div>
