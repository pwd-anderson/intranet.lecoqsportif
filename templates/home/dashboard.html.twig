                    { id: '2319',  label: 'Clearance' },
                ]},
                { id: 'affilies', label: 'Magasins Affiliés', stores: [
                    { id: '7754',  label: 'Bayonne' },
                    { id: '20425', label: 'Cabourg' },
                    { id: '20966', label: 'Cagnes-sur-Mer' },
                    { id: '20969', label: 'Saint-Jean-de-Luz' },
                ]},
                { id: 'outlet',   label: 'Factory Outlet', stores: [
                    { id: '11159', label: 'Miramas' },
                    { id: '9735',  label: 'Roppenheim' },
                    { id: '8606',  label: 'Roubaix' },
                    { id: '9822',  label: 'Troyes' },
                    { id: '11026', label: 'Villefontaine' },
