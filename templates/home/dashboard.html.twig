{% extends 'base.html.twig' %}
{% block stylesheets %}
    <style>
        /* Hauteur minimum pour aligner les boîtes sur desktop */
        .min-h-box {
            min-height: 440px;
        }

        .max-h-box {
            max-height: 440px;
        }

        .min-h-248-box {
            min-height: 280px;
        }

        .max-h-248-box {
            max-height: 280px;
        }

        /* Sur mobile (écran < 768px), on réduit la hauteur min pour éviter les espaces inutiles */
        @media (max-width: 767px) {
            .min-h-box {
                min-height: auto;
            }
        }

        .scroll-table {
            max-height: 440px;
            overflow-y: auto;
            scrollbar-width: none; /* Firefox */
        }

        .scroll-table::-webkit-scrollbar {
            width: 0px; /* Chrome/Safari */
            background: transparent;
        }

        .ct-bar-tooltip {
            position: relative;
            cursor: pointer;
        }

        .ct-bar-tooltip:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translate(-50%, -6px);
            background: rgba(0, 0, 0, 0.75);
            color: #fff;
            padding: 3px 8px;
            border-radius: 4px;
            white-space: nowrap;
            font-size: 12px;
            z-index: 10;
        }

        .chartist-tooltip {
            position: absolute;
            display: none;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 6px 10px;
            font-size: 12px;
            border-radius: 4px;
            pointer-events: none;
            white-space: nowrap;
            z-index: 100;
        }

        .top-product-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .top-product-img {
            width: 55px;
            height: 55px;
            object-fit: cover;
            border-radius: 8px;
            flex-shrink: 0;
        }

        .top-product-info {
            flex: 1;
        }

        .top-product-label {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .top-product-bar-container {
            width: 100%;
            height: 10px;
            background: #f1f1f1;
            border-radius: 6px;
            overflow: hidden;
        }

        .top-product-bar {
            height: 100%;
            background: linear-gradient(90deg, #00b894, #00cec9);
            border-radius: 6px;
            transition: width 0.6s ease;
        }

        .top-product-value {
            font-weight: 600;
            font-size: 14px;
            min-width: 90px;
            text-align: right;
        }

        #apex-legend-sales {
            margin-bottom: 1%;
            margin-top: 2.4%;
        }
        .titre-evolution {
            margin-bottom: 2.8%;
        }

    </style>
{% endblock %}

{% block title %}{{ 'dashboard.title'|trans }} | {{ 'site.title'|trans }}{% endblock %}

{% block body %}
    <section class="content">
        <!-- Traductions utilisées dans JS (dashboard.js) -->
        <span id="trans_variation_month" data-text="{{ 'dashboard.variation_text_month'|trans }}"></span>

        {# ── STANDARD DASHBOARD ── #}
        <div id="dashboard-standard">
        <div class="row">

            <!-- Bloc Ventes Année — large, barres mensuelles + annuelles -->
            <div class="col-lg-9 col-md-12">
                <div class="box min-h-248-box">
                    <div class="box-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="box-title mb-0">{{ 'dashboard.ventes.title'|trans }} <small>(EUR)</small></h6>
                            <span id="variation" class="small"></span>
                        </div>
                        <div class="d-flex gap-3">
                            <div style="flex: 3; min-width: 0;">
                                <div class="text-muted small mb-1">CA Mensuel</div>
                                <div id="chart-ca-mensuel"></div>
                            </div>
                            <div style="flex: 1; min-width: 160px;">
                                <div class="text-muted small mb-1">CA Annuel</div>
                                <div id="chart-ca-annuel"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Blocs Jour -->
            <div class="col-lg-3 col-md-6">
                <div class="box min-h-248-box">
                    <div class="box-body text-center" style="display: flex; flex-direction: column; justify-content: center;">
                        <div class="kpi-ca mb-1">
                            <p class="mb-1 fs-16 text-uppercase">CA du J-1 <small>(EUR)</small></p>
                            <h2 id="ca-jour-kpi" class="countnm mb-1">—</h2>
                            <p class="text-muted fs-15 mb-0"></p>
                        </div>
                        <div class="kpi-chart mt-1" style="margin-top: auto;">
                            <i class="fa fa-calendar-day fa-3x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TOP Client -->
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body pt-10 pb-10">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Top 10 Clients {{ "now"|date("Y") }}</span>
                        </div>
                        <div id="chart-top-clients" style="height: 360px;"></div>
                    </div>
                </div>
            </div>

            <!-- Répartition CA par famille -->
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body text-center p-10">
                        <span class="text-muted small">Répartition CA {{ "now"|date("Y") }} par famille</span>
                        <div id="chart-top-family-sales" class="mb-20"></div>
                        <div id="table-top-family-sales"></div>
                    </div>
                </div>
            </div>

            <!-- Top produits — toggle FTW / Textile -->
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted small">Top produits ({{ "now"|date("Y") }})</span>
                            <div class="btn-group btn-group-sm" role="group">
                                <button id="btn-top-ftw" class="btn btn-primary btn-sm active" onclick="switchTopProduit('FTW')">Footwear</button>
                                <button id="btn-top-apl" class="btn btn-outline-primary btn-sm" onclick="switchTopProduit('APL')">Textile</button>
                            </div>
                        </div>
                        <div id="chart-top-product" class="mt-3 top-product-container"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="box">
                    <div class="box-body text-center p-10">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Répartition backlog clients</span>
                        </div>
                        <div id="chart-backlog-client" class="mb-20"></div>
                        <div id="table-backlog-client"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-md-6">
                <div class="box">
                    <div class="box-body">
                        <span class="text-muted small">Évolution du CA sur 5 ans</span>
                        <div class="d-flex gap-3 mt-1">
                            <div style="flex: 3; min-width: 0;">
                                <div id="userflow"></div>
                            </div>
                            <div style="flex: 1; min-width: 140px;">
                                <div class="text-muted small mb-1">Total par année</div>
                                <div id="chart-ca-5y-totals"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        </div>{# /dashboard-standard #}

        {# ── BOUTIQUE GROUPS ── #}
        <div id="dashboard-boutique" style="display:none">
            {% set boutique_groups = [
                { id: 'propres',  label: 'Magasins propres' },
                { id: 'affilies', label: 'Magasins Affiliés' },
                { id: 'outlet',   label: 'Factory Outlet' },
            ] %}
            {% for grp in boutique_groups %}
            <div class="row mb-3" style="display:flex; align-items:stretch;">
                <div class="col-12 mb-1 mt-2">
                    <span class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em">{{ grp.label }}</span>
                </div>
                <div class="col-lg-8" style="display:flex; flex-direction:column;">
                    <div class="box" style="flex:1; margin-bottom:0;">
                        <div class="box-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="box-title mb-0">Ventes {{ "now"|date("Y") }} <small>(EUR)</small></h6>
                                <span id="boutique-{{ grp.id }}-variation" class="small"></span>
                            </div>
                            <div class="d-flex gap-3">
                                <div style="flex: 3; min-width: 0;">
                                    <div class="text-muted small mb-1">CA Mensuel</div>
                                    <div id="boutique-{{ grp.id }}-mensuel"></div>
                                </div>
                                <div style="flex: 1; min-width: 160px;">
                                    <div class="text-muted small mb-1">CA Annuel</div>
                                    <div id="boutique-{{ grp.id }}-annuel"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4" style="display:flex; flex-direction:column;">
                    <div class="box" style="flex:1; margin-bottom:0;">
                        <div class="box-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-muted small">Top produits {{ "now"|date("Y") }}</span>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button id="boutique-{{ grp.id }}-btn-ftw"
                                            class="btn btn-primary btn-sm active"
                                            onclick="switchBoutiqueTopProduit('{{ grp.id }}', 'FTW')">Footwear</button>
                                    <button id="boutique-{{ grp.id }}-btn-apl"
                                            class="btn btn-outline-primary btn-sm"
                                            onclick="switchBoutiqueTopProduit('{{ grp.id }}', 'APL')">Textile</button>
                                </div>
                            </div>
                            <div id="boutique-{{ grp.id }}-product" class="mt-2 top-product-container"></div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>{# /dashboard-boutique #}

    </section>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('assets/js/dashboard.js') }}?v=3.4"></script>
    <script>
        $(function () {

            'use strict';

            window.Apex = {
                markers: {
                    size: 0
                }
            };


            window.dashboardRoutes = {
                caParMois: '{{ path("api_dashboard_ca_par_mois") }}',
                salesCurrentMonth: '{{ path("api_dashboard_sales_current_month") }}',
                topClients: '{{ path("api_dashboard_top_clients") }}',
                topFamilySales: '{{ path("api_dashboard_top_family_sales") }}',
                topProductSales: '{{ path("api_dashboard_top_product_sales") }}',
                salesEvolution5y: '{{ path("api_dashboard_sales_evolution_5y") }}',
                caToday: '{{ path("api_dashboard_ca_today") }}',
                backlogClient: '{{ path("api_dashboard_backlog_client") }}',
                boutiqueGroupVentes: '{{ path("api_dashboard_boutique_group_ventes") }}',
                boutiqueGroupTopProduits: '{{ path("api_dashboard_boutique_group_top_produits") }}'
            };

            const networkSelect = document.querySelector('#network-switcher select');

            if (networkSelect) {
                if (networkSelect.options.length > 0) {
                    networkSelect.value = networkSelect.options[0].value;
                }

                networkSelect.addEventListener('change', function () {
                    loadDashboardData();
                });
            }

            loadDashboardData();
        });
    </script>
{% endblock %}
