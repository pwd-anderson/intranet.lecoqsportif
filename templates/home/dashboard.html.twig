                                    <button id="boutique-{{ grp.id }}-btn-apl"
                                            class="btn btn-outline-primary btn-sm"
                                            onclick="switchBoutiqueTopProduit('{{ grp.id }}', 'APL')">Textile</button>
                                </div>
                            </div>
                            <div id="boutique-{{ grp.id }}-product" class="mt-2 top-product-container"></div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>{# /dashboard-boutique #}

        {# ── E-COM GROUPS ── #}
        <div id="dashboard-ecom" style="display:none">

            {# Row Global : chart 8 séries #}
            <div class="row mb-3" style="display:flex; align-items:stretch;">
                <div class="col-12 mb-1 mt-2">
                    <span class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em">Global E-com</span>
                </div>
                <div class="col-lg-8" style="display:flex; flex-direction:column;">
                    <div class="box" style="flex:1; margin-bottom:0;">
                        <div class="box-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="box-title mb-0">Ventes {{ "now"|date("Y") }} <small>(EUR)</small></h6>
                                <span id="ecom-global-variation" class="small"></span>
                            </div>
                            <div class="d-flex gap-3">
                                <div style="flex: 3; min-width: 0;">
                                    <div class="text-muted small mb-1">CA Mensuel</div>
                                    <div id="ecom-global-mensuel"></div>
                                </div>
                                <div style="flex: 1; min-width: 160px;">
                                    <div class="text-muted small mb-1">CA Annuel</div>
                                    <div id="ecom-global-annuel"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4" style="display:flex; flex-direction:column;">
                    <div class="box" style="flex:1; margin-bottom:0;">
                        <div class="box-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-1">
                                    <button id="ecom-global-title-top" class="btn btn-primary btn-sm active" style="font-size:11px;padding:1px 7px;" onclick="switchEcomFamilleMode('global', 'top')">Top produits</button>
                                    <button id="ecom-global-btn-famille" class="btn btn-outline-secondary btn-sm" style="font-size:11px;padding:1px 7px;" onclick="switchEcomFamilleMode('global')">Rép. par famille</button>
                                </div>
                                <div id="ecom-global-btn-group-famille" class="btn-group btn-group-sm" role="group">
                                    <button id="ecom-global-btn-ftw" class="btn btn-primary btn-sm active" onclick="switchEcomTopProduit('global','FTW')">Footwear</button>
                                    <button id="ecom-global-btn-apl" class="btn btn-outline-primary btn-sm" onclick="switchEcomTopProduit('global','APL')">Textile</button>
                                </div>
                            </div>
                            <div id="ecom-global-product" class="mt-2 top-product-container"></div>
                            <div id="ecom-global-famille" class="mt-2" style="display:none;"></div>
                            <div id="ecom-global-famille-table" style="display:none;font-size:12px;"></div>
                        </div>
                    </div>
                </div>
            </div>

