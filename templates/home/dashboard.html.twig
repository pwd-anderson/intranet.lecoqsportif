                                    <button id="ecom-{{ grp.id }}-btn-famille" class="btn btn-outline-secondary btn-sm" style="font-size:11px;padding:1px 7px;" onclick="switchEcomFamilleMode('{{ grp.id }}')">Rép. par famille</button>
                                </div>
                                <div id="ecom-{{ grp.id }}-btn-group-famille" class="btn-group btn-group-sm" role="group">
                                    <button id="ecom-{{ grp.id }}-btn-ftw" class="btn btn-primary btn-sm active" onclick="switchEcomTopProduit('{{ grp.id }}','FTW')">Footwear</button>
                                    <button id="ecom-{{ grp.id }}-btn-apl" class="btn btn-outline-primary btn-sm" onclick="switchEcomTopProduit('{{ grp.id }}','APL')">Textile</button>
                                </div>
                            </div>
                            <div id="ecom-{{ grp.id }}-product" class="mt-2 top-product-container"></div>
                            <div id="ecom-{{ grp.id }}-famille" class="mt-2" style="display:none;"></div>
                            <div id="ecom-{{ grp.id }}-famille-table" style="display:none;font-size:12px;"></div>
                        </div>
                    </div>
                </div>
            </div>
            {% endfor %}

            {# Blocs globaux E-com #}
            <div class="row mb-3">
                <div class="col-12 mb-1 mt-2">
                    <span class="fw-semibold text-muted small text-uppercase" style="letter-spacing:.05em">Global E-com — Synthèse</span>
                </div>

                {# Top clients #}
                <div class="col-lg-4 col-md-6">
                    <div class="box min-h-box">
                        <div class="box-body pt-10 pb-10">
                            <span class="text-muted small">Top 10 Clients E-com {{ "now"|date("Y") }}</span>
                            <div id="ecom-chart-top-clients" style="height:360px;"></div>
                        </div>
                    </div>
                </div>

                {# Évolution CA 5 ans #}
                <div class="col-lg-8 col-md-6">
                    <div class="box min-h-box">
                        <div class="box-body">
                            <span class="text-muted small">Évolution du CA sur 5 ans</span>
                            <div class="d-flex gap-3 mt-1">
                                <div style="flex:3; min-width:0;">
                                    <div id="ecom-userflow"></div>
                                </div>
                                <div style="flex:1; min-width:100px;">
                                    <div class="text-muted small mb-1">Total par année</div>
                                    <div id="ecom-chart-ca-5y-totals"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>{# /dashboard-ecom #}

    </section>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('assets/js/dashboard.js') }}?v=4.6"></script>
    <script>
        $(function () {

            'use strict';

            window.Apex = {
                markers: {
                    size: 0
                }
            };


            window.dashboardRoutes = {
                caParMois: '{{ path("api_dashboard_ca_par_mois") }}',
                salesCurrentMonth: '{{ path("api_dashboard_sales_current_month") }}',
                topClients: '{{ path("api_dashboard_top_clients") }}',
                topFamilySales: '{{ path("api_dashboard_top_family_sales") }}',
                topProductSales: '{{ path("api_dashboard_top_product_sales") }}',
                salesEvolution5y: '{{ path("api_dashboard_sales_evolution_5y") }}',
                caToday: '{{ path("api_dashboard_ca_today") }}',
                backlogClient: '{{ path("api_dashboard_backlog_client") }}',
                boutiqueGroupVentes: '{{ path("api_dashboard_boutique_group_ventes") }}',
                boutiqueGroupTopProduits: '{{ path("api_dashboard_boutique_group_top_produits") }}',
                ecomGroupVentes: '{{ path("api_dashboard_ecom_group_ventes") }}',
                ecomGlobalVentes: '{{ path("api_dashboard_ecom_global_ventes") }}',
                ecomGroupTopProduits: '{{ path("api_dashboard_ecom_group_top_produits") }}',
                ecomGroupFamilySales: '{{ path("api_dashboard_ecom_group_family_sales") }}'
            };

            const networkSelect = document.querySelector('#network-switcher select');

            if (networkSelect) {
                if (networkSelect.options.length > 0) {
                    networkSelect.value = networkSelect.options[0].value;
                }

                networkSelect.addEventListener('change', function () {
                    loadDashboardData();
                });
            }

            loadDashboardData();
        });
    </script>
{% endblock %}
