{% extends 'base.html.twig' %}
{% block stylesheets %}
    <style>
        /* Hauteur minimum pour aligner les boîtes sur desktop */
        .min-h-box {
            min-height: 440px;
        }

        .max-h-box {
            max-height: 440px;
        }

        .min-h-248-box {
            min-height: 248px;
        }

        .max-h-248-box {
            max-height: 248px;
        }

        /* Sur mobile (écran < 768px), on réduit la hauteur min pour éviter les espaces inutiles */
        @media (max-width: 767px) {
            .min-h-box {
                min-height: auto;
            }
        }

        .scroll-table {
            max-height: 440px;
            overflow-y: auto;
            scrollbar-width: none; /* Firefox */
        }

        .scroll-table::-webkit-scrollbar {
            width: 0px; /* Chrome/Safari */
            background: transparent;
        }

        .ct-bar-tooltip {
            position: relative;
            cursor: pointer;
        }

        .ct-bar-tooltip:hover::after {
            content: attr(data-tooltip);
            position: absolute;
            bottom: 100%;
            left: 50%;
            transform: translate(-50%, -6px);
            background: rgba(0, 0, 0, 0.75);
            color: #fff;
            padding: 3px 8px;
            border-radius: 4px;
            white-space: nowrap;
            font-size: 12px;
            z-index: 10;
        }

        .chartist-tooltip {
            position: absolute;
            display: none;
            background: rgba(0, 0, 0, 0.8);
            color: white;
            padding: 6px 10px;
            font-size: 12px;
            border-radius: 4px;
            pointer-events: none;
            white-space: nowrap;
            z-index: 100;
        }

        .top-product-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .top-product-img {
            width: 55px;
            height: 55px;
            object-fit: cover;
            border-radius: 8px;
            flex-shrink: 0;
        }

        .top-product-info {
            flex: 1;
        }

        .top-product-label {
            font-size: 14px;
            font-weight: 500;
            margin-bottom: 6px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .top-product-bar-container {
            width: 100%;
            height: 10px;
            background: #f1f1f1;
            border-radius: 6px;
            overflow: hidden;
        }

        .top-product-bar {
            height: 100%;
            background: linear-gradient(90deg, #00b894, #00cec9);
            border-radius: 6px;
            transition: width 0.6s ease;
        }

        .top-product-value {
            font-weight: 600;
            font-size: 14px;
            min-width: 90px;
            text-align: right;
        }

        #apex-legend-sales {
            margin-bottom: 1%;
            margin-top: 2.4%;
        }
        .titre-evolution {
            margin-bottom: 2.8%;
        }

    </style>
{% endblock %}

{% block title %}{{ 'dashboard.title'|trans }} | {{ 'site.title'|trans }}{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <!-- Traductions utilisées dans JS (dashboard.js) -->
            <span id="trans_variation_month" data-text="{{ 'dashboard.variation_text_month'|trans }}"></span>

            <div class="col-lg-3 col-md-6">
                <div class="box min-h-248-box">
                    <div class="box-body">
                        <h6 class="box-title">{{ 'dashboard.conversion.title'|trans }} :
                            <span class="fw-bold text-info">1 EUR = <span id="taux-eur-usd-text"></span> USD</span>
                        </h6>
                        <div class="d-flex d-lg-block d-xl-flex align-items-end">
                            <h3 class="mb-0 me-5" id="taux-eur-usd-val"></h3>
                            <p class="mb-0" id="evolution-rate-eur-usd-text"></p>
                        </div>
                        <div id="bar-negative-chart-eur-usd"></div>
                    </div>
                </div>
            </div>
            <!-- Blocs Ventes Année en cours -->
            <div class="col-lg-3 col-md-6">
                <div class="box min-h-248-box">
                    <div class="box-body">
                        <h6 class="box-title">{{ 'dashboard.ventes.title'|trans }} {{ "now"|date("Y") }} <small>(EUR)</small></h6>
                        <div class="d-flex d-lg-block d-xl-flex align-items-end">
                            <h3 class="mb-0 me-5" id="ca_n"></h3>
                            <p class="mb-0"><span class="text-danger" id="variation"><i class="fa fa-arrow-down"></i></span></p>
                        </div>
                        <div id="primary-line-chart"></div>
                    </div>
                </div>
            </div>
            <!-- Blocs Mois en cours -->
            <div class="col-lg-3 col-md-6">
                <div class="box min-h-248-box">
                    <div class="box-body">
                        <h6 class="box-title">{{ 'dashboard.ventes.title'|trans }} {{ "now"|date("m/Y") }} <small>(EUR)</small></h6>
                        <div class="d-flex d-lg-block d-xl-flex align-items-end">
                            <h3 class="mb-0 me-5" id="ca_nm">–</h3>
                            <p class="mb-0" id="variation_m">–</p>
                        </div>
                        <div id="warning-line-chart"></div>
                    </div>
                </div>
            </div>

            <!-- Blocs Jour -->
            <div class="col-lg-3 col-md-6">
                <div class="box min-h-248-box">
                    <div class="box-body text-center" style="display: flex; flex-direction: column; justify-content: center;">
                        <div class="kpi-ca mb-1">
                            <p class="mb-1 fs-16 text-uppercase">CA du J-1 <small>(EUR)</small></p>
                            <h2 id="ca-jour-kpi" class="countnm mb-1">—</h2>
                            <p class="text-muted fs-15 mb-0"></p>
                        </div>
                        <div class="kpi-chart mt-1" style="margin-top: auto;">
                            <i class="fa fa-calendar-day fa-3x text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- TOP Client -->
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body pt-10 pb-10">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Top 10 Clients {{ "now"|date("Y") }}</span>
                        </div>
                        <div id="chart-top-clients" style="height: 360px;"></div>
                    </div>
                </div>
            </div>

            <!-- CA par famille -->
            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body text-center p-10">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Répartition CA {{ "now"|date("Y") }} par famille</span>
                        </div>
                        <div id="chart-top-family-sales" class="mb-20"></div>
                        <div id="table-top-family-sales"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="box min-h-box">
                    <div class="box-body">
                        <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">
                    Produits les plus vendus ({{ "now"|date("Y") }})
                </span>
                        </div>

                        <div id="chart-top-product-sales" class="mt-3 top-product-container"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="box">
                    <div class="box-body text-center p-10">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted small">Répartition backlog clients</span>
                        </div>
                        <div id="chart-backlog-client" class="mb-20"></div>
                        <div id="table-backlog-client"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-md-6">
                <div class="box">
                    <div class="box-body">
                        <div class="d-flex justify-content-between align-items-center titre-evolution">
                            <span class="text-muted small">Évolution du CA sur 5 ans</span>
                        </div>
                        <div id="userflow"></div>
                        <div id="apex-legend-sales" class="d-flex flex-wrap gap-4 justify-content-center small"></div>
                    </div>
                </div>
            </div>

        </div>
    </section>
{% endblock %}
{% block javascripts %}
    <script>
        $(function () {

            'use strict';

            window.Apex = {
                markers: {
                    size: 0
                }
            };

            const exchangeUrlEurUsd = "{{ path('api_dashboard_exchange_rate', { currency: 'EUR' }) }}";

            chargerConversionChart(exchangeUrlEurUsd, {
                text: '#taux-eur-usd-text',
                value: '#taux-eur-usd-val',
                evolution: '#evolution-rate-eur-usd-text'
            }, '#bar-negative-chart-eur-usd', ['#2e62b9', '#fad050']);

            renderBacklogClientChart(
                '{{ path("api_dashboard_backlog_client") }}',
                '#chart-backlog-client',
                '#table-backlog-client'
            );

            window.dashboardRoutes = {
                caParMois: '{{ path("api_dashboard_ca_par_mois") }}',
                salesCurrentMonth: '{{ path("api_dashboard_sales_current_month") }}',
                topClients: '{{ path("api_dashboard_top_clients") }}',
                topFamilySales: '{{ path("api_dashboard_top_family_sales") }}',
                topProductSales: '{{ path("api_dashboard_top_product_sales") }}',
                salesEvolution5y: '{{ path("api_dashboard_sales_evolution_5y") }}',
                caToday: '{{ path("api_dashboard_ca_today") }}'
            };

            const networkSelect = document.querySelector('#network-switcher select');

            if (networkSelect) {
                networkSelect.value = 'global';

                networkSelect.addEventListener('change', function () {
                    loadDashboardData();
                });
            }

            loadDashboardData();
        });
    </script>
{% endblock %}
