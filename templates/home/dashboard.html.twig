                { id: 'amazon_vendor', label: 'Amazon Vendor' },
                { id: 'amazon_seller', label: 'Amazon Seller' },
                { id: 'autres_mkp',    label: 'Autres Marketplaces', stores: [
                    { id: 'veepee',          label: 'Veepee' },
                    { id: '21407',           label: 'Showroomprive.com' },
                    { id: '21449',           label: 'Private Sport Shop' },
                    { id: '21450',           label: 'Vertbaudet' },
                    { id: '21451',           label: 'Decathlon' },
                    { id: '2301',            label: 'La Redoute' },
                    { id: '2497',            label: 'Les Galeries Lafayette' },
                ]},
                { id: 'ecom_btb',      label: 'E-commerce BTB', stores: [
                    { id: '3054',  label: 'The Agent' },
                    { id: '7023',  label: 'Spartoo' },
                    { id: '7271',  label: 'Sarenza' },
                    { id: '9953',  label: 'La Boutique Officielle' },
                ]},
