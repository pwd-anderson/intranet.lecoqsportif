{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/excel-loader.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }
        .ag-text-field-input { color: #000000 !important; }

        .grid-wrapper { position: relative; min-height: 500px; }

        .grid-custom-loader {
            position: absolute; inset: 0;
            display: none; flex-direction: column;
            align-items: center; justify-content: center;
            background: #ffffff; z-index: 10;
        }
        .grid-loader-spinner {
            width: 42px; height: 42px;
            border: 4px solid #d9d9d9;
            border-top: 4px solid #024185;
            border-radius: 50%;
            animation: gridSpin 0.8s linear infinite;
            margin-bottom: 12px;
        }
        @keyframes gridSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .grid-loader-text { font-size: 14px; color: #555; }
        .grid-loader-bar-track { height: 8px; background: #e0e0e0; border-radius: 99px; overflow: hidden; }
        .grid-loader-bar-fill { height: 100%; width: 0%; background: #024185; border-radius: 99px; transition: width 0.3s ease; }
        .grid-loader-percent-text { font-size: 13px; color: #024185; font-weight: 600; margin-top: 6px; }

        .grid-actions-hidden { visibility: hidden; opacity: 0; pointer-events: none; }
        .grid-actions-visible { visibility: visible; opacity: 1; pointer-events: auto; transition: opacity 0.2s ease-in-out; }

        .scc-search-block {
            margin: 14px 15px 4px;
            padding: 16px 20px 14px;
            background: #f5f8fc;
            border: 1px solid #dbe3ee;
            border-left: 4px solid #024185;
            border-radius: 6px;
        }
        .scc-search-title {
            font-size: 12px; font-weight: 700; letter-spacing: .06em;
            text-transform: uppercase; color: #024185; margin-bottom: 10px;
        }
        .scc-search-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(160px, 1fr)) auto;
            gap: 14px 16px;
            align-items: end;
        }
        .scc-field { display: flex; flex-direction: column; min-width: 0; }
        .scc-field label { font-size: 12.5px; font-weight: 600; color: #3d4753; margin-bottom: 4px; }
        .scc-field input { width: 100%; background: #fff; }
        .scc-buttons { display: flex; gap: 8px; }
        .scc-period {
            grid-column: 1 / -1;
            display: flex; align-items: flex-end; flex-wrap: wrap; gap: 10px 14px;
            padding-top: 10px; border-top: 1px dashed #cfd9e6;
        }
        .scc-period .scc-period-title { font-size: 12.5px; font-weight: 700; color: #024185; align-self: center; margin-right: 4px; }
        .scc-period .scc-or { font-size: 12.5px; color: #6b7683; padding-bottom: 6px; }
        .scc-period select { min-width: 170px; background-color: #fff; }
        /* Numeros de document : lien PDF (actif) ou meme rendu non cliquable (document pas encore dispo) */
        .scc-doc-link { color: #024185; text-decoration: underline; font-weight: 600; }
        a.scc-doc-link:hover { color: #40a2ed; }
        span.scc-doc-link--off { text-decoration: underline dotted; color: #5b7aa6; cursor: default; }
        .scc-pdf-icon { width: 13px; height: 16px; vertical-align: -3px; margin-right: 6px; }
        #sccHint { color: #c8102e; font-size: 12.5px; min-height: 18px; margin-top: 8px; }
        @media (max-width: 1100px) {
            .scc-search-grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); }
            .scc-buttons { grid-column: 1 / -1; }
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">

                    <div class="box-header with-border d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <h3 class="box-title mb-0">{{ title }}</h3>

                        <div id="gridActions" class="d-flex align-items-center gap-2 grid-actions-hidden">
                            <button id="saveGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-success" type="button">Save</button>
                            <button id="resetGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-secondary" type="button">Reset</button>
                            <button id="exportBtn" class="btn btn-primary btn-sm" type="button">Excel</button>
                            <button id="exportCsvBtn" class="btn btn-primary btn-sm" type="button" title="Toutes les lignes de la recherche en cours, sans la limite d'affichage">CSV complet</button>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>

                    <div class="scc-search-block">
                        <div class="scc-search-title">Recherche</div>
                        <form id="sccForm" autocomplete="off" novalidate>
                            <div class="scc-search-grid">
                                <div class="scc-field">
                                    <label for="sccNumCommande">N° Commande</label>
                                    <input id="sccNumCommande" name="NUM_COMMANDE" type="text" class="form-control form-control-sm" maxlength="40">
                                </div>
                                <div class="scc-field">
                                    <label for="sccNumBonPrepa">N° Bon de prépa</label>
                                    <input id="sccNumBonPrepa" name="NUM_BON_PREPA" type="text" class="form-control form-control-sm" maxlength="40">
                                </div>
                                <div class="scc-field">
                                    <label for="sccNumLivraison">N° Livraison</label>
                                    <input id="sccNumLivraison" name="NUM_LIVRAISON" type="text" class="form-control form-control-sm" maxlength="40">
                                </div>
                                <div class="scc-field">
                                    <label for="sccNumFacture">N° Facture</label>
                                    <input id="sccNumFacture" name="NUM_FACTURE" type="text" class="form-control form-control-sm" maxlength="40">
                                </div>
                                <div class="scc-buttons">
                                    <button id="sccSearchBtn" class="btn btn-primary btn-sm" type="submit">Rechercher</button>
                                    <button id="sccResetBtn" class="btn btn-secondary btn-sm" type="button">Réinitialiser</button>
                                </div>

                                <div class="scc-period">
                                    <span class="scc-period-title">Période</span>
                                    <div class="scc-field">
                                        <label for="sccPeriodMonths">Derniers mois</label>
                                        <select id="sccPeriodMonths" name="period_months" class="form-select form-select-sm">
                                            <option value="">—</option>
                                            <option value="3">3 derniers mois</option>
                                            <option value="6">6 derniers mois</option>
                                            <option value="12">12 derniers mois</option>
                                            <option value="18">18 derniers mois</option>
                                            <option value="24">24 derniers mois</option>
                                            <option value="30">30 derniers mois</option>
                                        </select>
                                    </div>
                                    <span class="scc-or">ou</span>
                                    <div class="scc-field">
                                        <label for="sccPeriodYear">Année</label>
                                        <select id="sccPeriodYear" name="period_year" class="form-select form-select-sm">
                                            <option value="">—</option>
                                            {% for y in periodYears %}
                                                <option value="{{ y }}">{{ y }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </form>
                        <div id="sccHint"></div>
                    </div>

                    <div class="box-body pt-2">
                        <div id="myGridWrapper" class="grid-wrapper">
                            <div id="gridCustomLoader" class="grid-custom-loader">
                                <div class="grid-loader-spinner"></div>
                                <div class="grid-loader-text">Recherche en cours...</div>
                                <div class="grid-loader-bar-track" style="width: 220px; margin-top: 12px;">
                                    <div id="gridLoaderBarFill" class="grid-loader-bar-fill"></div>
                                </div>
                                <div id="gridLoaderPercent" class="grid-loader-percent-text">0%</div>
                            </div>
                            <div id="myGrid" class="ag-theme-alpine" style="height: 500px; width: 100%;"></div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
        <div class="modal fade" id="sccBpModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Bon de préparation <span id="sccBpTitle"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <div id="sccBpState" class="text-muted"></div>
                        <table id="sccBpTable" class="table table-sm table-striped" style="display:none;">
                            <thead>
                                <tr><th>N° colis</th><th>Article</th><th>Description</th><th class="text-end">Qté</th><th class="text-end">Poids</th></tr>
                            </thead>
                            <tbody></tbody>
                            <tfoot>
                                <tr class="fw-bold"><td colspan="3">Total</td><td id="sccBpTotQty" class="text-end"></td><td id="sccBpTotWei" class="text-end"></td></tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
                    </div>
                </div>
            </div>
        </div>
        {{ include('components/_excel_loader.html.twig') }}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=2.5"></script>
    <script src="{{ asset('assets/js/pages/exceljs.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/fileSaver.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/excel-export-standard.js') }}?v=2"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            const DATA_URL = '{{ dataUrl }}';
            const STATE_KEY = 'aggrid-state-suivi-complet-commande-user-{{ app.user.id|default("local") }}-v1';
            const TOTAL_COLUMNS = {{ totalColumns|json_encode|raw }};
            const MSG_INVITE = 'Renseignez une période et/ou au moins un numéro, puis cliquez sur « Rechercher ».';
            const MSG_AUCUN = 'Aucun résultat pour cette recherche.';

            const form = document.getElementById('sccForm');
            const hint = document.getElementById('sccHint');
            const saveConfigModal = new bootstrap.Modal(document.getElementById('modal-save-config-aggrid'));

            const DOC_LINKS = {{ docLinks|json_encode|raw }};
            const columnDefs = {{ columns|json_encode|raw }};

            // N° commande / livraison / facture : lien PDF SharePoint si l'URL est configuree
            // (DOC_LINKS[champ] = prefixe), sinon meme apparence mais non cliquable.
            // Nom du fichier SharePoint : {numero}-{client}.pdf ; client = colonne CLIENT (client commande) pour la
            // commande et la livraison, CLIENT_FACTURE (client facture, souvent different) pour la facture. Sans client,
            // le nom exact est inconnu : pas de lien cliquable plutot qu'un lien casse.
            const DOC_CLIENT_FIELD = { NUM_COMMANDE: 'CLIENT', NUM_LIVRAISON: 'CLIENT', NUM_FACTURE: 'CLIENT_FACTURE' };
            // DOM construit via textContent : la valeur n'est jamais interpretee comme du HTML.
            function pdfIcon() {
                const NS = 'http://www.w3.org/2000/svg';
                const svg = document.createElementNS(NS, 'svg');
                svg.setAttribute('viewBox', '0 0 16 20');
                svg.setAttribute('class', 'scc-pdf-icon');
                svg.setAttribute('aria-hidden', 'true');

                const page = document.createElementNS(NS, 'path');
                page.setAttribute('d', 'M2 0h8l6 6v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2z');
                page.setAttribute('fill', '#d93025');

                const fold = document.createElementNS(NS, 'path');
                fold.setAttribute('d', 'M10 0l6 6h-5a1 1 0 0 1-1-1V0z');
                fold.setAttribute('fill', '#f4a6a0');

                const label = document.createElementNS(NS, 'text');
                label.setAttribute('x', '8');
                label.setAttribute('y', '16');
                label.setAttribute('text-anchor', 'middle');
                label.setAttribute('font-size', '6');
                label.setAttribute('font-weight', '700');
                label.setAttribute('font-family', 'Arial, sans-serif');
                label.setAttribute('fill', '#ffffff');
                label.textContent = 'PDF';

                svg.append(page, fold, label);
                return svg;
            }

            function docLinkRenderer(prefix, clientField) {
                return function (params) {
                    const value = params.value;
                    if (value === null || value === undefined || String(value).trim() === '') {
                        return '';
                    }
                    const text = String(value).trim();
                    const rawClient = params.data ? params.data[clientField] : null;
                    const client = rawClient !== null && rawClient !== undefined ? String(rawClient).trim() : '';

                    if (prefix && client !== '') {
                        const a = document.createElement('a');
                        a.className = 'scc-doc-link';
                        a.href = prefix + encodeURIComponent(text + '-' + client) + '.pdf';
                        a.target = '_blank';
                        a.rel = 'noopener';
                        a.append(pdfIcon(), document.createTextNode(text));
                        return a;
                    }

                    const span = document.createElement('span');
                    span.className = 'scc-doc-link scc-doc-link--off';
                    span.title = 'Document bientôt disponible';
                    span.append(pdfIcon(), document.createTextNode(text));
                    return span;
                };
            }

            columnDefs.forEach(function (col) {
                if (Object.prototype.hasOwnProperty.call(DOC_LINKS, col.field)) {
                    col.cellRenderer = docLinkRenderer(DOC_LINKS[col.field], DOC_CLIENT_FIELD[col.field] || 'CLIENT');
                }
            });

            // N° bon de prepa : lien (info-bulle) qui ouvre le detail du bon dans une fenetre Bootstrap.
            const BP_URL = {{ path('sales_suivi_complet_commande_bon_prepa')|json_encode|raw }};
            const bpModalEl = document.getElementById('sccBpModal');
            const bpModal = new bootstrap.Modal(bpModalEl);
            const nf = new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 3 });
            let bpRequest = 0;

            function openBpDetail(num) {
                const state = document.getElementById('sccBpState');
                const table = document.getElementById('sccBpTable');
                const tbody = table.querySelector('tbody');
                document.getElementById('sccBpTitle').textContent = num;
                tbody.replaceChildren();
                table.style.display = 'none';
                state.textContent = 'Chargement…';
                bpModal.show();

                const mine = ++bpRequest;
                fetch(BP_URL + '?num=' + encodeURIComponent(num))
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (rows) {
                        if (mine !== bpRequest) return;
                        if (rows.length === 0) { state.textContent = 'Aucun détail trouvé pour ce bon de préparation.'; return; }
                        let qty = 0, wei = 0;
                        rows.forEach(function (row) {
                            qty += Number(row.QTE) || 0;
                            wei += Number(row.POIDS) || 0;
                            const tr = document.createElement('tr');
                            [row.N_COLIS, row.ARTICLE, row.DESCRIPTION, nf.format(Number(row.QTE) || 0), nf.format(Number(row.POIDS) || 0)].forEach(function (v, i) {
                                const td = document.createElement('td');
                                td.textContent = v === null || v === undefined ? '' : String(v);
                                if (i >= 3) td.className = 'text-end';
                                tr.appendChild(td);
                            });
                            tbody.appendChild(tr);
                        });
                        document.getElementById('sccBpTotQty').textContent = nf.format(qty);
                        document.getElementById('sccBpTotWei').textContent = nf.format(wei);
                        // Sans n° de colis : bon pas encore expédié, on montre les lignes préparées.
                        state.textContent = rows.every(function (r) { return !r.N_COLIS; })
                            ? 'Bon non expédié : pas encore de colis, voici les lignes préparées.'
                            : '';
                        table.style.display = '';
                    })
                    .catch(function () { if (mine === bpRequest) state.textContent = 'Impossible de charger le détail du bon.'; });
            }

            columnDefs.forEach(function (col) {
                if (col.field !== 'NUM_BON_PREPA') return;
                col.cellRenderer = function (params) {
                    const text = params.value === null || params.value === undefined ? '' : String(params.value).trim();
                    if (text === '') return '';
                    const a = document.createElement('a');
                    a.href = '#';
                    a.className = 'scc-doc-link';
                    a.title = 'Voir le détail du bon de préparation';
                    a.textContent = text;
                    a.addEventListener('click', function (e) { e.preventDefault(); openBpDetail(text); });
                    return a;
                };
            });

            const agGridConfig = {
                columnDefs:     columnDefs,
                dataUrl:        null,
                numericColumns: {{ numericColumns|json_encode|raw }},
                integerColumns: {{ integerColumns|json_encode|raw }},
                totalColumns:   TOTAL_COLUMNS,
                extraOptions: {
                    overlayNoRowsTemplate: '<span id="sccNoRows" class="ag-overlay-no-rows-center">' + MSG_INVITE + '</span>',
                },
            };

            const gridOptions = window.AgGridCommon.initGrid('#myGrid', agGridConfig);
            window.gridOptions = gridOptions;
            gridOptions.api.showNoRowsOverlay();

            function setNoRowsMessage(message) {
                const el = document.getElementById('sccNoRows');
                if (el) el.textContent = message;
            }

            const periodMonths = document.getElementById('sccPeriodMonths');
            const periodYear = document.getElementById('sccPeriodYear');

            // Les deux choix de période sont exclusifs : en choisir un vide l'autre.
            periodMonths.addEventListener('change', function () { if (periodMonths.value) periodYear.value = ''; });
            periodYear.addEventListener('change', function () { if (periodYear.value) periodMonths.value = ''; });

            function collectFilters() {
                const params = new URLSearchParams();
                new FormData(form).forEach(function (value, key) {
                    if (key === 'period_months' || key === 'period_year') return;
                    const v = String(value).trim();
                    if (v !== '') params.set(key, v);
                });
                if (periodMonths.value) {
                    params.set('period_type', 'months');
                    params.set('period_value', periodMonths.value);
                } else if (periodYear.value) {
                    params.set('period_type', 'year');
                    params.set('period_value', periodYear.value);
                }
                return params;
            }

            function search() {
                const params = collectFilters();

                if ([...params.keys()].length === 0) {
                    hint.textContent = 'Choisissez une période ou renseignez au moins un des 4 champs pour lancer la recherche.';
                    return;
                }
                hint.textContent = '';

                window.AgGridCommon.hideGridActions();
                window.AgGridCommon.showGridLoader('#myGrid');

                fetch(DATA_URL + '?' + params.toString())
                    .then(function (r) {
                        // Le serveur coupe un résultat trop gros (les lignes les plus récentes sont gardées) et le signale par cet en-tête.
                        const cap = r.headers.get('X-Result-Truncated');
                        hint.textContent = cap
                            ? 'Résultat limité aux ' + Number(cap).toLocaleString('fr-FR') + ' lignes les plus récentes : choisissez une période plus courte ou cherchez par numéro pour tout voir.'
                            : '';
                        return r.json();
                    })
                    .then(function (data) {
                        gridOptions.api.setRowData(data);
                        window.AgGridCommon.loadGridState(gridOptions, STATE_KEY);
                        window.AgGridCommon.updateTotals(gridOptions, TOTAL_COLUMNS);
                        window.AgGridCommon.hideGridLoader('#myGrid');

                        if (data.length === 0) {
                            gridOptions.api.showNoRowsOverlay();
                            setNoRowsMessage(MSG_AUCUN);
                        } else {
                            gridOptions.api.hideOverlay();
                            window.AgGridCommon.showGridActions();
                        }
                    })
                    .catch(function (err) {
                        console.error(err);
                        gridOptions.api.setRowData([]);
                        window.AgGridCommon.hideGridLoader('#myGrid');
                        gridOptions.api.showNoRowsOverlay();
                        setNoRowsMessage('Erreur lors de la recherche.');
                    });
            }

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                search();
            });

            document.getElementById('sccResetBtn').addEventListener('click', function () {
                form.reset();
                hint.textContent = '';
                gridOptions.api.setRowData([]);
                window.AgGridCommon.hideGridActions();
                document.getElementById('rowCount').textContent = '';
                gridOptions.api.showNoRowsOverlay();
                setNoRowsMessage(MSG_INVITE);
            });

            document.getElementById('saveGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.saveGridState(gridOptions, STATE_KEY);
                saveConfigModal.show();
            });

            document.getElementById('resetGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.clearGridState(STATE_KEY);
                location.reload();
            });

            // CSV complet : relance la recherche affichee cote serveur, sans plafond de lignes.
            document.getElementById('exportCsvBtn').addEventListener('click', function () {
                const params = collectFilters();
                if ([...params.keys()].length === 0) return;
                window.location.href = {{ path('sales_suivi_complet_commande_export_csv')|json_encode|raw }} + '?' + params.toString();
            });

            document.getElementById('exportBtn').addEventListener('click', async function () {
                await ExcelExportStandard.export(gridOptions, 'suivi_complet_commande.xlsx');
            });
        });
    </script>
{% endblock %}
