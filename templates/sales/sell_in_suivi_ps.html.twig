{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/excel-loader.css') }}" rel="stylesheet">

    <style>

        .grid-outer-container {
            width: 100%;
        }

        .grid-outer-container.grid-width-auto {
            display: flex;
            justify-content: center;
        }

        .grid-inner-container {
            width: 100%;
        }

        .grid-outer-container.grid-width-auto .grid-inner-container {
            width: auto;
            min-width: 720px;
            max-width: 100%;
        }

        .grid-actions-hidden {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .grid-actions-visible {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            transition: opacity 0.2s ease-in-out;
        }

        /* Loader avec % */
        .grid-loader-bar-track {
            height: 8px;
            background: #e0e0e0;
            border-radius: 99px;
            overflow: hidden;
        }

        .grid-loader-bar-fill {
            height: 100%;
            width: 0%;
            background: #024185;
            border-radius: 99px;
            transition: width 0.3s ease;
        }

        .grid-loader-percent-text {
            font-size: 13px;
            color: #024185;
            font-weight: 600;
            margin-top: 6px;
        }

        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }

        .ag-text-field-input { color: #000000 !important; }

        .grid-wrapper { position: relative; min-height: 1000px; }

        .grid-custom-loader {
            position: absolute; inset: 0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            background: #ffffff; z-index: 10;
        }

        .grid-loader-spinner {
            width: 42px; height: 42px;
            border: 4px solid #d9d9d9;
            border-top: 4px solid #024185;
            border-radius: 50%;
            animation: gridSpin 0.8s linear infinite;
            margin-bottom: 12px;
        }

        .grid-loader-text { font-size: 14px; color: #555; }

        @keyframes gridSpin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        /* Cellules éditables : fond légèrement coloré pour les distinguer */
        .ag-theme-alpine .ag-cell.editable-cell {
            background-color: #fff7e6;
        }

        /* Footer (pinned row) : annule tout fond de cellule pour garder le fond bleu du footer */
        .ag-theme-alpine .ag-row-pinned .ag-cell {
            background-color: transparent !important;
        }

        /* Feedback save */
        .ag-theme-alpine .ag-cell.cell-save-ok {
            background-color: #d4edda !important;
            transition: background-color 0.3s ease;
        }
        .ag-theme-alpine .ag-cell.cell-save-ko {
            background-color: #f8d7da !important;
            transition: background-color 0.3s ease;
        }

        /* Toast simple */
        #saveToast {
            position: fixed; top: 20px; right: 20px;
            padding: 10px 18px; border-radius: 6px;
            color: #fff; font-size: 14px;
            z-index: 9999;
            opacity: 0; pointer-events: none;
            transition: opacity 0.3s ease;
        }
        #saveToast.toast-ok { background-color: #28a745; }
        #saveToast.toast-ko { background-color: #dc3545; }
        #saveToast.visible  { opacity: 1; }

        /* Cellules modifiées mais non encore enregistrées */
        .ag-theme-alpine .ag-cell.cell-pending {
            background-color: #ffe7a8 !important;
            font-weight: 600;
            box-shadow: inset -3px 0 0 #d97706;
        }

        /* ===== RECAP PANEL ===== */
        .recap-panel-body {
            padding: 8px 0 12px;
        }
        .recap-table {
            font-size: 11.5px;
            white-space: nowrap;
            border-collapse: collapse;
        }
        .recap-table thead th {
            background-color: #024185;
            color: #fff;
            padding: 5px 10px;
            font-weight: 600;
            text-align: center;
            border: 1px solid #01316a;
        }
        .recap-table tbody td {
            padding: 3px 10px;
            border: 1px solid #dee2e6;
        }
        .recap-th-label { min-width: 110px; }
        .recap-td-label { min-width: 110px; font-weight: inherit; }
        .recap-th-num, .recap-td-num { min-width: 90px; text-align: right !important; }
        .recap-row-total td {
            font-weight: 700;
            background-color: #1a3c6e;
            color: #fff;
        }
        .recap-row-family td {
            font-weight: 600;
            background-color: #d6e4f7;
            color: #024185;
        }
        .recap-row-gender td {
            background-color: #fff;
        }
        .recap-row-gender .recap-td-label {
            padding-left: 22px;
        }
        .recap-positive { color: #155724 !important; background-color: #c3e6cb !important; }
        .recap-negative { color: #721c24 !important; background-color: #f5c6cb !important; }
        #recapToggleBtn .recap-caret {
            display: inline-block;
            transition: transform 0.2s ease;
            font-size: 10px;
            margin-left: 2px;
        }
        #recapToggleBtn[aria-expanded="true"] .recap-caret {
            transform: rotate(180deg);
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div id="gridOuterContainer" class="grid-outer-container">
                        <div id="gridInnerContainer" class="grid-inner-container">
                            <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                                <h3 class="box-title mb-2">{{ title }}</h3>

                                <div id="gridActions" class="d-flex align-items-center gap-2 mt-2 mt-md-0 grid-actions-hidden">
                                    <button id="saveChangesBtn" class="btn btn-warning btn-sm" type="button" disabled>
                                        💾 Enregistrer
                                        <span id="pendingCount" class="badge bg-dark ms-1" style="display:none;">0</span>
                                    </button>

                                    <button id="saveGridConfigBtn"  class="waves-effect waves-light btn btn-sm bg-gradient-success"  type="button">Save</button>
                                    <button id="resetGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-secondary" type="button">Reset</button>
                                    <button id="exportBtn"          class="btn btn-primary btn-sm" type="button" onclick="onBtExportExcel()">Excel</button>
                                    <button id="recapToggleBtn" class="btn btn-outline-secondary btn-sm" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#recapPanel" aria-expanded="false"
                                            title="Afficher / masquer le récapitulatif">
                                        Récap <span class="recap-caret">&#9660;</span>
                                    </button>
                                    <span id="rowCount" class="text-muted small"></span>
                                </div>
                            </div>

                            <!-- RECAP PANEL (collapsible) -->
                            <div id="recapPanel" class="collapse">
                                <div class="recap-panel-body px-3">
                                    <div class="overflow-auto">
                                        <table id="recapTable" class="recap-table"></table>
                                    </div>
                                </div>
                            </div>

                            <div class="box-body">
                                <div class="table-responsive-sm">
                                    <div id="myGridWrapper" class="grid-wrapper">
                                        <div id="gridCustomLoader" class="grid-custom-loader">
                                            <div class="grid-loader-spinner"></div>
                                            <div class="grid-loader-text">Chargement de la grille...</div>
                                            <div class="grid-loader-bar-track" style="width: 220px; margin-top: 12px;">
                                                <div id="gridLoaderBarFill" class="grid-loader-bar-fill"></div>
                                            </div>
                                            <div id="gridLoaderPercent" class="grid-loader-percent-text">0%</div>
                                        </div>

                                        <div id="myGrid" class="ag-theme-alpine" style="height: 1000px; visibility: hidden;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div id="saveToast"></div>
        {{ include('components/_excel_loader.html.twig') }}

        <!-- Modal session expirée -->
        <div class="modal fade" id="sessionExpiredModal" tabindex="-1" aria-labelledby="sessionExpiredModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title" id="sessionExpiredModalLabel">⚠️ Session expirée</h5>
                    </div>
                    <div class="modal-body">
                        <p>Votre session Office 365 a expiré. <strong>Vos saisies ont été sauvegardées localement</strong> et seront restaurées automatiquement après reconnexion.</p>
                        <p class="text-muted small mb-0">Cliquez sur "Se connecter", connectez-vous dans le nouvel onglet, puis revenez sur cet onglet et cliquez "Réessayer".</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-primary" id="sessionLoginBtn">🔐 Se connecter</button>
                        <button type="button" class="btn btn-success" id="sessionRetryBtn">🔄 Réessayer</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=2.2"></script>
    <script src="{{ asset('assets/js/pages/exceljs.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/fileSaver.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/excel-export-standard.js') }}?v=2"></script>

    <script>
        const columnDefs = {{ columns|json_encode|raw }};

        // Convertit les cellStyle statiques en fonctions pour que le footer (rowPinned)
        // n'hérite pas du backgroundColor des colonnes éditables (texte blanc sur fond clair).
        columnDefs.forEach(col => {
            if (col.cellStyle && typeof col.cellStyle === 'object') {
                const originalStyle = col.cellStyle;
                col.cellStyle = (params) => {
                    if (params.node.rowPinned) {
                        const { backgroundColor, ...rest } = originalStyle;
                        return rest;
                    }
                    return originalStyle;
                };
            }
        });

        const editableFields = ['SIMPLE_STATUS', 'FORECAST', 'TARGET'];
        const saveUrl      = '{{ saveUrl }}';
        const saveBatchUrl = '{{ path('sales_sell_in_suivi_ps_save_batch') }}';
        const dataUrl = '{{ dataUrl }}';

        // Stocke les modifications en attente
        // Clé = CUSTOMER_CODE|CITY|FAMILY|GENDER|SERIESNO|field, valeur = payload complet
        const pendingChanges = new Map();

        // Marquer visuellement les cellules éditables
        columnDefs.forEach(col => {
            if (editableFields.includes(col.field)) {
                // Bypass la détection auto de type d'AG Grid 30+
                col.cellDataType = false;

                // Classe statique
                const existing = col.cellClass;
                const editableClass = 'editable-cell';
                if (!existing) {
                    col.cellClass = editableClass;
                } else if (Array.isArray(existing)) {
                    col.cellClass = [...existing, editableClass];
                } else {
                    col.cellClass = [existing, editableClass];
                }

                col.cellClassRules = {
                    'cell-pending': (params) => {
                        if (!params.data) return false;
                        const key = buildPendingKey(params.data, params.colDef.field);
                        if (key === null) return false;
                        return pendingChanges.has(key);
                    }
                };

                // Parser la valeur dans le bon type après édition
                if (col.field === 'FORECAST' || col.field === 'TARGET') {
                    col.valueParser = (params) => {
                        if (params.newValue === '' || params.newValue == null) {
                            return 0;
                        }
                        const n = Number(params.newValue);
                        return isNaN(n) ? params.oldValue : n;
                    };
                } else if (col.field === 'SIMPLE_STATUS') {
                    col.valueParser = (params) => String(params.newValue ?? '');
                }
            }
        });

        const agGridConfig = {
            columnDefs: columnDefs,
            dataUrl: dataUrl,
            numericColumns: {{ numericColumns|json_encode|raw }},
            integerColumns: {{ integerColumns|json_encode|raw }},
            totalColumns:   {{ totalColumns|json_encode|raw }},
            headerClass: 'excelHeaderBlue',
            stateKey: 'aggrid-state-sell_in_suivi_ps-user-{{ app.user.id|default("local") }}-v1',

            excelStyles: [
                {
                    id: 'excelHeaderBlue',
                    font: { bold: true, color: '#FFFFFF' },
                    alignment: { horizontal: 'Center' },
                    interior: { color: '#024185', pattern: 'Solid' }
                },
                {
                    id: 'excelPercentColumn',
                    interior: { color: '#baedbc', pattern: 'Solid' },
                    font: { color: '#1B5E20' }
                },
                // Styles recap Excel
                { id: 'recapHeader',  font: { bold: true, color: '#FFFFFF' }, interior: { color: '#024185', pattern: 'Solid' }, alignment: { horizontal: 'Center' } },
                { id: 'recapTotal',   font: { bold: true, color: '#FFFFFF' }, interior: { color: '#1a3c6e', pattern: 'Solid' } },
                { id: 'recapFamily',  font: { bold: true, color: '#024185' }, interior: { color: '#d6e4f7', pattern: 'Solid' } },
                { id: 'recapGender',  font: { color: '#000000' },             interior: { color: '#FFFFFF',  pattern: 'Solid' } },
                { id: 'recapPctPos',  font: { color: '#155724' },             interior: { color: '#c3e6cb',  pattern: 'Solid' } },
                { id: 'recapPctNeg',  font: { color: '#721c24' },             interior: { color: '#f5c6cb',  pattern: 'Solid' } },
            ],
        };

        // ========= RECAP =========

        const RECAP_SUM_FIELDS = [
            'FORECAST', 'PS_ORDER_SS25_EOS', 'PS_ORDER_SS26_EOS', 'PS_ORDER_FW26_EOS', 'PS_ORDER_SS27_TD',
            'PS_ORDER_SS26_TD', 'SS27_TD_LFL_COMPLETE', 'SS26_EOS_LFL', 'LANDING_FCST',
            'TARGET', 'TOGO_VS_FCST_EN_VALO', 'FCST_VS_TARGET_EN_VALO', 'SS26_EOS_VALO_COMPLETE',
            'CUST', 'TTL_PS_LY', 'CUST_OPEN', 'FCST_REPS', 'LW_FCST_REPS',
            'FCST_SS27_LFL', 'DIFF', 'SS27_COMPLETE', 'LY_COMPLETE_EOS', 'BOH_FIGE_LW'
        ];

        const RECAP_COLS = [
            { field: 'FORECAST',               label: 'FORECAST',               type: 'integer' },
            { field: 'PS_ORDER_SS25_EOS',      label: 'PS SS25 EOS',            type: 'decimal' },
            { field: 'PS_ORDER_SS26_EOS',      label: 'PS SS26 EOS',            type: 'decimal' },
            { field: 'PS_ORDER_FW26_EOS',      label: 'PS FW26 EOS',            type: 'decimal' },
            { field: 'PS_ORDER_SS27_TD',       label: 'PS SS27 TD',             type: 'decimal' },
            { field: 'PS_ORDER_SS26_TD',       label: 'PS SS26 TD',             type: 'decimal' },
            { field: 'VS_LY_TD',               label: 'VS LY TD',               type: 'percent', num: 'PS_ORDER_SS27_TD',     den: 'PS_ORDER_SS26_TD' },
            { field: 'SS27_TD_LFL_COMPLETE',   label: 'SS27 TD LFL COMPLETE',   type: 'decimal' },
            { field: 'SS26_EOS_LFL',           label: 'SS26 EOS LFL',           type: 'decimal' },
            { field: 'COMPLETE_VS_LY_LFL_EOS', label: 'COMPLETE VS LY LFL EOS', type: 'percent', num: 'SS27_TD_LFL_COMPLETE', den: 'SS26_EOS_LFL' },
            { field: 'LANDING_FCST',           label: 'LANDING FCST',           type: 'decimal' },
            { field: 'VS_SS26_EOS',            label: 'VS SS26 EOS',            type: 'percent', num: 'LANDING_FCST',         den: 'PS_ORDER_SS26_EOS' },
            { field: 'TARGET',                 label: 'TARGET',                 type: 'integer' },
            { field: 'TOGO_VS_FCST_EN_VALO',   label: 'TOGO VS FCST (VALO)',    type: 'decimal' },
            { field: 'FCST_VS_TARGET_EN_VALO', label: 'FCST VS TARGET (VALO)',  type: 'decimal' },
            { field: 'SS26_EOS_VALO_COMPLETE', label: 'SS26 EOS VALO COMPLETE', type: 'decimal' },
            { field: 'CUST',                   label: '#CUST',                  type: 'integer' },
            { field: 'TTL_PS_LY',              label: 'TTL PS LY',              type: 'decimal' },
            { field: 'CUST_OPEN',              label: 'CUST OPEN',              type: 'integer' },
            { field: 'FCST_REPS',              label: 'FCST REPS',              type: 'decimal' },
            { field: 'LW_FCST_REPS',           label: 'LW FCST REPS',           type: 'decimal' },
            { field: 'VS_LW',                  label: 'VS LW',                  type: 'string' },
            { field: 'FCST_SALES_VS_EOS_SS26', label: 'FCST SALES VS EOS SS26', type: 'percent', num: 'FCST_REPS',            den: 'TTL_PS_LY' },
            { field: 'FCST_SS27_LFL',          label: 'FCST SS27 LFL',          type: 'decimal' },
            { field: 'DIFF',                   label: 'DIFF',                   type: 'decimal' },
            { field: 'SS27_COMPLETE',          label: 'SS27 COMPLETE',          type: 'decimal' },
            { field: 'LY_COMPLETE_EOS',        label: 'LY COMPLETE EOS',        type: 'decimal' },
            { field: 'EVO_COMPLETE_VS_LY',     label: 'EVO COMPLETE VS LY',     type: 'percent', num: 'SS27_COMPLETE',        den: 'LY_COMPLETE_EOS' },
            { field: 'BOH_FIGE_LW',            label: 'BOH FIGE LW',            type: 'decimal' },
            { field: 'EVO_BOH_VS_LW',          label: 'EVO BOH VS LW',          type: 'string' },
        ];

        const _RECAP_FAM_LABELS = { FTW: 'Footwear', APL: 'Apparel', HDW: 'Accessories' };
        const _RECAP_FAM_ORDER  = ['FTW', 'APL', 'HDW'];
        const _RECAP_GEN_ORDER  = ['MALE', 'FEMALE', 'KIDS', 'UNISEX'];

        function _recapInitSums() {
            return Object.fromEntries(RECAP_SUM_FIELDS.map(f => [f, 0]));
        }

        function _recapAdd(target, row) {
            for (const f of RECAP_SUM_FIELDS) target[f] += Number(row[f]) || 0;
        }

        function _recapWithPct(sums) {
            const out = { ...sums };
            for (const col of RECAP_COLS) {
                if (col.type === 'percent') {
                    const den = sums[col.den] || 0;
                    out[col.field] = den !== 0 ? (sums[col.num] / den) - 1 : null;
                }
            }
            return out;
        }

        function recapBuild(api) {
            const total    = _recapInitSums();
            const famSums  = {};
            const genSums  = {};

            for (const fam of _RECAP_FAM_ORDER) {
                famSums[fam] = _recapInitSums();
                for (const gen of _RECAP_GEN_ORDER) genSums[`${fam}|${gen}`] = _recapInitSums();
                genSums[`${fam}|`] = _recapInitSums();
            }

            api.forEachNodeAfterFilter(node => {
                if (!node.data || node.rowPinned) return;
                const d   = node.data;
                const fam = d.FAMILY;
                const gen = d.GENDER ?? '';
                if (!_RECAP_FAM_ORDER.includes(fam)) return;
                _recapAdd(total, d);
                _recapAdd(famSums[fam], d);
                const gk = `${fam}|${gen}`;
                if (genSums[gk]) _recapAdd(genSums[gk], d);
            });

            const rows = [];
            rows.push({ label: 'TOTAL', cls: 'recap-row-total', data: _recapWithPct(total) });

            for (const fam of _RECAP_FAM_ORDER) {
                rows.push({ label: _RECAP_FAM_LABELS[fam] || fam, cls: 'recap-row-family', data: _recapWithPct(famSums[fam]) });
                if (fam !== 'HDW') {
                    for (const gen of _RECAP_GEN_ORDER) {
                        const s = genSums[`${fam}|${gen}`];
                        if (RECAP_SUM_FIELDS.some(f => s[f] !== 0)) {
                            rows.push({ label: gen, cls: 'recap-row-gender', data: _recapWithPct(s) });
                        }
                    }
                }
            }

            return rows;
        }

        function recapFmt(val, type) {
            if (val === null || val === undefined) return '';
            if (type === 'percent') {
                const p = Math.round(val * 100);
                return (p > 0 ? '+' : '') + p + ' %';
            }
            const n = Math.round(val);
            if (n === 0) return '0';
            return n.toLocaleString('fr-FR');
        }

        function recapRender(api) {
            const rows = recapBuild(api);
            const tbl  = document.getElementById('recapTable');
            if (!tbl) return;

            let h = '<thead><tr><th class="recap-th-label"></th>';
            for (const c of RECAP_COLS) h += `<th class="recap-th-num">${c.label}</th>`;
            h += '</tr></thead><tbody>';

            for (const row of rows) {
                h += `<tr class="${row.cls}"><td class="recap-td-label">${row.label}</td>`;
                for (const c of RECAP_COLS) {
                    const v  = row.data[c.field];
                    const f  = recapFmt(v, c.type);
                    let   cc = '';
                    if (c.type === 'percent' && v !== null) {
                        cc = v >  0.0005 ? 'recap-positive' :
                             v < -0.0005 ? 'recap-negative' : '';
                    }
                    h += `<td class="recap-td-num ${cc}">${f}</td>`;
                }
                h += '</tr>';
            }
            h += '</tbody>';
            tbl.innerHTML = h;
        }

        function recapBuildExcelRows(api) {
            const rows = recapBuild(api);
            const excelRows = [];

            // Nombre de colonnes vides à insérer avant le label pour aligner le FORECAST
            // de la recap avec la colonne FORECAST du tableau principal (colonne O = 15e).
            // Label recap → colonne N (14e), FORECAST → colonne O (15e) : 13 cellules vides.
            const RECAP_EXCEL_OFFSET = 14;
            const emptyCell = { data: { type: 'String', value: '' } };
            const offsetCells = Array.from({ length: RECAP_EXCEL_OFFSET }, () => emptyCell);

            // Ligne d'en-tête des colonnes recap
            const hdrCells = [...offsetCells, { data: { type: 'String', value: '' }, styleId: 'recapHeader' }];
            for (const col of RECAP_COLS) {
                hdrCells.push({ data: { type: 'String', value: col.label }, styleId: 'recapHeader' });
            }
            excelRows.push({ cells: hdrCells, height: 22 });

            // Lignes de données
            for (const row of rows) {
                const base = row.cls === 'recap-row-total'  ? 'recapTotal'  :
                             row.cls === 'recap-row-family' ? 'recapFamily' : 'recapGender';

                const cells = [...offsetCells, { data: { type: 'String', value: row.label }, styleId: base }];

                for (const col of RECAP_COLS) {
                    const val = row.data[col.field];
                    let style = base;
                    let data;

                    if (val === null || val === undefined) {
                        data = { type: 'String', value: '' };
                    } else if (col.type === 'percent') {
                        const p   = Math.round(val * 100);
                        const txt = (p > 0 ? '+' : '') + p + ' %';
                        data = { type: 'String', value: txt };
                        if (base !== 'recapTotal') {
                            if      (val >  0.0005) style = 'recapPctPos';
                            else if (val < -0.0005) style = 'recapPctNeg';
                        }
                    } else {
                        data = { type: 'Number', value: String(Math.round(val)) };
                    }

                    cells.push({ data, styleId: style });
                }

                excelRows.push({ cells, height: 18 });
            }

            // Ligne vide séparatrice
            excelRows.push({ cells: [{ data: { type: 'String', value: '' } }], height: 8 });

            return excelRows;
        }

        // ========= FIN RECAP =========

        document.addEventListener('DOMContentLoaded', async () => {
            // Restaurer les saisies sauvegardées avant expiration de session
            restorePendingFromLocalStorage();

            window.gridOptions = window.AgGridCommon.initGrid('#myGrid', agGridConfig);

            // Injecte le mot "Total" dans la première colonne du footer
// après chaque mise à jour de la pinned bottom row
            function injectTotalLabel() {
                const api = window.gridOptions.api;
                if (!api) return;

                const pinnedNode = api.getPinnedBottomRow(0);
                if (!pinnedNode || !pinnedNode.data) return;

                // Récupère la première colonne actuellement visible (utilise getColId pour respecter
                // l'ordre que l'utilisateur a éventuellement choisi)
                const displayedColumns = window.gridOptions.columnApi.getAllDisplayedColumns();
                if (displayedColumns.length === 0) return;

                const firstColField = displayedColumns[0].getColId();

                // Si la première colonne n'est PAS une colonne sum (sinon on écraserait son total),
                // on y met "Total"
                const totalColumns = {{ totalColumns|json_encode|raw }};
                if (!totalColumns.includes(firstColField)) {
                    pinnedNode.data[firstColField] = 'Total';
                    // Force le refresh de la cellule pour que la valeur s'affiche
                    api.refreshCells({
                        rowNodes: [pinnedNode],
                        columns: [firstColField],
                        force: true,
                    });
                }
            }

// Branche le listener sur les events qui modifient la pinned bottom row
            if (window.gridOptions && window.gridOptions.api) {
                window.gridOptions.api.addEventListener('filterChanged', () => setTimeout(injectTotalLabel, 50));
                window.gridOptions.api.addEventListener('sortChanged',   () => setTimeout(injectTotalLabel, 50));
                window.gridOptions.api.addEventListener('modelUpdated',  () => setTimeout(injectTotalLabel, 50));
                window.gridOptions.api.addEventListener('columnMoved',   () => setTimeout(injectTotalLabel, 50));
                window.gridOptions.api.addEventListener('columnVisible', () => setTimeout(injectTotalLabel, 50));
            } else {
                const checkInterval = setInterval(() => {
                    if (window.gridOptions && window.gridOptions.api) {
                        window.gridOptions.api.addEventListener('filterChanged', () => setTimeout(injectTotalLabel, 50));
                        window.gridOptions.api.addEventListener('sortChanged',   () => setTimeout(injectTotalLabel, 50));
                        window.gridOptions.api.addEventListener('modelUpdated',  () => setTimeout(injectTotalLabel, 50));
                        window.gridOptions.api.addEventListener('columnMoved',   () => setTimeout(injectTotalLabel, 50));
                        window.gridOptions.api.addEventListener('columnVisible', () => setTimeout(injectTotalLabel, 50));
                        clearInterval(checkInterval);
                    }
                }, 100);
            }

            window.AgGridCommon.patchSidebarCheckboxes('#myGrid');
            window.AgGridCommon.patchSetFilterCheckboxes();

            // Branche le hook d'édition après init
            if (window.gridOptions && window.gridOptions.api) {
                window.gridOptions.api.addEventListener('cellValueChanged', handleCellValueChanged);
            } else if (window.gridOptions) {
                const checkInterval = setInterval(() => {
                    if (window.gridOptions.api) {
                        window.gridOptions.api.addEventListener('cellValueChanged', handleCellValueChanged);
                        clearInterval(checkInterval);
                    }
                }, 100);
            }

            const saveConfigModalEl = document.getElementById('modal-save-config-aggrid');
            const saveConfigModal = new bootstrap.Modal(saveConfigModalEl);

            window.onBtExportExcel = async function () {
                const percentFields = ['VS_LY_TD', 'COMPLETE_VS_LY_LFL_EOS', 'VS_SS26_EOS', 'FCST_SALES_VS_EOS_SS26', 'EVO_COMPLETE_VS_LY'];

                await ExcelExportStandard.export(
                    window.gridOptions,
                    '{{ title|replace({" ": "_"}) }}.xlsx',
                    {
                        customHeader: recapBuildExcelRows(window.gridOptions.api),
                        processCellCallback: (p) => {
                            const field = p.column.getColId();
                            if (percentFields.includes(field)) {
                                if (p.value == null || p.value === '') return '';
                                return (Number(p.value) * 100).toFixed(0) + ' %';
                            }
                            return p.value;
                        }
                    }
                );
            };

            document.getElementById('saveGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.saveGridState(window.gridOptions, agGridConfig.stateKey);
                saveConfigModal.show();
            });

            document.getElementById('resetGridConfigBtn').addEventListener('click', function () {
                if (pendingChanges.size > 0) {
                    if (!confirm(`Vous avez ${pendingChanges.size} modification(s) non enregistrée(s). Continuer quand même ?`)) {
                        return;
                    }
                }
                window.AgGridCommon.clearGridState(agGridConfig.stateKey);
                location.reload();
            });

            // Bouton "Enregistrer" : déclenche le batch
            document.getElementById('saveChangesBtn').addEventListener('click', saveAllChanges);

            // Prévenir l'utilisateur s'il quitte la page avec des modifs non enregistrées
            window.addEventListener('beforeunload', (e) => {
                if (pendingChanges.size > 0) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });

            // Recap : mise à jour au 1er chargement, sur filtre et sur reload données
            const recapUpdate = () => {
                if (window.gridOptions && window.gridOptions.api) {
                    recapRender(window.gridOptions.api);
                }
            };
            if (window.gridOptions && window.gridOptions.api) {
                window.gridOptions.api.addEventListener('firstDataRendered', recapUpdate);
                window.gridOptions.api.addEventListener('filterChanged',     recapUpdate);
                window.gridOptions.api.addEventListener('rowDataUpdated',    recapUpdate);
            } else {
                const recapCheck = setInterval(() => {
                    if (window.gridOptions && window.gridOptions.api) {
                        window.gridOptions.api.addEventListener('firstDataRendered', recapUpdate);
                        window.gridOptions.api.addEventListener('filterChanged',     recapUpdate);
                        window.gridOptions.api.addEventListener('rowDataUpdated',    recapUpdate);
                        clearInterval(recapCheck);
                    }
                }, 100);
            }

            window.AgGridCommon.setupAutoWidth(window.gridOptions, { widthMode: 'full' });
            window.AgGridCommon.setupAutoHeight(window.gridOptions, {
                gridSelector: '#myGrid',
                maxHeight: 1000,
            });
        });

        function buildPendingKey(row, field) {
            // La ligne pinned bottom n'a pas de CUSTOMER_CODE -> on ne génère pas de clé valide
            if (!row || !row.CUSTOMER_CODE) {
                return null;
            }
            return [
                row.CUSTOMER_CODE,
                row.CITY ?? '',
                row.FAMILY,
                row.GENDER ?? '',
                row.SERIESNO,
                field,
            ].join('|');
        }

        function handleCellValueChanged(params) {
            const field = params.colDef.field;

            if (!editableFields.includes(field)) {
                return;
            }

            if (params.oldValue === params.newValue) {
                return;
            }

            const row = params.data;
            let value = params.newValue;

            if (field === 'SIMPLE_STATUS') {
                if (!['OPEN', 'COMPLETE'].includes(value)) {
                    showToast('Valeur invalide pour SIMPLE_STATUS', false);
                    params.node.setDataValue(field, params.oldValue);
                    return;
                }
            } else {
                const num = Number(value);
                if (isNaN(num)) {
                    showToast(`Valeur numérique attendue pour ${field}`, false);
                    params.node.setDataValue(field, params.oldValue);
                    return;
                }
                value = num;
            }

            const key = buildPendingKey(row, field);

            pendingChanges.set(key, {
                CUSTOMER_CODE: row.CUSTOMER_CODE,
                CITY:          row.CITY ?? '',
                FAMILY:        row.FAMILY,
                GENDER:        row.GENDER ?? '',
                SERIESNO:      row.SERIESNO,
                field:         field,
                value:         value,
            });

            // Force AG Grid à réévaluer la cellClassRules sur cette cellule
            params.api.refreshCells({
                rowNodes: [params.node],
                columns:  [field],
                force:    true,
            });

            updatePendingUI();
        }

        function updatePendingUI() {
            const btn   = document.getElementById('saveChangesBtn');
            const badge = document.getElementById('pendingCount');

            if (pendingChanges.size > 0) {
                btn.disabled = false;
                badge.textContent = pendingChanges.size;
                badge.style.display = 'inline-block';
            } else {
                btn.disabled = true;
                badge.style.display = 'none';
            }
        }

        const LS_KEY = 'sell_in_suivi_ps_pending_{{ app.user.id|default("local") }}';
        let _sessionModal = null;

        function _getSessionModal() {
            if (!_sessionModal) {
                _sessionModal = new bootstrap.Modal(document.getElementById('sessionExpiredModal'));
            }
            return _sessionModal;
        }

        function savePendingToLocalStorage() {
            const data = Array.from(pendingChanges.entries());
            localStorage.setItem(LS_KEY, JSON.stringify(data));
        }

        function restorePendingFromLocalStorage() {
            const raw = localStorage.getItem(LS_KEY);
            if (!raw) return false;
            try {
                const data = JSON.parse(raw);
                if (!Array.isArray(data) || data.length === 0) return false;
                data.forEach(([key, change]) => pendingChanges.set(key, change));
                localStorage.removeItem(LS_KEY);
                updatePendingUI();
                showToast(`🔄 ${data.length} saisie(s) restaurée(s) — cliquez Enregistrer`, true);
                return true;
            } catch { return false; }
        }

        function _isJsonResponse(res) {
            const ct = res.headers.get('content-type') || '';
            return ct.includes('application/json');
        }

        async function isSessionAlive() {
            try {
                const res = await fetch('{{ path('sales_ping') }}', {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                return res.ok && _isJsonResponse(res);
            } catch { return false; }
        }

        function showSessionExpiredModal() {
            savePendingToLocalStorage();

            document.getElementById('sessionLoginBtn').onclick = () => {
                window.open('{{ path('login') }}', '_blank');
            };

            document.getElementById('sessionRetryBtn').onclick = async () => {
                const alive = await isSessionAlive();
                if (alive) {
                    _getSessionModal().hide();
                    saveAllChanges();
                } else {
                    showToast('Session toujours expirée. Reconnectez-vous d\'abord.', false);
                }
            };

            _getSessionModal().show();
        }

        async function saveAllChanges() {
            if (pendingChanges.size === 0) return;

            // Vérification session avant d'envoyer
            const alive = await isSessionAlive();
            if (!alive) {
                showSessionExpiredModal();
                return;
            }

            const btn = document.getElementById('saveChangesBtn');
            btn.disabled = true;
            btn.innerHTML = '⏳ Enregistrement...';

            let okCount = 0;
            let koCount = 0;

            const changes = Array.from(pendingChanges.entries()); // [[key, change], ...]

            try {
                const res = await fetch(saveBatchUrl, {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify(changes.map(([, change]) => change)),
                });

                // Détection session expirée (HTML reçu à la place de JSON)
                if (!_isJsonResponse(res)) {
                    showSessionExpiredModal();
                    btn.innerHTML = '💾 Enregistrer <span id="pendingCount" class="badge bg-dark ms-1"></span>';
                    updatePendingUI();
                    return;
                }

                const json = await res.json();
                const results = json.results || {};

                for (const [key] of changes) {
                    const result = results[key];
                    if (result && result.success) {
                        okCount++;
                        pendingChanges.delete(key);
                    } else {
                        koCount++;
                        console.error('Échec save :', key, result);
                    }
                }
            } catch (err) {
                koCount = changes.length;
                console.error('Erreur réseau batch save :', err);
            }

            if (koCount === 0) {
                localStorage.removeItem(LS_KEY);
                showToast(`✅ ${okCount} modification(s) enregistrée(s)`, true);
                window.AgGridCommon.reloadData(
                    window.gridOptions,
                    dataUrl,
                    {{ totalColumns|json_encode|raw }}
                );
            } else {
                showToast(`⚠️ ${okCount} OK, ${koCount} échec(s) — cliquez à nouveau sur Enregistrer pour réessayer.`, false);
                window.gridOptions.api.refreshCells({ force: true });
            }

            btn.innerHTML = '💾 Enregistrer <span id="pendingCount" class="badge bg-dark ms-1"></span>';
            updatePendingUI();
        }

        function showToast(message, success) {
            const toast = document.getElementById('saveToast');
            toast.textContent = message;
            toast.classList.remove('toast-ok', 'toast-ko', 'visible');
            toast.classList.add(success ? 'toast-ok' : 'toast-ko', 'visible');

            setTimeout(() => {
                toast.classList.remove('visible');
            }, 3000);
        }
    </script>
{% endblock %}
