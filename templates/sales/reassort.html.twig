{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }

        .ag-text-field-input {
            color: #000000 !important;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">

                    <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                        <h3 class="box-title mb-0">{{ title }}</h3>

                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            <button id="exportBtn" class="btn btn-primary btn-sm" type="button">
                                Excel
                            </button>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>

                    <div class="box-body pt-2">
                        <div id="reassortGrid" class="ag-theme-alpine" style="height: 75vh; width: 100%;"></div>
                    </div>

                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-community.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {

            function integerCellStyle(params) {
                return {
                    borderRight: "0.2px solid #CECECEFF",
                    borderBottom: "0.2px solid #CECECEFF",
                    textAlign: 'right'
                };
            }

            function textCellStyle(params) {
                return {
                    borderRight: "0.2px solid #CECECEFF",
                    borderBottom: "0.2px solid #CECECEFF",
                    textAlign: 'left'
                };
            }

            function percentFormatter(params) {
                if (params.node.rowPinned) {
                    return '';
                }

                const value = Number(params.value);

                if (!isFinite(value)) {
                    return '0 %';
                }

                return value.toLocaleString('fr-CH', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                }) + ' %';
            }

            function buildSeriesGroup(series) {
                return {
                    headerName: series,
                    marryChildren: true,
                    children: [
                        {
                            field: series + '_ps',
                            headerName: 'PS',
                            filter: 'agNumberColumnFilter',
                            sortable: true,
                            resizable: true,
                            minWidth: 110,
                            valueFormatter: window.integerFormatter,
                            comparator: window.integerComparator,
                            cellStyle: integerCellStyle,
                            aggFunc: 'sum'
                        },
                        {
                            field: series + '_re',
                            headerName: 'RE',
                            filter: 'agNumberColumnFilter',
                            sortable: true,
                            resizable: true,
                            minWidth: 110,
                            valueFormatter: window.integerFormatter,
                            comparator: window.integerComparator,
                            cellStyle: integerCellStyle,
                            aggFunc: 'sum'
                        },
                        {
                            field: series + '_pct',
                            headerName: '%',
                            filter: 'agNumberColumnFilter',
                            sortable: true,
                            resizable: true,
                            minWidth: 100,
                            valueFormatter: percentFormatter,
                            cellStyle: integerCellStyle,
                            cellClass: params => {
                                return params.node.rowPinned ? '' : 'bg-secondary-light';
                            }
                        }
                    ]
                };
            }

            const totalColumns = [
                '2024-01-SS_ps', '2024-01-SS_re',
                '2024-02-FW_ps', '2024-02-FW_re',
                '2025-01-SS_ps', '2025-01-SS_re',
                '2025-02-FW_ps', '2025-02-FW_re',
                '2026-01-SS_ps', '2026-01-SS_re',
                '2026-02-FW_ps', '2026-02-FW_re'
            ];

            const columnDefs = [
                {
                    headerName: 'Client',
                    marryChildren: true,
                    children: [
                        {
                            field: 'CustomerNo',
                            headerName: 'Code Client',
                            filter: 'agTextColumnFilter',
                            pinned: 'left',
                            sortable: true,
                            resizable: true,
                            minWidth: 130,
                            cellStyle: textCellStyle,
                            cellClass: params => {
                                return params.node.rowPinned ? '' : 'bg-success-light';
                            }
                        },
                        {
                            field: 'Name',
                            headerName: 'Client',
                            filter: 'agTextColumnFilter',
                            pinned: 'left',
                            sortable: true,
                            resizable: true,
                            minWidth: 230,
                            cellStyle: textCellStyle,
                            cellClass: params => {
                                return params.node.rowPinned ? '' : 'bg-success-light';
                            }
                        },
                        {
                            field: 'ItemFamilyCode',
                            headerName: 'Item Family',
                            filter: 'agTextColumnFilter',
                            pinned: 'left',
                            sortable: true,
                            resizable: true,
                            minWidth: 150,
                            cellStyle: textCellStyle,
                            cellClass: params => {
                                return params.node.rowPinned ? '' : 'bg-success-light';
                            }
                        }
                    ]
                },

                buildSeriesGroup('2024-01-SS'),
                buildSeriesGroup('2024-02-FW'),
                buildSeriesGroup('2025-01-SS'),
                buildSeriesGroup('2025-02-FW'),

                {
                    headerName: 'Total',
                    marryChildren: true,
                    children: [
                        {
                            field: 'total_avg_pct',
                            headerName: 'Avg %',
                            filter: 'agNumberColumnFilter',
                            sortable: true,
                            resizable: true,
                            minWidth: 110,
                            valueFormatter: percentFormatter,
                            cellStyle: integerCellStyle,
                            cellClass: params => {
                                return params.node.rowPinned ? '' : 'bg-info';
                            }
                        }
                    ]
                },

                buildSeriesGroup('2026-01-SS'),
                buildSeriesGroup('2026-02-FW')
            ];

            const agGridConfig = {
                columnDefs: columnDefs,
                dataUrl: '{{ dataUrl }}',
                numericColumns: [
                    '2024-01-SS_pct',
                    '2024-02-FW_pct',
                    '2025-01-SS_pct',
                    '2025-02-FW_pct',
                    'total_avg_pct',
                    '2026-01-SS_pct',
                    '2026-02-FW_pct'
                ],
                integerColumns: [
                    '2024-01-SS_ps', '2024-01-SS_re',
                    '2024-02-FW_ps', '2024-02-FW_re',
                    '2025-01-SS_ps', '2025-01-SS_re',
                    '2025-02-FW_ps', '2025-02-FW_re',
                    '2026-01-SS_ps', '2026-01-SS_re',
                    '2026-02-FW_ps', '2026-02-FW_re'
                ],
                totalColumns: totalColumns
            };

            const gridOptions = window.AgGridCommon.initGrid('#reassortGrid', agGridConfig);

            setTimeout(() => {
                if (gridOptions.api) {
                    gridOptions.api.refreshHeader();
                }
            }, 100);

            document.getElementById('exportBtn').addEventListener('click', function () {
                gridOptions.api.exportDataAsExcel({
                    fileName: 'reassort_clients.xlsx',
                    sheetName: 'Reassort'
                });
            });
        });
    </script>
{% endblock %}
