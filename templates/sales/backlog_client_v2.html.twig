{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/excel-loader.css') }}" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }

        .ag-text-field-input {
            color: #000000 !important;
        }

        /* Largeur fixe : les collections sélectionnées s'empilent en hauteur plutôt que
           d'étirer le bandeau vers la droite. */
        #collectionPicker .ts-wrapper {
            width: 240px;
            min-width: 240px;
            max-width: 240px;
        }

        #collectionPicker .ts-control {
            flex-wrap: wrap;
            max-height: 96px;
            overflow-y: auto;
        }

        .grid-wrapper {
            position: relative;
            min-height: 1000px;
        }

        .grid-custom-loader {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            z-index: 10;
        }

        .grid-loader-spinner {
            width: 42px;
            height: 42px;
            border: 4px solid #d9d9d9;
            border-top: 4px solid #024185;
            border-radius: 50%;
            animation: gridSpin 0.8s linear infinite;
            margin-bottom: 12px;
        }

        .grid-loader-text {
            font-size: 14px;
            color: #555;
        }

        @keyframes gridSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .grid-actions-hidden {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .grid-actions-visible {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            transition: opacity 0.2s ease-in-out;
        }

        .grid-loader-bar-track {
            height: 8px;
            background: #e0e0e0;
            border-radius: 99px;
            overflow: hidden;
        }

        .grid-loader-bar-fill {
            height: 100%;
            width: 0%;
            background: #024185;
            border-radius: 99px;
            transition: width 0.3s ease;
        }

        .grid-loader-percent-text {
            font-size: 13px;
            color: #024185;
            font-weight: 600;
            margin-top: 6px;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                        <h3 class="box-title mb-2">{{ title }}</h3>

                        <div id="collectionPicker" class="d-flex align-items-start gap-2 mt-2 mt-md-0">
                            <select id="collectionSelect" class="form-select form-select-sm" multiple></select>
                            <div class="form-check mb-0" title="Ajoute le stock, le transit et le backlog fournisseur des 4 sites. Chargement plus long.">
                                <input class="form-check-input" type="checkbox" id="includeStock">
                                <label class="form-check-label small text-nowrap" for="includeStock">Inclure le stock</label>
                            </div>
                            <button id="loadBtn" class="btn btn-primary btn-sm" type="button">Charger</button>
                        </div>

                        <div id="gridActions" class="d-flex align-items-center gap-2 mt-2 mt-md-0 grid-actions-hidden">
                            <button id="saveGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-success" type="button">Save</button>
                            <button id="resetGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-secondary" type="button">Reset</button>
                            <button id="exportBtn" class="btn btn-primary btn-sm" type="button">Excel</button>
                            <button id="exportFullBtn" class="btn btn-primary btn-sm" type="button" title="Toutes les lignes filtrées, généré par le serveur (CSV compatible Excel)">CSV complet</button>
                            <form id="exportCsvForm" method="post" action="{{ path('backlog_clients_v2_export_csv') }}" style="display: none;">
                                <input type="hidden" name="payload">
                            </form>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>

                    <div class="box-body" id="mainBoxBody" style="display: none;">
                        <div class="table-responsive-sm">
                            <div id="myGridWrapper" class="grid-wrapper">
                                <div id="gridCustomLoader" class="grid-custom-loader">
                                    <div class="grid-loader-spinner"></div>
                                    <div class="grid-loader-text">Chargement de la grille...</div>
                                    <div class="grid-loader-bar-track" style="width: 220px; margin-top: 12px;">
                                        <div id="gridLoaderBarFill" class="grid-loader-bar-fill"></div>
                                    </div>
                                    <div id="gridLoaderPercent" class="grid-loader-percent-text">0%</div>
                                </div>

                                <div id="myGrid" class="ag-theme-alpine" style="height: 1000px; visibility: hidden;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{ include('components/_excel_loader.html.twig') }}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=2.6"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-ssrm.js') }}?v=1.9"></script>
    <script src="{{ asset('assets/js/pages/exceljs.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/fileSaver.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/tom-select.complete.min.js') }}"></script>

    <script>
        // Liste complète, jamais modifiée : chaque chargement en dérive les colonnes à afficher
        const allColumnDefs = {{ columns|json_encode|raw }};
        let columnDefs = allColumnDefs;
        const ALL_COLLECTIONS = '__ALL__';
        const STOCK_FIELD_RE = /_(WLOGM|WSFCN|WTAKH|WDTTH)$/;
        const BASE_STATE_KEY = 'aggrid-state-{{ type }}-user-{{ app.user.id|default("local") }}-v1';
        // Collections filtrées ([] si "Tout") et options envoyées au serveur
        let selectedCollections = [];
        let collectionOptions = { collections: [] };
        let includeStock = false;

        // En-tête 2 lignes (libellé + nom complet du site) pour les colonnes stock par site,
        // comme sur le Backlog Client X3.
        const SITE_NAMES = {
            WLOGM: 'LOGTEX Entrepôt Moussey',
            WSFCN: 'SF Entrepôt Chine',
            WTAKH: 'TALENT GLOBAL CO.,LIMITED (WOOLVET)',
            WDTTH: 'DT Entrepôt Thaïlande',
        };

        class SiteHeaderComponent {
            init(params) {
                this.eGui = document.createElement('div');
                this.eGui.style.cssText = 'line-height:1.25;padding:2px 0;white-space:normal;overflow:hidden;';
                this.eGui.innerHTML =
                    '<div style="font-weight:700;">' + params.mainLabel + '</div>' +
                    '<div style="font-size:10px;font-weight:400;opacity:.85;">' + params.siteName + '</div>';
            }
            getGui() { return this.eGui; }
            refresh() { return false; }
        }

        columnDefs.forEach(col => {
            const m = STOCK_FIELD_RE.exec(col.field || '');
            if (!m) return;

            const site = m[1];
            // Logtex garde son libellé complet sur 2 lignes ; les autres sites affichent
            // le code site et son nom en sous-titre.
            if (site === 'WLOGM') {
                col.wrapHeaderText = true;
                col.autoHeaderHeight = true;
                return;
            }

            col.headerComponent = SiteHeaderComponent;
            col.headerComponentParams = {
                mainLabel: col.headerName.replace(new RegExp('\\s*' + site + '$'), ''),
                siteName: site + ' — ' + SITE_NAMES[site],
            };
        });

        // Colonnes avec liste déroulante dynamique (SELECT DISTINCT côté serveur)
        const setFilterFields = [
            'SITE', 'MAINNETWORK', 'ZCLASSE_0', 'COLLECTION', 'FAMILLE',
            'GENRE', 'AGE', 'DROPPE', 'NOOS', 'GROUP_CODE', 'CUR_0', 'REP1', 'REP2',
            'CLIENT_COMMANDE', 'NOM_CLIENT_COMMANDE'
        ];

        columnDefs.forEach(col => {
            if (!setFilterFields.includes(col.field)) return;
            const field = col.field;
            col.filterParams = {
                filters: [
                    { filter: 'agTextColumnFilter' },
                    {
                        filter: 'agSetColumnFilter',
                        filterParams: {
                            values: (params) => {
                                const filterModel = window.gridOptions && window.gridOptions.api
                                    ? window.gridOptions.api.getFilterModel()
                                    : {};
                                // Exclure le filtre de la colonne en cours pour ne pas se filtrer soi-même
                                const otherFilters = Object.fromEntries(
                                    Object.entries(filterModel).filter(([k]) => k !== field)
                                );
                                fetch('{{ path('backlog_clients_v2_filter_values') }}', {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ field, filterModel: otherFilters, collections: selectedCollections, includeStock }),
                                })
                                    .then(r => r.json())
                                    .then(values => params.success(values))
                                    .catch(() => params.success([]));
                            }
                        }
                    }
                ]
            };
        });

        const agGridConfig = {
            columnDefs: columnDefs,
            dataUrl: '{{ dataUrl }}',
            blockSize: {{ blockSize|default(200) }},
            numericColumns: {{ numericColumns|json_encode|raw }},
            integerColumns: {{ integerColumns|json_encode|raw }},
            totalColumns: {{ totalColumns|json_encode|raw }},
            headerClass: 'excelHeaderBlue',
            stateKey: BASE_STATE_KEY,
            getStaticOptions: () => collectionOptions,
            excelStyles: [
                { id: 'excelHeaderBlue', font: { bold: true, color: '#FFFFFF' }, alignment: { horizontal: 'Center' }, interior: { color: '#024185', pattern: 'Solid' } },
            ],
        };

        let uiBound = false;

        function initializeGridAndUi() {
            // Rechargement : on détruit la grille précédente, ses colonnes ayant changé
            if (window.gridOptions && window.gridOptions.api) {
                window.gridOptions.api.destroy();
                document.getElementById('myGrid').innerHTML = '';
            }

            window.gridOptions = window.AgGridSsrm.initGrid('#myGrid', agGridConfig);
            window.AgGridCommon.patchSidebarCheckboxes('#myGrid');
            window.AgGridCommon.patchSetFilterCheckboxes();

            // Les boutons ne sont câblés qu'une fois, sinon les écouteurs s'empilent
            if (uiBound) return;
            uiBound = true;

            const saveConfigModal = new bootstrap.Modal(document.getElementById('modal-save-config-aggrid'));

            document.getElementById('exportBtn').addEventListener('click', () => {
                window.AgGridSsrm.exportExcel(window.gridOptions, agGridConfig, '{{ title|replace({" ": "_"}) }}.xlsx', { includeStock: true });
            });

            // CSV généré et envoyé au fil de l'eau par le serveur (filtres, tri et collections de la grille) :
            // pas de limite de lignes, contrairement à l'Excel construit dans le navigateur
            document.getElementById('exportFullBtn').addEventListener('click', () => {
                const sortModel = (window.gridOptions.columnApi.getColumnState() || [])
                    .filter(s => s.sort)
                    .sort((a, b) => (a.sortIndex ?? 0) - (b.sortIndex ?? 0))
                    .map(s => ({ colId: s.colId, sort: s.sort }));

                const form = document.getElementById('exportCsvForm');
                form.elements.payload.value = JSON.stringify({
                    filterModel: window.gridOptions.api.getFilterModel() || {},
                    sortModel,
                    options: collectionOptions,
                });
                form.submit();
            });

            document.getElementById('saveGridConfigBtn').addEventListener('click', () => {
                window.AgGridCommon.saveGridState(window.gridOptions, agGridConfig.stateKey);
                saveConfigModal.show();
            });

            document.getElementById('resetGridConfigBtn').addEventListener('click', () => {
                window.AgGridCommon.clearGridState(agGridConfig.stateKey);
                location.reload();
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            // Pas de chargement automatique : on attend la sélection de collections puis le clic "Charger"
            let collectionTomSelect = null;

            fetch('{{ path("poid_famille_par_variant_collections_json") }}')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('collectionSelect');
                    select.appendChild(new Option('Tout', ALL_COLLECTIONS));
                    data.forEach(collection => {
                        const option = document.createElement('option');
                        option.value = collection;
                        option.textContent = collection;
                        select.appendChild(option);
                    });

                    collectionTomSelect = window.AgGridCommon.setupMultiSelect('#collectionSelect', {
                        placeholder: 'Collection(s)',
                    });
                });

            document.getElementById('loadBtn').addEventListener('click', () => {
                const collections = collectionTomSelect ? collectionTomSelect.getValue() : [];

                if (!collections.length) {
                    alert('Veuillez sélectionner au moins une collection (ou "Tout") avant de charger la grille.');
                    return;
                }

                includeStock = document.getElementById('includeStock').checked;

                // "Tout" l'emporte sur les autres collections cochées : aucun filtre collection
                if (collections.includes(ALL_COLLECTIONS)) {
                    selectedCollections = [];
                    collectionOptions = { allCollections: true, includeStock };
                } else {
                    selectedCollections = collections;
                    collectionOptions = { collections, includeStock };
                }

                // Sans l'option, les colonnes stock ne sont pas dans la requête : on les retire
                // de la grille pour ne pas afficher des colonnes vides ni permettre de les filtrer.
                columnDefs = includeStock
                    ? allColumnDefs
                    : allColumnDefs.filter(col => !STOCK_FIELD_RE.test(col.field || ''));

                agGridConfig.columnDefs = columnDefs;
                // État sauvegardé séparé : les deux modes n'ont pas les mêmes colonnes
                agGridConfig.stateKey = BASE_STATE_KEY + (includeStock ? '-stock' : '');

                document.getElementById('mainBoxBody').style.display = '';

                initializeGridAndUi();
            });
        });
    </script>
{% endblock %}
