{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/excel-loader.css') }}" rel="stylesheet">
    {% if type == 'etat_commandes_clients_x3' %}
        <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
    {% endif %}

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }

        .ag-text-field-input {
            color: #000000 !important;
        }

        #etatCommandesPicker .ts-wrapper {
            min-width: 460px;
        }

        .grid-outer-container {
            width: 100%;
        }

        .grid-outer-container.grid-width-auto {
            display: flex;
            justify-content: center;
        }

        .grid-inner-container {
            width: 100%;
        }

        .grid-outer-container.grid-width-auto .grid-inner-container {
            width: auto;
            min-width: 720px;
            max-width: 100%;
        }

        .grid-wrapper {
            position: relative;
            min-height: 1000px;
        }

        .grid-custom-loader {
            position: absolute;
            inset: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            background: #ffffff;
            z-index: 10;
        }

        .grid-loader-spinner {
            width: 42px;
            height: 42px;
            border: 4px solid #d9d9d9;
            border-top: 4px solid #024185;
            border-radius: 50%;
            animation: gridSpin 0.8s linear infinite;
            margin-bottom: 12px;
        }

        .grid-loader-text {
            font-size: 14px;
            color: #555;
        }

        @keyframes gridSpin {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }

        .grid-actions-hidden {
            visibility: hidden;
            opacity: 0;
            pointer-events: none;
        }

        .grid-actions-visible {
            visibility: visible;
            opacity: 1;
            pointer-events: auto;
            transition: opacity 0.2s ease-in-out;
        }

        .best-demand-photo-cell {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            padding: 0 !important;
        }

        .ag-theme-alpine .ag-cell.best-demand-photo-cell {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        .best-demand-photo-cell img {
            width: 118px;
            height: 85px;
            object-fit: contain;
            display: block;
        }
        .ag-theme-alpine .ag-cell.best-demand-photo-cell {
            padding-left: 0 !important;
            padding-right: 0 !important;
        }

        {# ##### Grid loader avec % ##### #}
        .grid-loader-bar-track {
            height: 8px;
            background: #e0e0e0;
            border-radius: 99px;
            overflow: hidden;
        }

        .grid-loader-bar-fill {
            height: 100%;
            width: 0%;
            background: #024185;
            border-radius: 99px;
            transition: width 0.3s ease;
        }

        .grid-loader-percent-text {
            font-size: 13px;
            color: #024185;
            font-weight: 600;
            margin-top: 6px;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div id="gridOuterContainer" class="grid-outer-container {% if gridWidthMode == 'auto' %}grid-width-auto{% endif %}">
                        <div id="gridInnerContainer" class="grid-inner-container">
                            <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap">
                                <h3 class="box-title mb-2">{{ title }}</h3>

                                {% if type == 'etat_commandes_clients_x3' %}
                                    <div id="etatCommandesPicker" class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                                        <select id="etatCommandesCollectionSelect" class="form-select form-select-sm" multiple style="min-width: 260px;">
                                        </select>
                                        <button id="etatCommandesLoadBtn" class="btn btn-primary btn-sm" type="button">Charger</button>
                                    </div>
                                {% endif %}

                                <div id="gridActions" class="d-flex align-items-center gap-2 mt-2 mt-md-0 grid-actions-hidden">
                                    {% if type in ['poid_famille_par_variant', 'best_demand_per_style'] %}
                                        <select id="collectionSelect" class="form-select form-select-sm" style="width: 180px;">
                                            <option value="">Toutes les collections</option>
                                        </select>

                                        <select id="familySelect" class="form-select form-select-sm" style="width: 140px;">
                                            {% if type == 'poid_famille_par_variant' %}
                                                <option value="FTW" selected>FTW</option>
                                                <option value="APL">APL</option>
                                            {% elseif type == 'best_demand_per_style' %}
                                                <option value="" selected>Toutes les familles</option>
                                                <option value="FTW">FTW</option>
                                                <option value="APL">APL</option>
                                            {% endif %}
                                        </select>
                                        {% if type == 'poid_famille_par_variant' %}
                                            <select id="typeSelect" class="form-select form-select-sm" style="width: 140px;">
                                                <option value="">Tous les types</option>
                                            </select>
                                        {% endif %}
                                    {% endif %}

                                    <button id="saveGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-success" type="button">Save</button>
                                    <button id="resetGridConfigBtn" class="waves-effect waves-light btn btn-sm bg-gradient-secondary" type="button">Reset</button>
                                    <button id="exportBtn" class="btn btn-primary btn-sm" type="button" onclick="onBtExportExcel()">Excel</button>
                                    <span id="rowCount" class="text-muted small"></span>
                                </div>
                            </div>

                            <div class="box-body" id="mainBoxBody" {% if type == 'etat_commandes_clients_x3' %}style="display: none;"{% endif %}>
                                <div class="table-responsive-sm">
                                    <div id="myGridWrapper" class="grid-wrapper">
                                        <div id="gridCustomLoader" class="grid-custom-loader">
                                            <div class="grid-loader-spinner"></div>
                                            <div class="grid-loader-text">Chargement de la grille...</div>
                                            <div class="grid-loader-bar-track" style="width: 220px; margin-top: 12px;">
                                                <div id="gridLoaderBarFill" class="grid-loader-bar-fill"></div>
                                            </div>
                                            <div id="gridLoaderPercent" class="grid-loader-percent-text">0%</div>
                                        </div>

                                        <div id="myGrid" class="ag-theme-alpine" style="height: 1000px; visibility: hidden;"></div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {{ include('components/_excel_loader.html.twig') }}
    </section>

    {% if serverSide|default(false) %}
        <div class="modal fade" id="modal-export-options" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Options d'export Excel</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted small mb-3">
                            L'export avec les stocks est plus long. Décochez pour un export plus rapide sans les colonnes de stock.
                        </p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="exportIncludeStock">
                            <label class="form-check-label" for="exportIncludeStock">
                                Inclure les colonnes de stock par site
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" id="confirmExportBtn" class="btn btn-primary btn-sm">Exporter</button>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=2.6"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-ssrm.js') }}?v=1.7"></script>
    <script src="{{ asset('assets/js/pages/exceljs.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/fileSaver.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/excel-export-with-photo.js') }}"></script>
    <script src="{{ asset('assets/js/pages/excel-export-standard.js') }}"></script>
    {% if type == 'etat_commandes_clients_x3' %}
        <script src="{{ asset('assets/js/pages/tom-select.complete.min.js') }}"></script>
    {% endif %}

    <script>
        const salesType = '{{ type }}';
        const gridWidthMode = '{{ gridWidthMode|default("full") }}';
        const isServerSide = {{ serverSide|default(false) ? 'true' : 'false' }};
        const blockSize = {{ blockSize|default(200) }};
        const exportUrl = '{{ exportUrl|default("") }}';

        const columnDefs = {{ columns|json_encode|raw }};

        columnDefs.forEach(col => {
            function addCellClass(col, newClass) {
                if (!col.cellClass) { col.cellClass = newClass; return; }
                if (Array.isArray(col.cellClass)) col.cellClass.push(newClass);
                else col.cellClass = [col.cellClass, newClass];
            }
            if (col.field === 'WEIGHT_PERCENT') {
                col.valueFormatter = 'percentFormatter';
                col.comparator = 'percentComparator';
                addCellClass(col, 'excelPercentColumn');
            }
        });

        // Colonnes avec liste déroulante dynamique (SELECT DISTINCT côté serveur)
        const ssrmSetFilterFields = [
            'SITE', 'MAINNETWORK', 'ZCLASSE_0', 'COLLECTION', 'FAMILLE',
            'GENRE', 'AGE', 'DROPPE', 'GROUP_CODE', 'CUR_0', 'REP1', 'REP2',
            'CLIENT_COMMANDE', 'NOM_CLIENT_COMMANDE'
        ];
        const ssrmFilterValuesUrl = {
            'backlog_clients_x3': '{{ path('backlog_clients_x3_filter_values') }}',
            'etat_commandes_clients_x3': '{{ path('etat_commandes_clients_x3_filter_values') }}',
        };
        if (salesType === 'backlog_clients_x3' || salesType === 'etat_commandes_clients_x3') {
            columnDefs.forEach(col => {
                if (ssrmSetFilterFields.includes(col.field)) {
                    const field = col.field;
                    col.filterParams = {
                        filters: [
                            { filter: 'agTextColumnFilter' },
                            {
                                filter: 'agSetColumnFilter',
                                filterParams: {
                                    values: (params) => {
                                        const filterModel = window.gridOptions && window.gridOptions.api
                                            ? window.gridOptions.api.getFilterModel()
                                            : {};
                                        // Exclure le filtre de la colonne en cours pour ne pas se filtrer soi-même
                                        const otherFilters = Object.fromEntries(
                                            Object.entries(filterModel).filter(([k]) => k !== field)
                                        );
                                        const body = { field: field, filterModel: otherFilters };
                                        if (salesType === 'etat_commandes_clients_x3') {
                                            body.collections = (window.etatCommandesSelectedCollections || []);
                                        }
                                        fetch(ssrmFilterValuesUrl[salesType], {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify(body),
                                        })
                                            .then(r => r.json())
                                            .then(values => params.success(values))
                                            .catch(() => params.success([]));
                                    }
                                }
                            }
                        ]
                    };
                }
            });
        }

        let bestDemandDetailCache = {};

        if (salesType === 'best_demand_per_style') {
            const groupCol = columnDefs.find(c => c.field === 'ITEMGROUPCODE');
            if (groupCol) {
                groupCol.cellStyle = (p) => {
                    if (p.data && p.data.__isDetailRow) return {};
                    return { cursor: 'pointer', color: '#024185', textDecoration: 'underline', fontWeight: '600' };
                };
            }
        }

        const agGridConfig = {
            columnDefs: columnDefs,
            dataUrl: salesType === 'poid_famille_par_variant'
                ? '{{ dataUrl }}?family=FTW'
                : '{{ dataUrl }}',
            exportUrl: exportUrl,                  // 🆕
            blockSize: blockSize,                  // 🆕
            numericColumns: {{ numericColumns|json_encode|raw }},
            integerColumns: {{ integerColumns|json_encode|raw }},
            totalColumns: {{ totalColumns|json_encode|raw }},
            headerClass: 'excelHeaderBlue',
            stateKey: 'aggrid-state-{{ type }}-user-{{ app.user.id|default("local") }}-v1',
            transformData: salesType === 'best_demand_per_style'
                ? (data) => { bestDemandDetailCache = data.details || {}; return data.groups || []; }
                : null,
            extraOptions: salesType === 'best_demand_per_style' ? {
                isFullWidthRow: (params) => !!(params.rowNode.data && params.rowNode.data.__isDetailRow),
                fullWidthCellRenderer: (params) => {
                    const articles = params.data.__articles || [];
                    const fmtQty = v => new Intl.NumberFormat('fr-FR').format(Math.round(v || 0));
                    const fmtCa  = v => new Intl.NumberFormat('fr-FR', {minimumFractionDigits:2, maximumFractionDigits:2}).format(v || 0);

                    // Récupère les largeurs exactes des colonnes parentes
                    const cols   = params.columnApi.getAllDisplayedColumns();
                    const w      = cols.map(c => c.getActualWidth() + 'px');
                    const w0 = w[0] || '40%', w1 = w[1] || '30%', w2 = w[2] || '30%';

                    const rowStyle  = 'display:flex;align-items:center;height:42px;border-bottom:1px solid #b8d0e8;font-size:13px;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;';
                    const cellBase  = 'flex-shrink:0;padding:0 12px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;box-sizing:border-box;';

                    const rows = articles.map((a, i) => `
                        <div style="${rowStyle}background:${i % 2 === 0 ? '#ddeeff' : '#cce0f5'};">
                            <div style="${cellBase}width:${w0};text-align:left;">${a.ARTICLE || ''}</div>
                            <div style="${cellBase}width:${w1};text-align:right;">${fmtQty(a.QUANTITY)}</div>
                            <div style="${cellBase}width:${w2};text-align:right;">${fmtCa(a.CA)}</div>
                        </div>`).join('');

                    const container = document.createElement('div');
                    container.style.cssText = 'background:#cce0f5;border-bottom:2px solid #024185;';
                    container.innerHTML = rows || `<div style="padding:12px;font-size:13px;color:#666;">Aucun article trouvé</div>`;
                    return container;
                },
                getRowHeight: (params) => {
                    if (params.data && params.data.__isDetailRow) {
                        return (params.data.__articles || []).length * 42;
                    }
                    return undefined;
                },
                postSortRows: (params) => {
                    const nodes = params.nodes;
                    for (let i = nodes.length - 1; i >= 0; i--) {
                        const data = nodes[i].data;
                        if (data && data.__isDetailRow) {
                            const detail = nodes.splice(i, 1)[0];
                            const parentIdx = nodes.findIndex(n => n.data && n.data.ITEMGROUPCODE === data.__group);
                            nodes.splice(parentIdx !== -1 ? parentIdx + 1 : nodes.length, 0, detail);
                        }
                    }
                },
                onCellClicked: (params) => {
                    if (!params.data || params.data.__isDetailRow) return;
                    if (params.column.getColId() !== 'ITEMGROUPCODE') return;
                    const group = params.data.ITEMGROUPCODE;

                    const existingDetails = [];
                    params.api.forEachNode(node => {
                        if (node.data && node.data.__isDetailRow) existingDetails.push(node.data);
                    });

                    const alreadyOpen = existingDetails.some(d => d.__group === group);
                    if (existingDetails.length) {
                        params.api.applyTransaction({ remove: existingDetails });
                    }
                    if (alreadyOpen) return;

                    const articles = bestDemandDetailCache[group] || [];
                    params.api.applyTransaction({
                        add: [{ __isDetailRow: true, __group: group, __articles: articles }],
                        addIndex: params.rowIndex + 1
                    });
                },
            } : {},
            excelStyles: [
                { id: 'excelHeaderBlue', font: { bold: true, color: '#FFFFFF' }, alignment: { horizontal: 'Center' }, interior: { color: '#024185', pattern: 'Solid' } },
                { id: 'excelPercentColumn', interior: { color: '#baedbc', pattern: 'Solid' }, font: { color: '#1B5E20' } }
            ]
        };

        // 🆕 Initialisation de la grille (extraite pour pouvoir être déclenchée plus tard
        // à la demande, ex: bouton "Charger" pour État des commandes clients)
        async function initializeGridAndUi() {
            // 🆕 Branchement SSRM ou classique
            window.gridOptions = isServerSide
                ? window.AgGridSsrm.initGrid('#myGrid', agGridConfig)
                : window.AgGridCommon.initGrid('#myGrid', agGridConfig);

            if (salesType === 'best_demand_per_style' && !isServerSide) {
                window.gridOptions.api.resetRowHeights();
            }
            window.AgGridCommon.patchSidebarCheckboxes('#myGrid');
            window.AgGridCommon.patchSetFilterCheckboxes();

            const saveConfigModalEl = document.getElementById('modal-save-config-aggrid');
            const saveConfigModal = new bootstrap.Modal(saveConfigModalEl);

            window.onBtExportExcel = async function () {
                if (isServerSide) {
                    // 🆕 Ouvre la modale au lieu d'exporter direct
                    const modalEl = document.getElementById('modal-export-options');
                    const modal = new bootstrap.Modal(modalEl);
                    modal.show();
                    return;
                }

                if (salesType === 'best_demand_per_style') {
                    await _exportBestDemandExcel();
                    return;
                }

                // Mode classique inchangé
                await ExcelExportStandard.export(
                    window.gridOptions,
                    '{{ title|replace({" ": "_"}) }}.xlsx',
                    {
                        processCellCallback: (p) => {
                            const field = p.column.getColId();
                            if (field === 'WEIGHT_PERCENT') {
                                if (p.value == null || p.value === '') return '';
                                return (Number(p.value) * 100).toFixed(0) + ' %';
                            }
                            return p.value;
                        }
                    }
                );
            };

            async function _exportBestDemandExcel() {
                const wb = new ExcelJS.Workbook();
                const ws = wb.addWorksheet('Best Demand per Style');

                const fmtInt = v => Math.round(Number(v) || 0).toLocaleString('fr-FR');
                const fmtDec = v => (Number(v) || 0).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

                // ---- styles ----
                const styleGroupHeader = {
                    font: { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 },
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF024185' } },
                    alignment: { horizontal: 'center', vertical: 'middle' },
                    border: { bottom: { style: 'thin', color: { argb: 'FFCECECE' } } }
                };
                const styleGroupRow = {
                    font: { bold: true, color: { argb: 'FFFFFFFF' }, size: 11 },
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FF1a3c6e' } },
                    alignment: { vertical: 'middle' },
                    border: { bottom: { style: 'thin', color: { argb: 'FFCECECE' } } }
                };
                const styleGroupRowRight = { ...styleGroupRow, alignment: { horizontal: 'right', vertical: 'middle' } };
                const styleArticleEven = {
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFddeeff' } },
                    alignment: { vertical: 'middle' },
                    border: { bottom: { style: 'thin', color: { argb: 'FFb8d0e8' } } }
                };
                const styleArticleOdd = {
                    fill: { type: 'pattern', pattern: 'solid', fgColor: { argb: 'FFcce0f5' } },
                    alignment: { vertical: 'middle' },
                    border: { bottom: { style: 'thin', color: { argb: 'FFb8d0e8' } } }
                };
                const styleArticleRight = base => ({ ...base, alignment: { horizontal: 'right', vertical: 'middle' } });

                // ---- header ----
                ws.columns = [
                    { key: 'col1', width: 30 },
                    { key: 'col2', width: 18 },
                    { key: 'col3', width: 18 }
                ];
                const headerRow = ws.addRow(['GROUPE / ARTICLE', 'QUANTITÉ', 'CA']);
                headerRow.height = 22;
                headerRow.eachCell(cell => Object.assign(cell, styleGroupHeader));

                // ---- data : groupes dans l'ordre affiché du grid ----
                const groupNodes = [];
                window.gridOptions.api.forEachNodeAfterFilterAndSort(node => {
                    if (node.data && !node.data.__isDetailRow) groupNodes.push(node.data);
                });

                for (const gd of groupNodes) {
                    const group = gd.ITEMGROUPCODE;

                    // ligne groupe
                    const gr = ws.addRow([group, fmtInt(gd.QUANTITY), fmtDec(gd.CA)]);
                    gr.height = 20;
                    gr.getCell(1).style = styleGroupRow;
                    gr.getCell(2).style = styleGroupRowRight;
                    gr.getCell(3).style = styleGroupRowRight;

                    // lignes articles
                    const articles = bestDemandDetailCache[group] || [];
                    articles.forEach((a, i) => {
                        const base = i % 2 === 0 ? styleArticleEven : styleArticleOdd;
                        const ar = ws.addRow([a.ARTICLE || '', fmtInt(a.QUANTITY), fmtDec(a.CA)]);
                        ar.height = 18;
                        ar.getCell(1).style = base;
                        ar.getCell(2).style = styleArticleRight(base);
                        ar.getCell(3).style = styleArticleRight(base);
                    });
                }

                // ---- téléchargement ----
                const buf  = await wb.xlsx.writeBuffer();
                const blob = new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' });
                const url  = URL.createObjectURL(blob);
                const a    = document.createElement('a');
                a.href     = url;
                a.download = 'Best_Demand_per_Style.xlsx';
                a.click();
                URL.revokeObjectURL(url);
            }

// 🆕 Bouton "Exporter" de la modale
            if (isServerSide) {
                document.getElementById('confirmExportBtn')?.addEventListener('click', async () => {
                    const includeStock = document.getElementById('exportIncludeStock').checked;

                    // Ferme la modale
                    const modalEl = document.getElementById('modal-export-options');
                    bootstrap.Modal.getInstance(modalEl)?.hide();

                    // Petit délai pour que la modale se ferme avant l'overlay du loader
                    await new Promise(r => setTimeout(r, 200));

                    await window.AgGridSsrm.exportExcel(
                        window.gridOptions,
                        agGridConfig,
                        '{{ title|replace({" ": "_"}) }}.xlsx',
                        { includeStock }
                    );
                });
            }

            document.getElementById('saveGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.saveGridState(window.gridOptions, agGridConfig.stateKey);
                saveConfigModal.show();
            });

            document.getElementById('resetGridConfigBtn').addEventListener('click', function () {
                window.AgGridCommon.clearGridState(agGridConfig.stateKey);
                location.reload();
            });

            if (['poid_famille_par_variant', 'best_demand_per_style'].includes(salesType)) {
                const collectionSelect = document.getElementById('collectionSelect');
                const familySelect = document.getElementById('familySelect');
                const typeSelect = document.getElementById('typeSelect');
                const itemGroupSelect = document.getElementById('itemGroupSelect');

                if (collectionSelect) {
                    fetch('{{ path("poid_famille_par_variant_collections_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(collection => {
                                const option = document.createElement('option');
                                option.value = collection;
                                option.textContent = collection;
                                collectionSelect.appendChild(option);
                            });
                        });
                }

                if (typeSelect) {
                    fetch('{{ path("poid_famille_par_variant_types_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(type => {
                                const option = document.createElement('option');
                                option.value = type;
                                option.textContent = type;
                                typeSelect.appendChild(option);
                            });
                        });
                }

                if (itemGroupSelect && salesType === 'best_demand_per_style') {
                    fetch('{{ path("best_demand_per_style_item_groups_json") }}')
                        .then(res => res.json())
                        .then(data => {
                            data.forEach(itemGroup => {
                                const option = document.createElement('option');
                                option.value = itemGroup;
                                option.textContent = itemGroup;
                                itemGroupSelect.appendChild(option);
                            });
                        });
                }

                [collectionSelect, familySelect, typeSelect, itemGroupSelect].forEach(select => {
                    if (select) {
                        select.addEventListener('change', reloadGridWithFilters);
                    }
                });
            }

            if (!isServerSide) {
                window.AgGridCommon.setupAutoWidth(window.gridOptions, { widthMode: gridWidthMode });
                window.AgGridCommon.setupAutoHeight(window.gridOptions, {
                    gridSelector: '#myGrid', maxHeight: 1000,
                });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            if (salesType === 'etat_commandes_clients_x3') {
                // 🆕 Pas de chargement auto : on attend la sélection de collections + clic "Charger"
                let etatCommandesCollectionTomSelect = null;

                fetch('{{ path("poid_famille_par_variant_collections_json") }}')
                    .then(res => res.json())
                    .then(data => {
                        const select = document.getElementById('etatCommandesCollectionSelect');
                        if (!select) return;
                        data.forEach(collection => {
                            const option = document.createElement('option');
                            option.value = collection;
                            option.textContent = collection;
                            select.appendChild(option);
                        });

                        etatCommandesCollectionTomSelect = window.AgGridCommon.setupMultiSelect('#etatCommandesCollectionSelect', {
                            placeholder: 'Sélectionner une ou plusieurs collections...',
                        });
                    });

                document.getElementById('etatCommandesLoadBtn')?.addEventListener('click', async () => {
                    const collections = etatCommandesCollectionTomSelect ? etatCommandesCollectionTomSelect.getValue() : [];

                    if (!collections.length) {
                        alert('Veuillez sélectionner au moins une collection avant de charger la grille.');
                        return;
                    }

                    window.etatCommandesSelectedCollections = collections;
                    agGridConfig.getStaticOptions = () => ({ collections: window.etatCommandesSelectedCollections });

                    // Masque le sélecteur, affiche la grille, puis initialise la grille SSRM
                    const picker = document.getElementById('etatCommandesPicker');
                    if (picker) picker.style.display = 'none';

                    const mainBoxBody = document.getElementById('mainBoxBody');
                    if (mainBoxBody) mainBoxBody.style.display = '';

                    await initializeGridAndUi();
                });

                return;
            }

            initializeGridAndUi();
        });

        function reloadGridWithFilters() {
            if (!['poid_famille_par_variant', 'best_demand_per_style'].includes(salesType)) {
                return;
            }

            const collection = document.getElementById('collectionSelect')?.value || '';
            const family     = document.getElementById('familySelect')?.value || '';
            const type       = document.getElementById('typeSelect')?.value || '';
            const itemGroup  = document.getElementById('itemGroupSelect')?.value || '';

            const url = new URL('{{ dataUrl }}', window.location.origin);

            if (collection) url.searchParams.set('collection', collection);
            if (family)     url.searchParams.set('family', family);
            if (type)       url.searchParams.set('type', type);
            if (itemGroup)  url.searchParams.set('itemGroup', itemGroup);

            window.AgGridCommon.reloadData(
                window.gridOptions,
                url.toString(),
                {{ totalColumns|json_encode|raw }},
                null,
                agGridConfig.transformData || null
            );
        }

        function debounce(fn, delay) {
            let timer = null;
            return function (...args) {
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(this, args), delay);
            };
        }
    </script>
{% endblock %}
