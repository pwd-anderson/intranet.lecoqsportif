{% extends 'base.html.twig' %}

{#
   Backlog Clients — version principale.

   Charge l'integralite du backlog dans le navigateur au lieu du mode SSRM. Le stock
   est optionnel et passe par la jointure : l'enrichissement par requetes ciblees de
   la v2 n'a de sens que sur un bloc pagine.
#}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/excel-loader.css') }}" rel="stylesheet">

    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }

        .ag-text-field-input { color: #000000 !important; }


        .grid-wrapper { position: relative; min-height: 1000px; }

        .grid-custom-loader {
            position: absolute; inset: 0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            background: #ffffff; z-index: 10;
        }
        .grid-loader-spinner {
            width: 42px; height: 42px;
            border: 4px solid #d9d9d9;
            border-top: 4px solid #024185;
            border-radius: 50%;
            animation: gridSpin 0.8s linear infinite;
            margin-bottom: 12px;
        }
        @keyframes gridSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
        .grid-loader-text { font-size: 14px; color: #555; }
        .grid-loader-bar-track { height: 8px; background: #e0e0e0; border-radius: 99px; overflow: hidden; }
        .grid-loader-bar-fill { height: 100%; width: 0%; background: #024185; border-radius: 99px; transition: width 0.3s ease; }
        .grid-loader-percent-text { font-size: 13px; color: #024185; font-weight: 600; margin-top: 6px; }

        .grid-actions-hidden { visibility: hidden; opacity: 0; pointer-events: none; }
        .grid-actions-visible { visibility: visible; opacity: 1; pointer-events: auto; transition: opacity 0.2s ease-in-out; }

        .mesure-perf {
            font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 12px;
            color: #024185;
            background: #eef3f9;
            border-radius: 4px;
            padding: 4px 10px;
        }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div class="box-header with-border d-flex justify-content-between align-items-center flex-wrap gap-2">
                        {# L'option et le bouton de chargement restent accolés au titre :
                           isolés à droite, ils semblaient flotter dans l'en-tête. #}
                        <div id="collectionPicker" class="d-flex align-items-center gap-3">
                            <h3 class="box-title mb-0">{{ title }}</h3>

                            <div class="form-check mb-0" title="Ajoute le stock, le transit et le backlog fournisseur des 4 sites.">
                                <input class="form-check-input" type="checkbox" id="includeStock">
                                <label class="form-check-label small text-nowrap" for="includeStock">Inclure le stock</label>
                            </div>
                            <button id="loadBtn" class="btn btn-primary btn-sm" type="button">Charger</button>
                        </div>

                        <div id="gridActions" class="d-flex align-items-center gap-2 grid-actions-hidden">
                            <span id="exportEtat" class="small text-muted"></span>
                            {% if app.environment == 'dev' %}<span id="mesure" class="mesure-perf"></span>{% endif %}
                            <button id="exportCsvEcranBtn" class="btn btn-primary btn-sm" type="button" title="Exporte exactement les lignes affichées, filtres et tri compris. À privilégier après avoir filtré.">CSV</button>
                            <button id="exportCsvBtn" class="btn btn-primary btn-sm" type="button" title="La totalité du backlog, sans tenir compte des filtres de la grille. Généré par le serveur, sans limite de volume.">CSV complet</button>
                            <form id="exportCsvForm" method="post" action="{{ path('backlog_clients_v2_export_csv') }}" style="display: none;">
                                <input type="hidden" name="payload">
                            </form>
                            <span id="rowCount" class="text-muted small"></span>
                        </div>
                    </div>

                    <div class="box-body" id="mainBoxBody" style="display: none;">
                        <div class="table-responsive-sm">
                            <div id="myGridWrapper" class="grid-wrapper">
                                <div id="gridCustomLoader" class="grid-custom-loader">
                                    <div class="grid-loader-spinner"></div>
                                    <div class="grid-loader-text">Chargement de la grille...</div>
                                    <div class="grid-loader-bar-track" style="width: 220px; margin-top: 12px;">
                                        <div id="gridLoaderBarFill" class="grid-loader-bar-fill"></div>
                                    </div>
                                    <div id="gridLoaderPercent" class="grid-loader-percent-text">0%</div>
                                </div>

                                <div id="myGrid" class="ag-theme-alpine" style="height: 1000px; visibility: hidden;"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="modal-export-volumineux" tabindex="-1">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Export volumineux</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <p><strong id="exportNbLignes"></strong> lignes seraient exportées depuis le navigateur.</p>
                        <p class="mb-0 text-muted">
                            L'onglet risque de se figer plusieurs secondes. Filtrez davantage,
                            ou utilisez « CSV complet », qui passe par le serveur.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-danger" id="exportConfirmerBtn">Exporter quand même</button>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=2.6"></script>

    <script>
        // Liste complète : les colonnes stock sont retirées si l'option n'est pas cochée
        const allColumnDefs = {{ columns|json_encode|raw }};
        const STOCK_FIELD_RE = /_(WLOGM|WSFCN|WTAKH|WDTTH)$/;
        const ALL_TOTAL_COLUMNS = {{ totalColumns|json_encode|raw }};

        /**
         * Réactive filtre et tri sur les colonnes stock, pour la v3 uniquement.
         *
         * La configuration `backlog_client_v2_grid` les déclare non filtrables parce que
         * la v2 calcule le stock après la requête, hors de portée de SQL Server. En v3
         * la contrainte n'existe pas : le filtrage se fait dans le navigateur sur des
         * données déjà chargées, et l'export CSV dispose des colonnes via la jointure.
         */
        function rendreStockFiltrable(col) {
            if (!STOCK_FIELD_RE.test(col.field || '')) {
                return col;
            }

            return Object.assign({}, col, {
                sortable: true,
                filter: 'agNumberColumnFilter',
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            let exportBound = false;

            document.getElementById('loadBtn').addEventListener('click', () => {
                // Toutes les collections : la stat charge l'intégralité du backlog
                const includeStock = document.getElementById('includeStock').checked;

                const params = new URLSearchParams({ all: '1' });
                if (includeStock) {
                    params.set('stock', '1');
                }

                // Le bandeau reste visible : on doit pouvoir relancer un chargement pour
                // comparer avec et sans stock, ce qui est l'objet même de cette page.
                document.getElementById('mainBoxBody').style.display = '';

                const columnDefs = includeStock
                    ? allColumnDefs.map(rendreStockFiltrable)
                    : allColumnDefs.filter(col => !STOCK_FIELD_RE.test(col.field || ''));

                // Les totaux suivent les colonnes affichées : inutile de sommer le stock
                // quand il n'est pas chargé.
                const totalColumns = includeStock
                    ? ALL_TOTAL_COLUMNS
                    : ALL_TOTAL_COLUMNS.filter(field => !STOCK_FIELD_RE.test(field));

                chargerEtAfficher('{{ dataUrl }}?' + params.toString(), columnDefs, totalColumns);
            });

            /**
             * Charge les données en lisant la réponse au fil de l'eau, puis construit la
             * grille. Le serveur diffuse le JSON sans connaître sa taille finale : on
             * affiche donc le volume reçu, pas un pourcentage, qui serait inventé.
             */
            async function chargerEtAfficher(url, columnDefs, totalColumns) {
                const loader = document.getElementById('gridCustomLoader');
                const texte = loader.querySelector('.grid-loader-text');
                const barre = document.getElementById('gridLoaderBarFill');
                const compteur = document.getElementById('gridLoaderPercent');

                loader.style.display = 'flex';
                document.querySelector('#myGrid').style.visibility = 'hidden';

                const mo = octets => (octets / 1048576).toFixed(1);
                const depart = performance.now();

                // Progression continue sur les trois phases réelles du chargement.
                // Indispensable ici : l'exécution SQL dure une quinzaine de secondes
                // pendant lesquelles aucun octet n'arrive. Une barre figée à 0 % donne
                // l'impression que la stat est plantée.
                //
                // Chaque phase vise un plafond et s'en approche sans jamais l'atteindre
                // tant qu'elle dure : le pourcentage avance donc toujours, et ne recule
                // ni ne stagne, même si la durée réelle s'écarte de l'estimation.
                const PHASES = {
                    requete:      { debut: 0,  plafond: 35, duree: 15000, texte: 'Exécution de la requête…' },
                    telechargement: { debut: 35, plafond: 92, duree: 30000, texte: 'Téléchargement' },
                    traitement:   { debut: 92, plafond: 99, duree: 2000,  texte: 'Traitement des données…' },
                };

                let phase = PHASES.requete;
                let phaseDepuis = performance.now();
                let octetsRecus = 0;
                let animation = null;

                const rafraichirProgression = () => {
                    const ecoule = performance.now() - phaseDepuis;
                    const avancement = 1 - Math.exp(-3 * ecoule / phase.duree);
                    const pourcent = phase.debut + (phase.plafond - phase.debut) * avancement;

                    barre.style.width = pourcent.toFixed(1) + '%';
                    compteur.textContent = Math.round(pourcent) + '%';
                    texte.textContent = phase === PHASES.telechargement
                        ? `${phase.texte} — ${mo(octetsRecus)} Mo`
                        : phase.texte;

                    animation = requestAnimationFrame(rafraichirProgression);
                };

                const changerPhase = (nouvelle) => {
                    phase = nouvelle;
                    phaseDepuis = performance.now();
                };

                const terminerProgression = () => {
                    if (animation) cancelAnimationFrame(animation);
                    barre.style.width = '100%';
                    compteur.textContent = '100%';
                };

                rafraichirProgression();

                try {
                    // ─── Étape 1 : exécution de la requête ──────────────────────
                    const reponse = await fetch(url);
                    if (!reponse.ok) throw new Error('HTTP ' + reponse.status);

                    const lecteur = reponse.body.getReader();
                    const decodeur = new TextDecoder('utf-8');
                    let json = '';
                    let premierBloc = true;

                    while (true) {
                        const { done, value } = await lecteur.read();
                        if (done) break;

                        // Le premier octet reçu marque la fin du travail de la base
                        if (premierBloc) {
                            changerPhase(PHASES.telechargement);
                            premierBloc = false;
                        }

                        octetsRecus += value.length;
                        json += decodeur.decode(value, { stream: true });
                    }
                    json += decodeur.decode();

                    const finTelechargement = performance.now();

                    // ─── Étape 2 : traitement ───────────────────────────────────
                    changerPhase(PHASES.traitement);
                    const recu = octetsRecus;

                    // Laisse le navigateur peindre le message avant de bloquer sur JSON.parse
                    await new Promise(r => setTimeout(r, 50));

                    const lignes = JSON.parse(json);
                    json = '';

                    // Rechargement : on détruit la grille précédente, sinon une seconde
                    // grille se superpose à la première (double ligne d'en-tête en pied).
                    if (window.gridOptions && window.gridOptions.api) {
                        window.gridOptions.api.destroy();
                        document.getElementById('myGrid').innerHTML = '';
                    }

                    const gridOptions = window.AgGridCommon.initGrid('#myGrid', {
                        columnDefs: columnDefs,
                        dataUrl: null,
                        numericColumns: {{ numericColumns|json_encode|raw }},
                        integerColumns: {{ integerColumns|json_encode|raw }},
                        totalColumns: totalColumns,
                        headerClass: 'excelHeaderBlue',
                        excelStyles: [
                            { id: 'excelHeaderBlue', font: { bold: true, color: '#FFFFFF' }, alignment: { horizontal: 'Center' }, interior: { color: '#024185', pattern: 'Solid' } },
                        ],
                    });

                    window.gridOptions = gridOptions;
                    gridOptions.api.setRowData(lignes);

                    // Compteur de lignes et ligne de totaux, comme le fait reloadData()
                    // pour les stats standard : initGrid ne s'en charge pas quand les
                    // données ne viennent pas d'un dataUrl.
                    window.AgGridCommon.updateTotals(gridOptions, totalColumns);

                    gridOptions.api.addEventListener('filterChanged', () => {
                        window.AgGridCommon.updateTotals(gridOptions, totalColumns);
                    });
                    gridOptions.api.addEventListener('sortChanged', () => {
                        window.AgGridCommon.updateTotals(gridOptions, totalColumns);
                    });

                    const fin = performance.now();
                    const secondes = v => (v / 1000).toFixed(1);

                    const mesure = document.getElementById('mesure');
                    if (mesure) mesure.textContent =
                        `${lignes.length.toLocaleString('fr-FR')} lignes · ${mo(recu)} Mo · `
                        + `téléchargement ${secondes(finTelechargement - depart)} s · `
                        + `traitement ${secondes(fin - finTelechargement)} s · `
                        + `total ${secondes(fin - depart)} s`;

                    terminerProgression();
                    loader.style.display = 'none';
                    document.querySelector('#myGrid').style.visibility = 'visible';
                    window.AgGridCommon.showGridActions();

                    // Câblé une seule fois : sinon les écouteurs s'empilent à chaque
                    // rechargement et l'export se déclenche autant de fois qu'il y a eu
                    // de chargements. On passe par window.gridOptions pour viser la
                    // grille courante.
                    if (!exportBound) {
                        exportBound = true;

                        // Seul l'export serveur est proposé : sur 172 000 lignes, tout
                        // traitement synchrone dans le navigateur fige l'onglet, et
                        // ExcelJS casse au-delà d'environ 150 000 lignes.
                        const optionsExport = { allCollections: true, includeStock };

                        // CSV écran : ce que voit l'utilisateur, filtres et tri compris.
                        // Généré dans le navigateur, donc instantané sur un volume filtré
                        // mais bloquant au-delà : on prévient avant de figer l'onglet.
                        // Spinner dans le bouton pendant l'export. Le libellé d'origine
                        // est mémorisé pour être restauré, quel que soit le dénouement.
                        const avecSpinner = (bouton, libelle) => {
                            bouton.dataset.libelle = bouton.dataset.libelle || bouton.textContent.trim();
                            bouton.disabled = true;
                            bouton.innerHTML =
                                '<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>'
                                + libelle;
                        };

                        const sansSpinner = (bouton) => {
                            bouton.disabled = false;
                            bouton.textContent = bouton.dataset.libelle;
                        };

                        const exporterEcran = () => {
                            const bouton = document.getElementById('exportCsvEcranBtn');
                            avecSpinner(bouton, 'Export…');

                            // Laisse le navigateur peindre le spinner : la génération du
                            // CSV est synchrone et bloquerait l'affichage sinon.
                            setTimeout(() => {
                                try {
                                    window.gridOptions.api.exportDataAsCsv({
                                        fileName: 'backlog_client_v3.csv',
                                        columnSeparator: ';',
                                    });
                                } finally {
                                    sansSpinner(bouton);
                                }
                            }, 50);
                        };

                        const modaleVolume = new bootstrap.Modal(
                            document.getElementById('modal-export-volumineux')
                        );

                        document.getElementById('exportConfirmerBtn').addEventListener('click', () => {
                            modaleVolume.hide();
                            // Laisse la modale se fermer avant de bloquer le fil principal
                            setTimeout(exporterEcran, 200);
                        });

                        document.getElementById('exportCsvEcranBtn').addEventListener('click', () => {
                            const lignes = window.gridOptions.api.getDisplayedRowCount();

                            if (lignes > 50000) {
                                document.getElementById('exportNbLignes').textContent =
                                    lignes.toLocaleString('fr-FR');
                                modaleVolume.show();
                                return;
                            }

                            exporterEcran();
                        });

                        // CSV complet : la totalité du backlog, sans filtre ni tri. Les
                        // filtres de la grille sont volontairement ignorés — « complet »
                        // doit vouloir dire complet, sinon deux exports du même bouton
                        // donneraient des fichiers différents selon l'écran.
                        const boutonCsv = document.getElementById('exportCsvBtn');
                        const zoneEtat = document.getElementById('exportEtat');

                        boutonCsv.addEventListener('click', () => {
                            const form = document.getElementById('exportCsvForm');
                            form.elements.payload.value = JSON.stringify({
                                filterModel: {},
                                sortModel: [],
                                options: optionsExport,
                            });

                            avecSpinner(boutonCsv, 'Préparation…');
                            zoneEtat.textContent = 'Préparation du fichier sur le serveur…';

                            form.submit();

                            // La réponse étant diffusée au fil de l'eau, le navigateur ne
                            // nous signale pas la fin de la génération : on rend la main
                            // au bout d'un délai plutôt que de laisser le bouton bloqué.
                            setTimeout(() => {
                                sansSpinner(boutonCsv);
                                zoneEtat.textContent = 'Le téléchargement démarre automatiquement.';
                                setTimeout(() => { zoneEtat.textContent = ''; }, 8000);
                            }, 20000);
                        });
                    }
                } catch (erreur) {
                    console.error(erreur);
                    if (animation) cancelAnimationFrame(animation);
                    texte.textContent = 'Échec du chargement : ' + erreur.message;
                    compteur.textContent = '';
                }
            }

        });
    </script>
{% endblock %}
