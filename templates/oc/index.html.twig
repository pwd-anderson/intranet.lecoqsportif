{% extends 'base.html.twig' %}

{% block stylesheets %}
    {{ parent() }}
    <link href="{{ asset('assets/css/ag-grid/ag-theme-alpine.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/css/ag-grid/ag-default.css') }}" rel="stylesheet">
    <style>
        .ag-theme-alpine {
            --ag-header-background-color: rgb(2, 65, 133) !important;
            --ag-header-foreground-color: #FFFFFF !important;
        }
        .oc-badge { display: inline-block; padding: 2px 10px; border-radius: 10px; font-size: 12px; font-weight: 600; color: #fff; }
        .oc-badge.draft { background: #6c757d; }
        .oc-badge.submitted { background: #e0a100; }
        .oc-badge.validated { background: #1d8ed6; }
        .oc-badge.rejected { background: #c8102e; }
        .oc-badge.cancelled { background: #343a40; }
        .oc-badge.sent_to_x3 { background: #0f7b3d; }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div class="box-header with-border d-md-flex align-items-center justify-content-between">
                        <h4 class="box-title">{{ validationMode ? 'Validation OC — en attente de décision' : 'Liste des offres commerciales' }}</h4>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            {% if not validationMode %}
                            <select id="statusFilter" class="form-select form-select-sm" style="width: 170px;">
                                <option value="">Tous les statuts</option>
                                <option value="draft">Brouillon</option>
                                <option value="submitted">Soumise</option>
                                <option value="validated">Validée</option>
                                <option value="rejected">Rejetée</option>
                                <option value="cancelled">Annulée</option>
                                <option value="sent_to_x3">Envoyée à X3</option>
                            </select>
                            {% endif %}
                        </div>
                    </div>
                    <div class="box-body pt-2">
                        <div id="ocGrid" class="ag-theme-alpine" style="height: 70vh; width: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('assets/js/pages/ag-grid-enterprise.min.js') }}"></script>
    <script src="{{ asset('assets/js/pages/ag-grid-common.js') }}?v=1.9"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = {{ rows|json_encode|raw }};
            const SHOW_URL = '{{ path('app_oc_show', {id: 0}) }}'.replace(/0$/, '');
            const VALIDATION = {{ validationMode ? 'true' : 'false' }};
            const LINK_SUFFIX = {{ validationMode ? "'?from=validation'" : "''" }};
            const cellText = { borderRight: '0.2px solid #CECECEFF', textAlign: 'left' };

            const columnDefs = [
                {
                    field: 'number', headerName: 'N° OC', minWidth: 260, filter: 'agTextColumnFilter', cellStyle: cellText,
                    cellRenderer: function (p) { return '<a href="' + SHOW_URL + p.data.id + LINK_SUFFIX + '">' + p.value + '</a>'; },
                },
                { field: 'type', headerName: 'Type', minWidth: 110, filter: 'agSetColumnFilter', cellStyle: cellText },
                { field: 'customers', headerName: 'Client(s)', minWidth: 320, filter: 'agTextColumnFilter', cellStyle: cellText },
                { field: 'lines', headerName: 'Articles', minWidth: 100, filter: 'agNumberColumnFilter', cellStyle: { textAlign: 'right' } },
                {
                    field: 'status', headerName: 'Statut', minWidth: 150, filter: 'agSetColumnFilter',
                    cellRenderer: function (p) { return '<span class="oc-badge ' + p.value + '">' + p.data.statusLabel + '</span>'; },
                },
                { field: 'createdBy', headerName: 'Créée par', minWidth: 160, filter: 'agSetColumnFilter', cellStyle: cellText },
                { field: 'createdAt', headerName: 'Créée le', minWidth: 120, filter: 'agDateColumnFilter', cellStyle: cellText },
                { field: 'startDate', headerName: 'Début', minWidth: 120, cellStyle: cellText },
                { field: 'endDate', headerName: 'Fin', minWidth: 120, cellStyle: cellText },
                {
                    headerName: 'Actions', minWidth: 190, sortable: false, filter: false, cellStyle: cellText,
                    cellRenderer: function (p) {
                        const view = '<a class="btn btn-xs btn-outline-secondary me-1" href="' + SHOW_URL + p.data.id + LINK_SUFFIX + '">' + (VALIDATION ? 'Examiner' : 'Voir') + '</a>';
                        // Liste : « Modifier » uniquement pour un brouillon, sinon consultation seule (aucune autre action).
                        return view + (!VALIDATION && p.data.editUrl ? '<a class="btn btn-xs btn-primary" href="' + p.data.editUrl + '">Modifier</a>' : '');
                    },
                },
            ];

            const gridOptions = window.AgGridCommon.initGrid('#ocGrid', {
                columnDefs: columnDefs,
                dataUrl: null,
                numericColumns: [],
                integerColumns: [],
                totalColumns: [],
                extraOptions: {},
            });
            gridOptions.api.setRowData(rows);

            const statusFilter = document.getElementById('statusFilter');
            if (statusFilter) statusFilter.addEventListener('change', function () {
                const model = this.value ? { values: [this.value] } : null;
                gridOptions.api.setFilterModel(model ? { status: model } : null);
            });
        });
    </script>
{% endblock %}
