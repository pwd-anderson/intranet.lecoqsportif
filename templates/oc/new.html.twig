{% extends 'base.html.twig' %}

{#
  Module OC — saisie d'une offre (Tarif Spé) : création, modification d'un brouillon, ou nouvelle OC issue d'une OC
  rejetée (variable "initial"). Le tarif est saisi par le commercial ; la marge s'affiche à côté et se recalcule en JS
  (le serveur la recalcule à l'enregistrement) :
    PV net HT = MSRP * 100 / (100 + TVA)
    marge %   = (PV net HT - tarif) / PV net HT * 100
  À l'enregistrement le serveur relit X3 (client, remise, code tarif, tarif, MSRP) et fige ces valeurs (OfferService).
#}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Champs de recherche client et article : même largeur, boutons de même largeur. */
        .oc-search { width: 560px; max-width: 100%; flex-wrap: nowrap; }
        .oc-search .btn { min-width: 140px; }
        .oc-chip { display: inline-flex; align-items: center; gap: 6px; background: #eef6fd; border: 1px solid #b9d9f5; color: #172b4c; border-radius: 16px; padding: 3px 4px 3px 12px; margin: 0 6px 6px 0; font-size: 13px; }
        .oc-chip button { border: 0; background: #d3e7f9; border-radius: 50%; width: 20px; height: 20px; line-height: 18px; padding: 0; cursor: pointer; color: #172b4c; }
        .oc-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .oc-table th { background: #34495e; color: #fff; text-align: center; vertical-align: middle; padding: 8px 6px; font-size: 12px; text-transform: uppercase; }
        .oc-table th.oc-th-green { background: #43a047; }
        .oc-table td { padding: 8px 6px; border-bottom: 1px solid #e3e6ea; vertical-align: middle; text-align: center; }
        .oc-table td.oc-td-green { background: #e2f1e3; }
        .oc-table td.left { text-align: left; }
        .oc-table input.form-control { min-width: 70px; text-align: right; }
        .oc-table textarea.oc-comment { min-width: 220px; text-align: left; resize: vertical; }
        /* Photo article : même règle que les stats (excess for sales...) — image par défaut si aucune photo trouvée. */
        .oc-photo { display: flex; align-items: center; justify-content: center; width: 64px; height: 64px; margin: 0 auto; line-height: 0; overflow: hidden; }
        .oc-photo img { display: block; max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; border-radius: 4px; }
        .oc-photo img:not([src]) { width: 64px; height: 64px; background: url('/assets/images/no-image.png') center / contain no-repeat; }
        .oc-client-title { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 8px; }
        .oc-variant { background: #fafbfd; }
        .oc-variant td.left { padding-left: 30px; }
        .oc-size-badge { display: inline-block; background: #e8eef7; color: #1f3d6e; border-radius: 10px; padding: 1px 8px; font-size: 11px; font-weight: 600; }
        .oc-size-note { font-size: 12px; color: #5b6b7b; margin-top: 2px; }
        .oc-size-chip { display: inline-flex; align-items: center; gap: 6px; margin: 0 8px 8px 0; padding: 5px 12px 5px 8px; border: 1px solid #b9cbe0; border-radius: 16px; background: #fff; cursor: pointer; user-select: none; font-weight: 600; }
        .oc-size-chip:hover { border-color: #3b82c4; }
        .oc-size-chip input { position: absolute; opacity: 0; pointer-events: none; }
        .oc-size-box { width: 16px; height: 16px; border: 2px solid #8aa4c2; border-radius: 4px; background: #fff; display: inline-block; position: relative; }
        .oc-size-chip.on { background: #e3f0fd; border-color: #3b82c4; }
        .oc-size-chip.on .oc-size-box { background: #3b82c4; border-color: #3b82c4; }
        .oc-size-chip.on .oc-size-box::after { content: ''; position: absolute; left: 3px; top: -1px; width: 5px; height: 9px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }
        .oc-import-table td.err { background: #fdeaec; color: #a50e26; }
        .oc-import-table td.ok { background: #e6f4ea; color: #1e6b34; font-weight: 600; }
        .oc-import-table td.skip { background: #fdf2dc; color: #8a5500; }
        .oc-import-table tr.bad { background: #fff7f8; }
        .oc-sizes-panel { text-align: left; background: #f4f8fc; border: 1px solid #d5e3f3; border-radius: 6px; padding: 10px 14px; font-size: 13px; }
        .oc-warn { display: block; text-align: left; font-size: 12px; padding: 4px 10px; border-radius: 4px; margin: 2px 0; }
        .oc-warn.existing { background: #e6f2fc; color: #0b5394; }
        .oc-warn.pending { background: #fdeaec; color: #a50e26; font-weight: 600; }
        .oc-warn.unsent { background: #fdf2dc; color: #8a5500; font-weight: 600; }
        tr.oc-blocked td { background: #fff7f7; }
        .oc-empty { color: #6b7683; padding: 18px; text-align: center; }
    </style>
{% endblock %}

{% block body %}
    <section class="content">
        <div class="row">
            <div class="col-12">
                <div class="box">
                    <div class="box-header with-border d-md-flex align-items-center justify-content-between">
                        <h4 class="box-title" id="ocTitle">
                            {% if initial and initial.offerId %}Modifier l'OC {{ initial.number }} <span class="badge bg-secondary ms-2">Brouillon</span>
                            {% elseif initial and initial.sourceOfferId %}Nouvelle OC à partir de l'OC rejetée {{ initial.sourceNumber }}
                            {% else %}Nouvelle offre commerciale — Tarif Spé{% endif %}
                        </h4>
                        <div class="d-flex align-items-center gap-2 mt-2 mt-md-0">
                            <a href="{{ path('app_oc_index') }}" class="btn btn-sm btn-outline-secondary">Retour à la liste</a>
                            <button type="button" id="btnDraft" class="btn btn-sm btn-secondary">Enregistrer le brouillon</button>
                            <button type="button" id="btnSubmit" class="btn btn-sm btn-primary" disabled>Soumettre pour validation</button>
                        </div>
                    </div>

                    <div class="box-body">
                        <div id="ocToast" class="alert alert-info py-2 d-none"></div>
                        <div id="ocErrors" class="alert alert-danger d-none" role="alert"></div>
                        <div id="ocWarnings" class="alert alert-warning d-none" role="alert"></div>

                        {# 1. Paramètres #}
                        <div class="row g-3 mb-4 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Type d'offre</label>
                                <select class="form-select" id="ocType">
                                    <option value="tarif_spe" selected>Tarif Spé</option>
                                    <option value="referentiel" disabled>Référentiel (bientôt)</option>
                                    <option value="devis" disabled>Devis (bientôt)</option>
                                    <option value="remise" disabled>Remise (bientôt)</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold" for="ocStart">Début de validité</label>
                                <input type="date" class="form-control" id="ocStart">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label fw-bold" for="ocEnd">Fin de validité <span class="text-muted fw-normal">(1 an par défaut)</span></label>
                                <input type="date" class="form-control" id="ocEnd">
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-bold d-block">Commentaire</label>
                                <button type="button" class="btn btn-primary" id="btnComment" data-bs-toggle="modal" data-bs-target="#ocCommentModal">Commentaire</button>
                                <span class="text-muted small ms-2 d-none" id="ocCommentFlag">Commentaire renseigné</span>
                            </div>
                        </div>

                        {# 2. Clients #}
                        <div class="mb-4">
                            <label class="form-label fw-bold" for="ocCustomerInput">Client</label>
                            <div class="input-group oc-search mb-2">
                                <input type="text" class="form-control" id="ocCustomerInput" list="ocCustomerList" placeholder="Code ou nom du client…" autocomplete="off">
                            </div>
                            <datalist id="ocCustomerList"></datalist>
                            <div id="ocCustomerChips"></div>
                        </div>

                        {# 3. Articles : soit sélection d'un ou plusieurs articles, soit import d'un fichier (client(s) requis) #}
                        <div class="mb-4">
                            <label class="form-label fw-bold" for="ocArticleInput">Articles</label>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <div class="input-group oc-search">
                                    <input type="text" class="form-control" id="ocArticleInput" list="ocArticleList" placeholder="Code ou désignation de l'article…" autocomplete="off">
                                    <button type="button" class="btn btn-primary" id="btnAddArticle">Ajouter</button>
                                </div>
                                <span class="text-muted">ou</span>
                                <span id="ocImportWrap" title="Sélectionnez d'abord un client">
                                    <button type="button" class="btn btn-primary" id="btnImport" data-bs-toggle="modal" data-bs-target="#ocImportModal" disabled>Importer un fichier (Excel/CSV)</button>
                                </span>
                            </div>
                            <datalist id="ocArticleList"></datalist>
                            <div class="form-text">Pour une taille précise (ou une taille à un autre prix), tapez son code avec « _ » (ex. 2210037_T9) ou utilisez le bouton « Prix par taille » sous la ligne de l'article.</div>
                            <div class="form-text" id="ocImportHint">L'import est disponible une fois le client sélectionné.</div>
                        </div>

                        {# 4. Saisie des tarifs, un tableau par client #}
                        <div id="ocTables"></div>
                    </div>
                </div>
            </div>
        </div>
        {# Modal du commentaire de l'OC (visible du valideur) #}
        <div class="modal fade" id="ocCommentModal" tabindex="-1" aria-labelledby="ocCommentModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="ocCommentModalLabel">Commentaire de l'offre</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                    </div>
                    <div class="modal-body">
                        <textarea class="form-control" id="ocComment" rows="6" maxlength="500" placeholder="Contexte de l'offre (visible du valideur)"></textarea>
                        <div class="form-text text-end"><span id="ocCommentCount">0</span>/500</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                        <button type="button" class="btn btn-primary" id="btnCommentSave" data-bs-dismiss="modal">Enregistrer</button>
                    </div>
                </div>
            </div>
        </div>
        {{ include('oc/_import_modal.html.twig') }}
    </section>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const CSRF = '{{ csrf }}';
            const INITIAL = {{ initial|json_encode|raw }};
            const SAVE_URL = '{{ path('app_oc_save') }}';
            const SUBMIT_URL_TPL = '{{ path('app_oc_submit', {id: 0}) }}';
            const EXISTING_TARIFFS_URL = '{{ path('app_oc_api_existing_tariffs') }}';
            const CUSTOMER_URL = '{{ path('app_oc_api_customers') }}';
            const CUSTOMER_MIN_CHARS = 2;
            const DISCOUNT_URL = '{{ path('app_oc_api_customer_discount', {code: 'CODE_PLACEHOLDER'}) }}';
            const PRICES_URL = '{{ path('app_oc_api_prices') }}';
            const ARTICLE_URL = '{{ path('app_oc_api_articles') }}';
            const IMPORT_URL = '{{ path('app_oc_import') }}';
            // Tailles (variants) d'un article parent, lues dans X3 pour le bouton « Prix par taille ».
            const VARIANTS_URL = '{{ path('app_oc_api_article_variants', {parent: 'PARENTPLACEHOLDER'}) }}';
            // TVA : placeholder (20 %) tant que sa source n'est pas branchée (sert au calcul de la marge à partir du MSRP).
            const DEFAULT_TVA = 20;
            const PHOTO_BASE = 'https://www.lecoqsportif.com/cdn/shop/files/';
            // Cascade de noms de fichiers devinés, puis recherche Shopify côté serveur (même règle que les stats).
            const PHOTO_SUFFIXES = ['_2.webp', '_new_1.webp', '_1.webp', '_2.jpg', '_new_1.jpg', '_1.jpg'];
            const PHOTO_LOOKUP_URL = '{{ path('lecoqsportif_image_lookup', {article: 'ARTICLE_PLACEHOLDER'}) }}';

            // removed : lignes (client|article) supprimées individuellement ; l'article reste proposé aux autres clients.
            const state = { customers: [], articles: [], lines: {}, numbers: {}, removed: {}, prices: {}, offerId: null, sourceOfferId: null, variants: {}, sizePanel: null, sizeChecks: {} };

            const $ = function (id) { return document.getElementById(id); };
            const esc = function (s) { const d = document.createElement('div'); d.textContent = s == null ? '' : String(s); return d.innerHTML; };
            const round = function (v, d) { return Number(Math.round(v + 'e' + d) + 'e-' + d); };
            const num = function (s) { const n = parseFloat(String(s).replace(',', '.')); return isNaN(n) ? 0 : n; };
            const fmt = function (n) { return Number.isFinite(n) ? String(n) : ''; };
            const isoDate = function (d) { return d.toISOString().slice(0, 10); };

            // Dates par défaut : début = aujourd'hui, fin = +1 an.
            const today = new Date();
            const nextYear = new Date(today); nextYear.setFullYear(today.getFullYear() + 1);
            $('ocStart').value = isoDate(today);
            $('ocEnd').value = isoDate(nextYear);

            // Clients et articles viennent de X3 (recherche à la frappe, voir searchCustomers / searchArticles).

            function toast(msg) {
                const t = $('ocToast');
                t.textContent = msg;
                t.classList.remove('d-none');
                setTimeout(function () { t.classList.add('d-none'); }, 4000);
            }

            // Numéro prévisionnel : OC + AAAAMM + code client + 8 chiffres aléatoires (démo ; généré côté serveur ensuite).
            function previewNumber(customerCode) {
                if (!state.numbers[customerCode]) {
                    const ym = today.getFullYear() + String(today.getMonth() + 1).padStart(2, '0');
                    state.numbers[customerCode] = 'OC' + ym + customerCode + String(Math.floor(Math.random() * 1e8)).padStart(8, '0');
                }
                return state.numbers[customerCode];
            }

            // Photo : tente chaque suffixe, puis la recherche serveur, puis masque l'image (le fond "no-image" apparaît).
            window.ocPhotoError = function (img) {
                const step = parseInt(img.dataset.step || '0', 10);
                const article = img.dataset.article;
                if (step < PHOTO_SUFFIXES.length - 1) {
                    img.dataset.step = String(step + 1);
                    img.src = PHOTO_BASE + encodeURIComponent(article) + PHOTO_SUFFIXES[step + 1];
                } else if (step === PHOTO_SUFFIXES.length - 1) {
                    img.dataset.step = String(step + 1);
                    fetch(PHOTO_LOOKUP_URL.replace('ARTICLE_PLACEHOLDER', encodeURIComponent(article)))
                        .then(function (r) { return r.json(); })
                        .then(function (d) { if (d.success && d.url) { img.src = d.url; } else { img.removeAttribute('src'); } })
                        .catch(function () { img.removeAttribute('src'); });
                } else {
                    img.onerror = null;
                    img.removeAttribute('src');
                }
            };

            function photoHtml(ref) {
                return '<span class="oc-photo"><img alt="photo article" data-step="0" data-article="' + esc(ref) + '" src="'
                    + PHOTO_BASE + encodeURIComponent(ref) + PHOTO_SUFFIXES[0] + '" onerror="ocPhotoError(this)"></span>';
            }

            // Code tarif (groupe tarifaire du client), tarif et MSRP : X3, collection la plus récente de l'article.
            // state.prices[client|article] = { loading } puis { found, tariffCode, currency, tariff, msrp } ou { error }.
            function loadPrices(c, a) {
                const k = lineKey(c.code, a.ref);
                if (state.prices[k]) return;
                state.prices[k] = { loading: true };
                fetch(PRICES_URL + '?customer=' + encodeURIComponent(c.code) + '&article=' + encodeURIComponent(a.ref), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (d) {
                        state.prices[k] = d;
                        // MSRP proposé dans le champ (modifiable) tant que l'utilisateur ne l'a pas saisi lui-même.
                        const line = ensureLine(c, a);
                        if (d.msrp !== null && !line.pvcTouched) { line.pvc = String(d.msrp); }
                        // Ligne ajoutée avec un prix (import) : la marge se calcule dès que le MSRP est connu.
                        if (line.price !== '' && line.margin === '') {
                            const net = pvNet(line.pvc, a.tva);
                            if (net) { line.margin = fmt(round(((net - num(line.price)) / net) * 100, 2)); }
                        }
                        render();
                    })
                    .catch(function () { state.prices[k] = { error: true }; render(); });
            }

            function lineKey(c, a) { return c + '|' + a; }

            // Une ligne est soit un article PARENT (« 2210037 » : son prix vaut pour toutes ses tailles), soit une TAILLE
            // (« 2210037_T9 » : ce prix ne vaut que pour cette taille et l'emporte sur celui du parent).
            function parentOf(ref) { return String(ref).split('_')[0]; }
            function isVariant(ref) { return String(ref).indexOf('_') > -1; }
            function sizeOf(ref) { return String(ref).slice(parentOf(ref).length + 1); }

            function ensureLine(customer, article) {
                const k = lineKey(customer.code, article.ref);
                if (!state.lines[k]) {
                    state.lines[k] = { price: '', margin: '', pvc: article.pvc, minQty: 0, maxQty: 999999, comment: '' };
                }
                return state.lines[k];
            }

            // ── Calcul de la marge (reprise de l'ancien calcul(), sans markup) ──
            function pvNet(pvc, tva) { return (num(pvc) * 100) / (100 + tva); }

            function onInput(customerCode, articleRef, field, value) {
                const article = state.articles.find(function (a) { return a.ref === articleRef; });
                const line = state.lines[lineKey(customerCode, articleRef)];
                const net = pvNet(line.pvc, article.tva);
                if (field === 'pvc') {
                    line.pvc = value;
                    line.pvcTouched = true;
                    const n = pvNet(value, article.tva);
                    if (num(line.price) && n) line.margin = fmt(round(((n - num(line.price)) / n) * 100, 2));
                } else if (field === 'price') {
                    line.price = value;
                    line.margin = (value !== '' && net) ? fmt(round(((net - num(value)) / net) * 100, 2)) : '';
                } else if (field === 'margin') {
                    line.margin = value;
                    line.price = (value !== '' && net) ? fmt(round(net - (num(value) * net) / 100, 2)) : '';
                } else {
                    line[field] = value;
                }
                // Mise à jour ciblée des champs liés (sans reconstruire le tableau : le focus est conservé).
                const row = document.querySelector('tr[data-key="' + lineKey(customerCode, articleRef) + '"]');
                if (row) {
                    if (field !== 'price') row.querySelector('[data-f="price"]').value = line.price;
                    if (field !== 'margin') row.querySelector('[data-f="margin"]').value = line.margin;
                }
            }

            function priceText(p, field) {
                if (p.loading || (!p.error && p.found === undefined)) return '…';
                if (p.error) return 'Erreur';
                const v = p[field];
                return v === null || v === undefined || v === '' ? '—' : (typeof v === 'number' ? v.toFixed(2) : v);
            }
            function discountText(c) {
                if (c.discount === undefined) return '…';
                if (c.discountError) return 'Erreur';
                return c.discount === null ? 'Aucune' : c.discount + ' %';
            }
            function discountTitle(c) {
                if (c.discountError) return 'Remise client indisponible, réessayez';
                if (c.discount === null || c.discount === undefined) return 'Remise client (REMCLI)';
                return 'Remise client (REMCLI)' + (c.discountStart ? ', applicable à partir du ' + c.discountStart : '');
            }

            function warningHtml(article, customerCode) {
                const w = article.warnings[customerCode];
                if (!w) return '';
                if (w.type === 'existing') {
                    const start = new Date($('ocStart').value);
                    start.setDate(start.getDate() - 1);
                    return '<span class="oc-warn existing">Un tarif spé existe déjà (' + esc(w.ref) + ', fin ' + esc(w.endDate) + ') : il sera clôturé au ' + esc(isoDate(start)) + ' puis un nouveau tarif sera créé (2 flux X3).</span>';
                }
                if (w.type === 'pending') {
                    return '<span class="oc-warn pending">OC en attente de validation (' + esc(w.ref) + ') pour ce client et cet article : création impossible tant qu\'elle n\'est pas traitée.</span>';
                }
                return '<span class="oc-warn unsent">OC validée mais pas encore envoyée à X3 (' + esc(w.ref) + ') : création impossible tant que le flux n\'est pas parti.</span>';
            }

            function isBlocked(article, customerCode) {
                const w = article.warnings[customerCode];
                return !!w && (w.type === 'pending' || w.type === 'unsent');
            }

            // Cellule « Produit » : code, désignation et, sous un parent, ce qui part à X3 ; sous une taille, ce que son prix remplace.
            function productCell(a, visible, parentLines) {
                let html = '<strong>' + esc(a.ref) + '</strong>';
                if (isVariant(a.ref)) {
                    return html + ' <span class="oc-size-badge">Taille ' + esc(sizeOf(a.ref)) + '</span><br>' + esc(a.label)
                        + '<div class="oc-size-note">' + (parentLines[parentOf(a.ref)]
                            ? 'Ce prix remplace celui de l\'article pour cette taille.'
                            : 'Cette taille uniquement : les autres tailles ne partent pas à X3.') + '</div>';
                }
                const own = visible.filter(function (v) { return isVariant(v.ref) && parentOf(v.ref) === a.ref; }).map(function (v) { return esc(sizeOf(v.ref)); });
                return html + '<br>' + esc(a.label)
                    + '<div class="oc-size-note">' + (own.length ? 'Toutes les tailles à ce prix, sauf : ' + own.join(', ') + '.' : 'Toutes les tailles au même prix.') + '</div>'
                    + '<button type="button" class="btn btn-sm btn-outline-primary mt-1" data-sizes="' + esc(a.ref) + '">Prix par taille</button>';
            }

            // Tailles d'un parent lues dans X3 (une erreur n'est jamais présentée comme « aucune taille »).
            function loadVariants(parent) {
                const cur = state.variants[parent];
                if (cur && !cur.error) { return; }
                state.variants[parent] = { loading: true };
                fetch(VARIANTS_URL.replace('PARENTPLACEHOLDER', encodeURIComponent(parent)), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (d) { state.variants[parent] = { list: d.variants || [] }; render(); })
                    .catch(function () { state.variants[parent] = { error: true }; render(); });
            }

            // Panneau « Prix par taille » sous la ligne d'un parent : cases à cocher des tailles pas encore saisies.
            function sizesPanelRow(a) {
                if (isVariant(a.ref) || state.sizePanel !== a.ref) { return ''; }
                const v = state.variants[a.ref];
                let body;
                let actions = '';
                if (!v || v.loading) {
                    body = 'Chargement des tailles…';
                } else if (v.error) {
                    body = 'Les tailles ne peuvent pas être lues (X3 indisponible). <button type="button" class="btn btn-sm btn-link" data-sizes-retry="' + esc(a.ref) + '">Réessayer</button>';
                } else {
                    const present = {};
                    state.articles.forEach(function (x) { if (!state.removed[lineKey(state.customers[0].code, x.ref)]) { present[x.ref] = true; } });
                    const free = v.list.filter(function (r) { return !present[r]; });
                    if (!v.list.length) {
                        body = 'Cet article n\'a aucune taille dans X3.';
                    } else if (!free.length) {
                        body = 'Toutes les tailles ont déjà leur propre ligne.';
                    } else {
                        body = '<div class="mb-2">Cochez les tailles à tarifer à part. Chaque ligne démarre avec le prix et les quantités de l\'article, modifiables ensuite :</div>'
                            + free.map(function (r) {
                                const on = !!state.sizeChecks[r];
                                return '<label class="oc-size-chip' + (on ? ' on' : '') + '"><input type="checkbox" data-size-check="' + esc(r) + '"' + (on ? ' checked' : '') + '><span class="oc-size-box"></span>' + esc(sizeOf(r)) + '</label>';
                            }).join('');
                        actions = '<button type="button" class="btn btn-sm btn-primary me-2" data-sizes-add="' + esc(a.ref) + '">Ajouter les tailles cochées</button>'
                            + '<button type="button" class="btn btn-sm btn-outline-primary me-2" data-sizes-all="' + esc(a.ref) + '">Tout cocher</button>';
                    }
                }
                return '<tr class="oc-sizes-row"><td colspan="13"><div class="oc-sizes-panel">' + body
                    + '<div class="mt-2">' + actions + '<button type="button" class="btn btn-sm btn-secondary" data-sizes-close="1">Fermer</button></div></div></td></tr>';
            }

            // Crée une ligne par taille cochée, avec le prix, le MSRP et les quantités de la ligne parent comme point de départ.
            function addSizes(refs) {
                state.customers.forEach(function (c) {
                    refs.forEach(function (ref) {
                        const parentArt = state.articles.find(function (x) { return x.ref === parentOf(ref); });
                        const parentLine = parentArt ? ensureLine(c, parentArt) : null;
                        let art = state.articles.find(function (x) { return x.ref === ref; });
                        if (art) { delete state.removed[lineKey(c.code, ref)]; return; }
                        art = { ref: ref, label: parentArt ? parentArt.label : '', tva: parentArt ? parentArt.tva : DEFAULT_TVA, warnings: {} };
                        state.articles.push(art);
                        const l = ensureLine(c, art);
                        if (parentLine) {
                            l.price = parentLine.price; l.margin = parentLine.margin; l.pvc = parentLine.pvc; l.pvcTouched = parentLine.pvcTouched;
                            l.minQty = parentLine.minQty; l.maxQty = parentLine.maxQty; l.comment = parentLine.comment;
                        }
                        loadPrices(c, art);
                    });
                });
            }

            function render() {
                // Chips
                $('ocCustomerChips').innerHTML = state.customers.map(function (c) {
                    return '<span class="oc-chip">' + esc(c.code + ' - ' + c.name) + (c.city ? ' · ' + esc(c.city) : '') + (state.offerId ? '' : '<button type="button" data-rm-customer="' + esc(c.code) + '" aria-label="Retirer">×</button>') + '</span>';
                }).join('');

                // Un seul client par OC (la sélection multiple reviendra plus tard) : recherche bloquée une fois choisi.
                $('ocCustomerInput').disabled = state.customers.length >= 1;
                $('ocCustomerInput').placeholder = state.customers.length ? 'Retirez le client pour en choisir un autre' : 'Code ou nom du client…';

                // Import : disponible uniquement quand au moins un client est sélectionné.
                const hasCustomer = state.customers.length > 0;
                $('btnImport').disabled = !hasCustomer;
                $('ocImportWrap').title = hasCustomer ? '' : 'Sélectionnez d\'abord un client';
                $('ocImportHint').classList.toggle('d-none', hasCustomer);
                const importClients = document.getElementById('ocImportClients');
                if (importClients) {
                    importClients.textContent = state.customers.map(function (c) { return c.code + ' - ' + c.name; }).join(' · ');
                }

                // Tableaux
                if (!state.customers.length || !state.articles.length) {
                    $('ocTables').innerHTML = '<div class="oc-empty">Sélectionnez un client et ajoutez au moins un article pour saisir les tarifs.</div>';
                    $('btnSubmit').disabled = true;
                    return;
                }
                let anyBlocked = false;
                $('ocTables').innerHTML = state.customers.map(function (c) {
                    const visible = state.articles.filter(function (a) { return !state.removed[lineKey(c.code, a.ref)]; });
                    // Les lignes d'un même article sont regroupées : la ligne parent d'abord, puis ses tailles.
                    const firstIdx = {};
                    state.articles.forEach(function (a, i) { const p = parentOf(a.ref); if (!(p in firstIdx)) { firstIdx[p] = i; } });
                    visible.sort(function (x, y) {
                        const px = parentOf(x.ref), py = parentOf(y.ref);
                        if (px !== py) { return firstIdx[px] - firstIdx[py]; }
                        if (isVariant(x.ref) !== isVariant(y.ref)) { return isVariant(x.ref) ? 1 : -1; }
                        return x.ref < y.ref ? -1 : 1;
                    });
                    const parentLines = {};
                    visible.forEach(function (a) { if (!isVariant(a.ref)) { parentLines[a.ref] = true; } });
                    const rows = visible.map(function (a) {
                        const l = ensureLine(c, a);
                        const p = state.prices[lineKey(c.code, a.ref)] || {};
                        const blocked = isBlocked(a, c.code);
                        if (blocked) anyBlocked = true;
                        return '<tr data-key="' + esc(lineKey(c.code, a.ref)) + '" class="' + (blocked ? 'oc-blocked' : '') + (isVariant(a.ref) ? ' oc-variant' : '') + '">'
                            + '<td>' + (isVariant(a.ref) && parentLines[parentOf(a.ref)] ? '' : photoHtml(parentOf(a.ref))) + '</td>'
                            + '<td class="left">' + productCell(a, visible, parentLines) + '</td>'
                            + '<td>' + esc(p.currency || c.currency) + '</td>'
                            + '<td>' + esc(priceText(p, 'tariffCode')) + '</td>'
                            + '<td>' + esc(priceText(p, 'tariff')) + '</td>'
                            + '<td title="' + esc(discountTitle(c)) + '">' + esc(discountText(c)) + '</td>'
                            + '<td><input class="form-control form-control-sm" data-f="pvc" value="' + esc(l.pvc) + '" inputmode="decimal"></td>'
                            + '<td class="oc-td-green"><input class="form-control form-control-sm" data-f="price" value="' + esc(l.price) + '" inputmode="decimal" placeholder="Tarif">'+ '</td>'
                            + '<td class="oc-td-green"><input class="form-control form-control-sm" data-f="margin" value="' + esc(l.margin) + '" inputmode="decimal" placeholder="% marge"></td>'
 
                            + '<td><input class="form-control form-control-sm" data-f="minQty" value="' + esc(l.minQty) + '" inputmode="numeric"></td>'
                            + '<td><input class="form-control form-control-sm" data-f="maxQty" value="' + esc(l.maxQty) + '" inputmode="numeric"></td>'
                            + '<td><textarea class="form-control form-control-sm oc-comment" data-f="comment" rows="2" maxlength="500">' + esc(l.comment) + '</textarea></td>'
                            + '<td><button type="button" class="btn btn-sm btn-danger" data-rm-line="' + esc(lineKey(c.code, a.ref)) + '" title="Supprimer cet article pour ce client" aria-label="Supprimer la ligne">×</button></td>'
                            + '</tr>'
                            + sizesPanelRow(a)
                            + (a.warnings[c.code] ? '<tr><td colspan="13" style="padding:0 6px 6px">' + warningHtml(a, c.code) + '</td></tr>' : '');
                    }).join('');
                    return '<div class="mb-4" data-customer="' + esc(c.code) + '">'
                        + '<div class="oc-client-title"><h5 class="mb-2">Liste des produits pour le client ' + esc(c.code + ' - ' + c.name) + '</h5>'
                        + '<span class="text-muted small">N° prévisionnel : ' + esc(previewNumber(c.code)) + '</span></div>'
                        + '<div class="table-responsive"><table class="oc-table"><thead><tr>'
                        + '<th>Photo</th><th>Produit</th><th>Devise</th><th>Code tarif</th><th>Tarif</th><th>Remise client</th><th>MSRP</th>'
                        + '<th class="oc-th-green">Tarif OC (net)</th><th class="oc-th-green">Marge souhaitée (%)</th><th>Qté min</th><th>Qté max</th><th>Commentaire</th><th></th>'
                        + '</tr></thead><tbody>' + (rows || '<tr><td colspan="13" class="oc-empty">Aucun article pour ce client.</td></tr>') + '</tbody></table></div></div>';
                }).join('');
                $('btnSubmit').disabled = anyBlocked;
                $('btnSubmit').title = anyBlocked ? 'Une ou plusieurs lignes sont bloquées par une OC existante' : '';
            }

            // ── Clients : recherche X3 (code ou nom), debounce 300 ms ──
            const customerLabel = function (c) { return c.code + ' - ' + c.name; };
            let customerResults = [];
            let customerTimer = null;
            let customerSeq = 0;

            function searchCustomers(text) {
                const q = text.trim();
                if (q.length < CUSTOMER_MIN_CHARS) { return Promise.resolve([]); }
                const seq = ++customerSeq;
                return fetch(CUSTOMER_URL + '?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (rows) {
                        const list = rows.map(function (r) {
                            return { code: r.CODE_CLIENT, name: r.NOM_CLIENT, currency: r.DEVISE, city: r.VILLE, country: r.PAYS };
                        });
                        if (seq === customerSeq) {
                            customerResults = list;
                            $('ocCustomerList').innerHTML = list.map(function (c) { return '<option value="' + esc(customerLabel(c)) + '">'; }).join('');
                        }
                        return list;
                    });
            }

            $('ocCustomerInput').addEventListener('input', function () {
                clearTimeout(customerTimer);
                const v = this.value;
                // Choix dans la liste : la saisie est un libellé déjà proposé, le client est ajouté tout de suite (pas de bouton) et il est
                // inutile (et nocif) de relancer une recherche. Un code tapé seul n'ajoute rien : il peut n'être que le début d'un autre.
                const picked = customerResults.find(function (c) { return customerLabel(c).toLowerCase() === v.trim().toLowerCase(); });
                if (picked) { addCustomer(picked); return; }
                if (exactCustomer(v, customerResults)) { return; }
                customerTimer = setTimeout(function () {
                    searchCustomers(v).catch(function () { toast('Recherche client indisponible, réessayez.'); });
                }, 300);
            });

            // Retourne le client correspondant à la saisie : libellé exact de la liste, code exact,
            // ou résultat unique. Sinon null (ambigu ou introuvable).
            function exactCustomer(text, list) {
                const t = text.trim().toLowerCase();
                return list.find(function (c) { return customerLabel(c).toLowerCase() === t || c.code.toLowerCase() === t; }) || null;
            }

            // ── Articles parents : recherche X3 (code ou désignation), debounce 300 ms ──
            const articleLabel = function (a) { return a.ref + ' - ' + a.label; };
            let articleResults = [];
            let articleTimer = null;
            let articleSeq = 0;

            function searchArticles(text) {
                const q = text.trim();
                if (q.length < CUSTOMER_MIN_CHARS) { return Promise.resolve([]); }
                const seq = ++articleSeq;
                return fetch(ARTICLE_URL + '?q=' + encodeURIComponent(q), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (rows) {
                        const list = rows.map(function (r) {
                            return { ref: r.ARTICLE, label: r.DESIGNATION || '', tva: DEFAULT_TVA, warnings: {} };
                        });
                        if (seq === articleSeq) {
                            articleResults = list;
                            $('ocArticleList').innerHTML = list.map(function (a) { return '<option value="' + esc(articleLabel(a)) + '">'; }).join('');
                        }
                        return list;
                    });
            }

            $('ocArticleInput').addEventListener('input', function () {
                clearTimeout(articleTimer);
                const v = this.value;
                if (exactArticle(v, articleResults)) { return; }
                articleTimer = setTimeout(function () {
                    searchArticles(v).catch(function () { toast('Recherche article indisponible, réessayez.'); });
                }, 300);
            });

            function exactArticle(text, list) {
                const t = text.trim().toLowerCase();
                return list.find(function (a) { return articleLabel(a).toLowerCase() === t || a.ref.toLowerCase() === t; }) || null;
            }

            // Ajout : la valeur choisie dans la liste (libellé "code - nom") est reprise telle quelle depuis
            // les derniers résultats ; sinon on cherche avec la saisie (code exact ou résultat unique).
            // "code - libellé" -> "code" (un libellé complet ne correspond à aucun code ni nom en base).
            function codePart(text) {
                const i = text.indexOf(' - ');
                return i > 0 ? text.slice(0, i) : text;
            }

            // Remise client (REMCLI) : chargée une fois à l'ajout du client. undefined = en cours, null = aucune.
            function loadDiscount(c) {
                fetch(DISCOUNT_URL.replace('CODE_PLACEHOLDER', encodeURIComponent(c.code)), { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
                    .then(function (d) { c.discount = d.discount; c.discountStart = d.startDate; render(); })
                    .catch(function () { c.discount = null; c.discountError = true; render(); });
            }

            function addCustomer(c) {
                if (!state.customers.some(function (x) { return x.code === c.code; })) {
                    state.customers.push(c);
                    loadDiscount(c);
                    state.articles.forEach(function (a) { loadPrices(c, a); });
                }
                $('ocCustomerInput').value = '';
                render();
            }
            function addArticle(a) {
                state.customers.forEach(function (c) { delete state.removed[lineKey(c.code, a.ref)]; });
                if (!state.articles.some(function (x) { return x.ref === a.ref; })) state.articles.push(a);
                state.customers.forEach(function (c) { loadPrices(c, a); });
                $('ocArticleInput').value = '';
                render();
            }

            // Entrée dans le champ client : code exact, libellé exact ou résultat unique (le choix dans la liste ajoute déjà le client).
            function submitCustomer() {
                const text = $('ocCustomerInput').value;
                const cached = exactCustomer(text, customerResults);
                if (cached) { addCustomer(cached); return; }
                searchCustomers(codePart(text)).then(function (list) {
                    if (!list.length) { toast('Client introuvable (2 caractères minimum, code ou nom).'); return; }
                    const c = exactCustomer(text, list) || (list.length === 1 ? list[0] : null);
                    if (!c) { toast('Plusieurs clients correspondent : choisissez-en un dans la liste.'); return; }
                    addCustomer(c);
                }).catch(function () { toast('Recherche client indisponible, réessayez.'); });
            }
            $('btnAddArticle').addEventListener('click', function () {
                const text = $('ocArticleInput').value;
                const cached = exactArticle(text, articleResults);
                if (cached) { addArticle(cached); return; }
                searchArticles(codePart(text)).then(function (list) {
                    if (!list.length) { toast('Article introuvable (2 caractères minimum, code ou désignation).'); return; }
                    const a = exactArticle(text, list) || (list.length === 1 ? list[0] : null);
                    if (!a) { toast('Plusieurs articles correspondent : choisissez-en un dans la liste.'); return; }
                    addArticle(a);
                }).catch(function () { toast('Recherche article indisponible, réessayez.'); });
            });
            ['ocCustomerInput', 'ocArticleInput'].forEach(function (id) {
                $(id).addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); if (id === 'ocCustomerInput') { submitCustomer(); } else { $('btnAddArticle').click(); } }
                });
            });

            document.addEventListener('click', function (e) {
                const rc = e.target.getAttribute && e.target.getAttribute('data-rm-customer');
                const rl = e.target.getAttribute && e.target.getAttribute('data-rm-line');
                if (rl) {
                    state.removed[rl] = true;
                    const ref = rl.split('|')[1];
                    // Plus aucun client n'utilise cet article : on le retire aussi de la liste des articles.
                    if (state.customers.every(function (c) { return state.removed[lineKey(c.code, ref)]; })) {
                        state.articles = state.articles.filter(function (a) { return a.ref !== ref; });
                    }
                    render();
                }
                if (rc) { state.customers = state.customers.filter(function (c) { return c.code !== rc; }); render(); }
            });

            // « Prix par taille » : ouvrir / fermer le panneau, cocher des tailles, les ajouter.
            document.addEventListener('click', function (e) {
                const t = e.target;
                const get = function (n) { return t.getAttribute ? t.getAttribute(n) : null; };
                if (get('data-sizes')) {
                    const p = get('data-sizes');
                    state.sizePanel = state.sizePanel === p ? null : p;
                    if (state.sizePanel) { loadVariants(p); }
                    render();
                } else if (get('data-sizes-retry')) {
                    const p = get('data-sizes-retry');
                    delete state.variants[p];
                    loadVariants(p);
                    render();
                } else if (get('data-sizes-all')) {
                    const p = get('data-sizes-all');
                    const v = state.variants[p];
                    const present = {};
                    state.articles.forEach(function (x) { if (!state.removed[lineKey(state.customers[0].code, x.ref)]) { present[x.ref] = true; } });
                    (v && v.list ? v.list : []).forEach(function (r) { if (!present[r]) { state.sizeChecks[r] = true; } });
                    render();
                } else if (get('data-sizes-close')) {
                    state.sizePanel = null;
                    render();
                } else if (get('data-sizes-add')) {
                    const p = get('data-sizes-add');
                    const refs = Object.keys(state.sizeChecks).filter(function (r) { return state.sizeChecks[r] && parentOf(r) === p; });
                    if (!refs.length) { toast('Cochez au moins une taille.'); return; }
                    addSizes(refs);
                    refs.forEach(function (r) { delete state.sizeChecks[r]; });
                    state.sizePanel = null;
                    render();
                }
            });
            $('ocTables').addEventListener('change', function (e) {
                const r = e.target.getAttribute('data-size-check');
                if (r) {
                    state.sizeChecks[r] = e.target.checked;
                    e.target.closest('label').classList.toggle('on', e.target.checked);   // coche dessinée par la page (le thème masque les cases natives)
                }
            });

            $('ocTables').addEventListener('input', function (e) {
                const f = e.target.getAttribute('data-f');
                if (!f) return;
                const row = e.target.closest('tr');
                const key = row.getAttribute('data-key').split('|');
                onInput(key[0], key[1], f, e.target.value);
            });
            // Le message "clôturé au …" dépend de la date de début.
            $('ocStart').addEventListener('change', render);

            // Commentaire de l'OC : saisi dans un modal ; "Annuler" restaure la dernière valeur enregistrée.
            let savedComment = '';
            const commentBox = $('ocComment');
            const refreshCommentUi = function () {
                $('ocCommentCount').textContent = commentBox.value.length;
                $('ocCommentFlag').classList.toggle('d-none', savedComment.trim() === '');
            };
            commentBox.addEventListener('input', refreshCommentUi);
            $('ocCommentModal').addEventListener('show.bs.modal', function () { commentBox.value = savedComment; refreshCommentUi(); });
            $('btnCommentSave').addEventListener('click', function () { savedComment = commentBox.value.trim(); refreshCommentUi(); });

            // ── Enregistrement (le serveur relit X3 et fige les valeurs ; voir OfferService) ──
            function showErrors(list) {
                $('ocErrors').innerHTML = '<ul class="mb-0">' + list.map(function (e) { return '<li>' + esc(e) + '</li>'; }).join('') + '</ul>';
                $('ocErrors').classList.remove('d-none');
                $('ocErrors').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            function clearErrors() { $('ocErrors').classList.add('d-none'); $('ocErrors').innerHTML = ''; }
            function showWarnings(list) {
                const box = $('ocWarnings');
                box.innerHTML = (list || []).map(function (w) { return '<div>' + esc(w) + '</div>'; }).join('');
                box.classList.toggle('d-none', !list || list.length === 0);
            }
            function setBusy(busy) { ['btnDraft', 'btnSubmit'].forEach(function (id) { $(id).disabled = busy || (id === 'btnSubmit' && !canSubmit()); }); }
            function canSubmit() { return state.customers.length > 0 && state.articles.length > 0; }

            function post(url, body) {
                return fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': CSRF },
                    body: JSON.stringify(body),
                }).then(function (r) {
                    return r.json().catch(function () { return { ok: false, errors: ['Réponse inattendue du serveur (' + r.status + ').'] }; });
                });
            }

            function buildPayload() {
                const c = state.customers[0];
                const lines = state.articles
                    .filter(function (a) { return !state.removed[lineKey(c.code, a.ref)]; })
                    .map(function (a) {
                        const l = ensureLine(c, a);
                        return { articleCode: a.ref, tariff: l.price, msrp: l.pvc, vatRate: a.tva, minQty: l.minQty, maxQty: l.maxQty, comment: l.comment };
                    });
                return {
                    id: state.offerId, sourceOfferId: state.sourceOfferId, customerCode: c.code,
                    startDate: $('ocStart').value, endDate: $('ocEnd').value, comment: savedComment, lines: lines,
                };
            }

            // Enregistre le brouillon ; renvoie la réponse du serveur ou null (erreurs affichées).
            function saveDraft() {
                clearErrors();
                if (!canSubmit()) { showErrors(['Sélectionnez un client et ajoutez au moins un article.']); return Promise.resolve(null); }
                setBusy(true);
                return post(SAVE_URL, buildPayload()).then(function (res) {
                    setBusy(false);
                    if (!res.ok) { showErrors(res.errors || ['Erreur inconnue.']); return null; }
                    showWarnings(res.warnings);
                    const firstSave = state.offerId === null;
                    state.offerId = res.id;
                    history.replaceState(null, '', res.editUrl);   // un rechargement rouvre ce brouillon
                    $('ocTitle').innerHTML = 'Modifier l\'OC ' + esc(res.number) + ' <span class="badge bg-secondary ms-2">Brouillon</span>';
                    if (firstSave) { render(); }                   // le client n'est plus retirable
                    return res;
                }).catch(function () {
                    setBusy(false);
                    showErrors(['Le serveur ne répond pas : rien n\'a été enregistré, réessayez.']);
                    return null;
                });
            }

            $('btnDraft').addEventListener('click', function () {
                saveDraft().then(function (res) { if (res) { toast('Brouillon enregistré : ' + res.number); } });
            });

            function submitOffer() {
                saveDraft().then(function (res) {
                    if (!res) { return null; }
                    setBusy(true);
                    return post(SUBMIT_URL_TPL.replace('/0/', '/' + res.id + '/'), {}).then(function (r) {
                        if (r.ok) { window.location.href = r.showUrl; return; }
                        setBusy(false);
                        showErrors(r.errors || ['Erreur inconnue.']);
                    });
                }).catch(function () { setBusy(false); showErrors(['Le serveur ne répond pas, réessayez.']); });
            }

            const frDate = function (iso) { const p = String(iso).split('-'); return p.length === 3 ? p[2] + '/' + p[1] + '/' + p[0] : iso; };

            // Avertissement (non bloquant) : tarifs spéciaux du client déjà en place sur ces articles, lus dans X3 au clic sur « Soumettre ».
            function existingTariffsHtml(tariffs, start) {
                const rows = tariffs.map(function (t) {
                    return '<li><strong>' + esc(t.article) + '</strong> — fiche ' + esc(t.fiche) + ' : du ' + frDate(t.from) + ' au ' + frDate(t.to)
                        + ', prix ' + Number(t.price).toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 5 }) + ' ' + esc(t.currency) + '</li>';
                }).join('');
                return '<div class="p-3 mb-3 rounded" style="background:#f8d7da;color:#842029;border:1px solid #f1aeb5">'
                    + '<strong>Une OC existe déjà pour ce client sur ces articles</strong> (' + tariffs.length + ' tarif(s) spécial(aux) en place). Le prix de cette OC (début le ' + frDate(start) + ') remplacera l\'ancien.'
                    + '<ul class="small mt-2 mb-0" style="max-height:240px;overflow:auto">' + rows + '</ul></div>'
                    + 'Soumettre quand même ? Elle ne sera plus modifiable.';
            }

            $('btnSubmit').addEventListener('click', function () {
                clearErrors();
                if (!canSubmit()) { showErrors(['Sélectionnez un client et ajoutez au moins un article.']); return; }
                const p = buildPayload();
                const plain = function () { confirmModal('Soumettre cette OC pour validation ? Elle ne sera plus modifiable.', submitOffer, 'Soumettre l\'OC'); };
                setBusy(true);
                post(EXISTING_TARIFFS_URL, { customerCode: p.customerCode, startDate: p.startDate, articleCodes: p.lines.map(function (l) { return l.articleCode; }) })
                    .then(function (res) {
                        setBusy(false);
                        if (res.ok && res.tariffs && res.tariffs.length) {
                            confirmModal(existingTariffsHtml(res.tariffs, p.startDate), submitOffer, 'Tarifs spéciaux déjà en place');
                        } else {
                            plain();   // aucun tarif, ou X3 muet : la validation contrôlera de nouveau
                        }
                    })
                    .catch(function () { setBusy(false); plain(); });
            });

            // ── Import d'un fichier de lignes : analyse par le serveur, aperçu avec les erreurs, ajout des lignes valides ──
            let importRows = [];
            const fmtNum = function (v) { return v === null || v === undefined ? '—' : (Number(v) % 1 === 0 ? String(v) : Number(v).toFixed(2)); };
            const alreadyInOffer = function (ref) {
                return state.articles.some(function (a) { return a.ref === ref && !state.customers.some(function (c) { return state.removed[lineKey(c.code, a.ref)]; }); });
            };

            function importReset() {
                importRows = [];
                $('ocImportRows').innerHTML = '';
                $('ocImportPreviewWrap').classList.add('d-none');
                $('ocImportMsg').innerHTML = '';
                $('ocImportSummary').textContent = '';
                $('ocImportAdd').disabled = true;
                $('ocImportAdd').textContent = 'Ajouter les lignes valides';
            }

            function importRender(res) {
                importRows = res.rows;
                let ready = 0;
                $('ocImportRows').innerHTML = res.rows.map(function (r) {
                    const dup = r.status === 'ok' && alreadyInOffer(r.article);
                    if (r.status === 'ok' && !dup) { ready += 1; }
                    const check = r.status === 'ok'
                        ? (dup ? '<td class="skip">Déjà dans l\'OC : ignorée</td>' : '<td class="ok">✓ Valide' + (r.isSize ? ' (taille)' : '') + '</td>')
                        : '<td class="err">' + r.errors.map(esc).join('<br>') + '</td>';
                    return '<tr class="' + (r.status === 'ok' ? '' : 'bad') + '"><td>' + esc(r.line) + '</td><td><strong>' + esc(r.article) + '</strong></td>'
                        + '<td>' + esc(r.label || '—') + '</td><td class="text-end">' + esc(fmtNum(r.tariff)) + '</td><td class="text-end">' + esc(fmtNum(r.x3Tariff)) + '</td>'
                        + '<td class="text-end">' + esc(fmtNum(r.minQty)) + '</td><td class="text-end">' + esc(fmtNum(r.maxQty)) + '</td>'
                        + '<td>' + esc(r.comment || '') + '</td>' + check + '</tr>';
                }).join('');
                $('ocImportPreviewWrap').classList.remove('d-none');
                const s = res.summary;
                $('ocImportMsg').innerHTML = '<div class="alert ' + (s.errors ? 'alert-warning' : 'alert-success') + ' py-2 mb-0">'
                    + s.total + ' ligne' + (s.total > 1 ? 's' : '') + ' lue' + (s.total > 1 ? 's' : '') + ' : <strong>' + s.valid + ' valide' + (s.valid > 1 ? 's' : '') + '</strong>'
                    + (s.errors ? ', <strong>' + s.errors + ' en erreur</strong> (non ajoutée' + (s.errors > 1 ? 's' : '') + ' : corrigez le fichier et réimportez-les).' : '.') + '</div>';
                $('ocImportSummary').textContent = ready + ' ligne' + (ready > 1 ? 's' : '') + ' à ajouter';
                $('ocImportAdd').disabled = ready === 0;
                $('ocImportAdd').textContent = 'Ajouter ' + (ready > 1 ? 'les ' + ready + ' lignes valides' : (ready === 1 ? 'la ligne valide' : 'les lignes valides'));
            }

            $('ocImportModal').addEventListener('show.bs.modal', function () { $('ocImportFile').value = ''; importReset(); });

            $('ocImportFile').addEventListener('change', function () {
                importReset();
                const file = this.files && this.files[0];
                if (!file) { return; }
                if (!state.customers.length) { $('ocImportMsg').innerHTML = '<div class="alert alert-danger py-2 mb-0">Sélectionnez d\'abord le client.</div>'; return; }
                const fd = new FormData();
                fd.append('file', file);
                fd.append('customerCode', state.customers[0].code);
                $('ocImportMsg').innerHTML = '<div class="text-muted">Analyse du fichier en cours (contrôle des articles dans X3)…</div>';
                fetch(IMPORT_URL, { method: 'POST', headers: { 'Accept': 'application/json', 'X-CSRF-Token': CSRF }, body: fd })
                    .then(function (r) { return r.json().catch(function () { return { ok: false, errors: ['Réponse inattendue du serveur (' + r.status + ').'] }; }); })
                    .then(function (res) {
                        if (!res.ok) {
                            $('ocImportMsg').innerHTML = '<div class="alert alert-danger py-2 mb-0">' + (res.errors || ['Erreur inconnue.']).map(esc).join('<br>') + '</div>';
                            return;
                        }
                        importRender(res);
                    })
                    .catch(function () { $('ocImportMsg').innerHTML = '<div class="alert alert-danger py-2 mb-0">Le serveur ne répond pas : réessayez.</div>'; });
            });

            $('ocImportAdd').addEventListener('click', function () {
                let added = 0;
                importRows.forEach(function (r) {
                    if (r.status !== 'ok' || alreadyInOffer(r.article)) { return; }
                    state.customers.forEach(function (c) {
                        delete state.removed[lineKey(c.code, r.article)];
                        let art = state.articles.find(function (x) { return x.ref === r.article; });
                        if (!art) {
                            art = { ref: r.article, label: r.label || '', tva: DEFAULT_TVA, warnings: {} };
                            state.articles.push(art);
                        }
                        const l = ensureLine(c, art);
                        l.price = String(r.tariff);
                        l.margin = '';
                        l.minQty = r.minQty;
                        l.maxQty = r.maxQty;
                        l.comment = r.comment || '';
                        loadPrices(c, art);
                    });
                    added += 1;
                });
                // Fermeture par le bouton « Fermer » du modal (même chemin que l'utilisateur) : Modal.getInstance().hide() laisse un fond gris
                // bloquant quand Bootstrap est chargé deux fois par le thème de l'intranet.
                $('ocImportModal').querySelector('.modal-footer [data-bs-dismiss="modal"]').click();
                render();
                toast(added + ' ligne' + (added > 1 ? 's' : '') + ' ajoutée' + (added > 1 ? 's' : '') + ' à l\'OC : vérifiez-les puis enregistrez le brouillon.');
            });

            // ── Chargement d'une OC existante (modification d'un brouillon) ou d'une OC rejetée (nouvelle OC) ──
            if (INITIAL) {
                const ic = INITIAL.customer;
                const customer = { code: ic.code, name: ic.name, currency: ic.currency };
                state.customers.push(customer);
                state.offerId = INITIAL.offerId;
                state.sourceOfferId = INITIAL.sourceOfferId;
                $('ocStart').value = INITIAL.startDate;
                $('ocEnd').value = INITIAL.endDate;
                savedComment = INITIAL.comment || '';
                refreshCommentUi();
                INITIAL.lines.forEach(function (l) {
                    const tva = l.vatRate !== null ? parseFloat(l.vatRate) : DEFAULT_TVA;
                    const article = { ref: l.articleCode, label: l.articleLabel || '', tva: tva, warnings: {} };
                    state.articles.push(article);
                    const line = ensureLine(customer, article);
                    line.price = String(parseFloat(l.tariff));
                    line.pvc = l.msrp !== null ? String(parseFloat(l.msrp)) : '';
                    line.pvcTouched = l.msrp !== null;   // le MSRP enregistré est conservé (pas écrasé par la valeur X3 actuelle)
                    line.minQty = l.minQty;
                    line.maxQty = l.maxQty;
                    line.comment = l.comment || '';
                    const net = pvNet(line.pvc, tva);
                    line.margin = net ? fmt(round(((net - num(line.price)) / net) * 100, 2)) : '';
                });
                loadDiscount(customer);
                state.articles.forEach(function (a) { loadPrices(customer, a); });   // valeurs X3 actuelles, affichées pour information
            }

            render();
        });
    </script>
{% endblock %}
