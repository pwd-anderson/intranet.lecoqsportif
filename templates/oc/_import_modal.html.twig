{# Modal d'import Excel/CSV des lignes d'OC — v0 : interface seule, le traitement du fichier viendra plus tard. #}
<div class="modal fade" id="ocImportModal" tabindex="-1" aria-labelledby="ocImportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ocImportModalLabel">Importer des lignes d'OC</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted mb-2">
                    Importez plusieurs articles en une fois pour le client sélectionné (article, tarif, quantités, dates, commentaire).
                    Chaque ligne sera contrôlée avant création : client actif, article actif, tarif spé déjà existant, OC en attente.
                </p>
                <p class="small mb-2"><strong>Client concerné :</strong> <span id="ocImportClients" class="text-muted"></span></p>
                <div class="alert alert-warning py-2 small mb-3">
                    Version visuelle : le traitement du fichier n'est pas encore branché.
                </div>
                <div class="border rounded p-4 text-center mb-3" style="border-style: dashed !important; background: #f6f8fb;">
                    <input type="file" class="form-control" id="ocImportFile" accept=".xlsx,.xls,.csv">
                    <div class="small text-muted mt-2">Formats acceptés : .xlsx, .xls, .csv</div>
                </div>
                <a href="#" class="small disabled" aria-disabled="true" onclick="return false;">Télécharger le fichier modèle</a>
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-bordered mb-0 small">
                        <thead class="table-light">
                            <tr>
                                <th>Article</th><th>Tarif</th><th>Qté min</th><th>Qté max</th>
                                <th>Début</th><th>Fin</th><th>Commentaire</th><th>Contrôle</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="8" class="text-muted text-center">Aperçu et résultat des contrôles ligne par ligne après sélection du fichier.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-primary" disabled>Créer les OC</button>
            </div>
        </div>
    </div>
</div>
