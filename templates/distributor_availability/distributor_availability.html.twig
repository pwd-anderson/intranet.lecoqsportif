  const bodyR=el('bodyR');
  el('cntR').textContent=R.length+' rows · '+fmtN(qr)+' units';
  bodyR.innerHTML='';
  if(!R.length){ bodyR.innerHTML='<p style="color:var(--muted);margin-top:12px">No backorder'+(q?' for this filter':'')+' — everything is available.</p>'; }
  for(const grp of groupByOrder(R,9)){
    const lines=grp.lines;
    lines.sort((x,y)=>{
      const kx=(x[10]||0)>=x[2], ky=(y[10]||0)>=y[2];
      const dx=kx?'0000':(x[4]||x[5]||'9999'), dy=ky?'0000':(y[4]||y[5]||'9999');
      return dx.localeCompare(dy)||(P[x[0]][0]+'').localeCompare(P[y[0]][0])||szKey(P[x[0]][1])-szKey(P[y[0]][1]);
    });
    const sum=lines.reduce((s,l)=>s+l[2],0);
    const ref=lines[0][8]||'';
    const g=document.createElement('div'); g.className='ordergrp';
    let rows='';
    for(const l of lines){ const p=P[l[0]];
      rows+='<tr><td class="art">'+p[0]+'</td><td class="sku">'+skuOf(p)+'</td><td class="desc">'+p[2]+'</td><td class="sz">'+p[1]+'</td><td class="num">'+fmtN(l[2])+'</td><td>'+chipFor(l)+'</td><td class="po">'+(l[11]||'')+'</td></tr>';
    }
    g.innerHTML='<div class="ohead"><span class="ono">'+grp.ono+'</span>'+siteBadge(lines[0][9]||'')+(ref?'<span class="oref">'+ref+'</span>':'')+
      (lines[0][7]?'<span class="odate">requested delivery '+fmtD(lines[0][7])+'</span>':'')+
      '<span class="osum">'+fmtN(sum)+' units</span></div>'+
