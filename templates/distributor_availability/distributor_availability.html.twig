{% extends 'base.html.twig' %}

{#
  Module Distributor Availability — voir CLAUDE.md.
  Porté fidèlement depuis public/template/Distributor_Availability_intranet_3.html (fichier de
  référence PM, source de vérité pour la logique métier : FIFO, priorisation, Cambodge, PO_OVERRIDE).
  Différences vs le fichier de référence :
   - auto-chargement au DOMContentLoaded (pas de bouton manuel comme Pilotage) ;
   - les 4 sources SQL sont déjà filtrées/agrégées côté serveur (5 distributeurs, réserve France) ;
   - palette de couleurs intranet (#40a2ed / #2b84d4 / #172b4c), comme Pilotage Livraisons ;
   - mode "Import fichiers (test)" conservé en secours (bascule Live/Import).
#}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@700;800&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap">
<style id="daStyle">
.da-wrap{
  /* Palette intranet — mêmes valeurs hexadécimales que templates/pilotage/pilotage.html.twig */
  --bg:#eceef1;
  --surface:#ffffff;
  --surface-2:#eef0f3;
  --ink:#172b4c;
  --ink-2:#3d4753;
  --muted:#6b7683;
  --line:#d8dce2;
  --accent:#2b84d4;      /* goldD intranet */
  --accent-ink:#ffffff;
  --accent-soft:#eef6fd; /* bleuF intranet */
  --good:#0f7b3d; --good-bg:#e7f4ec;
  --warn:#a86a00; --warn-bg:#fdf2dc;
  --late:#c8102e; --late-bg:#fceaec;
  --unk:#5b6572;  --unk-bg:#eef0f3;
  --shadow:0 1px 3px rgba(23,43,76,.08);
  box-sizing:border-box;
}
.da-wrap *{box-sizing:border-box}
.da-wrap{background:var(--bg);color:var(--ink);font-family:"Source Sans 3",-apple-system,"Segoe UI",Roboto,sans-serif;font-size:14.5px;line-height:1.45;min-height:calc(100vh - 60px)}
.da-wrap .app{display:flex;min-height:calc(100vh - 60px)}
.da-wrap body.dist .side,.da-wrap.dist .side,.da-wrap.dist #internview,.da-wrap.dist #updview,.da-wrap.dist #genview,
.da-wrap.dist .legend,.da-wrap.dist .modetabs,.da-wrap.dist details.howto{display:none!important}
.da-wrap.dist #placeholder{display:none}
.da-wrap.dist .main{padding:30px clamp(18px,4vw,54px) 70px}
.da-wrap.dist .sitecode,.da-wrap.dist .sitebadge .cd{display:none}
.da-wrap .disthead{display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding-bottom:14px;margin-bottom:6px;border-bottom:1px solid var(--line)}
.da-wrap .disthead .logo{font-family:"Archivo",sans-serif;font-weight:800;font-size:14px;letter-spacing:.03em;text-transform:uppercase}
.da-wrap .disthead .logo span{color:var(--accent)}
.da-wrap .disthead .asof{margin-left:auto;color:var(--muted);font-size:12.5px}
.da-wrap .distnote{margin-top:26px;color:var(--muted);font-size:12.5px;max-width:70ch;border-top:1px solid var(--line);padding-top:12px}
.da-wrap .side{width:300px;flex:0 0 300px;border-right:1px solid var(--line);background:var(--surface);display:flex;flex-direction:column;position:sticky;top:60px;height:calc(100vh - 60px)}
.da-wrap .brand{padding:18px 18px 12px;border-bottom:1px solid var(--line)}
.da-wrap .brand h1{font-family:"Archivo",sans-serif;font-weight:800;font-size:17px;letter-spacing:.02em;margin:0;text-transform:uppercase;color:var(--ink)}
.da-wrap .brand h1 span{color:var(--accent)}
.da-wrap .brand .sub{color:var(--muted);font-size:12px;margin-top:2px}
.da-wrap .modetabs{display:flex;gap:3px;padding:10px 14px 0}
.da-wrap .modetabs button{flex:1;min-width:0;border:1px solid var(--line);background:var(--surface);color:var(--ink-2);border-radius:8px 8px 0 0;border-bottom:0;padding:7px 2px;font:inherit;font-size:11px;font-weight:700;text-transform:uppercase;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer}
.da-wrap .modetabs button.on{background:var(--accent);color:var(--accent-ink)}
.da-wrap .modetabs button:focus-visible{outline:2px solid var(--accent)}
.da-wrap .searchbox{padding:12px 14px;border-bottom:1px solid var(--line)}
.da-wrap .searchbox input{width:100%;padding:8px 10px;border:1px solid var(--line);border-radius:8px;background:var(--bg);color:var(--ink);font:inherit}
.da-wrap .searchbox input:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:transparent}
.da-wrap .clist{overflow-y:auto;flex:1;padding:6px}
.da-wrap .citem{display:block;width:100%;text-align:left;border:0;background:none;color:var(--ink);padding:8px 10px;border-radius:8px;cursor:pointer;font:inherit}
.da-wrap .citem:hover{background:var(--surface-2)}
.da-wrap .citem.on{background:var(--accent);color:var(--accent-ink)}
.da-wrap .citem .nm{font-weight:600;font-size:13px;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.da-wrap .citem .qt{font-size:11.5px;opacity:.75;font-variant-numeric:tabular-nums}
.da-wrap .main{flex:1;min-width:0;padding:26px 34px 60px}
.da-wrap .da-placeholder{color:var(--muted);max-width:46ch;margin:12vh auto;text-align:center}
.da-wrap .da-placeholder h2{font-family:"Archivo",sans-serif;font-weight:700;color:var(--ink-2)}
.da-wrap .chead h2{font-family:"Archivo",sans-serif;font-weight:800;font-size:26px;margin:0;color:var(--ink)}
.da-wrap .chead .meta{color:var(--muted);font-size:13px;margin-top:2px}
.da-wrap .toolrow{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px;align-items:center}
.da-wrap .btn{border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:8px;padding:7px 12px;font:inherit;font-size:13px;font-weight:600;cursor:pointer}
.da-wrap .btn:hover{background:var(--surface-2)}
.da-wrap .btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.da-wrap .btn.primary:disabled{opacity:.45;cursor:not-allowed}
.da-wrap .filterinp{flex:1;min-width:180px;max-width:340px;padding:7px 10px;border:1px solid var(--line);border-radius:8px;background:var(--surface);color:var(--ink);font:inherit;font-size:13px}
.da-wrap .sitefilter{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}
.da-wrap .sitefilter button{border:1px solid var(--line);background:var(--surface);color:var(--ink-2);border-radius:999px;padding:5px 13px;font:inherit;font-size:12.5px;font-weight:600;cursor:pointer}
.da-wrap .sitefilter button.on{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.da-wrap .sitefilter button .n{opacity:.75;font-variant-numeric:tabular-nums;font-weight:400}
.da-wrap .ordertot{margin-top:20px;display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.da-wrap .ordertot .lbl{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em;font-weight:700}
.da-wrap .ordertot .v{font-family:"Archivo",sans-serif;font-weight:800;font-size:26px;font-variant-numeric:tabular-nums;line-height:1}
.da-wrap .ordertot .u{color:var(--muted);font-size:13px}
.da-wrap .propbar{display:flex;gap:2px;margin-top:9px;height:12px;border-radius:6px;overflow:hidden;background:var(--surface-2)}
.da-wrap .propbar span{display:block;min-width:2px}
.da-wrap .propbar .sg-pickup{background:var(--good)}
.da-wrap .propbar .sg-dated{background:var(--accent)}
.da-wrap .propbar .sg-nodate{background:var(--muted)}
.da-wrap .propbar .sg-fr{background:var(--accent-soft)}
.da-wrap .propbar .sg-other{background:var(--line)}
.da-wrap .fchips{display:flex;gap:8px;flex-wrap:wrap;margin-top:11px}
.da-wrap .fchip{display:flex;flex-direction:column;gap:1px;text-align:left;border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:9px;padding:8px 13px;font:inherit;cursor:pointer;min-width:118px}
.da-wrap .fchip:hover{background:var(--surface-2)}
.da-wrap .fchip.on{border-width:2px;padding:7px 12px}
.da-wrap .fchip.on.c-pickup{border-color:var(--good)} .da-wrap .fchip.on.c-dated{border-color:var(--accent)}
.da-wrap .fchip.on.c-nodate{border-color:var(--muted)} .da-wrap .fchip.on.c-other{border-color:var(--line);background:var(--surface-2)}
.da-wrap .fchip .fv{font-family:"Archivo",sans-serif;font-weight:800;font-size:19px;font-variant-numeric:tabular-nums;line-height:1.1}
.da-wrap .fchip .fl{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);display:flex;align-items:center;gap:5px}
.da-wrap .fchip .fl::before{content:"";width:8px;height:8px;border-radius:2px;background:currentColor;flex:none}
.da-wrap .fchip.c-pickup .fl{color:var(--good)} .da-wrap .fchip.c-dated .fl{color:var(--accent)}
.da-wrap .fchip.c-nodate .fl{color:var(--muted)} .da-wrap .fchip.c-other .fl{color:var(--ink-2)}
.da-wrap .fchip .fp{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}
.da-wrap .filterbar{display:none;align-items:center;gap:10px;margin-top:12px;padding:8px 13px;border-radius:9px;background:var(--accent-soft);font-size:13.5px;font-weight:600}
.da-wrap .filterbar.on{display:flex}
.da-wrap .filterbar button{margin-left:auto;border:1px solid var(--accent);background:transparent;color:var(--accent);border-radius:7px;padding:3px 10px;font:inherit;font-size:12.5px;font-weight:700;cursor:pointer}
.da-wrap details.howto{margin-top:14px;background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:0 15px}
.da-wrap details.howto summary{cursor:pointer;padding:10px 0;font-size:13.5px;font-weight:700;color:var(--accent);list-style:none}
.da-wrap details.howto summary::-webkit-details-marker{display:none}
.da-wrap details.howto summary::before{content:"?  ";font-weight:800}
.da-wrap details.howto[open] summary{border-bottom:1px solid var(--line)}
.da-wrap details.howto dl{margin:0;padding:10px 0 14px;font-size:13.5px}
.da-wrap details.howto dt{font-weight:700;margin-top:9px}
.da-wrap details.howto dt:first-child{margin-top:0}
.da-wrap details.howto dd{margin:2px 0 0;color:var(--ink-2)}
.da-wrap .tiles{display:flex;gap:12px;flex-wrap:wrap;margin-top:16px}
.da-wrap .tile{background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:12px 16px;min-width:150px;box-shadow:var(--shadow)}
.da-wrap .tile .v{font-family:"Archivo",sans-serif;font-weight:800;font-size:24px;font-variant-numeric:tabular-nums;line-height:1.1}
.da-wrap .tile .l{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.06em;margin-top:3px}
.da-wrap .tile.sites{min-width:200px}
.da-wrap .tile.sites .l{margin-top:0;margin-bottom:6px}
.da-wrap .tile.sites table{font-size:13px;border-collapse:collapse}
.da-wrap .tile.sites td{padding:1px 0;border:0}
.da-wrap .tile.sites td.num{padding-left:14px;font-weight:700;font-variant-numeric:tabular-nums;text-align:right;color:var(--good)}
.da-wrap section{margin-top:34px}
.da-wrap .sechead{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;border-bottom:2px solid var(--accent);padding-bottom:6px}
.da-wrap .sechead h3{font-family:"Archivo",sans-serif;font-weight:800;font-size:17px;text-transform:uppercase;letter-spacing:.04em;margin:0;color:var(--ink)}
.da-wrap .sechead .cnt{color:var(--muted);font-size:13px;font-variant-numeric:tabular-nums}
.da-wrap .ordergrp{background:var(--surface);border:1px solid var(--line);border-radius:10px;margin-top:14px;overflow:hidden;box-shadow:var(--shadow)}
.da-wrap .ohead{display:flex;gap:14px;flex-wrap:wrap;align-items:baseline;padding:9px 14px;background:var(--surface-2);border-bottom:1px solid var(--line);font-size:13px}
.da-wrap .ohead .ono{font-weight:700}
.da-wrap .ohead .oref{color:var(--ink-2)}
.da-wrap .ohead .odate{color:var(--muted)}
.da-wrap .ohead .osum{margin-left:auto;font-weight:700;font-variant-numeric:tabular-nums}
.da-wrap .twrap{overflow-x:auto}
.da-wrap table{border-collapse:collapse;width:100%;font-size:13.5px}
.da-wrap th{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.05em;text-align:left;padding:7px 14px;border-bottom:1px solid var(--line);white-space:nowrap}
.da-wrap td{padding:6px 14px;border-bottom:1px solid var(--line);vertical-align:top}
.da-wrap tr:last-child td{border-bottom:0}
.da-wrap td.num,.da-wrap th.num{text-align:right;font-variant-numeric:tabular-nums}
.da-wrap td.art{font-weight:600;white-space:nowrap}
.da-wrap td.sz{white-space:nowrap}
.da-wrap td.desc{color:var(--ink-2);max-width:34ch}
.da-wrap .chip{display:inline-flex;align-items:center;gap:5px;border-radius:999px;padding:2px 9px;font-size:12px;font-weight:600;white-space:nowrap}
.da-wrap .chip::before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.da-wrap .chip.gd{color:var(--good);background:var(--good-bg)}
.da-wrap .chip.wn{color:var(--warn);background:var(--warn-bg)}
.da-wrap .chip.lt{color:var(--late);background:var(--late-bg)}
.da-wrap .chip.uk{color:var(--unk);background:var(--unk-bg)}
.da-wrap .chip.st{color:var(--accent);background:var(--accent-soft)}
.da-wrap .sitebadge{display:inline-block;border:1px solid var(--line);border-radius:5px;padding:1px 7px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--ink-2);background:var(--surface)}
.da-wrap .sitebadge .cd{font-weight:400;opacity:.6;margin-left:5px;font-family:ui-monospace,Menlo,monospace;letter-spacing:0}
.da-wrap .sitecode{font-weight:400;opacity:.55;font-family:ui-monospace,Menlo,monospace;font-size:.85em;letter-spacing:0;margin-left:5px}
.da-wrap table.allouer{font-size:12px}
.da-wrap table.allouer thead th{position:sticky;top:0;background:var(--surface-2);z-index:2;padding:7px 6px}
.da-wrap table.allouer td{padding:5px 6px}
.da-wrap table.allouer td.desc{max-width:9ch;color:var(--ink-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.da-wrap table.allouer td.cli{max-width:11ch;overflow:hidden;text-overflow:ellipsis;font-weight:700;white-space:nowrap}
.da-wrap table.allouer td.cmd{white-space:nowrap;font-variant-numeric:tabular-nums}
.da-wrap td.sku{white-space:nowrap;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.9em;font-weight:600}
.da-wrap td.po{white-space:nowrap;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:.85em;color:var(--ink-2)}
.da-wrap table.allouer td.src{white-space:nowrap;color:var(--good);font-weight:600}
.da-wrap .act{display:inline-block;border-radius:5px;padding:2px 7px;font-size:11px;font-weight:700;white-space:nowrap}
.da-wrap .act.a1{background:var(--warn-bg);color:var(--warn)}
.da-wrap .act.a0{background:var(--good-bg);color:var(--good)}
.da-wrap table.allouer tr.newcli td{border-top:2px solid var(--accent)}
.da-wrap table.allouer tbody tr:hover td{background:var(--accent-soft)}
.da-wrap .updwrap{max-width:760px}
.da-wrap .updwrap h2{font-family:"Archivo",sans-serif;font-weight:800;font-size:24px;margin:0 0 4px;color:var(--ink)}
.da-wrap .updwrap .intro{color:var(--ink-2);max-width:64ch}
.da-wrap .dropzone{display:block;border:2px dashed var(--line);border-radius:12px;padding:16px 18px;margin-top:14px;background:var(--surface);cursor:pointer}
.da-wrap .dropzone:hover{border-color:var(--accent)}
.da-wrap .dropzone.ok{border-style:solid;border-color:var(--good);background:var(--good-bg)}
.da-wrap .dropzone.err{border-style:solid;border-color:var(--late);background:var(--late-bg)}
.da-wrap .dropzone .dz-title{font-weight:700}
.da-wrap .dropzone .dz-hint{color:var(--muted);font-size:12.5px;margin-top:2px}
.da-wrap .dropzone .dz-state{font-size:13px;margin-top:6px;font-weight:600}
.da-wrap .dropzone input{display:none}
.da-wrap .ctrltable{margin-top:18px;border-collapse:collapse;font-size:13.5px;background:var(--surface);border:1px solid var(--line);border-radius:10px;overflow:hidden;width:100%}
.da-wrap .ctrltable th,.da-wrap .ctrltable td{padding:7px 14px;border-bottom:1px solid var(--line);text-align:right}
.da-wrap .ctrltable th:first-child,.da-wrap .ctrltable td:first-child{text-align:left}
.da-wrap .ctrltable tr:last-child td{border-bottom:0}
.da-wrap .updlog{margin-top:14px;font-size:12.5px;color:var(--ink-2);background:var(--surface);border:1px solid var(--line);border-radius:10px;padding:10px 14px;max-height:220px;overflow-y:auto;white-space:pre-wrap}
.da-wrap .updlog .err{color:var(--late);font-weight:700}
.da-wrap .legend{margin-top:26px;color:var(--muted);font-size:12.5px;max-width:72ch}
.da-wrap .legend code{font-family:ui-monospace,Menlo,monospace;font-size:.92em;background:var(--surface-2);padding:0 4px;border-radius:3px}
.da-wrap .legend b{color:var(--ink-2)}
.da-wrap .toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:var(--ink);color:#fff;padding:8px 16px;border-radius:8px;font-size:13px;opacity:0;transition:opacity .25s;pointer-events:none;z-index:9999}
.da-wrap .toast.show{opacity:1}
.da-wrap .srcswitch{display:flex;gap:8px;margin:0 14px 10px}
.da-wrap .srcswitch button{flex:1;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:8px;padding:6px 8px;font:inherit;font-size:11.5px;font-weight:700;cursor:pointer}
.da-wrap .srcswitch button.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.da-wrap #daloading{padding:15vh 24px 24px;color:var(--muted);text-align:center}
.da-wrap .da-spinner{width:34px;height:34px;margin:0 auto 18px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--accent);animation:da-spin .8s linear infinite}
.da-wrap .da-loading-text{font-size:13px}
@keyframes da-spin{to{transform:rotate(360deg)}}
@media (max-width: 860px){
  .da-wrap .app{flex-direction:column}
  .da-wrap .side{width:100%;flex:none;height:auto;position:static;max-height:45vh}
  .da-wrap .main{padding:18px 14px 50px}
}
@media print{
  .da-wrap .side,.da-wrap .toolrow,.da-wrap .searchbox{display:none!important}
  .da-wrap .main{padding:0}
  .da-wrap .ordergrp,.da-wrap .tile{box-shadow:none;break-inside:avoid}
}
</style>
{% endblock %}

{% block body %}
<div class="da-wrap" id="daRoot">
  <div class="app">
    <aside class="side">
      <div class="brand">
        <h1>Distributor <span>Availability</span></h1>
        <div class="sub">Backlog of <span id="gendate"></span> · <span id="nbcli"></span> distributors</div>
      </div>
      <div class="srcswitch">
        <button id="srcLive" class="on">Live (SEI Cube)</button>
        <button id="srcImport">Import fichiers (test)</button>
      </div>
      <div class="modetabs" role="tablist">
        <button id="tabClients" class="on" role="tab" aria-selected="true">Clients</button>
        <button id="tabSites" role="tab" aria-selected="false">Sites</button>
        <button id="tabIntern" role="tab" aria-selected="false" title="Communicated to the distributor, still to be allocated in the system">Allocate</button>
        <button id="tabUpdate" role="tab" aria-selected="false" title="Upload files (test mode)">⟳ Import</button>
        <button id="tabGen" role="tab" aria-selected="false" title="Build one file per distributor">Distributor pages</button>
      </div>
      <div class="searchbox"><input id="csearch" type="search" placeholder="Search a distributor…" aria-label="Search"></div>
      <nav class="clist" id="clist" aria-label="Distributor list"></nav>
    </aside>

    <main class="main" id="main">
      <div id="daloading">
        <div class="da-spinner" aria-hidden="true"></div>
        <div class="da-loading-text" id="daloadingText">Loading live data from SEI Cube…</div>
      </div>
      <div class="da-placeholder" id="placeholder" hidden>
        <h2>Select a distributor</h2>
        <p>Pick a distributor from the list to see what is ready for pick-up and the estimated arrival dates for the rest of their orders.</p>
      </div>
      <div class="disthead" id="disthead" hidden>
        <span class="logo">Le Coq Sportif <span>· B2B Availability</span></span>
        <span class="asof" id="distasof"></span>
      </div>
      <div id="view" hidden>
        <div class="chead">
          <h2 id="cname"></h2>
          <div class="meta" id="cmeta"></div>
        </div>
        <div class="toolrow">
          <input class="filterinp" id="fsearch" type="search" placeholder="Filter by item, SKU, description, order…" aria-label="Filter rows">
          <button class="btn" id="btnexport" hidden style="border-color:var(--accent);color:var(--accent)">⬇ Export to Excel</button>
          <button class="btn" id="btnprint">Print / PDF</button>
          <button class="btn" id="btncopyA">Copy “Available” for Excel</button>
          <button class="btn" id="btncopyR">Copy “Incoming” for Excel</button>
        </div>
        <div class="sitefilter" id="sitefilter" role="group" aria-label="Filter by shipping site"></div>
        <div class="ordertot" id="ordertot"></div>
        <div class="propbar" id="propbar"></div>
        <div class="fchips" id="fchips" role="group" aria-label="Filter by status"></div>
        <div class="filterbar" id="filterbar"><span id="filtertext"></span><button id="clearfilter">Show all</button></div>
        <details class="howto">
          <summary>How to read these figures</summary>
          <dl>
            <dt>Total ordered</dt>
            <dd>Everything the distributor has ordered, across all orders. The blocks below add up exactly to this total.</dd>
            <dt>Ready for pick-up</dt>
            <dd>Units physically available today: those already allocated to their orders on their own site, plus French stock (Logtex Moussey, WLOGM) allocated to them once the domestic market reserve is set aside.</dd>
            <dt>Pending · with a date</dt>
            <dd>Missing units covered by an existing supplier purchase order. The date shown is the expected arrival at the warehouse — not a firm availability date. If that date has already passed, the line is flagged “supplier delay”.</dd>
            <dt>Unavailable references</dt>
            <dd>Missing units with no supplier order behind them, or only partly covered. This is the real topic for the purchasing team: nothing allows us to commit to a date yet.</dd>
            <dt>Cambodia</dt>
            <dd>Cambodia never takes part in any calculation — no allocation, no supplier dates. It appears only for Pacific, whose units are ready to collect on site now, and Umnyama, whose units will be ready there on 15 September 2026.</dd>
            <dt>Unclassified</dt>
            <dd>Units ordered, not yet allocated, but not flagged as short by the system. Usually recent orders not yet processed for allocation. Marginal volume.</dd>
          </dl>
        </details>
        <div class="tiles" id="tiles"></div>

        <section id="secA">
