    bodyR.appendChild(g);
  }
  renderList();
}
function select(name){ fsearch.value=''; siteFilter=null; statusFilter=null; renderClient(name); el('main').scrollIntoView({behavior:'auto'}); }
function selectSite(name){ fsearch.value=''; siteFilter=null; statusFilter=null; renderSite(name); el('main').scrollIntoView({behavior:'auto'}); }

function renderSite(site){
  current=site; const q=fsearch.value.trim().toLowerCase();
  el('placeholder').hidden=true; el('disthead').hidden=true;
  el('view').hidden=false;
  el('cname').innerHTML='Site '+siteLbl(site);
  const sfEl=el('sitefilter'); sfEl.hidden=true; sfEl.innerHTML='';
  let A=[],R=[];
  for(const n of names){
    const c=C[n];
    for(const l of c.a){ if((l[5]||'—')===site && (!q||matches(l,q,'a')||n.toLowerCase().includes(q))) A.push({l,cli:n}); }
    for(const l of c.r){ if((l[9]||'—')===site && (!q||matches(l,q,'r')||n.toLowerCase().includes(q))) R.push({l,cli:n}); }
  }
  const nbCli=new Set(A.map(e=>e.cli).concat(R.map(e=>e.cli))).size;
  el('cmeta').textContent=nbCli+' distributors · as at '+fmtD(TODAY);
  const A0l=A.map(e=>e.l), R0l=R.map(e=>e.l);
  let tot=0,na=0;
  for(const n of names){ const c=C[n]; tot+=(c.t&&c.t[site])||0; na+=(c.na&&c.na[site])||0; }
  const S=renderSummary(A0l,R0l,q?0:tot,q?0:na,()=>renderSite(site));
  const keep=applyStatus(A0l,R0l);
  const keepA=new Set(keep.A), keepR=new Set(keep.R);
  A=A.filter(e=>keepA.has(e.l)); R=R.filter(e=>keepR.has(e.l));
  curA=A; curR=R;
  sectionVis();
  const qa=A.reduce((s,e)=>s+e.l[2],0), qr=R.reduce((s,e)=>s+e.l[2],0);
  el('tiles').innerHTML = (S.qLate>0&&!statusFilter?'<div class="tile"><div class="v" style="color:var(--late)">'+fmtN(S.qLate)+'</div><div class="l">of which already overdue</div></div>':'');

  function groupOC(entries){
    const m=new Map();
    for(const e of entries){ const k=e.cli+'||'+e.l[1]; if(!m.has(k)) m.set(k,{cli:e.cli,ono:e.l[1],lines:[]}); m.get(k).lines.push(e.l); }
    return [...m.values()].sort((x,y)=>x.cli.localeCompare(y.cli,'en')||x.ono.localeCompare(y.ono));
  }
  const bodyA=el('bodyA');
  el('cntA').textContent=A.length+' rows · '+fmtN(qa)+' units';
  bodyA.innerHTML='';
  if(!A.length){ bodyA.innerHTML='<p style="color:var(--muted);margin-top:12px">Nothing ready for pick-up on this site'+(q?' for this filter':'')+'.</p>'; }
  for(const grp of groupOC(A)){
    grp.lines.sort((x,y)=>(P[x[0]][0]+'').localeCompare(P[y[0]][0])||szKey(P[x[0]][1])-szKey(P[y[0]][1]));
    const sum=grp.lines.reduce((s,l)=>s+l[2],0);
    const g=document.createElement('div'); g.className='ordergrp';
    let rows='';
    for(const l of grp.lines){ const p=P[l[0]]; rows+='<tr><td class="art">'+p[0]+'</td><td class="sku">'+skuOf(p)+'</td><td class="desc">'+p[2]+'</td><td class="sz">'+p[1]+'</td><td class="num">'+fmtN(l[2])+'</td></tr>'; }
    g.innerHTML='<div class="ohead"><span class="ono"></span><span class="oref">'+grp.ono+(grp.lines[0][4]?' · '+grp.lines[0][4]:'')+'</span>'+
      (grp.lines[0][3]?'<span class="odate">requested delivery '+fmtD(grp.lines[0][3])+'</span>':'')+
      '<span class="osum">'+fmtN(sum)+' units</span></div>'+
      '<div class="twrap"><table><thead><tr><th>Item</th><th>SKU</th><th>Description</th><th>Size</th><th class="num">Qty ready</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
    g.querySelector('.ono').textContent=grp.cli;
    bodyA.appendChild(g);
  }
  const bodyR=el('bodyR');
  el('cntR').textContent=R.length+' rows · '+fmtN(qr)+' units';
  bodyR.innerHTML='';
  if(!R.length){ bodyR.innerHTML='<p style="color:var(--muted);margin-top:12px">No backorder on this site'+(q?' for this filter':'')+'.</p>'; }
  for(const grp of groupOC(R)){
    grp.lines.sort((x,y)=>{
      const kx=(x[10]||0)>=x[2], ky=(y[10]||0)>=y[2];
      const dx=kx?'0000':(x[4]||x[5]||'9999'), dy=ky?'0000':(y[4]||y[5]||'9999');
      return dx.localeCompare(dy)||(P[x[0]][0]+'').localeCompare(P[y[0]][0])||szKey(P[x[0]][1])-szKey(P[y[0]][1]);
    });
    const sum=grp.lines.reduce((s,l)=>s+l[2],0);
    const g=document.createElement('div'); g.className='ordergrp';
    let rows='';
    for(const l of grp.lines){ const p=P[l[0]]; rows+='<tr><td class="art">'+p[0]+'</td><td class="sku">'+skuOf(p)+'</td><td class="desc">'+p[2]+'</td><td class="sz">'+p[1]+'</td><td class="num">'+fmtN(l[2])+'</td><td>'+chipFor(l)+'</td><td class="po">'+(l[11]||'')+'</td></tr>'; }
    g.innerHTML='<div class="ohead"><span class="ono"></span><span class="oref">'+grp.ono+(grp.lines[0][8]?' · '+grp.lines[0][8]:'')+'</span>'+
      (grp.lines[0][7]?'<span class="odate">requested delivery '+fmtD(grp.lines[0][7])+'</span>':'')+
      '<span class="osum">'+fmtN(sum)+' units</span></div>'+
      '<div class="twrap"><table><thead><tr><th>Item</th><th>SKU</th><th>Description</th><th>Size</th><th class="num">Qty missing</th><th>Availability</th><th>PO number</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
    g.querySelector('.ono').textContent=grp.cli;
    bodyR.appendChild(g);
  }
  renderList();
}

function collectRows(kind){ return kind==='a'?curA:curR; }
function tableFor(kind){
  const rows=collectRows(kind);
  if(kind==='a'){
    const head=['Distributor','Site','Site code','Order','Cust. ref','Item','SKU','Description','Size','Qty ready for pick-up'];
    return {head, data: rows.map(e=>{ const l=e.l,p=P[l[0]]; return [e.cli,l[5]||'',codeOf(l[5]),l[1],l[4]||'',p[0],skuOf(p),p[2],p[1],l[2]]; })};
  }
  const head=['Distributor','Site','Site code','Order','Cust. ref','Item','SKU','Description','Size','Qty missing','Status','Estimated arrival','PO number','Qty partly covered'];
  return {head, data: rows.map(e=>{ const l=e.l,p=P[l[0]], w=l[12]||'';
    return [e.cli,l[9]||'',codeOf(l[9]),l[1],l[8]||'',p[0],skuOf(p),p[2],p[1],l[2],
      w?'Confirmed':(l[3]===2?(l[4]<TODAY?'Supplier delay':'Confirmed'):(l[3]===1?'Partial':'To be confirmed')),
      w||l[4]||l[5]||'',l[11]||'',l[3]===1?l[6]:'']; })};
}
function copyTSV(kind){
  if(!current) return;
  const t=tableFor(kind);
  const out=[t.head].concat(t.data).map(r=>r.join('\t')).join('\n')+'\n';
  navigator.clipboard.writeText(out).then(()=>toast('Copied — paste straight into Excel'),()=>toast('Copy not available in this browser'));
}
el('btncopyA').addEventListener('click',()=>copyTSV('a'));
el('btncopyR').addEventListener('click',()=>copyTSV('r'));

function browserSave(filename,data,type){
  const blob=new Blob([data],{type:type||'text/csv;charset=utf-8'});
  const url=URL.createObjectURL(blob);
  const a=document.createElement('a'); a.href=url; a.download=filename; a.style.display='none';
  document.body.appendChild(a); a.click(); a.remove();
  setTimeout(()=>URL.revokeObjectURL(url),3000);
}
function csvOf(t){
  const esc=v=>{ v=(v==null?'':String(v)); if(v.includes(';')||v.includes('"')||v.includes('\n')) v='"'+v.replace(/"/g,'""')+'"'; return v; };
  return '﻿sep=;\r\n'+[t.head].concat(t.data.map(r=>r.map(x=>esc(String(x==null?'':x))))).map(r=>r.join(';')).join('\r\n')+'\r\n';
}
function fslug(s){ return String(s).replace(/[\\/:*?"<>|]+/g,' ').replace(/\s+/g,' ').trim(); }
function exportExcel(){
  if(!current) return;
  const base=fslug(mode==='client'?current+(siteFilter?' - '+siteFilter:''):'Site '+current);
  for(const [kind,label] of [['a','Ready for pick-up'],['r','Pending']]){
    const t=tableFor(kind); if(!t.data.length) continue;
    browserSave(label+' - '+base+' - '+fmtD(TODAY)+'.csv', csvOf(t));
    toast(label+' exported — the file opens in Excel');
  }
}
el('btnexport').hidden=false;
el('btnexport').addEventListener('click',exportExcel);
el('btnprint').addEventListener('click',()=>window.print());
el('clearfilter').addEventListener('click',()=>{ statusFilter=null; if(mode==='client') renderClient(current); else renderSite(current); });

/* DA-STRIP:START — vue "Allocate" (interne, staff LCS uniquement) : son conteneur
   #internview est retiré du clone par distFile(), donc ces addEventListener sur
   des éléments absents planteraient le script exporté ; en plus les données I
   (allocation interne) n'ont rien à faire dans un fichier destiné à un distributeur. */
/* ===================== ALLOCATE (interne) ===================== */
function renderIntern(){
  el('placeholder').hidden=true; el('view').hidden=true; el('disthead').hidden=true;
  el('internview').hidden=false;
  const iclients=Object.keys(I).sort((a,b)=>a.localeCompare(b,'en'));
  const tot=iclients.reduce((s,n)=>s+I[n].reduce((x,l)=>x+l[3],0),0);
  const nl=iclients.reduce((s,n)=>s+I[n].length,0);
  const recap=iclients.map(n=>{ const q=I[n].reduce((x,l)=>x+l[3],0); return '<tr><td>'+n+'</td><td class="num">'+fmtN(q)+'</td></tr>'; }).join('');
  let nNew=0,nMod=0,nAll=0;
  for(const n of iclients) for(const l of I[n]){ const a=l[6]||0; if(a===1) nNew++; else if(a===2) nAll++; else nMod++; }
  el('tilesI').innerHTML=
    '<div class="tile" style="border-color:var(--accent)"><div class="v" style="color:var(--accent)">'+fmtN(tot)+'</div><div class="l">units to allocate</div></div>'+
    '<div class="tile"><div class="v">'+fmtN(nl)+'</div><div class="l">rows to process</div></div>'+
    (nNew?'<div class="tile"><div class="v" style="color:var(--warn)">'+fmtN(nNew)+'</div><div class="l">new lines to create</div></div>':'')+
    (nMod?'<div class="tile"><div class="v" style="color:var(--good)">'+fmtN(nMod)+'</div><div class="l">lines to amend</div></div>':'')+
    (nAll?'<div class="tile"><div class="v" style="color:var(--good)">'+fmtN(nAll)+'</div><div class="l">lines to allocate as they are</div></div>':'')+
    (iclients.length?'<div class="tile sites"><div class="l">Split by distributor</div><table><tbody>'+recap+'</tbody></table></div>':'');

  const body=el('bodyI'); body.innerHTML='';
  if(!nl){ body.innerHTML='<p style="color:var(--muted);margin-top:14px">Nothing to allocate — every unit communicated as available is already allocated in the system.</p>'; return; }
  const rows=[];
  for(const n of iclients) for(const l of I[n]) rows.push({cli:n,l});
  rows.sort((x,y)=> x.cli.localeCompare(y.cli,'en') || (x.l[1]<y.l[1]?-1:x.l[1]>y.l[1]?1:0) || (P[x.l[0]][0]+'').localeCompare(P[y.l[0]][0]) || szKey(P[x.l[0]][1])-szKey(P[y.l[0]][1]));
  let html='<div class="ordergrp" style="margin-top:16px"><div class="twrap"><table class="allouer"><thead><tr>'+
    '<th>Distributor</th><th>Order</th><th>Cust. ref</th><th>Item</th><th>SKU</th><th>Description</th><th>Size</th>'+
    '<th class="num">Qty to allocate</th><th>Picked from</th><th>ERP action</th><th>Order site</th></tr></thead><tbody>';
  let prev=null;
  for(const e of rows){
    const p=P[e.l[0]]; const isNew=e.cli!==prev; prev=e.cli;
    html+='<tr'+(isNew?' class="newcli"':'')+'>'+
      '<td class="cli">'+e.cli+'</td>'+'<td class="cmd">'+e.l[1]+'</td>'+
      '<td class="desc" title="'+(e.l[2]||'')+'">'+(e.l[2]||'')+'</td>'+
      '<td class="art">'+p[0]+'</td>'+'<td class="sku">'+skuOf(p)+'</td>'+
      '<td class="desc" title="'+p[2].replace(/"/g,'&quot;')+'">'+p[2]+'</td>'+'<td class="sz">'+p[1]+'</td>'+
      '<td class="num">'+fmtN(e.l[3])+'</td>'+'<td class="src">'+siteLbl(e.l[7]||STOCKSITE)+'</td>'+
      '<td><span class="act a'+(e.l[6]||0)+'">'+ACTION[e.l[6]||0]+'</span></td>'+
      '<td style="white-space:nowrap">'+siteLbl(e.l[5]||'')+'</td></tr>';
  }
  html+='</tbody></table></div></div>';
  body.innerHTML=html;
}
function internTable(){
  const head=['Distributor','Order','Cust. ref','Item','SKU','Description','Size','Qty to allocate','Picked from','Stock site code','ERP action','Order site','Order site code','Requested delivery'];
  const data=[];
  for(const n of Object.keys(I).sort((a,b)=>a.localeCompare(b,'en'))){
