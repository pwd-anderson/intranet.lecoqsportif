<script id="daXlsxLib" src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script id="daScript">
document.addEventListener('DOMContentLoaded', function(){
'use strict';
const ROOT = document.getElementById('daRoot');
const el = id => document.getElementById(id);
const NOOP = {classList:{toggle(){},add(){},remove(){}}, setAttribute(){}, addEventListener(){}};

const RULES = (()=>{ const e=document.getElementById('RULES');
  try{ return (e && e.textContent.trim()) ? JSON.parse(e.textContent) : {}; }catch(err){ return {}; } })();
const SITECODE = RULES.SITECODE || {};
const SITEMAP  = RULES.SITEMAP  || {};
const ACTION   = RULES.ACTION   || {};
const PRIO     = RULES.PRIO     || [];
const KEEPCLI  = RULES.KEEPCLI  || [];
const KH_CLI   = RULES.KH_CLI   || {};
const FR_RESERVE_MONTHS = RULES.FR_RESERVE_MONTHS || 3;
const PO_OVERRIDE = RULES.PO_OVERRIDE || [];
const STOCKSITE = 'France';
/* Sur la page live, #DB est vide ({}) au chargement (les données arrivent via loadLive()).
   Sur un fichier exporté par generateDistPages(), #DB contient déjà le sous-ensemble d'un
   seul distributeur (clé "only") — même mécanisme que le fichier de référence PM. */
const DB_SEED = (()=>{ const e=document.getElementById('DB');
  try{ const t=e && e.textContent.trim(); if(!t || t==='{}') return null; const d=JSON.parse(t);
    return (d && d.C) ? d : null; }catch(err){ return null; } })();
const DIST = (DB_SEED && DB_SEED.only && DB_SEED.C[DB_SEED.only]) ? DB_SEED.only : null;
const DIST_BAD = !!(DB_SEED && DB_SEED.only) && !DIST;

/* DA-STRIP:START — moteur de calcul et règles métier internes : jamais présents
   dans un fichier exporté par generateDistPages() (voir #DA-STRIP dans distFile()),
   même si le code source de la page live les contient — un distributeur ne doit
   trouver AUCUNE trace, même dans du code mort, d'un autre client ou d'une règle
   interne (ex: "UMNYAMA" codé en dur dans la restriction Madagascar/WCOMG). */
function poOverride(pl){
  if(!pl || !pl.length) return null;
  for(const o of PO_OVERRIDE){ if(pl.every(p=>o.po.indexOf(p)>=0)) return o; }
  return null;
}
const keptClient = n => KEEPCLI.some(k=>String(n).toUpperCase().includes(k));
const khAllowed = n => Object.keys(KH_CLI).some(k=>String(n).toUpperCase().includes(k));
const khDate = n => { const u=String(n).toUpperCase(); for(const k in KH_CLI) if(u.includes(k)) return KH_CLI[k]; return null; };
const RE_SPL = /(^|[^A-Z0-9])SPL([^A-Z0-9]|$)/;
const RE_SS27 = /SS\s*27|SS-27|2027-01-SS/;
const excluded = (ref,coll) => {
  const r=String(ref||'').toUpperCase(), c=String(coll||'').toUpperCase();
  return RE_SPL.test(r) || RE_SS27.test(r) || RE_SS27.test(c);
};
/* DA-STRIP:END */

const codeOf = s => SITECODE[s] || '';
function siteLbl(s,cls){ const c=codeOf(s); return s + (c ? '<span class="'+(cls||'sitecode')+'">'+c+'</span>' : ''); }
const showPO = () => true;
const skuOf = p => p[0]+'_'+p[1];
function siteBadge(s){ const c=codeOf(s); return '<span class="sitebadge">'+s+(c?'<span class="cd">'+c+'</span>':'')+'</span>'; }
const fmtN = n => (n||0).toLocaleString('en-GB');
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
function fmtD(s){ if(!s) return ''; const [y,m,d]=s.split('-'); return (+d)+' '+MONTHS[+m-1]+' '+y; }
const SIZE_ORDER = {'XXXS':1,'XXS':2,'XS':3,'S':4,'M':5,'L':6,'XL':7,'XXL':8,'2XL':8,'XXXL':9,'3XL':9,'4XL':10,'5XL':11,'TU':50,'OS':50};
function szKey(s){ s=(s||'').toUpperCase(); if(SIZE_ORDER[s]) return SIZE_ORDER[s]; const n=parseFloat(s.replace(',','.')); return isNaN(n)?60:100+n; }
function toast(msg){ const t=el('toast'); t.textContent=msg; t.classList.add('show'); setTimeout(()=>t.classList.remove('show'),2200); }

let TODAY = new Date().toISOString().slice(0,10);
let P = [], C = {}, I = {};
let names = [];

/* ===================== MOTEUR DE CALCUL ======================
   Porté fidèlement depuis public/template/Distributor_Availability_intranet_3.html
   (bloc #adminjs, fonction maybeRun(), lignes ~868-993 du fichier de référence).
   compute() prend des lignes déjà normalisées (identiques que la source soit
   l'API live ou l'import Excel) : {site,cli,num,cmd,ref,art,vr,desc,dcmd,dliv,qt,qa,qr,rst}
   pour CL, une map supply[sku] = [[date,qty,po], ...] triée, une map pool[sku] = qty,
   et une map frRes[sku] = quantité réservée au marché France (déjà avant la coupure). */
/* DA-STRIP:START — voir note plus haut */
function compute(CL, supply, pool, frRes){
  // réserve marché France : on retire du pool ce qui est déjà promis aux autres clients France
  let heldTotal=0;
  for(const sk in frRes){
    const av=pool[sk]||0; if(av<=0) continue;
    const take=Math.min(av,frRes[sk]); pool[sk]=av-take; heldTotal+=take;
  }

  const allocOrder={};
  for(const l of CL){ allocOrder[l.cmd]=(allocOrder[l.cmd]||0)+l.qa; }

  const prioRank={}; PRIO.forEach((n,i)=>prioRank[n]=i);
  const rupt=CL.filter(l=>l.qr>0 && l.site!=='WTAKH').map((l,i)=>({...l,i,sku:l.art+'_'+l.vr,prio:prioRank[l.cli]??99}));

  function fifoPass(needOf){
    rupt.sort((a,b)=>(a.sku<b.sku?-1:a.sku>b.sku?1:0) || (a.dcmd<b.dcmd?-1:a.dcmd>b.dcmd?1:0) || (a.cmd<b.cmd?-1:a.cmd>b.cmd?1:0) || a.i-b.i);
    const pos={}; let cov=0;
    for(const l of rupt){
      const need=Math.max(needOf(l),0);
      const start=pos[l.sku]||0, end=start+need; pos[l.sku]=end;
      l.dFull=null; l.dFirst=null; l.qCov=0; l.po=[];
      if(need<=0) continue;
      const sup=supply[l.sku];
      if(sup){
        let cum=0;
        for(const [d,q,po] of sup){
          cum+=q;
          if(cum>start){
            if(!l.dFirst) l.dFirst=d;
            if(po && l.po.indexOf(po)<0) l.po.push(po);
            l.qCov=Math.min(cum,end)-start;
          }
          if(cum>=end){ l.dFull=d; break; }
        }
      }
      cov+=Math.max(l.qCov,0);
    }
    return cov;
  }

  fifoPass(l=>l.qr);
  let ovReadyQty=0;
  for(const l of rupt){
    const ov=poOverride(l.po||[]);
    l.qrd=(ov && ov.mode==='ready') ? l.qr : 0;
    ovReadyQty+=l.qrd;
  }
  rupt.sort((a,b)=>a.prio-b.prio || (a.dcmd<b.dcmd?-1:a.dcmd>b.dcmd?1:0) || (a.cmd<b.cmd?-1:a.cmd>b.cmd?1:0) || a.i-b.i);
  let stockAlloc=0;
  for(const l of rupt){
    const avail=pool[l.sku]||0;
    l.qs=Math.max(Math.min(l.qr-l.qrd,avail),0);
    if(l.qs>0){ pool[l.sku]=avail-l.qs; stockAlloc+=l.qs; }
  }
  const fifoCov=fifoPass(l=>l.qr-l.qrd-l.qs);

  const skuIdx={}; const P2=[];
  const getIdx=(l)=>{ const k=l.art+'_'+l.vr; if(!(k in skuIdx)){ skuIdx[k]=P2.length; P2.push([l.art,l.vr,l.desc]); } return skuIdx[k]; };
  const sname=s=>SITEMAP[s]||s;
  const cnum=v=>{ const f=parseFloat(v); return isNaN(f)?String(v??''):String(Math.trunc(f)); };
  const C2={}; const I2={}; let allocQty=0, residQty=0;
  const newc=l=>C2[l.cli]=C2[l.cli]||{num:cnum(l.num),a:[],r:[],t:{},na:{}};
  for(const l of CL){
    const c=newc(l), sn2=sname(l.site);
    c.t[sn2]=(c.t[sn2]||0)+Math.trunc(l.qt);
    if(l.site!=='WTAKH') c.na[sn2]=(c.na[sn2]||0)+Math.max(0,Math.trunc(l.rst)-Math.max(0,Math.trunc(l.qr)));
    else c.na[sn2]=c.na[sn2]||0;
  }
  for(const l of CL){
    if(l.site==='WTAKH'){
      const q=Math.trunc(l.qa)+Math.max(0,Math.trunc(l.qr));
      if(q>0){
        const c=newc(l), d=khDate(l.cli);
        if(d){ c.r.push([getIdx(l),l.cmd,q,2,d,d,q,l.dliv,l.ref,'Cambodia',0,'','']); residQty+=q; }
        else { c.a.push([getIdx(l),l.cmd,q,l.dliv,l.ref,'Cambodia']); allocQty+=q; }
      }
      continue;
    }
    if(l.qa>0){
      const c=newc(l);
      c.a.push([getIdx(l),l.cmd,Math.trunc(l.qa),l.dliv,l.ref,sname(l.site)]);
      allocQty+=Math.trunc(l.qa);
    }
  }
  let ovReady=0, ovWin=0;
  for(const l of rupt){
    const c=newc(l);
    const idx=getIdx(l);
    const site0=sname(l.site);
    const qrd=Math.trunc(l.qrd||0), qs=Math.trunc(l.qs), resid=Math.trunc(l.qr)-qs-qrd;
    if(qrd>0){
      let hit=null;
      for(const al of c.a){ if(al[0]===idx && al[1]===l.cmd && al[5]===site0){ hit=al; break; } }
      if(hit) hit[2]+=qrd; else c.a.push([idx,l.cmd,qrd,l.dliv,l.ref,site0]);
      allocQty+=qrd; ovReady+=qrd;
      (I2[l.cli]=I2[l.cli]||[]).push([idx,l.cmd,l.ref,qrd,l.dliv,site0,2,site0]);
    }
    if(qs>0){
      let hit=null;
      for(const al of c.a){ if(al[0]===idx && al[1]===l.cmd && al[5]==='France'){ hit=al; break; } }
      if(hit) hit[2]+=qs; else c.a.push([idx,l.cmd,qs,l.dliv,l.ref,'France']);
      allocQty+=qs;
      const act = site0==='France' ? 2 : ((allocOrder[l.cmd]||0)>0 ? 1 : 0);
      (I2[l.cli]=I2[l.cli]||[]).push([idx,l.cmd,l.ref,qs,l.dliv,site0,act,'France']);
    }
    if(resid>0){
      const site=site0, ov=poOverride(l.po||[]);
      let st = l.dFull?2 : l.qCov>0?1 : 0, dF=l.dFull, dFi=l.dFirst, lab='';
      if(ov && ov.mode==='window'){ st=2; dF=ov.end; dFi=ov.end; lab=ov.label; ovWin+=resid; }
      c.r.push([idx,l.cmd,resid,st,dF,dFi,Math.trunc(l.qCov),l.dliv,l.ref,site,0,(l.po||[]).join(' + '),lab]);
      residQty+=resid;
    }
  }
  const today=new Date();
  const gen=today.getFullYear()+'-'+String(today.getMonth()+1).padStart(2,'0')+'-'+String(today.getDate()).padStart(2,'0');
  return {gen,P:P2,C:C2,I:I2,stats:{allocQty,residQty,stockAlloc,fifoCov,ovReady,ovWin,heldTotal}};
}

/* ===================== NORMALISATION DES SOURCES =====================
   Les 4 requêtes SQL (src/Infrastructure/Sql/Sei/distributor_availability_*.sql)
   sont déjà filtrées côté serveur (5 sites autorisés, 5 distributeurs suivis pour
   le backlog client, France uniquement statut A1 pour le stock, BL Fournisseur
   uniquement). Reste à porter côté JS les règles qui ne peuvent pas être du SQL
   pur : Madagascar réservé à Umnyama, Cambodge réservé à Pacific/Umnyama,
   exclusion SPL/SS27 — exactement comme le fichier de référence (lignes ~774-799). */
function normalizeClientRows(rows){
  const CL=[];
  for(const r of rows){
    const site=String(r['SITE']??'').trim();
    if(!(site in SITEMAP)) continue;
    const cli=String(r['NOM CLIENT CMDE']??'').trim();
    if(!keptClient(cli)) continue;
    if(site==='WCOMG' && !cli.toUpperCase().includes('UMNYAMA')) continue;
    if(site==='WTAKH' && !khAllowed(cli)) continue;
    if(excluded(r['REFERENCE CLIENT'], r['COLLECTION'])) continue;
    const cmd=r['N° COMMANDE'];
    if(cmd==null || String(cmd).trim()==='') continue;
    CL.push({
      site, cli, num:r['N° CLIENT CMDE'], cmd:String(cmd).trim(),
      ref:String(r['REFERENCE CLIENT']??'').trim(),
      art:String(r['ARTICLE']??'').trim(), vr:String(r['VARIANT']??'').trim(),
      desc:String(r['DESCRIPTION ARTICLE']??'').trim(),
      dcmd:r['DATE COMMANDE']||'9999-12-31', dliv:r['DATE DE LIVRAISON']||null,
      qt:Number(r['QUANTITE'])||0, qa:Number(r['QUANTITE ALLOUEE'])||0,
      qr:Number(r['QUANTITE EN RUPTURE'])||0, rst:Number(r['RESTE A ALLOUER'])||0,
    });
  }
  return CL;
}
function normalizeFranceReserve(rows){
  const frRes={};
  for(const r of rows){
    const sk=String(r['ARTICLE']??'').trim()+'_'+String(r['VARIANT']??'').trim();
    frRes[sk]=(frRes[sk]||0)+(Number(r['RESTE A ALLOUER'])||0);
  }
  return frRes;
}
function normalizeSupply(rows){
  const supply={};
  for(const r of rows){
    if(String(r['TYPE FLUX']??'').trim()!=='BL Fournisseur') continue;
    const q=Number(r['QTE A LIVRER'])||0; if(q<=0) continue;
    const d=r['DATE LIVRAISON']; if(!d) continue;
    const sku=String(r['ARTICLE']??'').trim();
    const po=String(r['N° COMMANDE']??'').trim();
    const kk=d+'\u0000'+po;
    (supply[sku]=supply[sku]||{})[kk]=(supply[sku][kk]||0)+q;
  }
  for(const k in supply) supply[k]=Object.entries(supply[k])
    .map(([kk,q])=>{ const i=kk.indexOf('\u0000'); return [kk.slice(0,i), q, kk.slice(i+1)]; })
    .sort((a,b)=> a[0]<b[0]?-1 : a[0]>b[0]?1 : (a[2]<b[2]?-1:a[2]>b[2]?1:0));
  return supply;
}
function normalizePool(rows){
  const pool={};
  for(const r of rows){
    if(String(r['STATUS STOCK']??'').trim()!=='A1') continue;
    const q=Number(r['STOCK DISPONIBLE'])||0; if(q<=0) continue;
    const sku=String(r['ARTICLE']??'').trim();
    pool[sku]=(pool[sku]||0)+q;
  }
  return pool;
}

/* DA-STRIP:END */
function applyResult(res){
  TODAY=res.gen; P=res.P; C=res.C; I=res.I||{};
  names = Object.keys(C).sort((a,b)=>a.localeCompare(b,'en'));
  if(el('gendate')) el('gendate').textContent = fmtD(TODAY);
  if(el('nbcli'))   el('nbcli').textContent   = names.length;
  el('daloading').hidden=true;
  el('placeholder').hidden=false;
  renderList();
}

/* ===================== CHARGEMENT LIVE (API JSON) =====================
   Auto-chargement au DOMContentLoaded (contrairement à Pilotage qui attend un
   clic) : la volumétrie de ce module (~26 700 lignes / 4 requêtes <1s chacune,
   5 distributeurs uniquement) le permet largement.
   Chargement séquentiel : même choix que Pilotage pour rester cohérent avec le
   reste du site, même si ici la faible volumétrie rendrait un Promise.all sans
   risque — on documente le choix plutôt que de le changer sans raison. */
const URL_CLIENT = "{{ path('api_distributor_availability_backlog_client') }}";
const URL_FRRES   = "{{ path('api_distributor_availability_france_reserve') }}";
const URL_FOURN   = "{{ path('api_distributor_availability_backlog_fournisseur') }}";
const URL_STOCK   = "{{ path('api_distributor_availability_stock') }}";

/* DA-STRIP:START — chargement live (mode Symfony) : absent des fichiers exportés
   par generateDistPages(), qui embarquent déjà leurs données dans #DB (DB_SEED). */
async function loadLive(){
  el('daloading').hidden=false; el('daloadingText').textContent='Loading live data from SEI Cube…';
  try{
    el('daloadingText').textContent='Loading customer backlog…';
    const client = await fetch(URL_CLIENT).then(r=>{ if(!r.ok) throw new Error('Backlog client : HTTP '+r.status); return r.json(); });
    el('daloadingText').textContent='Loading French market reserve…';
    const frres  = await fetch(URL_FRRES).then(r=>{ if(!r.ok) throw new Error('Réserve France : HTTP '+r.status); return r.json(); });
    el('daloadingText').textContent='Loading supplier backlog…';
    const fourn  = await fetch(URL_FOURN).then(r=>{ if(!r.ok) throw new Error('Backlog fournisseur : HTTP '+r.status); return r.json(); });
    el('daloadingText').textContent='Loading Logtex stock…';
    const stock  = await fetch(URL_STOCK).then(r=>{ if(!r.ok) throw new Error('Stock : HTTP '+r.status); return r.json(); });

    const CL = normalizeClientRows(client);
    const frRes = normalizeFranceReserve(frres);
    const supply = normalizeSupply(fourn);
    const pool = normalizePool(stock);
    const res = compute(CL, supply, pool, frRes);
    applyResult(res);
  }catch(e){
    el('daloadingText').textContent='';
    showModal('alert','Erreur de chargement des données live : '+e.message);
    console.error(e);
  }
}

/* ===================== IMPORT FICHIERS (mode test) =====================
   Reprend le parsing Excel du fichier de référence (bloc #adminjs) pour
   produire les mêmes structures normalisées, puis appelle le même compute(). */
const upd={files:{}, result:null, inited:false};
function log(msg,isErr){ const e=el('updlog'); e.hidden=false; const l=document.createElement('div'); if(isErr) l.className='err'; l.textContent=msg; e.appendChild(l); e.scrollTop=e.scrollHeight; }
function clearLog(){ const e=el('updlog'); e.innerHTML=''; e.hidden=true; }
const norm = s => String(s??'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/\s+/g,' ').trim();
const N = v => { const n=typeof v==='number'?v:parseFloat(String(v??'').replace(',','.').replace(/\s/g,'')); return isNaN(n)?0:n; };
function toISO(v){
  if(v==null || v==='') return null;
  if(typeof v==='number'){ const d=new Date(Math.round((v-25569)*86400000)); return d.getUTCFullYear()+'-'+String(d.getUTCMonth()+1).padStart(2,'0')+'-'+String(d.getUTCDate()).padStart(2,'0'); }
  if(v instanceof Date){ return v.getFullYear()+'-'+String(v.getMonth()+1).padStart(2,'0')+'-'+String(v.getDate()).padStart(2,'0'); }
  const s=String(v).trim();
  let m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/); if(m) return m[3]+'-'+m[2].padStart(2,'0')+'-'+m[1].padStart(2,'0');
  m=s.match(/^(\d{4})-(\d{2})-(\d{2})/); if(m) return m[1]+'-'+m[2]+'-'+m[3];
  return null;
}
async function sheetRows(file){ const buf=await file.arrayBuffer(); const wb=XLSX.read(buf,{type:'array',raw:true,dense:true}); const ws=wb.Sheets[wb.SheetNames[0]]; return XLSX.utils.sheet_to_json(ws,{header:1,raw:true,defval:null}); }
function headerIndex(rows,mustHave){ for(let i=0;i<Math.min(rows.length,10);i++){ const hs=(rows[i]||[]).map(norm); if(mustHave.every(h=>hs.includes(norm(h)))) return i; } return -1; }
function colmap(headerRow,wanted){ const hs=headerRow.map(norm); const map={}; const missing=[]; for(const [key,ns] of Object.entries(wanted)){ let idx=-1; for(const n of ns){ idx=hs.indexOf(norm(n)); if(idx>=0) break; } if(idx<0) missing.push(ns[0]); else map[key]=idx; } return {map,missing}; }

function initUpdate(){
  if(upd.inited) return; upd.inited=true;
  [['fC','dzC','stC','client'],['fF','dzF','stF','fourn'],['fS','dzS','stS','stock']].forEach(([fid,dzid,stid,role])=>{
    const inp=el(fid), dz=el(dzid), st=el(stid);
    inp.addEventListener('change',()=>{
      if(!inp.files.length) return;
      upd.files[role]=inp.files[0];
      st.textContent=inp.files[0].name+' — '+(inp.files[0].size/1e6).toFixed(1)+' MB';
      dz.classList.remove('err'); dz.classList.add('ok');
      maybeRun();
    });
  });
}

async function maybeRun(){
  if(!(upd.files.client && upd.files.fourn && upd.files.stock)) return;
  clearLog(); upd.result=null;
  el('btnpublish').disabled=true;
  el('ctrlzone').innerHTML='';
  try{
    log('Reading the files…');
    const [rc,rf,rs]=await Promise.all([sheetRows(upd.files.client),sheetRows(upd.files.fourn),sheetRows(upd.files.stock)]);

    const hc=headerIndex(rc,['N° Commande','Nom Client Cmde','Quantité Allouée']);
    if(hc<0) throw new Error('Customer backlog: expected columns not found.');
    const cw=colmap(rc[hc],{site:['Site'],num:['N° Client Cmde'],cli:['Nom Client Cmde'],cmd:['N° Commande'],ref:['Référence Client'],art:['Article'],var:['Variant'],desc:['Description Article'],dcmd:['Date Commande'],dliv:['Date de livraison'],coll:['Collection'],qt:['Quantité'],qa:['Quantité Allouée'],qr:['Quantité en rupture'],rst:['Reste à Allouer']});
    if(cw.missing.length) throw new Error('Customer backlog: missing columns: '+cw.missing.join(', '));
    const CL=[]; const frRes={};
    const _cut=new Date(); _cut.setMonth(_cut.getMonth()+FR_RESERVE_MONTHS);
    const FR_CUT=_cut.toISOString().slice(0,10);
    for(let i=hc+1;i<rc.length;i++){
      const r=rc[i]; if(!r) continue;
      const cmd=r[cw.map.cmd]; if(cmd==null||String(cmd).trim()==='') continue;
      const site=String(r[cw.map.site]??'').trim();
      if(!(site in SITEMAP)) continue;
      const cli=String(r[cw.map.cli]??'').trim();
      if(site==='WLOGM' && !keptClient(cli)){
        const rst=N(r[cw.map.rst]);
        if(rst>0){
          const dv=toISO(r[cw.map.dliv]);
          if(!dv || dv<=FR_CUT){
            const sk=String(r[cw.map.art]??'').trim()+'_'+String(r[cw.map.var]??'').trim();
            frRes[sk]=(frRes[sk]||0)+rst;
          }
        }
      }
      if(!keptClient(cli)) continue;
      if(site==='WCOMG' && !cli.toUpperCase().includes('UMNYAMA')) continue;
      if(excluded(r[cw.map.ref], r[cw.map.coll])) continue;
      if(site==='WTAKH' && !khAllowed(cli)) continue;
      CL.push({site,cli,num:r[cw.map.num],cmd:String(cmd).trim(),ref:String(r[cw.map.ref]??'').trim(),
        art:String(r[cw.map.art]??'').trim(),vr:String(r[cw.map.var]??'').trim(),desc:String(r[cw.map.desc]??'').trim(),
        dcmd:toISO(r[cw.map.dcmd])||'9999-12-31',dliv:toISO(r[cw.map.dliv]),qt:N(r[cw.map.qt]),qa:N(r[cw.map.qa]),qr:N(r[cw.map.qr]),rst:N(r[cw.map.rst])});
    }
    if(!CL.length) throw new Error('No rows kept: check the file contains orders for Pacific, Umnyama, Niala, Getro or Sports Life.');
    log('Customer backlog: '+CL.length.toLocaleString('en-GB')+' rows kept');

    const hf=headerIndex(rf,['TYPE FLUX','ARTICLE','QTÉ À LIVRER']);
    if(hf<0) throw new Error('Supplier backlog: expected columns not found.');
    const fw=colmap(rf[hf],{flux:['TYPE FLUX'],art:['ARTICLE'],q:['QTÉ À LIVRER'],dl:['DATE LIVRAISON'],po:['N° COMMANDE']});
    if(fw.missing.length) throw new Error('Supplier backlog: missing columns: '+fw.missing.join(', '));
    const fournRows=[];
    for(let i=hf+1;i<rf.length;i++){
      const r=rf[i]; if(!r) continue;
      fournRows.push({'TYPE FLUX':r[fw.map.flux],'ARTICLE':r[fw.map.art],'QTE A LIVRER':N(r[fw.map.q]),'DATE LIVRAISON':toISO(r[fw.map.dl]),'N° COMMANDE':r[fw.map.po]});
    }
    const supply=normalizeSupply(fournRows);
    log('Supplier backlog: '+fournRows.length.toLocaleString('en-GB')+' rows read');

    const hs2=headerIndex(rs,['Article','Status Stock','Stock Disponible']);
    if(hs2<0) throw new Error('Stock file: expected columns not found.');
    const sw=colmap(rs[hs2],{art:['Article'],st:['Status Stock'],q:['Stock Disponible']});
    if(sw.missing.length) throw new Error('Stock file: missing columns: '+sw.missing.join(', '));
    const siteCol=rs[hs2].findIndex(h=>norm(h)==='site');
    const stockRows=[];
    for(let i=hs2+1;i<rs.length;i++){
      const r=rs[i]; if(!r) continue;
      if(siteCol>=0 && String(r[siteCol]??'').trim()!=='WLOGM') continue;
      stockRows.push({'ARTICLE':r[sw.map.art],'STATUS STOCK':r[sw.map.st],'STOCK DISPONIBLE':N(r[sw.map.q])});
    }
    const pool=normalizePool(stockRows);
    log('Logtex WLOGM A1 stock: '+Object.values(pool).reduce((s,v)=>s+v,0).toLocaleString('en-GB')+' units available');

    const res=compute(CL,supply,pool,frRes);
    upd.result=res;
    const fmt=n=>Math.round(n).toLocaleString('en-GB');
    el('ctrlzone').innerHTML='<table class="ctrltable"><thead><tr><th>Check</th><th>Value</th></tr></thead><tbody>'+
      '<tr><td>Distributors</td><td>'+Object.keys(res.C).length+'</td></tr>'+
      '<tr><td>Units ready for pick-up</td><td>'+fmt(res.stats.allocQty)+'</td></tr>'+
      '<tr><td>Units pending</td><td>'+fmt(res.stats.residQty)+'</td></tr>'+
      '<tr><td>… of which dated via supplier</td><td>'+fmt(res.stats.fifoCov)+'</td></tr>'+
      '<tr><td>French stock allocated</td><td>'+fmt(res.stats.stockAlloc)+'</td></tr>'+
      '</tbody></table>';
    log('Calculation complete. Click "Use this dataset" to switch the page to this import.');
    el('btnpublish').disabled=false;
  }catch(e){
    log(String(e.message||e),true);
  }
}
el('btnpublish').addEventListener('click',()=>{
  if(!upd.result) return;
  applyResult(upd.result);
  toast('Import dataset in use');
  setMode('client');
});
/* DA-STRIP:END */

/* ===================== RENDU (vues Clients / Sites / Allocate) =====================
   Porté fidèlement depuis le fichier de référence (bloc #viewjs), adapté pour ne
   plus dépendre de la variable DIST (aucune vue distributeur isolée sur cette page —
   c'est le rôle des fichiers générés par generateDistPages()). renderList()/renderClient()
   restent présents dans les fichiers exportés : c'est renderClient() qui affiche le détail
   du distributeur dans DIST_BAD/DIST au démarrage (voir plus bas). */
const clist = el('clist');
const csearch = el('csearch');
let current = null;
let mode = 'client';
let siteFilter = null;
let statusFilter = null;
let curA = [], curR = [];

function siteAgg(){
  const SITES={};
  for(const n of names){
    const c=C[n];
    for(const l of c.a){ const s=l[5]||'—'; (SITES[s]=SITES[s]||{a:0,r:0}).a+=l[2]; }
    for(const l of c.r){ const s=l[9]||'—'; (SITES[s]=SITES[s]||{a:0,r:0}).r+=l[2]; }
  }
  return SITES;
}
function renderList(){
  if(!clist||!csearch) return;
  const q=csearch.value.trim().toLowerCase();
  clist.innerHTML=''; let shown=0;
  if(mode==='client'){
    for(const n of names){
      if(q && !n.toLowerCase().includes(q) && !(C[n].num||'').includes(q)) continue;
      shown++;
      const c=C[n];
      const qa=c.a.reduce((s,l)=>s+l[2],0), qr=c.r.reduce((s,l)=>s+l[2],0);
      const b=document.createElement('button');
      b.className='citem'+(mode==='client'&&n===current?' on':'');
      b.innerHTML='<span class="nm"></span><span class="qt">'+fmtN(qa)+' ready · '+fmtN(qr)+' incoming</span>';
      b.querySelector('.nm').textContent=n;
      b.addEventListener('click',()=>select(n));
      clist.appendChild(b);
    }
    if(!shown) clist.innerHTML='<p style="color:var(--muted);padding:10px 12px;font-size:13px">No matching distributor.</p>';
  } else {
    const SITES=siteAgg();
    const siteNames=Object.keys(SITES).sort((x,y)=>(SITES[y].a+SITES[y].r)-(SITES[x].a+SITES[x].r));
    for(const n of siteNames){
      if(q && !n.toLowerCase().includes(q)) continue;
      shown++;
      const s=SITES[n];
      const b=document.createElement('button');
      b.className='citem'+(mode==='site'&&n===current?' on':'');
      b.innerHTML='<span class="nm">'+siteLbl(n)+'</span><span class="qt">'+fmtN(s.a)+' ready · '+fmtN(s.r)+' incoming</span>';
      b.addEventListener('click',()=>selectSite(n));
      clist.appendChild(b);
    }
    if(!shown) clist.innerHTML='<p style="color:var(--muted);padding:10px 12px;font-size:13px">No matching site.</p>';
  }
}
if(csearch) csearch.addEventListener('input',renderList);

const tabC=el('tabClients')||NOOP, tabS=el('tabSites')||NOOP, tabU=el('tabUpdate')||NOOP, tabI=el('tabIntern')||NOOP, tabG=el('tabGen')||NOOP;
function setMode(m){
  mode=(m==='update'||m==='intern'||m==='gen')?mode:m;
  if(m==='client'||m==='site') current=null;
  tabC.classList.toggle('on',m==='client'); tabS.classList.toggle('on',m==='site'); tabU.classList.toggle('on',m==='update'); tabI.classList.toggle('on',m==='intern'); tabG.classList.toggle('on',m==='gen');
  el('view').hidden=true;
  el('updview').hidden = m!=='update';
  el('internview').hidden = m!=='intern';
  el('genview').hidden = m!=='gen';
  el('placeholder').hidden = (m==='update'||m==='intern'||m==='gen') || !names.length;
  if(m==='client'||m==='site'){
    if(csearch){ csearch.value=''; csearch.placeholder = m==='client'?'Search a distributor…':'Search a site…'; }
    const ph2=document.querySelector('#placeholder h2');
    if(ph2) ph2.textContent = m==='client'?'Select a distributor':'Select a shipping site';
    renderList();
  } else if(m==='update'){ initUpdate(); }
  else if(m==='gen'){ /* rien à faire */ }
  else { renderIntern(); }
}
tabC.addEventListener('click',()=>setMode('client'));
tabS.addEventListener('click',()=>setMode('site'));
tabU.addEventListener('click',()=>setMode('update'));
tabI.addEventListener('click',()=>setMode('intern'));
tabG.addEventListener('click',()=>setMode('gen'));

const fsearch=el('fsearch');
fsearch.addEventListener('input',()=>{ if(!current) return; mode==='client'?renderClient(current):renderSite(current); });

function renderSummary(A,R,tot,na,rerender){
  const qa=A.reduce((s,l)=>s+l[2],0);
  const qDated=R.filter(l=>l[3]===2).reduce((s,l)=>s+l[2],0);
  const qNo=R.reduce((s,l)=>s+l[2],0)-qDated;
  const qLate=R.filter(l=>l[3]===2 && l[4]<TODAY).reduce((s,l)=>s+l[2],0);
  const total=tot ? tot : (qa+qDated+qNo+na);
  const base=total; const pct=v=>base?Math.round(v/base*100):0;

  el('ordertot').innerHTML='<span class="lbl">Total ordered</span><span class="v">'+fmtN(total)+'</span><span class="u">units ordered</span>';

  const segs=[['pickup',qa],['dated',qDated],['nodate',qNo],['other',na]];
  el('propbar').innerHTML=segs.filter(([,v])=>v>0).map(([k,v])=>'<span class="sg-'+k+'" style="flex:'+v+'" title="'+fmtN(v)+' units"></span>').join('');

  const chips=[['pickup','Ready for pick-up',qa,true],['dated','Pending · with date',qDated,true],['nodate','Unavailable references',qNo,true],['other','Unclassified',na,false]].filter(c=>c[2]>0||c[0]==='pickup');
  el('fchips').innerHTML=chips.map(([k,lbl,v,click])=>
    '<button class="fchip c-'+k+(statusFilter===k?' on':'')+'" data-f="'+k+'"'+(click?'':' disabled style="cursor:default;opacity:.75"')+'>'+
    '<span class="fv">'+fmtN(v)+'</span><span class="fl">'+lbl+'</span><span class="fp">'+pct(v)+'% of the order</span></button>').join('');
  document.querySelectorAll('#fchips .fchip[data-f]').forEach(b=>{
    if(b.disabled) return;
    b.addEventListener('click',()=>{ statusFilter=(statusFilter===b.dataset.f)?null:b.dataset.f; rerender(); });
  });

  const LBL={pickup:'Ready for pick-up only',dated:'Pending with an arrival date only',nodate:'Unavailable references only'};
  const fb=el('filterbar');
  fb.classList.toggle('on',!!statusFilter);
  if(statusFilter) el('filtertext').textContent='Filter on — '+LBL[statusFilter]+'. Exports only include these rows.';
  return {qa,qDated,qNo,qLate,total};
}
function sectionVis(){
  el('secA').hidden = statusFilter && statusFilter!=='pickup';
  el('secR').hidden = statusFilter==='pickup';
  el('btncopyA').hidden = statusFilter && statusFilter!=='pickup';
  el('btncopyR').hidden = statusFilter==='pickup';
}
function applyStatus(A,R){
  return {
    A: statusFilter && statusFilter!=='pickup' ? [] : A,
    R: statusFilter==='pickup' ? [] : (statusFilter==='dated' ? R.filter(l=>l[3]===2) : statusFilter==='nodate' ? R.filter(l=>l[3]!==2) : R)
  };
}
function chipFor(l){
  const st=l[3], resid=l[2], win=l[12]||'';
  let out='';
  if(win){ out+='<span class="chip gd">expected '+win+'</span>'; }
  else if(st===2){
    if(l[4] < TODAY) out+='<span class="chip lt">supplier delay · expected '+fmtD(l[4])+'</span>';
    else out+='<span class="chip gd">confirmed · arriving '+fmtD(l[4])+'</span>';
  } else if(st===1){
    out+='<span class="chip wn">partial · '+fmtN(l[6])+' units around '+fmtD(l[5])+', balance to confirm</span>';
  } else {
    out+='<span class="chip uk">to be confirmed</span>';
  }
  return out;
}
function groupByOrder(lines,siteIdx){
  const m=new Map();
  for(const l of lines){ const k=l[1]+'||'+(l[siteIdx]||''); if(!m.has(k)) m.set(k,{ono:l[1],lines:[]}); m.get(k).lines.push(l); }
  return [...m.values()];
}
function matches(l,q,kind){
  if(!q) return true;
  const p=P[l[0]];
  const ref = kind==='a' ? (l[4]||'') : (l[8]||'');
  const site = kind==='a' ? (l[5]||'') : (l[9]||'');
  return (p[0]+' '+skuOf(p)+' '+p[1]+' '+p[2]+' '+l[1]+' '+ref+' '+site).toLowerCase().includes(q);
}

function renderClient(name){
  current=name; const c=C[name]; const q=fsearch.value.trim().toLowerCase();
  el('placeholder').hidden=true;
  const view=el('view'); view.hidden=false;
  el('cname').textContent=name;
  el('cmeta').textContent='Customer no. '+c.num+' · as at '+fmtD(TODAY);

  const csites={};
  for(const l of c.a){ const s=l[5]||'—'; (csites[s]=csites[s]||{a:0,r:0}).a+=l[2]; }
  for(const l of c.r){ const s=l[9]||'—'; (csites[s]=csites[s]||{a:0,r:0}).r+=l[2]; }
  if(siteFilter && !csites[siteFilter]) siteFilter=null;
  const sf=el('sitefilter');
  sf.hidden=Object.keys(csites).length<2;
  let sfHtml='<button'+(siteFilter?'':' class="on"')+' data-s="">All sites</button>';
  for(const [s,v] of Object.entries(csites).sort((x,y)=>(y[1].a+y[1].r)-(x[1].a+x[1].r))){
    sfHtml+='<button'+(siteFilter===s?' class="on"':'')+' data-s="'+s+'">'+siteLbl(s)+' <span class="n">'+fmtN(v.a)+' · '+fmtN(v.r)+'</span></button>';
  }
  sf.innerHTML=sfHtml;
  sf.querySelectorAll('button').forEach(b=>b.addEventListener('click',()=>{ siteFilter=b.dataset.s||null; statusFilter=null; renderClient(name); }));

  const A0=c.a.filter(l=>matches(l,q,'a') && (!siteFilter || (l[5]||'—')===siteFilter));
  const R0=c.r.filter(l=>matches(l,q,'r') && (!siteFilter || (l[9]||'—')===siteFilter));
  const sumMap=m=>Object.entries(m||{}).filter(([k])=>!siteFilter||k===siteFilter).reduce((s,[,v])=>s+v,0);
  const tot=sumMap(c.t), na=sumMap(c.na);
  const S=renderSummary(A0,R0,q?0:tot,q?0:na,()=>renderClient(name));
  const {A,R}=applyStatus(A0,R0);
  curA=A.map(l=>({l,cli:name})); curR=R.map(l=>({l,cli:name}));
  sectionVis();
  const qa=A.reduce((s,l)=>s+l[2],0), qr=R.reduce((s,l)=>s+l[2],0);

  const bySite={};
  for(const l of A){ const s2=l[5]||'—'; bySite[s2]=(bySite[s2]||0)+l[2]; }
  const siteRows=Object.entries(bySite).sort((x,y)=>y[1]-x[1]).map(([s2,v])=>'<tr><td>'+siteLbl(s2)+'</td><td class="num">'+fmtN(v)+'</td></tr>').join('');
  el('tiles').innerHTML =
    (A.length?'<div class="tile sites"><div class="l">Ready for pick-up by site</div><table><tbody>'+siteRows+'</tbody></table></div>':'')+
    (S.qLate>0&&!statusFilter?'<div class="tile"><div class="v" style="color:var(--late)">'+fmtN(S.qLate)+'</div><div class="l">of which already overdue</div></div>':'');

  const bodyA=el('bodyA');
  el('cntA').textContent=A.length+' rows · '+fmtN(qa)+' units';
  bodyA.innerHTML='';
  if(!A.length){ bodyA.innerHTML='<p style="color:var(--muted);margin-top:12px">Nothing ready for pick-up'+(q?' for this filter':'')+'.</p>'; }
  for(const grp of groupByOrder(A,5)){
    const lines=grp.lines;
    lines.sort((x,y)=>(P[x[0]][0]+'').localeCompare(P[y[0]][0])||szKey(P[x[0]][1])-szKey(P[y[0]][1]));
    const sum=lines.reduce((s,l)=>s+l[2],0);
    const ref=lines[0][4]||'';
    const g=document.createElement('div'); g.className='ordergrp';
    let rows='';
    for(const l of lines){ const p=P[l[0]]; rows+='<tr><td class="art">'+p[0]+'</td><td class="sku">'+skuOf(p)+'</td><td class="desc">'+p[2]+'</td><td class="sz">'+p[1]+'</td><td class="num">'+fmtN(l[2])+'</td></tr>'; }
    g.innerHTML='<div class="ohead"><span class="ono">'+grp.ono+'</span>'+siteBadge(lines[0][5]||'')+(ref?'<span class="oref">'+ref+'</span>':'')+
      (lines[0][3]?'<span class="odate">requested delivery '+fmtD(lines[0][3])+'</span>':'')+
      '<span class="osum">'+fmtN(sum)+' units</span></div>'+
      '<div class="twrap"><table><thead><tr><th>Item</th><th>SKU</th><th>Description</th><th>Size</th><th class="num">Qty ready</th></tr></thead><tbody>'+rows+'</tbody></table></div>';
    bodyA.appendChild(g);
