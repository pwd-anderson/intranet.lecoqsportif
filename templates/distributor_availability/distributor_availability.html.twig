/* ===================== GÉNÉRATION DES PAGES DISTRIBUTEUR =====================
   Porté fidèlement depuis generateDistPages()/distSubset()/distFile() du fichier
   de référence, avec le même garde-fou anti-fuite : chaque fichier généré est
   scanné pour vérifier qu'aucun autre nom de distributeur n'y apparaît avant
   d'autoriser le téléchargement. */
function glog(msg,bad){ const e=el('genlog'); e.hidden=false; const d=document.createElement('div'); if(bad) d.className='err'; d.textContent=msg; e.appendChild(d); e.scrollTop=e.scrollHeight; }
function distSlug(n){ return String(n).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,40); }
function distSubset(cli){
  const c=C[cli];
  const rk=c.r.filter(l=>l[9]==='Cambodia');
  const used=[...new Set(c.a.map(l=>l[0]).concat(rk.map(l=>l[0])))].sort((x,y)=>x-y);
  const remap={}; used.forEach((o,i)=>{ remap[o]=i; });
  const a=c.a.map(l=>[remap[l[0]]].concat(l.slice(1)));
  const r=rk.map(l=>{ const x=[remap[l[0]]].concat(l.slice(1)); x[11]=''; return x; });
  const t={}; for(const l of a) t[l[5]]=(t[l[5]]||0)+l[2]; for(const l of r) t[l[9]]=(t[l[9]]||0)+l[2];
  const na={}; for(const k in t) na[k]=0;
  return {gen:TODAY, only:cli, P:used.map(o=>P[o]), C:{[cli]:{num:c.num,a,r,t,na}}, I:{}};
}
/**
 * Génère une page HTML autonome (self-contained) pour un distributeur, en clonant
 * le VRAI DOM du widget (#daRoot) — même principe que le fichier de référence PM
 * (qui clone document.documentElement), adapté puisque notre page vit dans le
 * layout de l'intranet : on ne clone que le widget, pas le header/sidebar du site.
 * Le clone embarque son propre <style id="daStyle"> et le <script id="daScript">
 * de cette page (mêmes fonctions, dont renderClient) — aucune donnée des autres
 * distributeurs, aucune règle interne (RULES retiré), aucun appel réseau.
 */
function distFile(cli){
  const sub=distSubset(cli);
  const title = cli+' · Availability';

  const root=el('daRoot').cloneNode(true);
  const q=sel=>root.querySelector(sel);
  const qa=sel=>root.querySelectorAll(sel);

  // Données : #DB du clone reçoit le sous-ensemble filtré, #RULES est retiré
  const dbEl=q('#DB'); if(dbEl) dbEl.textContent=JSON.stringify(sub).replace(/<\//g,'<\\/');
  const rulesEl=q('#RULES'); if(rulesEl) rulesEl.remove();

  // Blocs entièrement internes : retirés du DOM (pas juste masqués)
  ['.side','.legend','.modetabs','details.howto','#internview','#updview','#genview']
    .forEach(s=>qa(s).forEach(e=>e.remove()));

  // Zones dynamiques reconstruites par le script au chargement : on repart vierge
  ['#clist','#tiles','#bodyA','#bodyR','#sitefilter','#tilesI','#bodyI','#gencards',
   '#ctrlzone','#updlog','#genlog','#fchips','#propbar','#ordertot'].forEach(s=>{ const e=q(s); if(e) e.innerHTML=''; });
  ['#cname','#cmeta'].forEach(s=>{ const e=q(s); if(e) e.textContent=''; });
  ['#view','#updlog','#genlog'].forEach(s=>{ const e=q(s); if(e) e.setAttribute('hidden',''); });
  const ph=q('#placeholder'); if(ph) ph.removeAttribute('hidden');

  // Zone d'upload (mode Import) réinitialisée
  ['stC','stF','stS'].forEach(id=>{ const e=q('#'+id); if(e) e.textContent='No file'; });
  ['dzC','dzF','dzS'].forEach(id=>{ const e=q('#'+id); if(e) e.classList.remove('ok','err'); });
  const bp=q('#btnpublish'); if(bp){ bp.setAttribute('disabled',''); bp.textContent='Publish the update'; }

  // Les boutons d'onglets (Sites/Update/Allocate/Distributor pages) disparaissent déjà
  // avec .modetabs ci-dessus — le script partagé les référence via el(id)||NOOP,
  // donc leur absence ne casse rien (même principe que le fichier de référence PM).

  const styleTag=el('daStyle'), scriptTag=el('daScript');
  // Retire le moteur de calcul / import / génération (voir marqueurs DA-STRIP dans
  // le script) : même du code mort ne doit jamais mentionner un autre distributeur
  // ou une règle interne dans le fichier livré.
  const scriptSrc=(scriptTag?scriptTag.textContent:'')
    .replace(/\/\* DA-STRIP:START[\s\S]*?DA-STRIP:END \*\//g, '');
  const html='<!doctype html>\n<html lang="en"><head><meta charset="utf-8">'+
    '<meta name="viewport" content="width=device-width,initial-scale=1">'+
    '<title>'+title.replace(/</g,'&lt;')+'</title>'+
    '<style>'+(styleTag?styleTag.textContent:'')+'</style></head><body>'+
    root.outerHTML+
    '<script>'+scriptSrc+'<\/script>'+
    '</body></html>';

  const units=Object.values(sub.C[cli].t).reduce((s,v)=>s+v,0);
  return {html, units, lines: sub.C[cli].a.length+sub.C[cli].r.length,
    name:'Availability - '+cli.replace(/[\\/:*?"<>|]/g,' ').trim()+' - '+fmtD(TODAY)+'.html',
    slug: distSlug(cli)};
}

async function generateDistPages(){
  const btn=el('btngenall');
  btn.disabled=true; btn.textContent='Generating…';
  el('genlog').innerHTML=''; el('gencards').innerHTML='';
  const rows=[];
  try{
    for(const cli of names){
      const f=distFile(cli);
      // garde-fou : aucun autre distributeur ne doit apparaître dans le fichier généré
      const leak=names.filter(n=>n!==cli && f.html.indexOf(n)>=0);
      if(leak.length) throw new Error('Aborted — '+cli+' file would mention '+leak.join(', '));
      browserSave(f.name, f.html, 'text/html;charset=utf-8');
      glog(f.name+' — '+fmtN(f.units)+' units, '+fmtN(f.lines)+' lines');
      rows.push(f);
      await new Promise(r=>setTimeout(r,300));
    }
    el('gencards').innerHTML=
      '<div class="ordergrp" style="margin-top:16px"><div class="twrap"><table><thead><tr>'+
      '<th>Distributor</th><th class="num">Units ready</th><th class="num">Lines</th><th>File</th>'+
      '</tr></thead><tbody>'+rows.map(f=>'<tr><td>'+f.name.split(' - ')[1]+'</td>'+
      '<td class="num">'+fmtN(f.units)+'</td><td class="num">'+fmtN(f.lines)+'</td>'+
      '<td class="desc">'+f.name+'</td></tr>').join('')+'</tbody></table></div></div>';
    glog('Done — '+rows.length+' files in your downloads folder. Checked: no file mentions another distributor.');
    btn.textContent='Generate the 5 files';
  }catch(e){
    glog(String(e.message||e),true);
    btn.textContent='Generate the 5 files';
  }
  btn.disabled=false;
}
el('btngenall').addEventListener('click',generateDistPages);

/* ===================== BASCULE LIVE / IMPORT ===================== */
el('srcLive').addEventListener('click',()=>{
  el('srcLive').classList.add('on'); el('srcImport').classList.remove('on');
  if(typeof confirmModal==='function'){
    confirmModal('Recharger les données live depuis le SEI Cube et écraser le dataset importé actuel ?', ()=>loadLive());
  } else {
    loadLive();
  }
});
el('srcImport').addEventListener('click',()=>{
  el('srcImport').classList.add('on'); el('srcLive').classList.remove('on');
  setMode('update');
});

/* DA-STRIP:END */

/* ===================== DÉMARRAGE ===================== */
if(DIST_BAD){
  document.body.classList.add('dist');
  el('disthead').hidden=false;
  el('view').hidden=true;
  el('placeholder').hidden=false;
  el('placeholder').style.display='block';
  const ph=document.querySelector('#placeholder h2'); if(ph) ph.textContent='Link not recognised';
  const pp=document.querySelector('#placeholder p'); if(pp) pp.textContent='This availability link is not valid. Please ask your Le Coq Sportif contact for an up-to-date link.';
} else if(DIST){
  // Fichier exporté par generateDistPages() : les données du seul distributeur
  // sont déjà dans #DB, pas d'appel réseau — voir DB_SEED plus haut.
  TODAY=DB_SEED.gen; P=DB_SEED.P; C=DB_SEED.C; I=DB_SEED.I||{};
  names=Object.keys(C).sort((a,b)=>a.localeCompare(b,'en'));
  document.body.classList.add('dist');
  el('disthead').hidden=false;
  el('distasof').textContent='Backlog as at '+fmtD(TODAY);
  const note=el('distnote');
  note.hidden=false;
  note.innerHTML='This page lists <b>only what is ready for you to collect</b>: units available now '+
    'at the site shown on each order, plus units already produced and waiting on site from the date '+
    'shown. Order lines still awaiting production or shipment are not listed here — they are followed '+
    'up separately. Figures are indicative and non-contractual, and reflect the backlog at the date above.';
  const howto=document.querySelector('details.howto'); if(howto) howto.remove();
  const rt=el('secRttl'); if(rt) rt.textContent='Ready from the date shown';
  renderClient(DIST);
} else {
  /* Page live normale : auto-chargement au DOMContentLoaded (contrairement à
     Pilotage qui attend un clic) — la volumétrie de ce module (~26 700 lignes
     / 4 requêtes <1s chacune, 5 distributeurs uniquement) le permet largement. */
  loadLive();
}

}); // DOMContentLoaded
</script>
{% endblock %}
